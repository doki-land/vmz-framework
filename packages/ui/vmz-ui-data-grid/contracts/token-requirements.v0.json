{
    "schema": "vmz.ui.token_requirements.v0",
    "package": "@vmz/ui-data-grid",
    "cssVar": {
        "prefix": "--vmz-",
        "fromDotted": "split on '.' then join with '-'"
    },
    "forbiddenBrandHex": ["#176BFF", "#0D57DB", "#FFB000", "#00C878", "#121416"],
    "components": {
        "DataGrid": {
            "source": "src/components/DataGrid.vmz",
            "stableHint": "ui-data-grid.DataGrid",
            "tokens": [
                "surface.paper",
                "surface.mist",
                "surface.fill",
                "text.ink",
                "text.steel",
                "text.tertiary",
                "line.default",
                "line.subtle",
                "action.primary.background",
                "action.primary.active",
                "action.primary.soft",
                "focus.ring",
                "font.mono",
                "density.compact.padding-y",
                "density.compact.padding-x",
                "radius.md",
                "radius.lg",
                "space.1",
                "space.2",
                "space.4"
            ],
            "surfaces": ["WebSurface"],
            "contracts": [
                "parent-owned-selection",
                "row-virtualization",
                "pinned-column",
                "sticky-header",
                "column-sort",
                "row-grouping",
                "group-aggregation",
                "tree-rows",
                "cell-editing",
                "pivot-matrix",
                "not-ordinary-datatable",
                "records-column-definition",
                "stable-row-identity",
                "local-filtering",
                "controlled-pagination",
                "selection-single-multi-plus-page-all",
                "empty-loading-error-states",
                "keyboard-row-focus",
                "aria-table-semantics"
            ]
        }
    },
    "composition": {
        "reuseFrom": "@vmz/ui",
        "mustNotShip": ["Button", "Field", "Dialog", "Form", "Empty", "Skeleton"],
        "composeWith": ["Pagination", "Empty", "Spinner", "BulkActions", "FilterBar", "ConsoleShell", "Field"]
    }
}
