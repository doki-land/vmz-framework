<template>
    <div data-vmz-ui-charts="chart" @mousemove="_onMouseMove" @mouseleave="_onMouseLeave" @mousedown="_onMouseDown" @mouseup="_onMouseUp" @click="_onClick" @keydown="_onKeydown" @pointerdown="_onPointerDown" @pointermove="_onPointerMove" @pointerup="_onPointerUp" @pointercancel="_onPointerUp" @dblclick="_onDblClick" :data-theme="_themeName()" tabindex="0" :role="tableView ? 'group' : 'img'" :aria-label="_ariaLabel()" :aria-describedby="_describedBy()" class="vmz-ui-charts__chart" :style="hostStyle">
        <div v-if="_isEmpty()" class="vmz-ui-charts__empty">
            No chart spec or data.
        </div>
        <div v-else>
            <div v-if="_hasError()" class="vmz-ui-charts__error-banner">
                Chart compile failed — see diagnostics below.
            </div>
            <div v-if="tableView" v-html="_tableHtml()" class="vmz-ui-charts__table-view" />
            <div v-if="!tableView" v-html="markup()" :data-anim="_animMode()" class="vmz-ui-charts__svg" />
            <canvas v-if="_useCanvas() && !tableView" class="vmz-ui-charts__canvas" />
        </div>
        <div v-if="diagnostics.length > 0" class="vmz-ui-charts__diag">
            <div v-for="(d, i) in diagnostics" :key="i" :data-sev="d.severity" class="vmz-ui-charts__diag-item">
                {{ d.severity }}
                :
                {{ d.message }}
            </div>
        </div>
        <div v-if="_crosshair.visible" class="vmz-ui-charts__crosshair" :style="_crosshairStyle()" />
        <div v-for="(dot, i) in _crosshairDots" :key="i" class="vmz-ui-charts__crosshair-dot" :style="_dotStyle(dot)" />
        <div v-if="_brush.active" class="vmz-ui-charts__brush" :style="_brushStyle()" />
        <div v-if="_tooltip.visible" aria-live="polite" class="vmz-ui-charts__tooltip" :style="_tooltipStyle()">
            {{ _tooltip.text }}
        </div>
        <button v-if="_zoomResetVisible()" type="button" @click="_resetZoom" aria-label="重置缩放" class="vmz-ui-charts__zoom-reset">
            重置缩放
        </button>
        <button v-if="_drillBackVisible()" type="button" @click="_drillUp" aria-label="返回上一级" class="vmz-ui-charts__drill-up">
            返回上一级
        </button>
        <div :id="_liveId()" aria-live="polite" class="vmz-ui-charts__sr">
            {{ _liveText }}
        </div>
        <div :id="_srId()" class="vmz-ui-charts__sr">
            {{ _summary() }}
        </div>
        <div v-if="!tableView && !_isEmpty()" :id="_srTableId()" v-html="_tableHtml()" class="vmz-ui-charts__sr" />
    </div>
</template>
<style>
.vmz-ui-charts__chart {
    display: block;
    background: var(--vmz-surface-paper, #ffffff);
    border: 1px solid var(--vmz-line-default, #e5e7eb);
    border-radius: 4px;
    overflow: hidden;
    box-sizing: border-box;
    /* 拖拽（brush/pan）期间禁止浏览器文本选择，否则选区高亮会盖在刻度标签上。 */
    user-select: none;
    -webkit-user-select: none;
    /* 触摸合同：纵向滚动永远归页面，横向手势驱动图表交互。 */
    touch-action: pan-y;
    position: relative;
}
.vmz-ui-charts__zoom-reset,
.vmz-ui-charts__drill-up {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 6;
    padding: 2px 8px;
    border: 1px solid var(--vmz-line-default, #e5e7eb);
    border-radius: 4px;
    background: var(--vmz-surface-paper, #ffffff);
    color: var(--vmz-text-steel, #4b5563);
    font: 500 11px/1.4 var(--vmz-font-sans, system-ui, sans-serif);
    cursor: pointer;
}
/* 返回按钮在左上角，和右上的重置缩放分开，互不遮挡。 */
.vmz-ui-charts__drill-up {
    right: auto;
    left: 6px;
}
.vmz-ui-charts__zoom-reset:hover,
.vmz-ui-charts__drill-up:hover {
    color: var(--vmz-text-ink, #111827);
    border-color: var(--vmz-text-steel, #4b5563);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__zoom-reset,
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__drill-up {
    background: var(--vmz-surface-paper, #0b1220);
    border-color: var(--vmz-line-default, #1f2937);
    color: var(--vmz-text-steel, #9ca3af);
}
/* 数据更新淡入（入场另见 vmz-charts-in；reduced-motion 下一律关闭）。 */
.vmz-ui-charts__svg[data-anim="fade"] svg {
    animation: vmz-charts-fade 0.12s ease-out;
}
.vmz-ui-charts__svg[data-anim="none"] svg {
    animation: none;
}
@keyframes vmz-charts-fade {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}
@media (prefers-reduced-motion: reduce) {
    .vmz-ui-charts__svg[data-anim="fade"] svg {
        animation: none;
    }
}
.vmz-ui-charts__chart[data-theme="dark"] {
    background: var(--vmz-surface-paper, #0b1220);
    border-color: var(--vmz-line-default, #1f2937);
}
.vmz-ui-charts__chart:focus-visible {
    outline: 2px solid var(--vmz-brand-primary, #1677ff);
    outline-offset: 2px;
}
.vmz-ui-charts__chart[data-theme="dark"]:focus-visible {
    outline-color: var(--vmz-brand-primary, #60a5fa);
}
.vmz-ui-charts__svg {
    width: 100%;
    height: 100%;
    display: block;
}
.vmz-ui-charts__svg svg {
    width: 100%;
    height: 100%;
    display: block;
    animation: vmz-charts-in 0.24s ease-out;
}
.vmz-ui-charts__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
}
.vmz-ui-charts__svg svg [data-dvz-id] {
    transition: opacity 0.15s ease;
}
@keyframes vmz-charts-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: none;
    }
}
@media (prefers-reduced-motion: reduce) {
    .vmz-ui-charts__svg svg {
        animation: none;
    }
    .vmz-ui-charts__svg svg [data-dvz-id] {
        transition: none;
    }
}
/* 交互覆盖层（crosshair / brush）——即时定位，无动画，天然满足 reduced-motion。 */
.vmz-ui-charts__crosshair {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--vmz-line-default, #9ca3af);
    opacity: 0.7;
    pointer-events: none;
    z-index: 3;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__crosshair {
    background: var(--vmz-line-default, #6b7280);
}
.vmz-ui-charts__crosshair-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--vmz-surface-paper, #ffffff);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 4;
    box-sizing: border-box;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__crosshair-dot {
    border-color: var(--vmz-surface-paper, #0b1220);
}
.vmz-ui-charts__brush {
    position: absolute;
    border: 1px dashed var(--vmz-brand-primary, #1677ff);
    background: color-mix(in srgb, var(--vmz-brand-primary, #1677ff) 12%, transparent);
    pointer-events: none;
    z-index: 3;
    box-sizing: border-box;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__brush {
    border-color: var(--vmz-brand-primary, #60a5fa);
    background: color-mix(in srgb, var(--vmz-brand-primary, #60a5fa) 14%, transparent);
}
.vmz-ui-charts__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vmz-text-muted, #6b7280);
    font-size: 0.875rem;
}
.vmz-ui-charts__error-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--vmz-status-danger-foreground, #b91c1c);
    color: #fff;
    font-size: 0.75rem;
    padding: 4px 8px;
    z-index: 2;
}
.vmz-ui-charts__diag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--vmz-surface-paper, #fff) 88%, transparent);
    max-height: 40%;
    overflow: auto;
    font-family: var(--vmz-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-top: 1px solid var(--vmz-line-default, #e5e5e5);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag {
    background: color-mix(in srgb, var(--vmz-surface-paper, #0b1220) 88%, transparent);
    border-top-color: var(--vmz-line-default, #1f2937);
    color: #e5e7eb;
}
.vmz-ui-charts__diag-item {
    padding: 1px 0;
}
.vmz-ui-charts__diag-item[data-sev="error"] {
    color: var(--vmz-status-danger-foreground, #b91c1c);
}
.vmz-ui-charts__diag-item[data-sev="warning"] {
    color: var(--vmz-status-warning-foreground, #b7791f);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="error"] {
    color: var(--vmz-status-danger-foreground, #f87171);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="warning"] {
    color: var(--vmz-status-warning-foreground, #fbbf24);
}
.vmz-ui-charts__tooltip {
    position: absolute;
    z-index: 999;
    pointer-events: none;
    background: rgba(17, 24, 39, 0.92);
    color: #f9fafb;
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 4px 8px;
    border-radius: 4px;
    transform: translate(10px, 10px);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__tooltip {
    background: rgba(249, 250, 251, 0.95);
    color: #111827;
}
/* 数据表降级视图：同一组件的原生表格渲染。 */
.vmz-ui-charts__table-view {
    overflow: auto;
    max-height: 100%;
    font-size: 0.8125rem;
    line-height: 1.5;
}
.vmz-ui-charts__table-view table {
    border-collapse: collapse;
    width: 100%;
}
.vmz-ui-charts__table-view caption {
    text-align: left;
    padding: 6px 8px;
    font-weight: 600;
    color: var(--vmz-text-ink, #111827);
}
.vmz-ui-charts__table-view th,
.vmz-ui-charts__table-view td {
    text-align: left;
    padding: 4px 10px;
    border-bottom: 1px solid var(--vmz-line-default, #e5e7eb);
    white-space: nowrap;
}
.vmz-ui-charts__table-view th {
    color: var(--vmz-text-muted, #6b7280);
    font-weight: 500;
    position: sticky;
    top: 0;
    background: var(--vmz-surface-paper, #ffffff);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__table-view caption {
    color: var(--vmz-text-ink, #f3f4f6);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__table-view th,
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__table-view td {
    border-bottom-color: var(--vmz-line-default, #1f2937);
    color: #e5e7eb;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__table-view th {
    background: var(--vmz-surface-paper, #0b1220);
    color: var(--vmz-text-muted, #9ca3af);
}
.vmz-ui-charts__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
}
</style>
<script client>
/**
 * VMZ UI Charts — Chart 组件。
 *
 * 作者面：
 *   <Chart :spec="{...}" :data="[...]" theme="light|dark|auto" label="…" />
 *
 * 管线：ChartSpec + DataSnapshot → compile → scene builder（视口像素）→
 * resolve → DisplayScene → 宿主 SVG 渲染。组件只做 Vue 绑定、容器尺寸、
 * 生命周期、平台输入与可访问呈现，不重新计算统计 / 比例尺 / 主题。
 *
 * 交互：pointer / 键盘命中测试直接读 SemanticScene 几何，tooltip 展示真实
 * 行数据；选择事件指向稳定行 key。高亮经 `data-dvz-id` DOM 钩子回放，
 * canonical scene 不携带交互状态。
 */
import {
    DARK_CHART_THEME,
    DEFAULT_CHART_THEME,
    buildScene,
    compile,
    fromRows,
    type ChartCompilePlan,
    type ChartSpec,
    type ChartTheme,
    type DataSnapshot,
    type Scale,
} from "@doki-land/davinci/chart";
import {
    renderCanvas,
    renderSvg,
    resolve,
    resolveResourceIdPrefix,
    type DisplayScene,
    type SemanticNode,
    type SemanticScene,
} from "@doki-land/davinci/scene";
import { initialState, reduce, type RuntimeState, type Action } from "@doki-land/davinci/runtime";
import type { Point2D, RGBA } from "@doki-land/davinci/types";

/** Crosshair 顶点标记（CSS px）。 */
interface CrosshairDot {
    x: number;
    y: number;
    color: string;
}

/** line/area 系列的折线命中区（scene 坐标）。 */
interface PolylineHit {
    id: string;
    points: ReadonlyArray<Point2D>;
    keys: ReadonlyArray<string>;
    color: string;
}

/** 键盘导航目标：mark 节点或折线顶点（key 非空时 tooltip 读行值）。 */
interface NavTarget {
    id: string;
    key: string | null;
    point: Point2D | null;
}

const FALLBACK_WIDTH = 640;
const FALLBACK_HEIGHT = 360;
const HIT_TOLERANCE_PX = 8;
/** 数据表视图的最大渲染行数（超出截断并标注）。 */
const TABLE_MAX_ROWS = 1000;

export default class Chart {
    /** DaVinci ChartSpec（mark + encoding）。 */
    public spec: ChartSpec | null = null;
    /** 原始数据（行数组）。优先于 snapshot。 */
    public data: Record<string, unknown>[] | null = null;
    /** 预构建 DataSnapshot（与 data 二选一）。 */
    public snapshot: DataSnapshot | null = null;
    /** 显式宽度。null 时跟随容器测量，测量前退回 FALLBACK_WIDTH。 */
    public width: number | null = null;
    /** 显式高度。null 时跟随容器测量，测量前退回 FALLBACK_HEIGHT。 */
    public height: number | null = null;
    /** 主题："light" | "dark" | "auto"。auto 在客户端跟随系统，SSR 为 light。 */
    public theme: string | null = null;
    /** 可访问名称。缺省时从 spec 派生一句话摘要。 */
    public label: string | null = null;
    /** 宿主显式提供的 SVG 资源 id 前缀。null 时从声明式输入确定性派生，
     *  同页多实例不撞 id；需要绝对唯一（例如同 spec 重复内联）时由宿主传入。 */
    public resourceIdPrefix: string | null = null;
    /** true 时用原生数据表代替 SVG 渲染（降级视图）；false 时表格仍以视觉
     *  隐藏形式挂在 `aria-describedby` 上供读屏器取数。 */
    public tableView: boolean = false;
    /** 主题令牌覆盖：按字段浅合并到当前亮/暗基础主题上（如品牌色板、网格
     *  颜色、面积透明度）。null 时用内置主题。 */
    public themeTokens: Partial<ChartTheme> | null = null;
    /** 渲染后端：`"svg"`（默认）| `"canvas"` | `"auto"`（行数超过 50000 自动
     *  切 canvas）。SSR 始终回退 SVG。 */
    public renderer: string | null = null;
    /** tooltip 触发口径：`"item"`（默认,单 mark）| `"axis"`（同一 x 全部
     *  系列合并展示）。 */
    public tooltipTrigger: string | null = null;
    /** 联动 id：同 `linkId` 的图表共享 crosshair x 值（line/area 族）。 */
    public linkId: string | null = null;
    /** 受控选择集（mark id 数组）；传入后组件不自行改选择，只发事件。 */
    public selection: string[] | null = null;
    /** 受控缩放域 `[lo, hi]`（数据单位）；null = 非受控。 */
    public zoomDomain: number[] | null = null;
    /** 动效开关：`"auto"`（默认,尊重 prefers-reduced-motion）| `"off"`。 */
    public motion: string | null = null;

    /** 交互 runtime state。 */
    public state: RuntimeState | null = null;
    /** `compile` 产出的只读诊断（code / severity / message），宿主只读展示。 */
    public diagnostics: ReadonlyArray<{ severity: string; code: string; message: string }> = [];

    // ---- 交互与生命周期内部字段 ----

    /** ResizeObserver 实例，onMount 创建 onUnmount 断开。 */
    public _resizeObserver: ResizeObserver | null = null;
    /** auto 主题的 matchMedia 状态。 */
    public _themeMedia: { matches: boolean } | null = null;
    /** 容器测量尺寸（width/height 为 null 时由 ResizeObserver 回写）。 */
    public _measuredWidth: number | null = null;
    public _measuredHeight: number | null = null;
    /** 渲染期缓存：最近一次编译产物，命中测试直接读，不重编译。
     *  `#` 私有字段不参与响应式（生成器 `__vmzState` 只收集非 `#` 字段）——
     *  渲染期写入它们不得再触发 patch，否则形成自激回路。 */
    #semanticScene: SemanticScene | null = null;
    #plan: ChartCompilePlan | null = null;
    /** 只读公开句柄：demo / 宿主核对编译产物用，不参与响应式。 */
    public get _plan(): ChartCompilePlan | null {
        return this.#plan;
    }
    /** 当前 hover / 键盘聚焦的 mark id。 */
    public _hoverId: string | null = null;
    /** 键盘聚焦索引（marks 顺序）。 */
    public _focusIndex: number = -1;
    /** Tooltip 状态。 */
    public _tooltip: { visible: boolean; x: number; y: number; text: string } = {
        visible: false,
        x: 0,
        y: 0,
        text: "",
    };
    /** Crosshair 竖线状态（CSS px）。 */
    public _crosshair: { visible: boolean; x: number } = { visible: false, x: 0 };
    /** Crosshair 顶点标记（CSS px + 系列色）。 */
    public _crosshairDots: CrosshairDot[] = [];
    /** Brush 选区（scene 坐标）。 */
    public _brush: { active: boolean; x0: number; y0: number; x1: number; y1: number } = {
        active: false,
        x0: 0,
        y0: 0,
        x1: 0,
        y1: 0,
    };
    /** Shift+拖拽 pan 的起点（clientX + 起始域）。 */
    public _panStart: { clientX: number; lo: number; hi: number } | null = null;
    /** 当前 x 视域（数据单位），null = 全域。 */
    public _viewDomain: number[] | null = null;
    /** 未缩放 x 比例尺缓存（zoom/pan 的基准域与 kind）。 */
    public _baseXDomain: number[] | null = null;
    public _baseXKind: string | null = null;
    /** wheel 非被动监听器的稳定引用（onMount 挂、onUnmount 摘）。 */
    public _wheelBound: ((ev: WheelEvent) => void) | null = null;
    /** brush / pan 结束后的那次 click 是拖拽余波，必须抑制（否则空命中立即清空选择）。 */
    public _suppressClick: boolean = false;
    /** 图例显隐状态：隐藏的系列名集合（runtime reactive，触发重编译）。 */
    public _hiddenSeries: string[] = [];
    /** 图例单独聚焦的系列名（非 null 时只显示它）。 */
    public _isolatedSeries: string | null = null;
    /** treemap 下钻路径：栈尾是当前作为根的节点 key（空 = 文档根）。
     *  只存节点身份，不存几何，重排 / 重绘后仍然有效。 */
    public _drillPath: string[] = [];
    /** 钉住的 tooltip（Enter / 长按产生，Esc 或再次 Enter 解除）。 */
    public _pinnedTooltip: { x: number; y: number; text: string } | null = null;
    /** aria-live 播报文本（焦点 / 钉住 / 图例变化时更新）。 */
    public _liveText: string = "";
    /** 触摸手势跟踪（pointerId → 起点与当前位置）。 */
    public _pointers: Map<number, { x0: number; y0: number; x: number; y: number }> | null = null;
    /** 捏合缩放基准（双指起点距离 + 起始域）。 */
    public _pinch: { startDist: number; lo: number; hi: number } | null = null;
    /** 长按定时器 id（>=450ms 钉住 tooltip / 图例单独聚焦）。 */
    public _longPressTimer: number | null = null;
    /** 本轮触摸手势已判为纵向滚动——后续 move 全部放行给页面。 */
    public _touchScroll: boolean = false;

    // ---- 尺寸与主题 ----

    public _effWidth(): number {
        if (this.width !== null && Number.isFinite(this.width) && this.width > 0) return this.width;
        if (this._measuredWidth !== null && this._measuredWidth > 0) return this._measuredWidth;
        return FALLBACK_WIDTH;
    }

    public _effHeight(): number {
        if (this.height !== null && Number.isFinite(this.height) && this.height > 0) return this.height;
        if (this._measuredHeight !== null && this._measuredHeight > 0) return this._measuredHeight;
        return FALLBACK_HEIGHT;
    }

    public _themeName(): string {
        if (this.theme === "dark") return "dark";
        if (this.theme === "auto" && this._themeMedia && this._themeMedia.matches) return "dark";
        return "light";
    }

    public _chartTheme(): ChartTheme {
        const base = this._themeName() === "dark" ? DARK_CHART_THEME : DEFAULT_CHART_THEME;
        if (!this.themeTokens) return base;
        // 浅合并：每个令牌字段整体替换，未给的字段沿用基础主题。
        return { ...base, ...this.themeTokens };
    }

    /**
     * 图表主体归属：尺寸在构建期未完全确定（响应式维度尚未测量）时，
     * SVG 归客户端所有。SSR 不序列化一个必然会被容器测量推翻的尺寸。
     * 显式 width 与 height 都在场时尺寸已知，SSR SVG 可水合复用。
     */
    public _bodyAwaitingMeasure(): boolean {
        const widthPending = this.width === null && this._measuredWidth === null;
        const heightPending = this.height === null && this._measuredHeight === null;
        return widthPending || heightPending;
    }

    /** 零尺寸 guard —— 宽或高为 0 时跳过渲染避免 NaN / 空 SVG 闪烁。 */
    public _zeroSize(): boolean {
        return this._effWidth() <= 0 || this._effHeight() <= 0;
    }

    /** 空态判断 —— spec 或数据均缺失时渲染空态面板。 */
    public _isEmpty(): boolean {
        if (!this.spec) return true;
        const hasData = !!(this.snapshot || (this.data && this.data.length > 0));
        return !hasData;
    }

    /** 编译错误判断 —— diagnostics 中存在 severity="error"。 */
    public _hasError(): boolean {
        return this.diagnostics.some((d) => d.severity === "error");
    }

    /** 只在内容真正变化时写 `diagnostics`。渲染期无条件赋值（哪怕内容相同）
     *  都会把依赖标脏并再入队 patch，形成自激回路。 */
    public _setDiagnostics(next: ReadonlyArray<{ severity: string; code: string; message: string }>): void {
        if (next.length === this.diagnostics.length) {
            let same = true;
            for (let i = 0; i < next.length; i++) {
                const a = this.diagnostics[i];
                const b = next[i];
                if (a.severity !== b.severity || a.code !== b.code || a.message !== b.message) {
                    same = false;
                    break;
                }
            }
            if (same) return;
        }
        this.diagnostics = next;
    }

    // ---- 渲染管线 ----

    /** 计算属性：spec / data / 尺寸变化时重新编译并解析为 DisplayScene。 */
    public scene(): DisplayScene | null {
        if (this._zeroSize()) {
            this._setDiagnostics([]);
            this.#semanticScene = null;
            this.#plan = null;
            return null;
        }
        const snapshot = this._filteredSnapshot();
        const effSpec = this._effectiveSpec();
        if (!effSpec || !snapshot) {
            this._setDiagnostics([]);
            this.#semanticScene = null;
            this.#plan = null;
            return null;
        }
        let plan = compile(effSpec, snapshot);
        // 图例显隐过滤后：系列域用未过滤的全量域覆盖——图例保持完整可点，
        // 可见系列的调色板槽位不随隐藏漂移。
        if ((this._hiddenSeries.length > 0 || this._isolatedSeries !== null) && plan.series.field !== null) {
            const baseSnap = this._baseSnapshot();
            if (baseSnap && baseSnap.rowCount !== snapshot.rowCount) {
                const fullPlan = compile(effSpec, baseSnap);
                plan = { ...plan, series: fullPlan.series };
            }
        }
        this._setDiagnostics(plan.diagnostics.items.map((d) => ({
            severity: d.severity,
            code: d.code,
            message: d.message,
        })));
        // zoom/pan 基准：未缩放时的 x 域与 kind，从首次编译的比例尺捕获。
        const xScale = plan.scales.get("x");
        if (xScale && (xScale.kind === "linear" || xScale.kind === "log")) {
            if (this._baseXDomain === null) {
                this._baseXDomain = [xScale.domain[0], xScale.domain[1]];
                this._baseXKind = xScale.kind;
            }
        } else {
            this._baseXDomain = null;
            this._baseXKind = null;
        }
        const w = this._effWidth();
        const h = this._effHeight();
        const semantic = buildScene(plan, { width: w, height: h }, { theme: this._chartTheme() });
        this.#semanticScene = semantic;
        this.#plan = plan;
        // preserveNodeIds：交互宿主把 DOM 元素绑回稳定身份；SSR 输出同样
        // 携带 `data-dvz-id`，水合后高亮路径一致。
        return resolve(semantic, { width: w, height: h, preserveNodeIds: true });
    }

    /** SVG 资源 id 前缀 —— 显式 prop 优先，否则从声明式输入（spec + 数据）
     *  确定性派生。SSR 与客户端对同一输入再生同一前缀，不同 spec 天然不撞 id。 */
    public _resourcePrefix(): string {
        const identity = {
            mark: this.spec?.mark ?? null,
            encoding: this.spec?.encoding ?? null,
            keyField: this.spec?.keyField ?? null,
            facetField: this.spec?.facetField ?? null,
            scales: this.spec?.scales ? Array.from(this.spec.scales.entries()) : null,
            data: this.data ?? this.snapshot?.columns ?? null,
        };
        return resolveResourceIdPrefix("davinci-chart", identity, this.resourceIdPrefix);
    }

    /** DisplayScene → 确定性 SVG markup（SSR 安全，无 DOM API）。 */
    public markup(): string {
        // 每次渲染兜底一次联动注册：props 在水合顺序上晚于 onMount 赋值，
        // 只靠 onMount 注册会漏掉从未被交互的接收端。
        this._linkEnsure();
        // 响应式维度尚未测量：主体归客户端，SSR 不输出必然被推翻的 SVG。
        if (this._bodyAwaitingMeasure()) return "";
        if (this._zeroSize()) return "";
        const scene = this.scene();
        if (!scene) return "";
        // canvas 模式：SVG 输出为空，绘制调度到 microtask（此时 canvas 已挂载）。
        if (this._useCanvas()) {
            this._scheduleCanvasPaint(scene);
            return "";
        }
        return renderSvg(scene, { resourceIdPrefix: this._resourcePrefix() });
    }

    // ---- Canvas 后端（>50k 点或显式 canvas；SVG 仍是默认与 SSR 降级） ----

    /** 是否用 canvas 后端：表格视图与 SSR 永不用；auto 按行数阈值切换。 */
    public _useCanvas(): boolean {
        if (this.tableView) return false;
        if (typeof document === "undefined") return false;
        if (this.renderer === "canvas") return true;
        if (this.renderer === "auto") {
            const rows = this.data ? this.data.length : this.snapshot ? this.snapshot.rowCount : 0;
            return rows > 50000;
        }
        return false;
    }

    /** 调度一次 canvas 绘制（microtask 去重）。
     *  注意：渲染期不得写响应式字段（会再触发渲染形成自激回路），待绘 scene
     *  与去重标记都走非响应式 expando。 */
    public _scheduleCanvasPaint(scene: DisplayScene): void {
        const bag = this as any;
        bag.__pendingScene = scene;
        if (bag.__paintQueued) return;
        bag.__paintQueued = true;
        queueMicrotask(this._flushCanvasPaint.bind(this));
    }

    public _flushCanvasPaint(): void {
        (this as any).__paintQueued = false;
        this._paintCanvas();
    }

    /** 把缓存的 display scene 画进 canvas（DPR 感知，逻辑坐标系不变）。 */
    public _paintCanvas(): void {
        const scene = (this as any).__pendingScene as DisplayScene | null | undefined;
        if (!scene) return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.querySelector !== "function") return;
        const canvas: any = root.querySelector("canvas.vmz-ui-charts__canvas");
        if (!canvas || typeof canvas.getContext !== "function") return;
        const dpr = typeof devicePixelRatio === "number" && devicePixelRatio > 0 ? devicePixelRatio : 1;
        const w = this._effWidth();
        const h = this._effHeight();
        const bw = Math.max(1, Math.round(w * dpr));
        const bh = Math.max(1, Math.round(h * dpr));
        if (canvas.width !== bw) canvas.width = bw;
        if (canvas.height !== bh) canvas.height = bh;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        renderCanvas(scene, ctx);
    }

    public get hostStyle(): string {
        const w = this._effWidth();
        const h = this._effHeight();
        const widthCss = this.width !== null ? `width:${w}px;` : "width:100%;";
        return `${widthCss}height:${h}px;position:relative;`;
    }

    // ---- 可访问呈现 ----

    public _srId(): string {
        return `${this._resourcePrefix()}summary`;
    }

    /** 隐藏数据表的 id（aria-describedby 的第二段）。 */
    public _srTableId(): string {
        return `${this._resourcePrefix()}table`;
    }

    /** aria-describedby：摘要 + 隐藏数据表（表格视图下表格本身可读，不再重复引用）。 */
    public _describedBy(): string {
        if (this.tableView) return this._srId();
        return `${this._srId()} ${this._srTableId()}`;
    }

    // ---- 数据表降级视图 ----

    /** 表格列：按 spec 编码顺序取字段，facet / key 字段收尾，去重。 */
    public _tableFields(): string[] {
        if (!this.spec) return [];
        const fields: string[] = [];
        for (const enc of this.spec.encoding) {
            if (!fields.includes(enc.field)) fields.push(enc.field);
        }
        if (this.spec.facetField && !fields.includes(this.spec.facetField)) fields.push(this.spec.facetField);
        if (this.spec.keyField && !fields.includes(this.spec.keyField)) fields.push(this.spec.keyField);
        if (this.spec.parentField && !fields.includes(this.spec.parentField)) fields.push(this.spec.parentField);
        return fields;
    }

    /** 真实数据的 HTML 表（表格视图与屏幕阅读器隐藏表共用）。超过 1000 行
     *  截断并显式标注余量，避免万行 DOM 拖垮页面。 */
    public _tableHtml(): string {
        const snap = this.snapshot ?? (this.data ? fromRows(this.data) : null);
        if (!snap) return "";
        const fields = this._tableFields();
        if (fields.length === 0) return "";
        const total = snap.rowCount;
        const shown = Math.min(total, TABLE_MAX_ROWS);
        let html = `<table><caption>${escapeHtml(this._ariaLabel())}</caption><thead><tr>`;
        for (const f of fields) {
            html += `<th scope="col">${escapeHtml(f)}</th>`;
        }
        html += "</tr></thead><tbody>";
        for (let r = 0; r < shown; r++) {
            html += "<tr>";
            for (const f of fields) {
                html += `<td>${escapeHtml(formatCell(readCell(snap, f, r)))}</td>`;
            }
            html += "</tr>";
        }
        if (shown < total) {
            html += `<tr><td colspan="${fields.length}">… ${total - shown} more rows not listed</td></tr>`;
        }
        return html + "</tbody></table>";
    }

    public _markCount(): number {
        return this.#plan ? this.#plan.marks.length : 0;
    }

    public _ariaLabel(): string {
        if (this.label) return this.label;
        const mark = this.spec ? String(this.spec.mark) : "chart";
        return `${mark} chart`;
    }

    public _summary(): string {
        if (this._isEmpty()) return "Empty chart.";
        const count = this._markCount();
        const series = this.#plan && this.#plan.series.field !== null ? `, ${this.#plan.series.categories.length} series` : "";
        return `${this._ariaLabel()} with ${count} marks${series}.`;
    }

    // ---- 生命周期 ----

    onMount() {
        this.state = initialState(this._effWidth(), this._effHeight());
        this._seedFallbackSizeWhenUnmeasurable();
        this._attachResizeObserver();
        this._attachThemeMedia();
        this._attachWheel();
        this._linkEnsure();
        (this as any).__didFirstPaint = true;
        // canvas 模式的首帧：markup 在挂载前已跑，此时元素已存在，补一次绘制。
        const pending = (this as any).__pendingScene as DisplayScene | null | undefined;
        if (this._useCanvas() && pending) this._scheduleCanvasPaint(pending);
    }

    onUnmount() {
        this._detachResizeObserver();
        this._detachThemeMedia();
        this._detachWheel();
        this._linkUnregister();
        this._clearLongPress();
    }

    public _attachThemeMedia(): void {
        if (this.theme !== "auto") return;
        if (typeof matchMedia !== "function") return;
        const media = matchMedia("(prefers-color-scheme: dark)");
        this._themeMedia = { matches: media.matches };
    }

    public _detachThemeMedia(): void {
        this._themeMedia = null;
    }

    /** 无 ResizeObserver 的浏览器不会回写测量值，落回默认尺寸避免主体永久为空。 */
    public _seedFallbackSizeWhenUnmeasurable(): void {
        if (typeof window === "undefined" || typeof ResizeObserver !== "undefined") return;
        if (this.width === null && this._measuredWidth === null) this._measuredWidth = FALLBACK_WIDTH;
        if (this.height === null && this._measuredHeight === null) this._measuredHeight = FALLBACK_HEIGHT;
    }

    public _attachResizeObserver(): void {
        if (typeof ResizeObserver === "undefined") return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof (root as any).getBoundingClientRect !== "function") return;
        const ro = new ResizeObserver((entries) => {
            for (const entry of entries) {
                const cr = (entry as any).contentRect as DOMRectReadOnly | undefined;
                if (!cr) continue;
                const w = Math.round(cr.width);
                const h = Math.round(cr.height);
                // 只有 auto 维度跟随容器；显式 prop 永远优先。
                if (this.width === null && w > 0 && w !== this._measuredWidth) this._measuredWidth = w;
                if (this.height === null && h > 0 && h !== this._measuredHeight) this._measuredHeight = h;
                if (this.state) {
                    this.state = reduce(this.state, { kind: "container-resize", w, h });
                }
            }
        });
        ro.observe(root);
        this._resizeObserver = ro;
    }

    public _detachResizeObserver(): void {
        if (this._resizeObserver) {
            this._resizeObserver.disconnect();
            this._resizeObserver = null;
        }
    }

    /** 派发交互 action → 返回新 runtime state。 */
    public dispatch(action: Action): RuntimeState | null {
        if (!this.state) return null;
        this.state = reduce(this.state, action);
        return this.state;
    }

    // ---- 视域（zoom / pan，仅定量 x、非分面） ----

    /** 视域生效的 spec：x 比例尺域被 `_viewDomain` 覆盖，kind/range 沿用编译基线。 */
    public _effectiveSpec(): ChartSpec | null {
        const spec = this.spec;
        if (!spec) return null;
        // treemap 下钻：把当前根节点注入 spec，渲染仍然是同一条管线。
        const drilled =
            this._drillRoot() !== null && String(spec.mark) === "treemap"
                ? { ...spec, treemapRoot: this._drillRoot() as string }
                : spec;
        if (!this._viewDomainEffective() || !this._baseXKind) return drilled;
        const scales = new Map<string, Scale>();
        if (drilled.scales) {
            for (const entry of Array.from(drilled.scales.entries())) {
                scales.set(entry[0], entry[1]);
            }
        }
        const domain: [number, number] = [this._viewDomainEffective()![0], this._viewDomainEffective()![1]];
        if (this._baseXKind === "log") {
            scales.set("x", { kind: "log", domain, range: [0, 1] });
        } else {
            scales.set("x", { kind: "linear", domain, range: [0, 1] });
        }
        return { ...drilled, scales };
    }

    // ---- 图例显隐（过滤快照，比例尺按可见数据重算） ----

    /** 系列字段名（color / series / group 编码的字段，无分组为 null）。 */
    public _seriesFieldOf(): string | null {
        if (!this.spec) return null;
        const enc = this.spec.encoding.find((e) => e.channel === "color" || e.channel === "series" || e.channel === "group");
        // heatmap / calendar / geo 的 color 是数值通道，不是分组。
        const markKind = String(this.spec.mark);
        if ((markKind === "heatmap" || markKind === "calendar" || markKind === "geo") && enc?.channel === "color") return null;
        return enc ? enc.field : null;
    }

    /** 基础快照（未过滤）。 */
    public _baseSnapshot(): DataSnapshot | null {
        return this.snapshot ?? (this.data ? fromRows(this.data) : null);
    }

    /** 图例过滤后的快照：隐藏系列与单独聚焦都会真实滤出行，随后 compile
     *  按可见数据重算比例尺与堆叠基线（不是留白）。 */
    public _filteredSnapshot(): DataSnapshot | null {
        const base = this._baseSnapshot();
        if (!base) return null;
        const field = this._seriesFieldOf();
        if (!field) return base;
        const hidden = new Set(this._hiddenSeries);
        if (hidden.size === 0 && this._isolatedSeries === null) return base;
        const col = base.columns.find((c) => c.name === field);
        if (!col) return base;
        const rows: Record<string, unknown>[] = [];
        for (let r = 0; r < base.rowCount; r++) {
            const v = col.values[r];
            const key = v === null || v === undefined ? null : String(v);
            if (this._isolatedSeries !== null) {
                if (key === this._isolatedSeries) rows.push(rowOf(base, r));
            } else if (key === null || !hidden.has(key)) {
                rows.push(rowOf(base, r));
            }
        }
        return fromRows(rows);
    }

    /** 图例交互入口：单击切换显隐；最后一项可见系列拒绝隐藏。 */
    public _toggleLegendSeries(name: string): void {
        if (this._isolatedSeries !== null) {
            // 单独聚焦态下单击恢复原状。
            this._isolatedSeries = null;
            this._hiddenSeries = [];
            this._announce(`已恢复全部系列`);
            return;
        }
        const plan = this.#plan;
        const cats = plan && plan.series.field !== null ? plan.series.categories : [];
        const hidden = new Set(this._hiddenSeries);
        if (hidden.has(name)) {
            hidden.delete(name);
        } else {
            const visible = cats.filter((c) => !hidden.has(c));
            if (visible.length <= 1 && visible.includes(name)) {
                this._announce(`至少保留一个可见系列`);
                return;
            }
            hidden.add(name);
        }
        this._hiddenSeries = [...hidden];
        this._announce(hidden.has(name) ? `已隐藏 ${name}` : `已显示 ${name}`);
        this._emitLegendChange();
        // v-html 重渲染后内联样式丢失——下一拍回放缓边/图例透明度。
        queueMicrotask(() => this._applyDomState());
    }

    /** 图例单独聚焦：只显示该系列；再次同样操作恢复。 */
    public _isolateLegendSeries(name: string): void {
        if (this._isolatedSeries === name) {
            this._isolatedSeries = null;
            this._hiddenSeries = [];
            this._announce(`已恢复全部系列`);
        } else {
            this._isolatedSeries = name;
            this._hiddenSeries = [];
            this._announce(`单独聚焦 ${name}`);
        }
        this._emitLegendChange();
        queueMicrotask(() => this._applyDomState());
    }

    /** 图例节点 id → 系列名（`legend:swatch:N` / `legend:label:N`）。 */
    public _legendNameFromId(id: string): string | null {
        const m = /^legend:(?:swatch|label):(\d+)$/.exec(id);
        if (!m) return null;
        const plan = this.#plan;
        if (!plan || plan.series.field === null) return null;
        const idx = Number(m[1]);
        return plan.series.categories[idx] ?? null;
    }

    // ---- 联动 / 事件外抛 ----

    /** 联动频道：同 `linkId` 的实例互收 crosshair x 值（window 级，空频道自毁）。 */
    public _linkChannel(): Map<string, Set<object>> | null {
        if (typeof window === "undefined") return null;
        const w = window as any;
        // 注意：嵌套泛型实参会被 VMZ 编译器漏剥成运行时标识符，`new` 表达式一律不带类型实参。
        if (!w.__vmzChartLinks) w.__vmzChartLinks = new Map();
        return w.__vmzChartLinks;
    }

    public _linkRegister(): void {
        if (!this.linkId) return;
        const bus = this._linkChannel();
        if (!bus) return;
        let set = bus.get(this.linkId);
        if (!set) {
            set = new Set<object>();
            bus.set(this.linkId, set);
        }
        set.add(this);
    }

    /** 惰性注册：props 在水合完成顺序上可能晚于 onMount 才赋值，首个交互
     *  路径再兜底一次，保证 linkId 一定进频道。 */
    public _linkEnsure(): void {
        const bag = this as any;
        if (bag.__linkRegistered || !this.linkId) return;
        // SSR 下无频道可注册：不能置旗标，否则客户端永远不再重试。
        if (typeof window === "undefined") return;
        bag.__linkRegistered = true;
        this._linkRegister();
    }

    public _linkUnregister(): void {
        (this as any).__linkRegistered = false;
        if (!this.linkId) return;
        const bus = this._linkChannel();
        if (!bus) return;
        const set = bus.get(this.linkId);
        if (set) {
            set.delete(this);
            if (set.size === 0) bus.delete(this.linkId);
        }
    }

    /** 把 crosshair 的数据 x 值广播给同 linkId 的伙伴（不再回播）。 */
    public _linkBroadcast(xValue: number): void {
        this._linkEnsure();
        if (!this.linkId) return;
        const bus = this._linkChannel();
        const set = bus ? bus.get(this.linkId) : undefined;
        if (!set) return;
        for (const peer of set) {
            if (peer !== this) (peer as Chart)._linkReceive(xValue, this);
        }
    }

    /** 接收伙伴的 crosshair x 值：吸附到本图最近的数据 x（定量 x 专用，
     *  收端永不回播，天然无循环）。 */
    public _linkReceive(xValue: number, from: object): void {
        void from;
        this._linkEnsure();
        const plan = this.#plan;
        const xEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "x") : undefined;
        if (!plan || !xEnc) return;
        const polylines = this._polylines();
        if (polylines.length === 0) return;
        let bestKey: string | null = null;
        let bestD = Infinity;
        for (const m of plan.marks) {
            const v = readCell(plan.resolvedData, xEnc.field, m.rowIndex);
            if (typeof v !== "number" || !Number.isFinite(v)) continue;
            const d = Math.abs(v - xValue);
            if (d < bestD) {
                bestD = d;
                bestKey = m.key;
            }
        }
        if (bestKey === null) return;
        for (const pl of polylines) {
            const i = pl.keys.indexOf(bestKey);
            if (i < 0) continue;
            // DOM 写入委托给 `_updateCrosshair`：编译器只对模板事件可达的
            // 方法插桩写屏障，本方法经 `(peer as Chart)` 调用、不在调用图内，
            // 裸写入不会触发本组件的 DOM patch。安静旗标防止收端回播成环。
            const bag = this as any;
            bag.__linkQuiet = true;
            try {
                this._updateCrosshair(pl.points[i]);
            } finally {
                bag.__linkQuiet = false;
            }
            return;
        }
    }

    /** 事件外抛：CustomEvent 从宿主元素冒泡。 */
    public _emitChartEvent(name: string, detail: unknown): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.dispatchEvent !== "function") return;
        root.dispatchEvent(new CustomEvent(name, { detail, bubbles: true }));
    }

    public _emitSelectionChange(): void {
        const sel = this.state ? [...this.state.selection.nodeIds] : [];
        this._emitChartEvent("vmz-chart-selection-change", { selection: sel });
    }

    public _emitZoomChange(): void {
        this._emitChartEvent("vmz-chart-zoom-change", { domain: this._viewDomain ? [this._viewDomain[0], this._viewDomain[1]] : null });
    }

    public _emitLegendChange(): void {
        this._emitChartEvent("vmz-chart-legend-change", { hidden: [...this._hiddenSeries], isolated: this._isolatedSeries });
    }

    // ---- aria-live 播报 ----

    public _liveId(): string {
        return `${this._resourcePrefix()}-live`;
    }

    public _announce(text: string): void {
        // aria-live 只认文本变化——同文本先清空再写，保证每次都播报。
        if (this._liveText === text) {
            this._liveText = "";
            queueMicrotask(() => {
                this._liveText = text;
            });
        } else {
            this._liveText = text;
        }
    }

    // ---- 动效口径 ----

    /** svg 包装的动画口径：首帧入场、更新淡入、off/reduced-motion 关闭。 */
    public _animMode(): string {
        if (this.motion === "off") return "none";
        const bag = this as any;
        if (!bag.__didFirstPaint) {
            return "in";
        }
        return "fade";
    }

    /** 当前是否可缩放/平移：笛卡尔 + 定量 x + 非分面 + 非统计型 mark
     *  （直方图分箱与山脊密度是全局统计，视域裁剪不会重算，禁止缩放）。 */
    public _zoomable(): boolean {
        if (!this.spec) return false;
        if (this.spec.facetField) return false;
        const markKind = String(this.spec.mark);
        if (markKind === "histogram" || markKind === "ridgeline") return false;
        if (this._baseXDomain === null) return false;
        return true;
    }

    /** 从语义场景的轴基线还原 plot 矩形（x 轴底线 + y 轴底线）。 */
    public _plotBounds() {
        if (!this.#semanticScene) return null;
        let xFrom: number | null = null;
        let xTo = 0;
        let yTop = 0;
        let yBottom = 0;
        for (const g of this.#semanticScene.root.children) {
            if (g.kind !== "group") continue;
            if (g.id !== "x-axis" && g.id !== "y-axis") continue;
            for (const n of g.children) {
                if (n.kind !== "path" || !n.id.endsWith(":baseline")) continue;
                const cmds = n.path.commands;
                const a = cmds[0];
                const b = cmds[1];
                if (a.kind !== "move" || !b || b.kind !== "line") continue;
                if (g.id === "x-axis") {
                    xFrom = a.to.x;
                    xTo = b.to.x;
                    yBottom = a.to.y;
                } else {
                    yTop = a.to.y;
                    yBottom = b.to.y;
                    if (xFrom === null) xFrom = a.to.x;
                }
            }
        }
        if (xFrom === null || !(xTo > xFrom) || !(yBottom > yTop)) return null;
        return { x: xFrom, y: yTop, w: xTo - xFrom, h: yBottom - yTop };
    }

    /** wheel 缩放：以指针下的数据值为焦点，限定在基线域内。 */
    public _onWheel(ev: WheelEvent): void {
        if (!this._zoomable()) return;
        if (typeof ev.preventDefault === "function") ev.preventDefault();
        const point = this._toScenePoint(ev);
        const bounds = this._plotBounds();
        const base = this._baseXDomain;
        if (!point || !bounds || !base) return;
        const cur = this._viewDomain ?? [base[0], base[1]];
        const kind = this._baseXKind;
        const t = Math.max(0, Math.min(1, (point.x - bounds.x) / bounds.w));
        const zFocus = zoomSpace(kind, cur[0]) + t * (zoomSpace(kind, cur[1]) - zoomSpace(kind, cur[0]));
        const factor = ev.deltaY > 0 ? 1.25 : 0.8;
        let newLo = fromZoomSpace(kind, zFocus - (zFocus - zoomSpace(kind, cur[0])) * factor);
        let newHi = fromZoomSpace(kind, zFocus + (zoomSpace(kind, cur[1]) - zFocus) * factor);
        newLo = Math.max(newLo, base[0]);
        newHi = Math.min(newHi, base[1]);
        if (!(newHi > newLo)) return;
        this._setViewDomain(newLo <= base[0] && newHi >= base[1] ? null : [newLo, newHi]);
        this._hideCrosshair();
    }

    public _attachWheel(): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.addEventListener !== "function") return;
        this._wheelBound = (ev: WheelEvent) => this._onWheel(ev);
        root.addEventListener("wheel", this._wheelBound, { passive: false });
    }

    public _detachWheel(): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (root && this._wheelBound && typeof root.removeEventListener === "function") {
            root.removeEventListener("wheel", this._wheelBound);
        }
        this._wheelBound = null;
    }

    /** 键盘缩放：+ 放大、- 缩小、0 复位（键盘等价路径）。 */
    public _zoomBy(factor: number): void {
        if (!this._zoomable()) return;
        const base = this._baseXDomain;
        if (!base) return;
        const cur = this._viewDomain ?? [base[0], base[1]];
        const kind = this._baseXKind;
        const zMid = (zoomSpace(kind, cur[0]) + zoomSpace(kind, cur[1])) / 2;
        let newLo = fromZoomSpace(kind, zMid - (zMid - zoomSpace(kind, cur[0])) * factor);
        let newHi = fromZoomSpace(kind, zMid + (zoomSpace(kind, cur[1]) - zMid) * factor);
        newLo = Math.max(newLo, base[0]);
        newHi = Math.min(newHi, base[1]);
        if (!(newHi > newLo)) return;
        this._setViewDomain(newLo <= base[0] && newHi >= base[1] ? null : [newLo, newHi]);
    }

    /** 视域写入的唯一入口：受控 `zoomDomain` 只发事件不落状态。 */
    public _setViewDomain(d: number[] | null): void {
        if (this.zoomDomain !== null) {
            this._emitChartEvent("vmz-chart-zoom-change", { domain: d });
            return;
        }
        this._viewDomain = d;
        this._emitZoomChange();
    }

    /** 生效视域：受控 prop 优先。 */
    public _viewDomainEffective(): number[] | null {
        return this.zoomDomain ?? this._viewDomain;
    }

    /** 重置视域到全域（双击 / `0` 键 / 复位按钮同一路径）。 */
    public _resetView(): void {
        this._setViewDomain(null);
    }

    /** 复位按钮可见性：当前处于缩放态时显示。 */
    public _zoomResetVisible(): boolean {
        return this._zoomable() && this._viewDomainEffective() !== null;
    }

    /** 复位按钮点击（模板绑定）。 */
    public _resetZoom(): void {
        this._resetView();
    }

    // ---- 触摸 / 指针（tap 出 tooltip、横向跟随、双指捏合、纵向放行） ----

    /** 清理长按定时器。 */
    public _clearLongPress(): void {
        if (this._longPressTimer !== null) {
            clearTimeout(this._longPressTimer);
            this._longPressTimer = null;
        }
    }

    /** 图例区命中的系列名（用于长按单独聚焦）。 */
    public _legendNameAtEvent(ev: PointerEvent): string | null {
        const target = ev.target as Element | null;
        const legendEl = target && typeof target.closest === "function" ? target.closest('[data-dvz-id^="legend:swatch:"], [data-dvz-id^="legend:label:"]') : null;
        if (!legendEl) return null;
        return this._legendNameFromId(legendEl.getAttribute("data-dvz-id") ?? "");
    }

    public _onPointerDown(ev: PointerEvent): void {
        (this as any).__lastPointerWasTouch = ev.pointerType !== "mouse";
        if (ev.pointerType === "mouse") return;
        // 触摸点按先解钉（再按本次命中重新出 tooltip）。
        if (this._pinnedTooltip) {
            this._pinnedTooltip = null;
            this._announce("tooltip 已关闭");
        }
        const point = this._toScenePoint(ev);
        if (!point) return;
        if (!this._pointers) this._pointers = new Map();
        this._pointers.set(ev.pointerId, { x0: point.x, y0: point.y, x: point.x, y: point.y });
        this._touchScroll = false;
        if (this._pointers.size === 2) {
            // 双指：取消长按，进入捏合（仅可缩放时）。
            this._clearLongPress();
            if (this._zoomable()) {
                const [a, b] = [...this._pointers.values()];
                const dist = Math.hypot(a.x - b.x, a.y - b.y);
                const base = this._baseXDomain;
                const cur = this._viewDomainEffective() ?? (base ? [base[0], base[1]] : null);
                if (dist > 0 && base && cur) {
                    this._pinch = { startDist: dist, lo: cur[0], hi: cur[1] };
                }
            }
            return;
        }
        // 单指：与 hover 等价的焦点；长按 450ms 钉住（图例上长按 = 单独聚焦）。
        const legendName = this._legendNameAtEvent(ev);
        this._onMouseMove(ev as unknown as MouseEvent);
        this._clearLongPress();
        this._longPressTimer = (
            typeof window !== "undefined" ? window.setTimeout : setTimeout
        )(() => {
            this._longPressTimer = null;
            if (legendName !== null) {
                this._isolateLegendSeries(legendName);
            } else if (this._tooltip.visible) {
                this._pinnedTooltip = { x: this._tooltip.x, y: this._tooltip.y, text: this._tooltip.text };
                this._announce(`已钉住 ${this._tooltip.text}`);
            }
        }, 450) as unknown as number;
    }

    public _onPointerMove(ev: PointerEvent): void {
        if (ev.pointerType === "mouse") return;
        if (!this._pointers || !this._pointers.has(ev.pointerId)) return;
        const point = this._toScenePoint(ev);
        if (!point) return;
        const rec = this._pointers.get(ev.pointerId)!;
        rec.x = point.x;
        rec.y = point.y;
        // 双指捏合。
        if (this._pinch && this._pointers.size === 2) {
            const [a, b] = [...this._pointers.values()];
            const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist <= 0) return;
            const base = this._baseXDomain;
            if (!base) return;
            const kind = this._baseXKind;
            const factor = this._pinch.startDist / dist;
            const zMid = (zoomSpace(kind, this._pinch.lo) + zoomSpace(kind, this._pinch.hi)) / 2;
            let newLo = fromZoomSpace(kind, zMid - (zMid - zoomSpace(kind, this._pinch.lo)) * factor);
            let newHi = fromZoomSpace(kind, zMid + (zoomSpace(kind, this._pinch.hi) - zMid) * factor);
            newLo = Math.max(newLo, base[0]);
            newHi = Math.min(newHi, base[1]);
            if (!(newHi > newLo)) return;
            this._setViewDomain(newLo <= base[0] && newHi >= base[1] ? null : [newLo, newHi]);
            return;
        }
        // 单指：位移判定——纵向占优即把手势让给页面滚动。
        const dx = rec.x - rec.x0;
        const dy = rec.y - rec.y0;
        if (!this._touchScroll && Math.abs(dy) > 10 && Math.abs(dx) < 10) {
            this._touchScroll = true;
            this._clearLongPress();
            return;
        }
        if (this._touchScroll) return;
        if (Math.abs(dx) + Math.abs(dy) > 6) this._clearLongPress();
        // 横向跟随：与 hover 等价。
        this._onMouseMove(ev as unknown as MouseEvent);
    }

    public _onPointerUp(ev: PointerEvent): void {
        if (ev.pointerType === "mouse") return;
        if (this._pointers) {
            this._pointers.delete(ev.pointerId);
            if (this._pointers.size < 2) this._pinch = null;
            if (this._pointers.size === 0) this._pointers = null;
        }
        this._clearLongPress();
    }

    // ---- treemap 下钻（进入节点作为根 / 返回上一级） ----

    /** 下钻栈顶：当前作为根的节点 key，空栈 = 文档根。 */
    public _drillRoot(): string | null {
        return this._drillPath.length > 0 ? this._drillPath[this._drillPath.length - 1] : null;
    }

    /** 返回按钮可见性：treemap 且已下钻。 */
    public _drillBackVisible(): boolean {
        return this._drillRoot() !== null && this.spec !== null && String(this.spec.mark) === "treemap";
    }

    /** mark id → treemap 节点 key（非 treemap id 返回 null）。 */
    public _treemapKeyOf(id: string | null): string | null {
        if (id === null || !id.startsWith("treemap:")) return null;
        return id.slice("treemap:".length);
    }

    /** 节点是否有子行：父子关系读 parentField，与几何和绘制深度无关。 */
    public _treemapHasChildren(key: string): boolean {
        const plan = this.#plan;
        const field = this.spec ? this.spec.parentField : undefined;
        if (!plan || !field) return false;
        for (const mark of plan.marks) {
            const pv = readCell(plan.resolvedData, field, mark.rowIndex);
            if (pv !== null && pv !== undefined && !(typeof pv === "number" && !Number.isFinite(pv)) && String(pv) === key) {
                return true;
            }
        }
        return false;
    }

    /** 下钻：只记录节点身份，重绘仍走 `_effectiveSpec` → compile → scene。 */
    public _drillTo(key: string): void {
        if (this._drillRoot() === key) return;
        this._drillPath = [...this._drillPath, key];
        this._announce(`下钻到 ${key}`);
        this._emitChartEvent("vmz-chart-drilldown-change", { root: key, path: [...this._drillPath] });
    }

    /** 返回上一级；弹出最后一级后回到文档根。 */
    public _drillUp(): void {
        if (this._drillPath.length === 0) return;
        this._drillPath = this._drillPath.slice(0, -1);
        const root = this._drillRoot();
        this._announce(root === null ? "已返回顶层" : `已返回 ${root}`);
        this._emitChartEvent("vmz-chart-drilldown-change", { root, path: [...this._drillPath] });
    }

    /** 双击：treemap 下钻 / 返回，其它 mark 复位缩放（图例区不触发）。 */
    public _onDblClick(ev: MouseEvent): void {
        const point = this._toScenePoint(ev);
        if (!point) return;
        if (this.spec && String(this.spec.mark) === "treemap") {
            const key = this._treemapKeyOf(this._hitTest(point.x, point.y));
            if (key !== null && this._treemapHasChildren(key)) {
                ev.preventDefault();
                this._drillTo(key);
                return;
            }
            if (key === null && this._drillRoot() !== null) {
                ev.preventDefault();
                this._drillUp();
            }
            return;
        }
        if (this._zoomResetVisible()) {
            ev.preventDefault();
            this._resetView();
        }
    }

    // ---- Crosshair（line/area 最近点取值） ----

    /** line/area 卡片的全部系列折线命中区。 */
    public _polylines(): PolylineHit[] {
        const out: PolylineHit[] = [];
        if (!this.#semanticScene) return out;
        if (!this.spec) return out;
        if (this.spec.facetField) return out;
        const markKind = String(this.spec.mark);
        if (markKind !== "line" && markKind !== "area" && markKind !== "bump" && markKind !== "slope" && markKind !== "streamgraph" && markKind !== "parallel") return out;
        for (const node of this._markNodes()) {
            // 折线/面积/雷达多边形都带 stroke；没有 stroke 的路径不可见也不出点标记。
            if (node.kind !== "path" || !node.hitRegion || !("polyline" in node.hitRegion)) continue;
            if (!node.stroke) continue;
            out.push({ id: node.id, points: node.hitRegion.polyline.points, keys: node.hitRegion.polyline.keys, color: rgbaCss(node.stroke.color) });
        }
        return out;
    }

    /** 指针在 plot 内时显示 crosshair：吸附到最近数据 x，tooltip 列出各系列真实值。 */
    public _updateCrosshair(point: Point2D): void {
        const polylines = this._polylines();
        const bounds = this._plotBounds();
        if (polylines.length === 0 || !bounds) return;
        if (point.x < bounds.x || point.x > bounds.x + bounds.w || point.y < bounds.y || point.y > bounds.y + bounds.h) {
            this._hideCrosshair();
            return;
        }
        // 最近的数据 x（scene 坐标），跨全部系列。
        let bestX: number | null = null;
        for (const pl of polylines) {
            for (const p of pl.points) {
                if (bestX === null || Math.abs(p.x - point.x) < Math.abs(bestX - point.x)) bestX = p.x;
            }
        }
        if (bestX === null) return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        const rect = root && typeof root.getBoundingClientRect === "function" ? root.getBoundingClientRect() : null;
        const scaleX = rect && rect.width > 0 ? rect.width / this._effWidth() : 1;
        const scaleY = rect && rect.height > 0 ? rect.height / this._effHeight() : 1;
        this._crosshair.x = bestX * scaleX;
        this._crosshair.visible = true;

        // 每个系列在该 x 处的顶点 → 点标记 + tooltip 行。
        const dots: CrosshairDot[] = [];
        const parts: string[] = [];
        const xEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "x") : undefined;
        const yEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "y") : undefined;
        let xLabel = "";
        for (const pl of polylines) {
            for (let i = 0; i < pl.points.length; i++) {
                if (Math.abs(pl.points[i].x - bestX) > 0.5) continue;
                dots.push({ x: pl.points[i].x * scaleX, y: pl.points[i].y * scaleY, color: pl.color });
                const mark = this.#plan ? this.#plan.marks.find((m) => m.key === pl.keys[i]) : undefined;
                if (mark && this.#plan) {
                    // 无分组时回退到 y 字段名而不是内部节点 id。
                    const seriesName = mark.series !== null ? mark.series : yEnc ? yEnc.field : pl.id;
                    if (yEnc) {
                        const rank = this.spec && String(this.spec.mark) === "bump" ? mark.channels.get("rank") : undefined;
                        parts.push(
                            typeof rank === "number"
                                ? `${seriesName}: 第 ${rank} 名`
                                : `${seriesName}: ${formatCell(readCell(this.#plan.resolvedData, yEnc.field, mark.rowIndex))}`,
                        );
                    }
                    if (xLabel === "" && xEnc) {
                        xLabel = `${xEnc.field}: ${formatCell(readCell(this.#plan.resolvedData, xEnc.field, mark.rowIndex))}`;
                    }
                }
                break;
            }
        }
        this._crosshairDots = dots;
        const head = xLabel !== "" ? xLabel : "";
        this._tooltip.text = head !== "" && parts.length > 0 ? `${head} · ${parts.join(" · ")}` : parts.join(" · ");
        this._tooltip.x = this._crosshair.x;
        this._tooltip.y = point.y * scaleY;
        this._tooltip.visible = parts.length > 0;
        // 联动广播：吸附到的真实数据 x 值（定量 x 才有意义）。
        // `__linkQuiet`：收端借道本方法刷新 DOM，不得回播成环。
        if (this.linkId && xEnc && this.#plan && !(this as any).__linkQuiet) {
            for (const pl of polylines) {
                for (let i = 0; i < pl.points.length; i++) {
                    if (Math.abs(pl.points[i].x - bestX) > 0.5) continue;
                    const mark = this.#plan.marks.find((m) => m.key === pl.keys[i]);
                    if (mark) {
                        const v = readCell(this.#plan.resolvedData, xEnc.field, mark.rowIndex);
                        if (typeof v === "number" && Number.isFinite(v)) this._linkBroadcast(v);
                    }
                    i = pl.points.length;
                    break;
                }
                break;
            }
        }
    }

    public _hideCrosshair(): void {
        this._crosshair.visible = false;
        this._crosshairDots = [];
    }

    public _crosshairStyle(): string {
        return `left:${this._crosshair.x}px`;
    }

    public _dotStyle(dot: CrosshairDot): string {
        return `left:${dot.x}px;top:${dot.y}px;background:${dot.color}`;
    }

    // ---- Brush 选区 / Shift+拖拽 pan ----

    /** 宿主可 override 的 brush 回调（事件名 `chart-brush`）。 */
    public onchartBrush(payload: { keys: Array<string | number> }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onMouseDown(ev: MouseEvent): void {
        const point = this._toScenePoint(ev);
        if (!point) return;
        if (ev.shiftKey && this._zoomable()) {
            const base = this._baseXDomain;
            const cur = this._viewDomain ?? (base ? [base[0], base[1]] : null);
            if (base && cur) {
                this._panStart = { clientX: ev.clientX, lo: cur[0], hi: cur[1] };
            }
            return;
        }
        // 空白处按下开始 brush；命中 mark 时保持点击选择语义。
        if (this._hitTest(point.x, point.y) !== null) return;
        this._brush.active = true;
        this._brush.x0 = point.x;
        this._brush.y0 = point.y;
        this._brush.x1 = point.x;
        this._brush.y1 = point.y;
    }

    public _onMouseUp(ev: MouseEvent): void {
        if (this._panStart) {
            // 只有真的拖动了视域才吞掉随后的 click。
            const cur = this._viewDomain;
            if (cur && (cur[0] !== this._panStart.lo || cur[1] !== this._panStart.hi)) {
                this._suppressClick = true;
            }
            this._panStart = null;
            return;
        }
        if (!this._brush.active) return;
        const point = this._toScenePoint(ev);
        if (point) {
            this._brush.x1 = point.x;
            this._brush.y1 = point.y;
        }
        this._brush.active = false;
        const x0 = Math.min(this._brush.x0, this._brush.x1);
        const x1 = Math.max(this._brush.x0, this._brush.x1);
        const y0 = Math.min(this._brush.y0, this._brush.y1);
        const y1 = Math.max(this._brush.y0, this._brush.y1);
        // 小于 3px 的拖拽视为误触，不改变选择。
        if (x1 - x0 < 3 && y1 - y0 < 3) return;
        // brush 的 mouseup 之后浏览器还会补发一次 click——不清掉它，空命中会立刻清选择。
        this._suppressClick = true;
        const keys: Array<string | number> = [];
        this.dispatch({ kind: "clear-selection" });
        for (const node of this._markNodes()) {
            const anchor = this._nodeAnchor(node.id);
            if (!anchor) continue;
            if (anchor.x >= x0 && anchor.x <= x1 && anchor.y >= y0 && anchor.y <= y1) {
                this.dispatch({ kind: "select-toggle", nodeId: node.id });
                keys.push(node.id);
            }
        }
        this.onchartBrush({ keys });
        this._applyDomState();
    }

    public _brushStyle(): string {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        const rect = root && typeof root.getBoundingClientRect === "function" ? root.getBoundingClientRect() : null;
        const scaleX = rect && rect.width > 0 ? rect.width / this._effWidth() : 1;
        const scaleY = rect && rect.height > 0 ? rect.height / this._effHeight() : 1;
        const x = Math.min(this._brush.x0, this._brush.x1) * scaleX;
        const y = Math.min(this._brush.y0, this._brush.y1) * scaleY;
        const w = Math.abs(this._brush.x1 - this._brush.x0) * scaleX;
        const h = Math.abs(this._brush.y1 - this._brush.y0) * scaleY;
        return `left:${x}px;top:${y}px;width:${w}px;height:${h}px`;
    }

    /** 取消进行中的 brush / pan（Escape 路径）。 */
    public _cancelDrag(): void {
        this._brush.active = false;
        this._panStart = null;
    }

    // ---- 命中测试（读渲染期缓存的 SemanticScene，不重编译） ----

    /** 渲染坐标 → scene 坐标的缩放（SVG 可能被 CSS 拉伸）。 */
    public _toScenePoint(ev: MouseEvent) {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root) {
            return null;
        }
        const rect = root.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) {
            return null;
        }
        return {
            x: ((ev.clientX - rect.left) / rect.width) * this._effWidth(),
            y: ((ev.clientY - rect.top) / rect.height) * this._effHeight(),
        };
    }

    /** 收集 mark 节点（直接子级，role=chart.mark）。 */
    public _markNodes(): SemanticNode[] {
        if (!this.#semanticScene) {
            return [];
        }
        return this.#semanticScene.root.children.filter((n) => n.role === "chart.mark");
    }

    /** 命中测试：返回最近的 mark 稳定 id，未命中返回 null。重叠 rect（嵌套
     *  treemap）同样距离时取面积更小的那个 —— 最深节点才代表点到的格子。 */
    public _hitTest(px: number, py: number): string | null {
        let bestId: string | null = null;
        let bestDist: number = Number.POSITIVE_INFINITY;
        let bestArea: number = Number.POSITIVE_INFINITY;
        for (const node of this._markNodes()) {
            const dist = this._distanceTo(node, px, py);
            if (dist === null || dist > HIT_TOLERANCE_PX) {
                continue;
            }
            const area = node.kind === "rect" ? node.w * node.h : Number.POSITIVE_INFINITY;
            if (bestId === null || dist < bestDist || (dist === bestDist && area < bestArea)) {
                bestId = node.id;
                bestDist = dist;
                bestArea = area;
            }
        }
        return bestId;
    }

    /** 点到单个 mark 的距离（rect/ellipse 内部为 0，path 为到折线段距离）。 */
    public _distanceTo(node: SemanticNode, px: number, py: number): number | null {
        // 显式扇形命中区（pie / donut 切片）优先于几何近似。
        if (node.hitRegion && "sector" in node.hitRegion) {
            return sectorDistance(node.hitRegion.sector, px, py);
        }
        // 折线命中区：到最近顶点的距离（顶点吸附优先于线段近似）。
        if (node.hitRegion && "polyline" in node.hitRegion) {
            let best: number | null = null;
            for (const p of node.hitRegion.polyline.points) {
                const d = Math.hypot(px - p.x, py - p.y);
                if (best === null || d < best) best = d;
            }
            return best;
        }
        // 多边形命中区（漏斗梯形 / 桑基流 / 山脊带）：内部射线法，外部最近边距离。
        if (node.hitRegion && "polygon" in node.hitRegion) {
            const pts = node.hitRegion.polygon.points;
            if (pointInPolygon(px, py, pts)) return 0;
            let best: number | null = null;
            for (let i = 0; i < pts.length; i++) {
                const d = segmentDistance(px, py, pts[i], pts[(i + 1) % pts.length]);
                if (best === null || d < best) best = d;
            }
            return best;
        }
        if (node.kind === "rect") {
            const inside = px >= node.x && px <= node.x + node.w && py >= node.y && py <= node.y + node.h;
            if (inside) {
                return 0;
            }
            const dx = Math.max(node.x - px, 0, px - (node.x + node.w));
            const dy = Math.max(node.y - py, 0, py - (node.y + node.h));
            return Math.hypot(dx, dy);
        }
        if (node.kind === "ellipse") {
            const radial = Math.hypot(px - node.cx, py - node.cy);
            return Math.max(0, radial - node.rx);
        }
        if (node.kind === "path") {
            const points = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") {
                    points.push(cmd.to);
                }
            }
            let best: number | null = null;
            for (let i = 1; i < points.length; i++) {
                const d = segmentDistance(px, py, points[i - 1], points[i]);
                if (best === null || d < best) {
                    best = d;
                }
            }
            return best;
        }
        return null;
    }

    // ---- Tooltip（真实行数据） ----

    /** 从 mark id 还原 tooltip 文本：统计型 mark 读 stat 快照，特殊 mark
     *  读派生量（占比 / 累计 / 秩次），其余读全部编码字段的真实行值。 */
    public _tooltipTextFor(id: string): string {
        const plan = this.#plan;
        if (!plan || !this.spec) return id;
        const markKind = String(this.spec.mark);
        const xEnc = this.spec.encoding.find((e) => e.channel === "x");
        const yEnc = this.spec.encoding.find((e) => e.channel === "y");
        // force 节点 id：名称 + 度数（布局在 compile 物化，度在 channels）。
        if (id.startsWith("force:")) {
            const name = id.slice("force:".length);
            const mark = plan.marks.find((m) => m.key === name);
            const deg = mark ? mark.channels.get("degree") : undefined;
            return typeof deg === "number" ? `${name} · 度 ${deg}` : name;
        }
        // geo 区域 id：按名匹配的行以行键命名，iso 匹配与未匹配特性以特性名
        // 命名。先按行键解，再按特性名解；标签恒取 channels.feature 的特性名。
        if (id.startsWith("geo:")) {
            const suffix = id.slice("geo:".length);
            const mark = plan.marks.find((m) => m.key === suffix) ?? plan.marks.find((m) => m.channels.get("feature") === suffix);
            if (mark) {
                const feature = mark.channels.get("feature");
                const label = typeof feature === "string" ? feature : suffix;
                const cEnc = this.spec.encoding.find((e) => e.channel === "color");
                if (cEnc) {
                    const v = readCell(plan.resolvedData, cEnc.field, mark.rowIndex);
                    if (v !== null && v !== undefined) return `${label} · ${cEnc.field}: ${formatCell(v)}`;
                }
                return label;
            }
            return suffix;
        }
        // sankey / chord 的派生节点 id：名称 + 总流量（从原始行现算）。
        if (id.startsWith("chord-group:")) {
            const name = id.slice("chord-group:".length);
            if (plan.stat) {
                for (let i = 0; i < plan.stat.rowCount; i++) {
                    if (String(readCell(plan.stat, "name", i)) === name) {
                        return `${name} · 总量 ${formatCell(readCell(plan.stat, "total", i))}`;
                    }
                }
            }
            return name;
        }
        if (id.startsWith("sankey-node:")) {
            const name = id.slice("sankey-node:".length);
            const sEnc = this.spec.encoding.find((e) => e.channel === "source");
            const tEnc = this.spec.encoding.find((e) => e.channel === "target");
            const vEnc = this.spec.encoding.find((e) => e.channel === "value");
            if (sEnc && tEnc && vEnc) {
                let sumIn = 0;
                let sumOut = 0;
                for (let r = 0; r < plan.resolvedData.rowCount; r++) {
                    const v = readCell(plan.resolvedData, vEnc.field, r);
                    if (typeof v !== "number" || !Number.isFinite(v)) continue;
                    if (String(readCell(plan.resolvedData, sEnc.field, r)) === name) sumOut += v;
                    if (String(readCell(plan.resolvedData, tEnc.field, r)) === name) sumIn += v;
                }
                return `${name} · 总量 ${formatCell(Math.max(sumIn, sumOut))}`;
            }
            return name;
        }
        // line / area 的 id 是 series 名；bar / point 是行 key。
        const mark = plan.marks.find((m) => `${markKind}:${m.key}` === id);
        if (mark) {
            const rowIndex = mark.rowIndex;
            const parts: string[] = [];
            if (mark.series !== null && markKind !== "ridgeline") parts.push(mark.series);
            if (markKind === "pie") {
                // pie 切片报 theta 原值与真实占比（对正切片求和）。
                const thetaEnc = this.spec.encoding.find((e) => e.channel === "theta");
                if (thetaEnc) {
                    const value = readCell(plan.resolvedData, thetaEnc.field, rowIndex);
                    parts.push(`${thetaEnc.field}: ${formatCell(value)}`);
                    let total = 0;
                    for (const m of plan.marks) {
                        const v = readCell(plan.resolvedData, thetaEnc.field, m.rowIndex);
                        if (typeof v === "number" && Number.isFinite(v) && v > 0) total += v;
                    }
                    if (typeof value === "number" && total > 0) {
                        parts.push(`${Math.round((value / total) * 1000) / 10}%`);
                    }
                }
                return parts.length > 0 ? parts.join(" · ") : id;
            }
            // 统计型 mark：行索引指向 compile 产出的 stat 快照。
            if (markKind === "histogram" && plan.stat) {
                const x0 = readCell(plan.stat, "x0", rowIndex);
                const x1 = readCell(plan.stat, "x1", rowIndex);
                const count = readCell(plan.stat, "count", rowIndex);
                return `[${formatCell(x0)}, ${formatCell(x1)}) · count: ${formatCell(count)}`;
            }
            if (markKind === "calendar" && plan.stat) {
                const date = readCell(plan.stat, "date", rowIndex);
                const cEnc = this.spec.encoding.find((e) => e.channel === "color");
                return `${formatCell(date)} · ${cEnc?.field ?? "value"}: ${formatCell(readCell(plan.stat, "value", rowIndex))}`;
            }
            if (markKind === "violin") {
                const cat = mark.key;
                const num = (k: string) => formatCell(typeof mark.channels.get(k) === "number" ? (mark.channels.get(k) as number) : null);
                return [
                    cat,
                    `min ${num("low")}`,
                    `Q1 ${num("q1")}`,
                    `中位 ${num("median")}`,
                    `Q3 ${num("q3")}`,
                    `max ${num("high")}`,
                    `n=${num("n")}`,
                ].join(" · ");
            }
            if (markKind === "sunburst") {
                const subtree = mark.channels.get("subtree");
                return `${mark.key} · 占比值: ${formatCell(typeof subtree === "number" ? subtree : null)}`;
            }
            if (markKind === "mosaic") {
                const share = mark.channels.get("share");
                if (xEnc) parts.push(`${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
                if (yEnc) parts.push(`${yEnc.field}: ${formatCell(readCell(plan.resolvedData, yEnc.field, rowIndex))}`);
                if (typeof share === "number") parts.push(`占列 ${Math.round(share * 1000) / 10}%`);
                return parts.join(" · ");
            }
            if (markKind === "gantt") {
                const sEnc = this.spec.encoding.find((e) => e.channel === "start");
                const eEnc = this.spec.encoding.find((e) => e.channel === "end");
                const sv = mark.channels.get("startV");
                const ev = mark.channels.get("endV");
                if (yEnc) parts.push(`${formatCell(readCell(plan.resolvedData, yEnc.field, rowIndex))}`);
                if (sEnc && eEnc) {
                    parts.push(`${formatCell(readCell(plan.resolvedData, sEnc.field, rowIndex))} → ${formatCell(readCell(plan.resolvedData, eEnc.field, rowIndex))}`);
                }
                if (typeof sv === "number" && typeof ev === "number") parts.push(`时长 ${formatCell(ev - sv)}`);
                return parts.join(" · ");
            }
            if (markKind === "force") {
                const degree = mark.channels.get("degree");
                return `${mark.key} · 度 ${formatCell(typeof degree === "number" ? degree : null)}`;
            }
            if (markKind === "parallel") {
                const dims = this.spec.dimensions ?? [];
                const parts2: string[] = [];
                if (mark.series !== null) parts2.push(mark.series);
                for (const dim of dims) {
                    parts2.push(`${dim}: ${formatCell(readCell(plan.resolvedData, dim, rowIndex))}`);
                }
                return parts2.join(" · ");
            }
            if (markKind === "hexbin" && plan.stat) {
                const cx = readCell(plan.stat, "cx", rowIndex);
                const cy = readCell(plan.stat, "cy", rowIndex);
                const count = readCell(plan.stat, "count", rowIndex);
                return `count: ${formatCell(count)} · 中心 (${formatCell(cx)}, ${formatCell(cy)})`;
            }
            if (markKind === "contour") {
                const level = mark.channels.get("level");
                return `密度 level: ${formatCell(typeof level === "number" ? level : null)}`;
            }
            if (markKind === "chord") {
                const sEnc = this.spec.encoding.find((e) => e.channel === "source");
                const tEnc = this.spec.encoding.find((e) => e.channel === "target");
                const vEnc = this.spec.encoding.find((e) => e.channel === "value");
                if (sEnc && tEnc && vEnc) {
                    return `${formatCell(readCell(plan.resolvedData, sEnc.field, rowIndex))} → ${formatCell(readCell(plan.resolvedData, tEnc.field, rowIndex))} · ${formatCell(readCell(plan.resolvedData, vEnc.field, rowIndex))}`;
                }
            }
            if (markKind === "boxplot" && plan.stat) {
                const kind = String(readCell(plan.stat, "kind", rowIndex));
                const cat = String(readCell(plan.stat, "category", rowIndex));
                if (kind === "outlier") {
                    return `${cat} · 异常值: ${formatCell(readCell(plan.stat, "value", rowIndex))}`;
                }
                return [
                    cat,
                    `min ${formatCell(readCell(plan.stat, "low", rowIndex))}`,
                    `Q1 ${formatCell(readCell(plan.stat, "q1", rowIndex))}`,
                    `中位 ${formatCell(readCell(plan.stat, "median", rowIndex))}`,
                    `Q3 ${formatCell(readCell(plan.stat, "q3", rowIndex))}`,
                    `max ${formatCell(readCell(plan.stat, "high", rowIndex))}`,
                    `n=${formatCell(readCell(plan.stat, "n", rowIndex))}`,
                ].join(" · ");
            }
            if (markKind === "ridgeline") {
                // 山脊 tooltip 是分组摘要：n 与值域从原始行现算（一次 hover 一次扫描）。
                const group = mark.series ?? mark.key;
                if (xEnc && yEnc) {
                    let n = 0;
                    let lo = Number.POSITIVE_INFINITY;
                    let hi = Number.NEGATIVE_INFINITY;
                    for (let r = 0; r < plan.resolvedData.rowCount; r++) {
                        if (String(readCell(plan.resolvedData, yEnc.field, r)) !== group) continue;
                        const v = readCell(plan.resolvedData, xEnc.field, r);
                        if (typeof v !== "number" || !Number.isFinite(v)) continue;
                        n++;
                        if (v < lo) lo = v;
                        if (v > hi) hi = v;
                    }
                    return `${group} · n=${n}${n > 0 ? ` · [${formatCell(lo)}, ${formatCell(hi)}]` : ""}`;
                }
                return group;
            }
            // 特殊派生量。
            if (markKind === "waterfall") {
                const v = yEnc ? readCell(plan.resolvedData, yEnc.field, rowIndex) : null;
                const cum = (mark.stackBase ?? 0) + (typeof v === "number" ? v : 0);
                if (xEnc) parts.push(`${xEnc.field}: ${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
                parts.push(`Δ ${formatCell(v)}`);
                parts.push(`累计 ${formatCell(cum)}`);
                return parts.join(" · ");
            }
            if (markKind === "funnel") {
                const v = yEnc ? readCell(plan.resolvedData, yEnc.field, rowIndex) : null;
                let max = 0;
                for (const m of plan.marks) {
                    const mv = yEnc ? readCell(plan.resolvedData, yEnc.field, m.rowIndex) : null;
                    if (typeof mv === "number" && Number.isFinite(mv) && mv > max) max = mv;
                }
                if (xEnc) parts.push(`${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
                parts.push(`${yEnc?.field ?? "value"}: ${formatCell(v)}`);
                if (typeof v === "number" && max > 0) parts.push(`占首层 ${Math.round((v / max) * 1000) / 10}%`);
                return parts.join(" · ");
            }
            if (markKind === "gauge") {
                const thetaEnc = this.spec.encoding.find((e) => e.channel === "theta");
                const domain = this.spec.valueDomain ?? [0, 100];
                const v = thetaEnc ? readCell(plan.resolvedData, thetaEnc.field, rowIndex) : null;
                parts.push(`${thetaEnc?.field ?? "value"}: ${formatCell(v)}`);
                if (typeof v === "number" && domain[1] > domain[0]) {
                    parts.push(`${Math.round(((v - domain[0]) / (domain[1] - domain[0])) * 1000) / 10}%`);
                }
                return parts.join(" · ");
            }
            if (markKind === "treemap") {
                const subtree = mark.channels.get("subtree");
                parts.push(mark.key);
                parts.push(`占比值: ${formatCell(typeof subtree === "number" ? subtree : null)}`);
                return parts.join(" · ");
            }
            if (markKind === "bump") {
                const rank = mark.channels.get("rank");
                if (xEnc) parts.push(`${xEnc.field}: ${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
                if (typeof rank === "number") parts.push(`第 ${rank} 名`);
                if (yEnc) parts.push(`${yEnc.field}: ${formatCell(readCell(plan.resolvedData, yEnc.field, rowIndex))}`);
                return parts.join(" · ");
            }
            if (markKind === "sankey") {
                const sEnc = this.spec.encoding.find((e) => e.channel === "source");
                const tEnc = this.spec.encoding.find((e) => e.channel === "target");
                const vEnc = this.spec.encoding.find((e) => e.channel === "value");
                if (sEnc && tEnc && vEnc) {
                    return `${formatCell(readCell(plan.resolvedData, sEnc.field, rowIndex))} → ${formatCell(readCell(plan.resolvedData, tEnc.field, rowIndex))} · ${formatCell(readCell(plan.resolvedData, vEnc.field, rowIndex))}`;
                }
            }
            if (markKind === "radial-bar") {
                if (xEnc) parts.push(`${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
                const v = yEnc ? readCell(plan.resolvedData, yEnc.field, rowIndex) : null;
                parts.push(`${yEnc?.field ?? "value"}: ${formatCell(v)}`);
                const ys = plan.scales.get("y");
                if (typeof v === "number" && ys && ys.kind === "linear" && ys.domain[1] > 0) {
                    parts.push(`${Math.round((v / ys.domain[1]) * 1000) / 10}%`);
                }
                return parts.join(" · ");
            }
            // 通用路径：系列 + 全部编码字段的真实行值（heatmap / candlestick /
            // bubble / error bar / bullet / rose / slope 等全覆盖）。
            for (const enc of this.spec.encoding) {
                parts.push(`${enc.field}: ${formatCell(readCell(plan.resolvedData, enc.field, rowIndex))}`);
            }
            return parts.length > 0 ? parts.join(" · ") : id;
        }
        // facet 面板的系列级 id 带 `f<i>:` 前缀（如 `f1:line:North`），剥掉再匹配。
        let bare = id;
        if (id.startsWith("f")) {
            const colon = id.indexOf(":");
            const head = id.slice(1, colon);
            const rest = id.slice(colon + 1);
            const facetPrefixed =
                colon > 1 &&
                head.length > 0 &&
                !Number.isNaN(Number(head)) &&
                (rest.startsWith("line:") || rest.startsWith("area:") || rest.startsWith("radar-series:"));
            if (facetPrefixed) bare = rest;
        }
        if (bare.startsWith("line:") || bare.startsWith("area:")) {
            return bare.slice(bare.indexOf(":") + 1);
        }
        if (bare.startsWith("radar-series:")) {
            return bare.slice("radar-series:".length);
        }
        return id;
    }

    /** 按行 key 直接还原 tooltip 文本（crosshair / 键盘顶点路径）。 */
    public _tooltipForRowKey(key: string): string {
        const plan = this.#plan;
        if (!plan || !this.spec) return key;
        const mark = plan.marks.find((m) => m.key === key);
        if (!mark) return key;
        const xEnc = this.spec.encoding.find((e) => e.channel === "x");
        const yEnc = this.spec.encoding.find((e) => e.channel === "y");
        const parts: string[] = [];
        if (mark.series !== null) parts.push(mark.series);
        if (xEnc) parts.push(`${xEnc.field}: ${formatCell(readCell(plan.resolvedData, xEnc.field, mark.rowIndex))}`);
        if (String(this.spec.mark) === "bump") {
            const rank = mark.channels.get("rank");
            if (typeof rank === "number") parts.push(`第 ${rank} 名`);
        }
        if (yEnc) parts.push(`${yEnc.field}: ${formatCell(readCell(plan.resolvedData, yEnc.field, mark.rowIndex))}`);
        return parts.length > 0 ? parts.join(" · ") : key;
    }

    /** mark 节点在 scene 坐标里的锚点（tooltip / 键盘定位用）。 */
    public _nodeAnchor(id: string): Point2D | null {
        const node = this._markNodes().find((n) => n.id === id);
        if (!node) return null;
        // 扇形切片的锚点在中角中半径处。
        if (node.hitRegion && "sector" in node.hitRegion) {
            const s = node.hitRegion.sector;
            const mid = (s.a0 + s.a1) / 2;
            const r = (s.rInner + s.rOuter) / 2;
            return { x: s.cx + r * Math.cos(mid), y: s.cy + r * Math.sin(mid) };
        }
        // 多边形命中区的锚点在质心。
        if (node.hitRegion && "polygon" in node.hitRegion) {
            const pts = node.hitRegion.polygon.points;
            if (pts.length === 0) return null;
            let sx = 0;
            let sy = 0;
            for (const p of pts) {
                sx += p.x;
                sy += p.y;
            }
            return { x: sx / pts.length, y: sy / pts.length };
        }
        if (node.kind === "rect") return { x: node.x + node.w / 2, y: node.y };
        if (node.kind === "ellipse") return { x: node.cx, y: node.cy - node.ry };
        if (node.kind === "path") {
            const pts = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") pts.push(cmd.to);
            }
            if (pts.length === 0) return null;
            return pts[Math.floor(pts.length / 2)];
        }
        return null;
    }

    // ---- Pointer 交互 ----

    /** 宿主可 override 的 hover 回调（事件名 `chart-hover`）。 */
    public onchartHover(payload: { rowKey: string | number; x: number; y: number }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onMouseMove(ev: MouseEvent): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root) return;
        const rect = root.getBoundingClientRect();
        this._tooltip.x = ev.clientX - rect.left;
        this._tooltip.y = ev.clientY - rect.top;
        const point = this._toScenePoint(ev);

        // pan 中：按指针位移平移 x 视域，视域不越过基线域。
        if (this._panStart && point) {
            const bounds = this._plotBounds();
            const base = this._baseXDomain;
            if (bounds && base && rect.width > 0) {
                const sceneDx = ((ev.clientX - this._panStart.clientX) / rect.width) * this._effWidth();
                const span = this._panStart.hi - this._panStart.lo;
                const dataDx = (sceneDx / bounds.w) * span;
                let lo = this._panStart.lo - dataDx;
                let hi = this._panStart.hi - dataDx;
                if (lo < base[0]) {
                    lo = base[0];
                    hi = lo + span;
                }
                if (hi > base[1]) {
                    hi = base[1];
                    lo = hi - span;
                }
                this._setViewDomain(lo <= base[0] && hi >= base[1] ? null : [lo, hi]);
            }
            this._hideCrosshair();
            this._tooltip.visible = false;
            return;
        }

        // brush 中：只更新选框，不动 hover。
        if (this._brush.active && point) {
            this._brush.x1 = point.x;
            this._brush.y1 = point.y;
            return;
        }

        // 钉住态：tooltip 冻结在钉住内容，指针不再改写 tooltip（点击/Esc 解除）。
        if (this._pinnedTooltip) {
            this._tooltip.x = this._pinnedTooltip.x;
            this._tooltip.y = this._pinnedTooltip.y;
            this._tooltip.text = this._pinnedTooltip.text;
            this._tooltip.visible = true;
            return;
        }

        // line/area/bump/slope/streamgraph：plot 内任意位置给 crosshair 最近点取值（吸附数据 x）。
        const markKind = this.spec ? String(this.spec.mark) : "";
        const crosshairMark =
            (markKind === "line" || markKind === "area" || markKind === "bump" || markKind === "slope" || markKind === "streamgraph") &&
            !(this.spec && this.spec.facetField);
        // axis 触发（bar 族）：同一 x 槽的全部系列合并为一条 tooltip。
        if (this.tooltipTrigger === "axis" && point && !crosshairMark) {
            const slot = this._slotFromPoint(point);
            if (slot !== null) {
                this._hoverId = null;
                this._axisTooltipForSlot(slot, point);
                this._applyDomState();
                return;
            }
        }
        if (crosshairMark && point) {
            this._hoverId = null;
            this._updateCrosshair(point);
            if (!this._crosshair.visible) this._tooltip.visible = false;
            this.dispatch({ kind: "hover", nodeId: null });
            this._focusIndex = -1;
            this._applyDomState();
            return;
        }

        const hit = point ? this._hitTest(point.x, point.y) : null;
        this._hoverId = hit;
        if (hit) {
            this._hideCrosshair();
            this._tooltip.text = this._tooltipTextFor(hit);
            this._tooltip.visible = true;
            this.dispatch({ kind: "hover", nodeId: hit });
            this.onchartHover({ rowKey: hit, x: this._tooltip.x, y: this._tooltip.y });
        } else {
            this._hideCrosshair();
            this._tooltip.visible = false;
            this.dispatch({ kind: "hover", nodeId: null });
        }
        this._focusIndex = hit ? this._markNodes().findIndex((n) => n.id === hit) : -1;
        this._applyDomState();
    }
    public _onMouseLeave(): void {
        this._tooltip.visible = false;
        this._hoverId = null;
        this._hideCrosshair();
        this._cancelDrag();
        this.dispatch({ kind: "hover", nodeId: null });
        this._applyDomState();
    }

    public _tooltipStyle(): string {
        const raw = `left:${this._tooltip.x}px;top:${this._tooltip.y}px`;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.getBoundingClientRect !== "function") return raw;
        const rect = root.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return raw;
        // 视口夹取：tooltip 盒子含 CSS 偏移 translate(10px, 10px)，必须留在宿主内。
        // 已挂载时测真实尺寸；首帧无元素可测，用按字符宽的高估兜底（宁紧勿溢）。
        const el = root.querySelector(".vmz-ui-charts__tooltip") as HTMLElement | null;
        let w = 0;
        let h = 0;
        if (el && el.offsetWidth > 0 && el.offsetHeight > 0) {
            w = el.offsetWidth;
            h = el.offsetHeight;
        } else {
            let est = 0;
            const text = this._tooltip.text;
            for (let i = 0; i < text.length; i++) {
                const wide = text.charCodeAt(i) > 255;
                est = est + (wide ? 13 : 7);
            }
            w = Math.min(est + 18, Math.max(rect.width - 8, 0));
            h = 30;
        }
        const minX = -6;
        const minY = -6;
        const maxX = Math.max(minX, rect.width - 14 - w);
        const maxY = Math.max(minY, rect.height - 14 - h);
        const x = Math.min(Math.max(this._tooltip.x, minX), maxX);
        const y = Math.min(Math.max(this._tooltip.y, minY), maxY);
        return `left:${x}px;top:${y}px`;
    }

    // ---- Click → select dispatch + emit ----

    /** 宿主可 override 的选择回调（事件名 `chart-select`）。 */
    public onchartSelect(payload: { rowKey: string | number }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onClick(ev: MouseEvent): void {
        if (!this.state) return;
        // brush / pan 拖拽收尾的那次 click 不是选择意图。
        if (this._suppressClick) {
            this._suppressClick = false;
            return;
        }
        // 图例项优先：单击切换显隐（mark 命中逻辑不参与）。
        const target = ev.target as Element | null;
        const legendEl = target && typeof target.closest === "function" ? target.closest('[data-dvz-id^="legend:swatch:"], [data-dvz-id^="legend:label:"]') : null;
        if (legendEl) {
            const name = this._legendNameFromId(legendEl.getAttribute("data-dvz-id") ?? "");
            if (name !== null) this._toggleLegendSeries(name);
            return;
        }
        // 钉住态 tooltip 存在时，点击只解除钉住，不改选择。触摸点按的解钉
        // 已在 pointerdown 处理，这里只认鼠标 click。
        if (this._pinnedTooltip) {
            if ((this as any).__lastPointerWasTouch) return;
            this._pinnedTooltip = null;
            this._tooltip.visible = false;
            this._announce("tooltip 已关闭");
            return;
        }
        const point = this._toScenePoint(ev);
        const hit = point ? this._hitTest(point.x, point.y) : null;
        if (!hit) {
            if (this.selection === null) {
                this.dispatch({ kind: "clear-selection" });
            }
            this._emitSelectionChange();
            this._applyDomState();
            return;
        }
        if (this.selection === null) {
            this.dispatch({ kind: "select-toggle", nodeId: hit });
        } else {
            // 受控选择集：只提议，不落状态。
            const proposed = new Set(this.selection);
            if (proposed.has(hit)) proposed.delete(hit);
            else proposed.add(hit);
            this._emitChartEvent("vmz-chart-selection-change", { selection: [...proposed] });
        }
        this.onchartSelect({ rowKey: hit });
        this._applyDomState();
    }

    // ---- 键盘等价入口 ----

    /** 键盘导航目标：line/area 展开为逐顶点（最近点取值），其它 mark 逐节点。 */
    public _navTargets(): NavTarget[] {
        const polylines = this._polylines();
        if (polylines.length > 0) {
            const out: NavTarget[] = [];
            for (const pl of polylines) {
                for (let i = 0; i < pl.points.length; i++) {
                    out.push({ id: pl.id, key: pl.keys[i], point: pl.points[i] });
                }
            }
            return out;
        }
        return this._markNodes().map((n) => ({ id: n.id, key: null, point: null }));
    }

    public _onKeydown(ev: KeyboardEvent): void {
        // 视域键盘路径：+ / - 缩放，0 复位。
        if (ev.key === "+" || ev.key === "=") {
            if (this._zoomable()) {
                ev.preventDefault();
                this._zoomBy(0.8);
            }
            return;
        }
        if (ev.key === "-" || ev.key === "_") {
            if (this._zoomable()) {
                ev.preventDefault();
                this._zoomBy(1.25);
            }
            return;
        }
        if (ev.key === "0") {
            if (this._zoomable()) {
                ev.preventDefault();
                this._resetView();
            }
            return;
        }
        const targets = this._navTargets();
        if (targets.length === 0) return;
        if (ev.key === "ArrowRight" || ev.key === "ArrowDown") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex + 1) % targets.length;
            this._focusTarget(targets[this._focusIndex]);
        } else if (ev.key === "ArrowLeft" || ev.key === "ArrowUp") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex - 1 + targets.length) % targets.length;
            this._focusTarget(targets[this._focusIndex]);
        } else if (ev.key === "Home") {
            ev.preventDefault();
            this._focusIndex = 0;
            this._focusTarget(targets[0]);
        } else if (ev.key === "End") {
            ev.preventDefault();
            this._focusIndex = targets.length - 1;
            this._focusTarget(targets[this._focusIndex]);
        } else if (ev.key === "Enter") {
            // Enter 展开 / 钉住 tooltip（再次 Enter 或 Esc 解除）。
            if (this._pinnedTooltip) {
                ev.preventDefault();
                this._pinnedTooltip = null;
                this._tooltip.visible = false;
                this._announce("tooltip 已关闭");
            } else if (this._hoverId && this._tooltip.visible) {
                ev.preventDefault();
                this._pinnedTooltip = { x: this._tooltip.x, y: this._tooltip.y, text: this._tooltip.text };
                this._announce(`已钉住 ${this._tooltip.text}`);
            }
        } else if (ev.key === " ") {
            if (this._hoverId) {
                ev.preventDefault();
                if (this.selection === null) {
                    this.dispatch({ kind: "select-toggle", nodeId: this._hoverId });
                }
                this.onchartSelect({ rowKey: this._hoverId });
                this._emitSelectionChange();
                this._applyDomState();
            }
        } else if (ev.key === "Escape") {
            // treemap 已下钻时，Escape 先返回上一级（再按一次才清选择）。
            if (this._drillBackVisible()) {
                ev.preventDefault();
                this._drillUp();
                return;
            }
            this._hoverId = null;
            this._focusIndex = -1;
            this._pinnedTooltip = null;
            this._tooltip.visible = false;
            this._hideCrosshair();
            this._cancelDrag();
            if (this.selection === null) {
                this.dispatch({ kind: "clear-selection" });
            }
            this._emitSelectionChange();
            this._applyDomState();
        }
    }

    /** axis 触发：从 scene 坐标解析 band x 槽的类目（非 band x 返回 null）。 */
    public _slotFromPoint(point: Point2D): string | null {
        const plan = this.#plan;
        const bounds = this._plotBounds();
        const xEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "x") : undefined;
        if (!plan || !bounds || !xEnc) return null;
        const xs = plan.scales.get("x");
        if (!xs || xs.kind !== "band") return null;
        const cats = xs.domain.map(String);
        if (cats.length === 0) return null;
        const step = bounds.w / cats.length;
        const idx = Math.max(0, Math.min(cats.length - 1, Math.floor((point.x - bounds.x) / step)));
        return cats[idx];
    }

    /** axis 触发：同一槽全部系列按图例序合并，值读全部编码字段的真实行值。 */
    public _axisTooltipForSlot(slot: string, point: Point2D): void {
        const plan = this.#plan;
        const xEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "x") : undefined;
        const yEnc = this.spec ? this.spec.encoding.find((e) => e.channel === "y") : undefined;
        if (!plan || !xEnc) return;
        const lines: string[] = [];
        for (const m of plan.marks) {
            const xv = readCell(plan.resolvedData, xEnc.field, m.rowIndex);
            if (xv === null || xv === undefined || String(xv) !== slot) continue;
            const parts: string[] = [];
            if (m.series !== null) parts.push(m.series);
            if (yEnc) parts.push(`${yEnc.field}: ${formatCell(readCell(plan.resolvedData, yEnc.field, m.rowIndex))}`);
            lines.push(parts.join(" "));
        }
        if (lines.length === 0) return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        const rect = root ? root.getBoundingClientRect() : null;
        const scaleY = rect && rect.height > 0 ? rect.height / this._effHeight() : 1;
        this._tooltip.text = `${xEnc.field}: ${slot} · ${lines.join(" · ")}`;
        this._tooltip.y = point.y * scaleY;
        this._tooltip.visible = true;
        this._announce(this._tooltip.text);
    }

    /** 键盘聚焦某个导航目标：tooltip 锚到顶点或节点，文本读真实行值并播报。 */
    public _focusTarget(target: NavTarget): void {
        this._hoverId = target.id;
        const anchor = target.point ? target.point : this._nodeAnchor(target.id);
        if (anchor) {
            const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
            const rect = root ? root.getBoundingClientRect() : null;
            const scaleX = rect && rect.width > 0 ? rect.width / this._effWidth() : 1;
            const scaleY = rect && rect.height > 0 ? rect.height / this._effHeight() : 1;
            this._tooltip.x = anchor.x * scaleX;
            this._tooltip.y = anchor.y * scaleY;
            this._tooltip.text = target.key !== null ? this._tooltipForRowKey(target.key) : this._tooltipTextFor(target.id);
            this._tooltip.visible = true;
            this._announce(this._tooltip.text);
        }
        this.dispatch({ kind: "hover", nodeId: target.id });
        this._emitChartEvent("vmz-chart-focus", { id: target.id, key: target.key });
        this._applyDomState();
    }

    // ---- DOM 高亮回放（交互状态不进 canonical scene） ----

    /** 把 hover / selection 映射到 `data-dvz-id` 元素透明度。v-html 重渲染
     *  后内联样式丢失，下个交互事件会重新回放；runtime state 是真相源。 */
    public _applyDomState(): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.querySelectorAll !== "function") {
            return;
        }
        // mark id 集合按 scene 缓存（非响应式 expando），任何 mark 前缀都覆盖，
        // 新 mark 类型不需要回这里补白名单。
        const bag = this as any;
        if (!bag.__markIdSet || bag.__markIdScene !== this.#semanticScene) {
            bag.__markIdSet = new Set(this._markNodes().map((n) => n.id));
            bag.__markIdScene = this.#semanticScene;
        }
        const markIds = bag.__markIdSet as Set<string>;
        // 受控选择集优先（宿主回灌的 selection prop）。
        const selected: Set<string> = this.selection !== null ? new Set(this.selection) : this.state ? this.state.selection.nodeIds : new Set<string>();
        const active = this._hoverId !== null || selected.size > 0;
        const nodes = root.querySelectorAll("[data-dvz-id]");
        const elements = Array.from(nodes);
        for (const el of elements) {
            const id = el.getAttribute("data-dvz-id") ?? "";
            // 图例项按显隐调透明度（隐藏 0.35，单独聚焦时非聚焦 0.35）。
            if (id.startsWith("legend:swatch:") || id.startsWith("legend:label:")) {
                const name = this._legendNameFromId(id);
                if (name !== null) {
                    const dim = this._isolatedSeries !== null ? this._isolatedSeries !== name : this._hiddenSeries.includes(name);
                    el.style.opacity = dim ? "0.35" : "1";
                }
                continue;
            }
            if (!markIds.has(id)) {
                continue;
            }
            const hot = id === this._hoverId || selected.has(id);
            el.style.opacity = !active || hot ? "1" : "0.35";
        }
    }
}

/** 快照第 r 行还原为行对象（图例过滤重建快照用）。 */
function rowOf(snap: DataSnapshot, r: number): Record<string, unknown> {
    const row: Record<string, unknown> = {};
    for (const col of snap.columns) {
        row[col.name] = col.values[r];
    }
    return row;
}

/** 射线法：点是否在闭合多边形内（漏斗 / 桑基流 / 山脊带命中）。 */
function pointInPolygon(px: number, py: number, pts: ReadonlyArray<Point2D>): boolean {
    let inside = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
        const a = pts[i];
        const b = pts[j];
        if (a.y > py !== b.y > py && px < ((b.x - a.x) * (py - a.y)) / (b.y - a.y) + a.x) {
            inside = !inside;
        }
    }
    return inside;
}

/** 点到线段的最短距离。 */
function segmentDistance(
    px: number,
    py: number,
    a: { x: number; y: number },
    b: { x: number; y: number },
): number {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const lengthSq = dx * dx + dy * dy;
    if (lengthSq === 0) return Math.hypot(px - a.x, py - a.y);
    let t = ((px - a.x) * dx + (py - a.y) * dy) / lengthSq;
    t = Math.max(0, Math.min(1, t));
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
}

/** 点到环形扇区的距离：内部为 0，外部为到最近边界的距离。 */
function sectorDistance(
    s: { cx: number; cy: number; rOuter: number; rInner: number; a0: number; a1: number },
    px: number,
    py: number,
): number {
    const dx = px - s.cx;
    const dy = py - s.cy;
    const r = Math.hypot(dx, dy);
    const twoPi = Math.PI * 2;
    // 把指针角度规范化进 [a0, a0+2π)，与扇区扫掠窗口直接可比。
    let ang = Math.atan2(dy, dx);
    while (ang < s.a0) ang += twoPi;
    while (ang >= s.a0 + twoPi) ang -= twoPi;
    const withinAngle = ang >= s.a0 && ang <= s.a1;
    if (withinAngle && r >= s.rInner && r <= s.rOuter) return 0;
    if (withinAngle) {
        // 角度在扫掠内：最近边界是外弧、内弧或（纯饼的）圆心。
        const candidates = [Math.abs(r - s.rOuter)];
        if (s.rInner > 0) candidates.push(Math.abs(r - s.rInner));
        else candidates.push(r);
        return Math.min(...candidates);
    }
    // 角度在扫掠外：最近边界是两条径向边之一。
    const edge = (a: number): number =>
        segmentDistance(
            px,
            py,
            { x: s.cx + s.rInner * Math.cos(a), y: s.cy + s.rInner * Math.sin(a) },
            { x: s.cx + s.rOuter * Math.cos(a), y: s.cy + s.rOuter * Math.sin(a) },
        );
    return Math.min(edge(s.a0), edge(s.a1));
}

/** 读取快照单元格。 */
function readCell(data: DataSnapshot, field: string, rowIndex: number): unknown {
    const col = data.columns.find((c) => c.name === field);
    return col ? col.values[rowIndex] : null;
}

/** zoom/pan 的缩放空间：log 域在对数轴上平移缩放，线性域原样。 */
function zoomSpace(kind: string | null, v: number): number {
    return kind === "log" ? Math.log(v) : v;
}

function fromZoomSpace(kind: string | null, z: number): number {
    return kind === "log" ? Math.exp(z) : z;
}

/** RGBA → CSS 颜色串（crosshair 点标记用）。 */
function rgbaCss(c: RGBA): string {
    return `rgba(${Math.round(c.r)}, ${Math.round(c.g)}, ${Math.round(c.b)}, ${c.a})`;
}

/** HTML 转义（数据表单元格 / caption）。 */
function escapeHtml(s: string): string {
    return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

/** 数值格式化成短标签（最多两位小数，去尾零）。 */
function formatCell(value: unknown): string {
    if (value === null || value === undefined) return "—";
    if (typeof value === "number") {
        if (!Number.isFinite(value)) return "—";
        const rounded = Math.round(value * 100) / 100;
        return String(Object.is(rounded, -0) ? 0 : rounded);
    }
    return String(value);
}
</script>
