    z-index: 2;
}
.vmz-ui-charts__diag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--vmz-surface-paper, #fff) 88%, transparent);
    max-height: 40%;
    overflow: auto;
    font-family: var(--vmz-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
