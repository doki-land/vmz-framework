<template>
    <div data-vmz-ui-charts="chart" @mousemove="_onMouseMove" @mouseleave="_onMouseLeave" @click="_onClick" @keydown="_onKeydown" class="vmz-ui-charts__chart" :style="hostStyle" :data-theme="_themeName()" tabindex="0" role="img" :aria-label="_ariaLabel()" :aria-describedby="_srId()">
        <div v-if="_isEmpty()" class="vmz-ui-charts__empty">
            No chart spec or data.
        </div>
        <div v-else>
            <div v-if="_hasError()" class="vmz-ui-charts__error-banner">
                Chart compile failed — see diagnostics below.
            </div>
            <div v-html="markup()" class="vmz-ui-charts__svg" />
        </div>
        <div v-if="diagnostics.length > 0" class="vmz-ui-charts__diag">
            <div v-for="(d, i) in diagnostics" :key="i" :data-sev="d.severity" class="vmz-ui-charts__diag-item">
                {{ d.severity }}
                :
                {{ d.message }}
            </div>
        </div>
        <div v-if="_tooltip.visible" class="vmz-ui-charts__tooltip" :style="_tooltipStyle()" aria-live="polite">
            {{ _tooltip.text }}
        </div>
        <div class="vmz-ui-charts__sr" :id="_srId()">{{ _summary() }}</div>
    </div>
</template>
<style>
.vmz-ui-charts__chart {
    display: block;
    background: var(--vmz-surface-paper, #ffffff);
    border: 1px solid var(--vmz-line-default, #e5e7eb);
    border-radius: 4px;
    overflow: hidden;
    box-sizing: border-box;
}
.vmz-ui-charts__chart[data-theme="dark"] {
    background: var(--vmz-surface-paper-dark, #0b1220);
    border-color: var(--vmz-line-default-dark, #1f2937);
}
.vmz-ui-charts__chart:focus-visible {
    outline: 2px solid #1677ff;
    outline-offset: 2px;
}
.vmz-ui-charts__chart[data-theme="dark"]:focus-visible {
    outline-color: #60a5fa;
}
.vmz-ui-charts__svg {
    width: 100%;
    height: 100%;
    display: block;
}
.vmz-ui-charts__svg svg {
    width: 100%;
    height: 100%;
    display: block;
    animation: vmz-charts-in 0.24s ease-out;
}
.vmz-ui-charts__svg svg [data-dvz-id] {
    transition: opacity 0.15s ease;
}
@keyframes vmz-charts-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
}
@media (prefers-reduced-motion: reduce) {
    .vmz-ui-charts__svg svg { animation: none; }
    .vmz-ui-charts__svg svg [data-dvz-id] { transition: none; }
}
.vmz-ui-charts__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vmz-text-muted, #6b7280);
    font-size: 0.875rem;
}
.vmz-ui-charts__error-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: #b91c1c;
    color: #fff;
    font-size: 0.75rem;
    padding: 4px 8px;
    z-index: 2;
}
.vmz-ui-charts__diag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--vmz-surface-paper, #fff) 88%, transparent);
    max-height: 40%;
    overflow: auto;
    font-family: var(--vmz-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-top: 1px solid var(--vmz-line-default, #e5e5e5);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag {
    background: color-mix(in srgb, var(--vmz-surface-paper-dark, #0b1220) 88%, transparent);
    border-top-color: var(--vmz-line-default-dark, #1f2937);
    color: #e5e7eb;
}
.vmz-ui-charts__diag-item {
    padding: 1px 0;
}
.vmz-ui-charts__diag-item[data-sev="error"] {
    color: #b91c1c;
}
.vmz-ui-charts__diag-item[data-sev="warning"] {
    color: #b7791f;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="error"] {
    color: #f87171;
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="warning"] {
    color: #fbbf24;
}
.vmz-ui-charts__tooltip {
    position: absolute;
    z-index: 999;
    pointer-events: none;
    background: rgba(17, 24, 39, 0.92);
    color: #f9fafb;
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 4px 8px;
    border-radius: 4px;
    transform: translate(10px, 10px);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.vmz-ui-charts__chart[data-theme="dark"] .vmz-ui-charts__tooltip {
    background: rgba(249, 250, 251, 0.95);
    color: #111827;
}
.vmz-ui-charts__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
}
</style>
<script client>
/**
 * VMZ UI Charts — Chart 组件。
 *
 * 作者面：
 *   <Chart :spec="{...}" :data="[...]" theme="light|dark|auto" label="…" />
 *
 * 管线：ChartSpec + DataSnapshot → compile → scene builder（视口像素）→
 * resolve → DisplayScene → 宿主 SVG 渲染。组件只做 Vue 绑定、容器尺寸、
 * 生命周期、平台输入与可访问呈现，不重新计算统计 / 比例尺 / 主题。
 *
 * 交互：pointer / 键盘命中测试直接读 SemanticScene 几何，tooltip 展示真实
 * 行数据；选择事件指向稳定行 key。高亮经 `data-dvz-id` DOM 钩子回放，
 * canonical scene 不携带交互状态。
 */
import {
    DARK_CHART_THEME,
    DEFAULT_CHART_THEME,
    buildScene,
    compile,
    fromRows,
    type ChartCompilePlan,
    type ChartSpec,
    type ChartTheme,
    type DataSnapshot,
} from "@doki-land/davinci/chart";
import {
    renderSvg,
    resolve,
    resolveResourceIdPrefix,
    type DisplayScene,
    type SemanticNode,
    type SemanticScene,
} from "@doki-land/davinci/scene";
import { initialState, reduce, type RuntimeState, type Action } from "@doki-land/davinci/runtime";
import type { Point2D } from "@doki-land/davinci/types";

const FALLBACK_WIDTH = 640;
const FALLBACK_HEIGHT = 360;
const HIT_TOLERANCE_PX = 8;

export default class Chart {
    /** DaVinci ChartSpec（mark + encoding）。 */
    public spec: ChartSpec | null = null;
    /** 原始数据（行数组）。优先于 snapshot。 */
    public data: Record<string, unknown>[] | null = null;
    /** 预构建 DataSnapshot（与 data 二选一）。 */
    public snapshot: DataSnapshot | null = null;
    /** 显式宽度。null 时跟随容器测量，测量前退回 FALLBACK_WIDTH。 */
    public width: number | null = null;
    /** 显式高度。null 时跟随容器测量，测量前退回 FALLBACK_HEIGHT。 */
    public height: number | null = null;
    /** 主题："light" | "dark" | "auto"。auto 在客户端跟随系统，SSR 为 light。 */
    public theme: string | null = null;
    /** 可访问名称。缺省时从 spec 派生一句话摘要。 */
    public label: string | null = null;
    /** 宿主显式提供的 SVG 资源 id 前缀。null 时从声明式输入确定性派生，
     *  同页多实例不撞 id；需要绝对唯一（例如同 spec 重复内联）时由宿主传入。 */
    public resourceIdPrefix: string | null = null;

    /** 交互 runtime state。 */
    public state: RuntimeState | null = null;
    /** `compile` 产出的只读诊断（code / severity / message），宿主只读展示。 */
    public diagnostics: ReadonlyArray<{ severity: string; code: string; message: string }> = [];

    // ---- 交互与生命周期内部字段 ----

    /** 每次 scene() 计算递增。异步返回时先比对再应用，为未来异步管线预留。 */
    public _latestRevision: number = 0;
    /** ResizeObserver 实例，onMount 创建 onUnmount 断开。 */
    public _resizeObserver: ResizeObserver | null = null;
    /** auto 主题的 matchMedia 状态。 */
    public _themeMedia: { matches: boolean } | null = null;
    /** 容器测量尺寸（width/height 为 null 时由 ResizeObserver 回写）。 */
    public _measuredWidth: number | null = null;
    public _measuredHeight: number | null = null;
    /** 渲染期缓存：最近一次编译产物，命中测试直接读，不重编译。 */
    public _semanticScene: SemanticScene | null = null;
    public _plan: ChartCompilePlan | null = null;
    /** 当前 hover / 键盘聚焦的 mark id。 */
    public _hoverId: string | null = null;
    /** 键盘聚焦索引（marks 顺序）。 */
    public _focusIndex: number = -1;
    /** Tooltip 状态。 */
    public _tooltip: { visible: boolean; x: number; y: number; text: string } = {
        visible: false,
        x: 0,
        y: 0,
        text: "",
    };

    // ---- 尺寸与主题 ----

    public _effWidth(): number {
        if (this.width !== null && Number.isFinite(this.width) && this.width > 0) return this.width;
        if (this._measuredWidth !== null && this._measuredWidth > 0) return this._measuredWidth;
        return FALLBACK_WIDTH;
    }

    public _effHeight(): number {
        if (this.height !== null && Number.isFinite(this.height) && this.height > 0) return this.height;
        if (this._measuredHeight !== null && this._measuredHeight > 0) return this._measuredHeight;
        return FALLBACK_HEIGHT;
    }

    public _themeName(): string {
        if (this.theme === "dark") return "dark";
        if (this.theme === "auto" && this._themeMedia && this._themeMedia.matches) return "dark";
        return "light";
    }

    public _chartTheme(): ChartTheme {
        return this._themeName() === "dark" ? DARK_CHART_THEME : DEFAULT_CHART_THEME;
    }

    /** 零尺寸 guard —— 宽或高为 0 时跳过渲染避免 NaN / 空 SVG 闪烁。 */
    public _zeroSize(): boolean {
        return this._effWidth() <= 0 || this._effHeight() <= 0;
    }

    /** 空态判断 —— spec 或数据均缺失时渲染空态面板。 */
    public _isEmpty(): boolean {
        if (!this.spec) return true;
        const hasData = !!(this.snapshot || (this.data && this.data.length > 0));
        return !hasData;
    }

    /** 编译错误判断 —— diagnostics 中存在 severity="error"。 */
    public _hasError(): boolean {
        return this.diagnostics.some((d) => d.severity === "error");
    }

    // ---- 渲染管线 ----

    /** 计算属性：spec / data / 尺寸变化时重新编译并解析为 DisplayScene。 */
    public scene(): DisplayScene | null {
        this._latestRevision++;
        if (this._zeroSize()) {
            this.diagnostics = [];
            this._semanticScene = null;
            this._plan = null;
            return null;
        }
        const snapshot = this.snapshot ?? (this.data ? fromRows(this.data) : null);
        if (!this.spec || !snapshot) {
            this.diagnostics = [];
            this._semanticScene = null;
            this._plan = null;
            return null;
        }
        const plan = compile(this.spec, snapshot);
        this.diagnostics = plan.diagnostics.items.map((d) => ({
            severity: d.severity,
            code: d.code,
            message: d.message,
        }));
        const w = this._effWidth();
        const h = this._effHeight();
        const semantic = buildScene(plan, { width: w, height: h }, { theme: this._chartTheme() });
        this._semanticScene = semantic;
        this._plan = plan;
        // preserveNodeIds：交互宿主把 DOM 元素绑回稳定身份；SSR 输出同样
        // 携带 `data-dvz-id`，水合后高亮路径一致。
        return resolve(semantic, { width: w, height: h, preserveNodeIds: true });
    }

    /** SVG 资源 id 前缀 —— 显式 prop 优先，否则从声明式输入（spec + 数据）
     *  确定性派生。SSR 与客户端对同一输入再生同一前缀，不同 spec 天然不撞 id。 */
    public _resourcePrefix(): string {
        const identity = {
            mark: this.spec?.mark ?? null,
            encoding: this.spec?.encoding ?? null,
            keyField: this.spec?.keyField ?? null,
            facetField: this.spec?.facetField ?? null,
            scales: this.spec?.scales ? Array.from(this.spec.scales.entries()) : null,
            data: this.data ?? this.snapshot?.columns ?? null,
        };
        return resolveResourceIdPrefix("davinci-chart", identity, this.resourceIdPrefix);
    }

    /** DisplayScene → 确定性 SVG markup（SSR 安全，无 DOM API）。 */
    public markup(): string {
        if (this._zeroSize()) return "";
        const scene = this.scene();
        return scene ? renderSvg(scene, { resourceIdPrefix: this._resourcePrefix() }) : "";
    }

    public get hostStyle(): string {
        const w = this._effWidth();
        const h = this._effHeight();
        const widthCss = this.width !== null ? `width:${w}px;` : "width:100%;";
        return `${widthCss}height:${h}px;position:relative;`;
    }

    // ---- 可访问呈现 ----

    public _srId(): string {
        return `${this._resourcePrefix()}summary`;
    }

    public _markCount(): number {
        return this._plan ? this._plan.marks.length : 0;
    }

    public _ariaLabel(): string {
        if (this.label) return this.label;
        const mark = this.spec ? String(this.spec.mark) : "chart";
        return `${mark} chart`;
    }

    public _summary(): string {
        if (this._isEmpty()) return "Empty chart.";
        const count = this._markCount();
        const series = this._plan && this._plan.series.field !== null ? `, ${this._plan.series.categories.length} series` : "";
        return `${this._ariaLabel()} with ${count} marks${series}.`;
    }

    // ---- 生命周期 ----

    onMount() {
        this.state = initialState(this._effWidth(), this._effHeight());
        this._attachResizeObserver();
        this._attachThemeMedia();
    }

    onUnmount() {
        this._detachResizeObserver();
        this._detachThemeMedia();
    }

    public _attachThemeMedia(): void {
        if (this.theme !== "auto") return;
        if (typeof matchMedia !== "function") return;
        const media = matchMedia("(prefers-color-scheme: dark)");
        this._themeMedia = { matches: media.matches };
    }

    public _detachThemeMedia(): void {
        this._themeMedia = null;
    }

    public _attachResizeObserver(): void {
        if (typeof ResizeObserver === "undefined") return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof (root as any).getBoundingClientRect !== "function") return;
        const ro = new ResizeObserver((entries) => {
            for (const entry of entries) {
                const cr = (entry as any).contentRect as DOMRectReadOnly | undefined;
                if (!cr) continue;
                const w = Math.round(cr.width);
                const h = Math.round(cr.height);
                // 只有 auto 维度跟随容器；显式 prop 永远优先。
                if (this.width === null && w > 0 && w !== this._measuredWidth) this._measuredWidth = w;
                if (this.height === null && h > 0 && h !== this._measuredHeight) this._measuredHeight = h;
                if (this.state) {
                    this.state = reduce(this.state, { kind: "container-resize", w, h });
                }
            }
        });
        ro.observe(root);
        this._resizeObserver = ro;
    }

    public _detachResizeObserver(): void {
        if (this._resizeObserver) {
            this._resizeObserver.disconnect();
            this._resizeObserver = null;
        }
    }

    /** 派发交互 action → 返回新 runtime state。 */
    public dispatch(action: Action): RuntimeState | null {
        if (!this.state) return null;
        this.state = reduce(this.state, action);
        return this.state;
    }

    // ---- 命中测试（读渲染期缓存的 SemanticScene，不重编译） ----

    /** 渲染坐标 → scene 坐标的缩放（SVG 可能被 CSS 拉伸）。 */
    public _toScenePoint(ev: MouseEvent) {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root) {
            return null;
        }
        const rect = root.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) {
            return null;
        }
        return {
            x: ((ev.clientX - rect.left) / rect.width) * this._effWidth(),
            y: ((ev.clientY - rect.top) / rect.height) * this._effHeight(),
        };
    }

    /** 收集 mark 节点（直接子级，role=chart.mark）。 */
    public _markNodes(): SemanticNode[] {
        if (!this._semanticScene) {
            return [];
        }
        return this._semanticScene.root.children.filter((n) => n.role === "chart.mark");
    }

    /** 命中测试：返回最近的 mark 稳定 id，未命中返回 null。 */
    public _hitTest(px: number, py: number): string | null {
        let bestId: string | null = null;
        let bestDist: number = Number.POSITIVE_INFINITY;
        for (const node of this._markNodes()) {
            const dist = this._distanceTo(node, px, py);
            if (dist === null || dist > HIT_TOLERANCE_PX) {
                continue;
            }
            if (bestId === null || dist < bestDist) {
                bestId = node.id;
                bestDist = dist;
            }
        }
        return bestId;
    }

    /** 点到单个 mark 的距离（rect/ellipse 内部为 0，path 为到折线段距离）。 */
    public _distanceTo(node: SemanticNode, px: number, py: number): number | null {
        // 显式扇形命中区（pie / donut 切片）优先于几何近似。
        if (node.hitRegion && "sector" in node.hitRegion) {
            return sectorDistance(node.hitRegion.sector, px, py);
        }
        if (node.kind === "rect") {
            const inside = px >= node.x && px <= node.x + node.w && py >= node.y && py <= node.y + node.h;
            if (inside) {
                return 0;
            }
            const dx = Math.max(node.x - px, 0, px - (node.x + node.w));
            const dy = Math.max(node.y - py, 0, py - (node.y + node.h));
            return Math.hypot(dx, dy);
        }
        if (node.kind === "ellipse") {
            const radial = Math.hypot(px - node.cx, py - node.cy);
            return Math.max(0, radial - node.rx);
        }
        if (node.kind === "path") {
            const points = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") {
                    points.push(cmd.to);
                }
            }
            let best: number | null = null;
            for (let i = 1; i < points.length; i++) {
                const d = segmentDistance(px, py, points[i - 1], points[i]);
                if (best === null || d < best) {
                    best = d;
                }
            }
            return best;
        }
        return null;
    }

    // ---- Tooltip（真实行数据） ----

    /** 从 mark id 还原 tooltip 文本：series + x/y 字段真实值。 */
    public _tooltipTextFor(id: string): string {
        const plan = this._plan;
        if (!plan || !this.spec) return id;
        const markKind = String(this.spec.mark);
        const xEnc = this.spec.encoding.find((e) => e.channel === "x");
        const yEnc = this.spec.encoding.find((e) => e.channel === "y");
        // line / area 的 id 是 series 名；bar / point 是行 key。
        const mark = plan.marks.find((m) => `${markKind}:${m.key}` === id);
        if (mark) {
            const rowIndex = mark.rowIndex;
            const parts: string[] = [];
            if (mark.series !== null) parts.push(mark.series);
            if (markKind === "pie") {
                // pie 切片报 theta 原值与真实占比（对正切片求和）。
                const thetaEnc = this.spec.encoding.find((e) => e.channel === "theta");
                if (thetaEnc) {
                    const value = readCell(plan.resolvedData, thetaEnc.field, rowIndex);
                    parts.push(`${thetaEnc.field}: ${formatCell(value)}`);
                    let total = 0;
                    for (const m of plan.marks) {
                        const v = readCell(plan.resolvedData, thetaEnc.field, m.rowIndex);
                        if (typeof v === "number" && Number.isFinite(v) && v > 0) total += v;
                    }
                    if (typeof value === "number" && total > 0) {
                        parts.push(`${Math.round((value / total) * 1000) / 10}%`);
                    }
                }
                return parts.length > 0 ? parts.join(" · ") : id;
            }
            if (xEnc) parts.push(`${xEnc.field}: ${formatCell(readCell(plan.resolvedData, xEnc.field, rowIndex))}`);
            if (yEnc) parts.push(`${yEnc.field}: ${formatCell(readCell(plan.resolvedData, yEnc.field, rowIndex))}`);
            return parts.length > 0 ? parts.join(" · ") : id;
        }
        if (id.startsWith("line:") || id.startsWith("area:")) {
            return id.slice(id.indexOf(":") + 1);
        }
        if (id.startsWith("radar-series:")) {
            return id.slice("radar-series:".length);
        }
        return id;
    }

    /** mark 节点在 scene 坐标里的锚点（tooltip / 键盘定位用）。 */
    public _nodeAnchor(id: string): Point2D | null {
        const node = this._markNodes().find((n) => n.id === id);
        if (!node) return null;
        // 扇形切片的锚点在中角中半径处。
        if (node.hitRegion && "sector" in node.hitRegion) {
            const s = node.hitRegion.sector;
            const mid = (s.a0 + s.a1) / 2;
            const r = (s.rInner + s.rOuter) / 2;
            return { x: s.cx + r * Math.cos(mid), y: s.cy + r * Math.sin(mid) };
        }
        if (node.kind === "rect") return { x: node.x + node.w / 2, y: node.y };
        if (node.kind === "ellipse") return { x: node.cx, y: node.cy - node.ry };
        if (node.kind === "path") {
            const pts = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") pts.push(cmd.to);
            }
            if (pts.length === 0) return null;
            return pts[Math.floor(pts.length / 2)];
        }
        return null;
    }

    // ---- Pointer 交互 ----

    /** 宿主可 override 的 hover 回调（事件名 `chart-hover`）。 */
    public onchartHover(payload: { rowKey: string | number; x: number; y: number }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onMouseMove(ev: MouseEvent): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root) return;
        const rect = root.getBoundingClientRect();
        this._tooltip.x = ev.clientX - rect.left;
        this._tooltip.y = ev.clientY - rect.top;
        const point = this._toScenePoint(ev);
        const hit = point ? this._hitTest(point.x, point.y) : null;
        this._hoverId = hit;
        if (hit) {
            this._tooltip.text = this._tooltipTextFor(hit);
            this._tooltip.visible = true;
            this.dispatch({ kind: "hover", nodeId: hit });
            this.onchartHover({ rowKey: hit, x: this._tooltip.x, y: this._tooltip.y });
        } else {
            this._tooltip.visible = false;
            this.dispatch({ kind: "hover", nodeId: null });
        }
        this._focusIndex = hit ? this._markNodes().findIndex((n) => n.id === hit) : -1;
        this._applyDomState();
    }
    public _onMouseLeave(): void {
        this._tooltip.visible = false;
        this._hoverId = null;
        this.dispatch({ kind: "hover", nodeId: null });
        this._applyDomState();
    }

    public _tooltipStyle(): string {
        return `left:${this._tooltip.x}px;top:${this._tooltip.y}px`;
    }

    // ---- Click → select dispatch + emit ----

    /** 宿主可 override 的选择回调（事件名 `chart-select`）。 */
    public onchartSelect(payload: { rowKey: string | number }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onClick(ev: MouseEvent): void {
        if (!this.state) return;
        const point = this._toScenePoint(ev);
        const hit = point ? this._hitTest(point.x, point.y) : null;
        if (!hit) {
            this.dispatch({ kind: "clear-selection" });
            this._applyDomState();
            return;
        }
        this.dispatch({ kind: "select-toggle", nodeId: hit });
        this.onchartSelect({ rowKey: hit });
        this._applyDomState();
    }

    // ---- 键盘等价入口 ----

    public _onKeydown(ev: KeyboardEvent): void {
        const marks = this._markNodes();
        if (marks.length === 0) return;
        if (ev.key === "ArrowRight" || ev.key === "ArrowDown") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex + 1) % marks.length;
            this._focusMark(marks[this._focusIndex].id);
        } else if (ev.key === "ArrowLeft" || ev.key === "ArrowUp") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex - 1 + marks.length) % marks.length;
            this._focusMark(marks[this._focusIndex].id);
        } else if (ev.key === "Enter" || ev.key === " ") {
            if (this._hoverId) {
                ev.preventDefault();
                this.dispatch({ kind: "select-toggle", nodeId: this._hoverId });
                this.onchartSelect({ rowKey: this._hoverId });
                this._applyDomState();
            }
        } else if (ev.key === "Escape") {
            this._hoverId = null;
            this._focusIndex = -1;
            this._tooltip.visible = false;
            this.dispatch({ kind: "clear-selection" });
            this._applyDomState();
        }
    }

    /** 键盘聚焦某个 mark：tooltip 锚到节点位置，状态与 pointer 路径一致。 */
    public _focusMark(id: string): void {
        this._hoverId = id;
        const anchor = this._nodeAnchor(id);
        if (anchor) {
            const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
            const rect = root ? root.getBoundingClientRect() : null;
            const scaleX = rect && rect.width > 0 ? rect.width / this._effWidth() : 1;
            const scaleY = rect && rect.height > 0 ? rect.height / this._effHeight() : 1;
            this._tooltip.x = anchor.x * scaleX;
            this._tooltip.y = anchor.y * scaleY;
            this._tooltip.text = this._tooltipTextFor(id);
            this._tooltip.visible = true;
        }
        this.dispatch({ kind: "hover", nodeId: id });
        this._applyDomState();
    }

    // ---- DOM 高亮回放（交互状态不进 canonical scene） ----

    /** 把 hover / selection 映射到 `data-dvz-id` 元素透明度。v-html 重渲染
     *  后内联样式丢失，下个交互事件会重新回放；runtime state 是真相源。 */
    public _applyDomState(): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.querySelectorAll !== "function") {
            return;
        }
        const selected = this.state ? this.state.selection.nodeIds : new Set<string>();
        const active = this._hoverId !== null || selected.size > 0;
        const markPrefix = `${this.spec ? String(this.spec.mark) : "bar"}:`;
        const nodes = root.querySelectorAll("[data-dvz-id]");
        const elements = Array.from(nodes);
        for (const el of elements) {
            const id = el.getAttribute("data-dvz-id") ?? "";
            const isMark =
                id.startsWith(markPrefix) ||
                id.startsWith("line:") ||
                id.startsWith("area:") ||
                id.startsWith("point:") ||
                id.startsWith("circle:") ||
                id.startsWith("rect:") ||
                id.startsWith("bar:");
            if (!isMark) {
                continue;
            }
            const hot = id === this._hoverId || selected.has(id);
            el.style.opacity = !active || hot ? "1" : "0.35";
        }
    }
}

/** 点到线段的最短距离。 */
function segmentDistance(
    px: number,
    py: number,
    a: { x: number; y: number },
    b: { x: number; y: number },
): number {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const lengthSq = dx * dx + dy * dy;
    if (lengthSq === 0) return Math.hypot(px - a.x, py - a.y);
    let t = ((px - a.x) * dx + (py - a.y) * dy) / lengthSq;
    t = Math.max(0, Math.min(1, t));
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
}

/** 点到环形扇区的距离：内部为 0，外部为到最近边界的距离。 */
function sectorDistance(
    s: { cx: number; cy: number; rOuter: number; rInner: number; a0: number; a1: number },
    px: number,
    py: number,
): number {
    const dx = px - s.cx;
    const dy = py - s.cy;
    const r = Math.hypot(dx, dy);
    const twoPi = Math.PI * 2;
    // 把指针角度规范化进 [a0, a0+2π)，与扇区扫掠窗口直接可比。
    let ang = Math.atan2(dy, dx);
    while (ang < s.a0) ang += twoPi;
    while (ang >= s.a0 + twoPi) ang -= twoPi;
    const withinAngle = ang >= s.a0 && ang <= s.a1;
    if (withinAngle && r >= s.rInner && r <= s.rOuter) return 0;
    if (withinAngle) {
        // 角度在扫掠内：最近边界是外弧、内弧或（纯饼的）圆心。
        const candidates = [Math.abs(r - s.rOuter)];
        if (s.rInner > 0) candidates.push(Math.abs(r - s.rInner));
        else candidates.push(r);
        return Math.min(...candidates);
    }
    // 角度在扫掠外：最近边界是两条径向边之一。
    const edge = (a: number): number =>
        segmentDistance(
            px,
            py,
            { x: s.cx + s.rInner * Math.cos(a), y: s.cy + s.rInner * Math.sin(a) },
            { x: s.cx + s.rOuter * Math.cos(a), y: s.cy + s.rOuter * Math.sin(a) },
        );
    return Math.min(edge(s.a0), edge(s.a1));
}

/** 读取快照单元格。 */
function readCell(data: DataSnapshot, field: string, rowIndex: number): unknown {
    const col = data.columns.find((c) => c.name === field);
    return col ? col.values[rowIndex] : null;
}

/** 数值格式化成短标签（最多两位小数，去尾零）。 */
function formatCell(value: unknown): string {
    if (value === null || value === undefined) return "—";
    if (typeof value === "number") {
        if (!Number.isFinite(value)) return "—";
        const rounded = Math.round(value * 100) / 100;
        return String(Object.is(rounded, -0) ? 0 : rounded);
    }
    return String(value);
}
</script>
