<template>
    <div data-vmz-ui-charts="diagram" @mousemove="_onMouseMove" @mouseleave="_onMouseLeave" @click="_onClick" @keydown="_onKeydown" :data-theme="_themeName()" tabindex="0" role="img" :aria-label="_ariaLabel()" :aria-describedby="_srId()" class="vmz-ui-charts__diagram" :style="hostStyle">
        <div v-if="_isEmpty()" class="vmz-ui-charts__empty">
            No diagram spec.
        </div>
        <div v-else>
            <div v-if="_hasError()" class="vmz-ui-charts__error-banner">
                Diagram layout failed — see diagnostics below.
            </div>
            <div v-html="markup()" class="vmz-ui-charts__svg" />
        </div>
        <div v-if="diagnostics.length > 0" class="vmz-ui-charts__diag">
            <div v-for="(d, i) in diagnostics" :key="i" :data-sev="d.severity" class="vmz-ui-charts__diag-item">
                {{ d.severity }}
                :
                {{ d.message }}
            </div>
        </div>
        <div v-if="_tooltip.visible" aria-live="polite" class="vmz-ui-charts__tooltip" :style="_tooltipStyle()">
            {{ _tooltip.text }}
        </div>
        <div :id="_srId()" class="vmz-ui-charts__sr">
            {{ _summary() }}
        </div>
    </div>
</template>
<style>
.vmz-ui-charts__diagram {
    display: block;
    background: var(--vmz-surface-paper, #ffffff);
    border: 1px solid var(--vmz-line-default, #e5e7eb);
    border-radius: 4px;
    overflow: hidden;
    box-sizing: border-box;
}
.vmz-ui-charts__diagram[data-theme="dark"] {
    background: var(--vmz-surface-paper, #0b1220);
    border-color: var(--vmz-line-default, #1f2937);
}
.vmz-ui-charts__diagram:focus-visible {
    outline: 2px solid var(--vmz-brand-primary, #1677ff);
    outline-offset: 2px;
}
.vmz-ui-charts__diagram[data-theme="dark"]:focus-visible {
    outline-color: var(--vmz-brand-primary, #60a5fa);
}
.vmz-ui-charts__diagram .vmz-ui-charts__svg {
    width: 100%;
    height: 100%;
    display: block;
}
.vmz-ui-charts__diagram .vmz-ui-charts__svg svg {
    width: 100%;
    height: 100%;
    display: block;
    animation: vmz-diagram-in 0.24s ease-out;
}
.vmz-ui-charts__diagram .vmz-ui-charts__svg svg [data-dvz-id] {
    transition: opacity 0.15s ease;
}
@keyframes vmz-diagram-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: none;
    }
}
@media (prefers-reduced-motion: reduce) {
    .vmz-ui-charts__diagram .vmz-ui-charts__svg svg {
        animation: none;
    }
    .vmz-ui-charts__diagram .vmz-ui-charts__svg svg [data-dvz-id] {
        transition: none;
    }
}
.vmz-ui-charts__diagram .vmz-ui-charts__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vmz-text-muted, #6b7280);
    font-size: 0.875rem;
}
.vmz-ui-charts__diagram .vmz-ui-charts__error-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--vmz-status-danger-foreground, #b91c1c);
    color: #fff;
    font-size: 0.75rem;
    padding: 4px 8px;
    z-index: 2;
}
.vmz-ui-charts__diagram .vmz-ui-charts__diag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--vmz-surface-paper, #fff) 88%, transparent);
    max-height: 40%;
    overflow: auto;
    font-family: var(--vmz-font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-top: 1px solid var(--vmz-line-default, #e5e5e5);
}
.vmz-ui-charts__diagram[data-theme="dark"] .vmz-ui-charts__diag {
    background: color-mix(in srgb, var(--vmz-surface-paper, #0b1220) 88%, transparent);
    border-top-color: var(--vmz-line-default, #1f2937);
    color: #e5e7eb;
}
.vmz-ui-charts__diagram .vmz-ui-charts__diag-item {
    padding: 1px 0;
}
.vmz-ui-charts__diagram .vmz-ui-charts__diag-item[data-sev="error"] {
    color: var(--vmz-status-danger-foreground, #b91c1c);
}
.vmz-ui-charts__diagram .vmz-ui-charts__diag-item[data-sev="warning"] {
    color: var(--vmz-status-warning-foreground, #b7791f);
}
.vmz-ui-charts__diagram[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="error"] {
    color: var(--vmz-status-danger-foreground, #f87171);
}
.vmz-ui-charts__diagram[data-theme="dark"] .vmz-ui-charts__diag-item[data-sev="warning"] {
    color: var(--vmz-status-warning-foreground, #fbbf24);
}
.vmz-ui-charts__diagram .vmz-ui-charts__tooltip {
    position: absolute;
    z-index: 999;
    pointer-events: none;
    background: rgba(17, 24, 39, 0.92);
    color: #f9fafb;
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 4px 8px;
    border-radius: 4px;
    transform: translate(10px, 10px);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.vmz-ui-charts__diagram[data-theme="dark"] .vmz-ui-charts__tooltip {
    background: rgba(249, 250, 251, 0.95);
    color: #111827;
}
.vmz-ui-charts__diagram .vmz-ui-charts__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
}
</style>
<script client>
/**
 * VMZ UI Charts — Diagram 组件。
 *
 * 作者面：
 *   <Diagram :spec="{...nodes, edges...}" direction="LR" theme="light|dark|auto" />
 *
 * 管线：DiagramSpec → simpleLayout → buildScene → resolve → DisplayScene →
 * `@doki-land/davinci/scene` 的 SVG 串行化。组件只做绑定、容器尺寸、生命
 * 周期与可访问呈现，不画形状。
 *
 * 交互：pointer / 键盘命中测试直接读 SemanticScene 节点边界与边几何，
 * tooltip 展示真实节点 / 边标签；选择事件指向 spec 里的稳定 id。
 */
import {
    DARK_DIAGRAM_THEME,
    DEFAULT_DIAGRAM_THEME,
    buildScene as buildDiagramScene,
    simpleLayout,
    type DiagramSpec,
    type DiagramTheme,
} from "@doki-land/davinci/diagram";
import {
    renderSvg,
    resolve,
    resolveResourceIdPrefix,
    type DisplayScene,
    type SemanticNode,
    type SemanticScene,
} from "@doki-land/davinci/scene";
import { initialState, reduce, type RuntimeState, type Action } from "@doki-land/davinci/runtime";
import type { Point2D } from "@doki-land/davinci/types";

const HIT_TOLERANCE_PX = 8;

export default class Diagram {
    /** DiagramSpec（nodes / edges / clusters）。 */
    public spec: DiagramSpec | null = null;
    /** 布局方向（覆盖 spec.direction）。 */
    public direction: "LR" | "RL" | "TB" | "BT" | null = null;
    /** 主题："light" | "dark" | "auto"。auto 在客户端跟随系统，SSR 为 light。 */
    public theme: string | null = null;
    /** 可访问名称。缺省时派生一句话摘要。 */
    public label: string | null = null;
    /** 宿主显式提供的 SVG 资源 id 前缀。null 时从声明式输入确定性派生，
     *  同页多实例不撞 id；需要绝对唯一时由宿主传入。 */
    public resourceIdPrefix: string | null = null;

    public scene: DisplayScene | null = null;
    public state: RuntimeState | null = null;
    public diagnostics: ReadonlyArray<{ severity: string; code: string; message: string }> = [];

    // ---- 交互与生命周期内部字段 ----

    /** 每次 recompile 递增。异步返回时先比对再应用，为未来异步管线预留。 */
    public _latestRevision: number = 0;
    /** ResizeObserver 实例，onMount 创建 onUnmount 断开（autoSize 下仅同步容器 state）。 */
    public _resizeObserver: ResizeObserver | null = null;
    /** auto 主题的 matchMedia 状态。 */
    public _themeMedia: { matches: boolean } | null = null;
    /** 渲染期缓存：命中测试直接读，不重布局。 */
    public _semanticScene: SemanticScene | null = null;
    /** 当前 hover / 键盘聚焦的节点或边 id。 */
    public _hoverId: string | null = null;
    /** 键盘聚焦索引（节点顺序）。 */
    public _focusIndex: number = -1;
    /** Tooltip 状态。 */
    public _tooltip: { visible: boolean; x: number; y: number; text: string } = {
        visible: false,
        x: 0,
        y: 0,
        text: "",
    };

    public _themeName(): string {
        if (this.theme === "dark") return "dark";
        if (this.theme === "auto" && this._themeMedia && this._themeMedia.matches) return "dark";
        return "light";
    }

    public _diagramTheme(): DiagramTheme {
        return this._themeName() === "dark" ? DARK_DIAGRAM_THEME : DEFAULT_DIAGRAM_THEME;
    }

    /** 零尺寸 guard —— 宽或高为 0 时跳过渲染避免 NaN。 */
    public _zeroSize(): boolean {
        const w = this.scene ? this.scene.width : 0;
        const h = this.scene ? this.scene.height : 0;
        return w <= 0 || h <= 0;
    }

    /** 空态判断 —— spec 缺失时渲染空态面板。 */
    public _isEmpty(): boolean {
        return !this.spec;
    }

    /** 编译错误判断 —— diagnostics 中存在 severity="error"。 */
    public _hasError(): boolean {
        return this.diagnostics.some((d) => d.severity === "error");
    }

    public get hostStyle(): string {
        const w = this.scene ? this.scene.width : 0;
        const h = this.scene ? this.scene.height : 0;
        return `width:100%;max-width:${Math.ceil(w)}px;height:${h}px;position:relative;`;
    }

    /** SVG 资源 id 前缀 —— 显式 prop 优先，否则从声明式输入（spec + direction）
     *  确定性派生。SSR 与客户端对同一输入再生同一前缀，不同 spec 天然不撞 id。 */
    public _resourcePrefix(): string {
        const identity = { spec: this.spec, direction: this.direction };
        return resolveResourceIdPrefix("davinci-diagram", identity, this.resourceIdPrefix);
    }

    /** DisplayScene → 确定性 SVG markup（SSR 安全，无 DOM API）。 */
    public markup(): string {
        this._ensureCompiled();
        if (this._zeroSize()) return "";
        return this.scene ? renderSvg(this.scene, { resourceIdPrefix: this._resourcePrefix() }) : "";
    }

    // ---- 可访问呈现 ----

    public _srId(): string {
        return `${this._resourcePrefix()}summary`;
    }

    public _ariaLabel(): string {
        if (this.label) return this.label;
        return this.spec ? `${this.spec.kind} diagram` : "diagram";
    }

    public _summary(): string {
        if (!this.spec) return "Empty diagram.";
        return `${this._ariaLabel()} with ${this.spec.nodes.length} nodes and ${this.spec.edges.length} edges.`;
    }

    // ---- 生命周期 ----

    onMount() {
        this._ensureCompiled();
        this.state = initialState(this.scene ? this.scene.width : 0, this.scene ? this.scene.height : 0);
        this._attachResizeObserver();
        this._attachThemeMedia();
    }

    onUnmount() {
        this._detachResizeObserver();
        this._themeMedia = null;
    }

    public _attachThemeMedia(): void {
        if (this.theme !== "auto") return;
        if (typeof matchMedia !== "function") return;
        const media = matchMedia("(prefers-color-scheme: dark)");
        this._themeMedia = { matches: media.matches };
    }

    /** SSR 与首渲染共用：spec 就绪而 scene 未建时同步编译一次。 */
    public _ensureCompiled(): void {
        if (!this.spec) {
            this.scene = null;
            this._semanticScene = null;
            this.diagnostics = [];
            return;
        }
        if (this.scene && this._semanticScene) return;
        this.recompile();
    }

    public recompile() {
        this._latestRevision++;
        if (!this.spec) {
            this.scene = null;
            this._semanticScene = null;
            this.diagnostics = [];
            return;
        }
        const effectiveSpec: DiagramSpec = this.direction ? { ...this.spec, direction: this.direction } : this.spec;
        const plan = simpleLayout(effectiveSpec);
        this.diagnostics = plan.diagnostics.items.map((d) => ({
            severity: d.severity,
            code: d.code,
            message: d.message,
        }));
        const semantic = buildDiagramScene(effectiveSpec, plan, { theme: this._diagramTheme() });
        this._semanticScene = semantic;
        this.scene = resolve(semantic, {
            width: plan.canvasBounds.w,
            height: plan.canvasBounds.h,
            preserveNodeIds: true,
        });
        this.state = initialState(this.scene.width, this.scene.height);
    }

    public dispatch(action: Action): RuntimeState | null {
        if (!this.state) return null;
        this.state = reduce(this.state, action);
        return this.state;
    }

    // ---- ResizeObserver（autoSize：只同步 runtime 容器状态，不回写尺寸） ----

    public _attachResizeObserver(): void {
        if (typeof ResizeObserver === "undefined") return;
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof (root as any).getBoundingClientRect !== "function") return;
        const ro = new ResizeObserver((entries) => {
            for (const entry of entries) {
                const cr = (entry as any).contentRect as DOMRectReadOnly | undefined;
                if (!cr) continue;
                if (this.state) {
                    this.state = reduce(this.state, {
                        kind: "container-resize",
                        w: Math.round(cr.width),
                        h: Math.round(cr.height),
                    });
                }
            }
        });
        ro.observe(root);
        this._resizeObserver = ro;
    }

    public _detachResizeObserver(): void {
        if (this._resizeObserver) {
            this._resizeObserver.disconnect();
            this._resizeObserver = null;
        }
    }

    // ---- 命中测试 ----

    public _toScenePoint(ev: MouseEvent): Point2D | null {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || !this.scene) return null;
        const rect = root.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0 || this.scene.width <= 0 || this.scene.height <= 0) return null;
        return {
            x: ((ev.clientX - rect.left) / rect.width) * this.scene.width,
            y: ((ev.clientY - rect.top) / rect.height) * this.scene.height,
        };
    }

    /** 可命中的节点与边（role=diagram.node / diagram.edge 的 rect 与 path）。 */
    public _hitTargets(): SemanticNode[] {
        if (!this._semanticScene) {
            return [];
        }
        return this._semanticScene.root.children.filter(
            (n) => (n.role === "diagram.node" && n.kind === "rect") || (n.role === "diagram.edge" && n.kind === "path")
        );
    }

    /** 命中测试：节点优先（包含即中），其次到边的折线距离。 */
    public _hitTest(px: number, py: number): string | null {
        if (!this._semanticScene) {
            return null;
        }
        for (const node of this._semanticScene.root.children) {
            if (node.role === "diagram.node" && node.kind === "rect") {
                if (px >= node.x && px <= node.x + node.w && py >= node.y && py <= node.y + node.h) {
                    return node.id;
                }
            }
        }
        let bestId: string | null = null;
        let bestDist: number = Number.POSITIVE_INFINITY;
        for (const node of this._semanticScene.root.children) {
            if (node.role !== "diagram.edge" || node.kind !== "path") {
                continue;
            }
            const points = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") {
                    points.push(cmd.to);
                }
            }
            for (let i = 1; i < points.length; i++) {
                const d = segmentDistance(px, py, points[i - 1], points[i]);
                if (d <= HIT_TOLERANCE_PX && (bestId === null || d < bestDist)) {
                    bestId = node.id;
                    bestDist = d;
                }
            }
        }
        return bestId;
    }

    /** tooltip 文本：节点标签或边标签，缺省回退稳定 id。 */
    public _tooltipTextFor(id: string): string {
        if (this.spec) {
            if (id.startsWith("node-")) {
                const nodeId = id.slice("node-".length);
                const node = this.spec.nodes.find((n) => n.id === nodeId);
                if (node) return node.label ?? node.id;
            }
            if (id.startsWith("edge-")) {
                const edgeId = id.slice("edge-".length);
                const edge = this.spec.edges.find((e) => e.id === edgeId);
                if (edge) return edge.label ?? `${edge.fromNode} → ${edge.toNode}`;
            }
        }
        return id;
    }

    /** 节点 / 边的 scene 锚点（tooltip 定位）。 */
    public _nodeAnchor(id: string): Point2D | null {
        if (!this._semanticScene) return null;
        const node = this._semanticScene.root.children.find((n) => n.id === id);
        if (!node) return null;
        if (node.kind === "rect") return { x: node.x + node.w / 2, y: node.y };
        if (node.kind === "path") {
            const pts = [];
            for (const cmd of node.path.commands) {
                if (cmd.kind === "move" || cmd.kind === "line") pts.push(cmd.to);
            }
            if (pts.length > 0) return pts[Math.floor(pts.length / 2)];
        }
        return null;
    }

    // ---- Pointer 交互 ----

    /** 宿主可 override 的 hover 回调（事件名 `diagram-hover`）。 */
    public ondiagramHover(payload: { nodeId: string }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onMouseMove(ev: MouseEvent): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root) return;
        const rect = root.getBoundingClientRect();
        this._tooltip.x = ev.clientX - rect.left;
        this._tooltip.y = ev.clientY - rect.top;
        const point = this._toScenePoint(ev);
        const hit = point ? this._hitTest(point.x, point.y) : null;
        this._hoverId = hit;
        if (hit) {
            this._tooltip.text = this._tooltipTextFor(hit);
            this._tooltip.visible = true;
            this.dispatch({ kind: "hover", nodeId: hit });
            this.ondiagramHover({ nodeId: hit });
        } else {
            this._tooltip.visible = false;
            this.dispatch({ kind: "hover", nodeId: null });
        }
        this._focusIndex = hit ? this._hitTargets().findIndex((n) => n.id === hit) : -1;
        this._applyDomState();
    }

    public _onMouseLeave(): void {
        this._tooltip.visible = false;
        this._hoverId = null;
        this.dispatch({ kind: "hover", nodeId: null });
        this._applyDomState();
    }

    public _tooltipStyle(): string {
        return `left:${this._tooltip.x}px;top:${this._tooltip.y}px`;
    }

    // ---- Click → select dispatch + emit ----

    /** 宿主可 override 的选择回调（事件名 `diagram-select`）。 */
    public ondiagramSelect(payload: { nodeId: string }): void {
        // 默认空实现，宿主在组件实例上 override 即可接收事件。
    }

    public _onClick(ev: MouseEvent): void {
        if (!this.state) return;
        const point = this._toScenePoint(ev);
        const hit = point ? this._hitTest(point.x, point.y) : null;
        if (!hit) {
            this.dispatch({ kind: "clear-selection" });
            this._applyDomState();
            return;
        }
        this.dispatch({ kind: "select-toggle", nodeId: hit });
        this.ondiagramSelect({ nodeId: hit });
        this._applyDomState();
    }

    // ---- 键盘等价入口 ----

    public _onKeydown(ev: KeyboardEvent): void {
        const targets = this._hitTargets();
        if (targets.length === 0) return;
        if (ev.key === "ArrowRight" || ev.key === "ArrowDown") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex + 1) % targets.length;
            this._focusTarget(targets[this._focusIndex].id);
        } else if (ev.key === "ArrowLeft" || ev.key === "ArrowUp") {
            ev.preventDefault();
            this._focusIndex = (this._focusIndex - 1 + targets.length) % targets.length;
            this._focusTarget(targets[this._focusIndex].id);
        } else if (ev.key === "Enter" || ev.key === " ") {
            if (this._hoverId) {
                ev.preventDefault();
                this.dispatch({ kind: "select-toggle", nodeId: this._hoverId });
                this.ondiagramSelect({ nodeId: this._hoverId });
                this._applyDomState();
            }
        } else if (ev.key === "Escape") {
            this._hoverId = null;
            this._focusIndex = -1;
            this._tooltip.visible = false;
            this.dispatch({ kind: "clear-selection" });
            this._applyDomState();
        }
    }

    public _focusTarget(id: string): void {
        this._hoverId = id;
        const anchor = this._nodeAnchor(id);
        if (anchor && this.scene) {
            const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
            const rect = root ? root.getBoundingClientRect() : null;
            const scaleX = rect && rect.width > 0 ? rect.width / this.scene.width : 1;
            const scaleY = rect && rect.height > 0 ? rect.height / this.scene.height : 1;
            this._tooltip.x = anchor.x * scaleX;
            this._tooltip.y = anchor.y * scaleY;
            this._tooltip.text = this._tooltipTextFor(id);
            this._tooltip.visible = true;
        }
        this.dispatch({ kind: "hover", nodeId: id });
        this._applyDomState();
    }

    // ---- DOM 高亮回放 ----

    public _applyDomState(): void {
        const root = (this as any).__vmzDomRoot as HTMLElement | undefined;
        if (!root || typeof root.querySelectorAll !== "function") {
            return;
        }
        const selected = this.state ? this.state.selection.nodeIds : new Set();
        const active = this._hoverId !== null || selected.size > 0;
        const nodes = root.querySelectorAll("[data-dvz-id]");
        const elements = Array.from(nodes);
        for (const el of elements) {
            const id = el.getAttribute("data-dvz-id") ?? "";
            const isTarget = id.startsWith("node-") || id.startsWith("edge-");
            if (!isTarget) {
                continue;
            }
            const hot = id === this._hoverId || selected.has(id);
            el.style.opacity = !active || hot ? "1" : "0.4";
        }
    }
}

/** 点到线段的最短距离。 */
function segmentDistance(
    px: number,
    py: number,
    a: { x: number; y: number },
    b: { x: number; y: number },
): number {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const lengthSq = dx * dx + dy * dy;
    if (lengthSq === 0) return Math.hypot(px - a.x, py - a.y);
    let t = ((px - a.x) * dx + (py - a.y) * dy) / lengthSq;
    t = Math.max(0, Math.min(1, t));
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
}
</script>
