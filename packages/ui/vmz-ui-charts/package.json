{
    "name": "@vmz/ui-charts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/ui/vmz-ui-charts"
    },
    "version": "0.3.16",
    "type": "module",
    "description": "VMZ UI Charts — author-facing Vue bindings for DaVinci. Container sizing, lifecycle, property/attribute/event binding. Not a second chart engine.",
    "license": "MIT",
    "exports": {
        "./Chart": {
            "types": "./dist/Chart.d.ts",
            "default": "./dist/Chart.js"
        },
        "./Chart.css": "./dist/Chart.css",
        "./Diagram": {
            "types": "./dist/Diagram.d.ts",
            "default": "./dist/Diagram.js"
        },
        "./Diagram.css": "./dist/Diagram.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": [
        "./dist/*.css"
    ],
    "dependencies": {
        "@doki-land/davinci": "workspace:*"
    },
    "keywords": [
        "vmz",
        "ui",
        "charts",
        "davinci"
    ],
    "vmz": {
        "library": {
            "entries": {
                "Chart": "src/components/Chart.vmz",
                "Diagram": "src/components/Diagram.vmz"
            }
        }
    }
}
