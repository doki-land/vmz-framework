<template>
    <span data-vmz-ui="icon" :data-icon="name" :data-size="size" :role="roleAttr" :aria-hidden="hiddenAttr" :aria-label="labelAttr" class="vmz-ui-icon">
        <span v-if="isTextBadge()" class="vmz-ui-icon__badge">
            {{ badgeLabel() }}
        </span>
        <svg v-else viewBox="0 0 24 24" focusable="false" aria-hidden="true" class="vmz-ui-icon__svg">
            <g v-if="isStroke()" fill="none" stroke="currentColor" :stroke-width="strokeWidth()" stroke-linecap="round" stroke-linejoin="round">
                <path v-for="d in strokePaths()" :key="d" :d="d" />
                <circle v-for="c in strokeCircles()" :key="circleKey(c)" :cx="c.cx" :cy="c.cy" :r="c.r" />
                <circle v-for="dot in strokeDots()" :key="dotKey(dot)" :cx="dot.cx" :cy="dot.cy" :r="dot.r" fill="currentColor" stroke="none" />
            </g>
            <g v-else-if="isMixed()">
                <path v-for="node in mixedPaths()" :key="node.key" :d="node.d" :fill="node.fill" :stroke="node.stroke" :stroke-width="node.strokeWidth" :fill-rule="node.fillRule" />
                <circle v-for="node in mixedCircles()" :key="node.key" :cx="node.cx" :cy="node.cy" :r="node.r" :fill="node.fill" :stroke="node.stroke" :stroke-width="node.strokeWidth" />
                <rect v-for="node in mixedRects()" :key="node.key" :x="node.x" :y="node.y" :width="node.width" :height="node.height" :rx="node.rx" :fill="node.fill" :stroke="node.stroke" :stroke-width="node.strokeWidth" />
            </g>
            <path v-else-if="isFill()" fill="currentColor" :fill-rule="fillRule()" :d="fillD()" />
        </svg>
    </span>
</template>
<style>
.vmz-ui-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
    color: inherit;
    line-height: 1;
    vertical-align: middle;
    user-select: none;
}

.vmz-ui-icon__svg {
    display: block;
    width: 1em;
    height: 1em;
}

.vmz-ui-icon__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 1.65em;
    padding: 0.12em 0.22em;
    border: 1.5px solid currentColor;
    border-radius: 0.2em;
    font-family: var(--vmz-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-size: 0.52em;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
}

.vmz-ui-icon[data-size="sm"] {
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.95rem;
}

.vmz-ui-icon[data-size="md"] {
    width: 2.35rem;
    height: 2.35rem;
    font-size: 1.15rem;
}

.vmz-ui-icon[data-size="lg"] {
    width: 2.85rem;
    height: 2.85rem;
    font-size: 1.35rem;
}
</style>
<script client>
import { DEFAULT_STROKE_WIDTH, resolveIconDef } from "./registry.ts";

/**
 * VMZ UI Icons — semantic Icon backed by the shared registry export.
 * Optional package: apps that only need UI chrome can use `@vmz/ui/Icon` instead.
 */
export default class Icon {
    static __vmzHostBox = "contents";
    /** Semantic icon id, e.g. tool.base64 / action.search */
    public name: string = "";
    /** sm | md | lg */
    public size: string = "md";
    /** Accessible name; empty ⇒ decorative */
    public label: string = "";

    roleAttr = "";
    hiddenAttr = "true";
    labelAttr = "";

    onMount() {
        this.syncA11y();
    }

    iconDef() {
        return resolveIconDef(this.name);
    }

    isStroke() {
        const def = this.iconDef();
        return def?.kind === "stroke";
    }

    isFill() {
        const def = this.iconDef();
        return def?.kind === "fill";
    }

    isMixed() {
        const def = this.iconDef();
        return def?.kind === "mixed";
    }

    isTextBadge() {
        const def = this.iconDef();
        return def?.kind === "text-badge";
    }

    badgeLabel() {
        const def = this.iconDef();
        if (def?.kind !== "text-badge") return "";
        return def.label;
    }

    strokeWidth() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return DEFAULT_STROKE_WIDTH;
        return def.strokeWidth ?? DEFAULT_STROKE_WIDTH;
    }

    strokePaths() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.paths ?? [];
    }

    strokeCircles() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.circles ?? [];
    }

    strokeDots() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.dots ?? [];
    }

    circleKey(c) {
        return `c-${c.cx}-${c.cy}-${c.r}`;
    }

    dotKey(dot) {
        return `d-${dot.cx}-${dot.cy}-${dot.r}`;
    }

    fillD() {
        const def = this.iconDef();
        if (def?.kind !== "fill") return "";
        return def.d;
    }

    fillRule() {
        const def = this.iconDef();
        if (def?.kind !== "fill" || !def.fillRule) return "";
        return def.fillRule;
    }

    mixedPaths() {
        const def = this.iconDef();
        if (def?.kind !== "mixed") return [];
        return def.nodes
            .filter((node) => node.tag === "path")
            .map((node, index) => ({
                key: `p-${index}`,
                d: node.attrs.d ?? "",
                fill: node.attrs.fill ?? "none",
                stroke: node.attrs.stroke ?? "currentColor",
                strokeWidth: node.attrs["stroke-width"] ?? DEFAULT_STROKE_WIDTH,
                fillRule: node.attrs["fill-rule"] ?? "",
            }));
    }

    mixedCircles() {
        const def = this.iconDef();
        if (def?.kind !== "mixed") return [];
        return def.nodes
            .filter((node) => node.tag === "circle")
            .map((node, index) => ({
                key: `c-${index}`,
                cx: node.attrs.cx ?? "12",
                cy: node.attrs.cy ?? "12",
                r: node.attrs.r ?? "9",
                fill: node.attrs.fill ?? "none",
                stroke: node.attrs.stroke ?? "currentColor",
                strokeWidth: node.attrs["stroke-width"] ?? DEFAULT_STROKE_WIDTH,
            }));
    }

    mixedRects() {
        const def = this.iconDef();
        if (def?.kind !== "mixed") return [];
        return def.nodes
            .filter((node) => node.tag === "rect")
            .map((node, index) => ({
                key: `r-${index}`,
                x: node.attrs.x ?? "0",
                y: node.attrs.y ?? "0",
                width: node.attrs.width ?? "24",
                height: node.attrs.height ?? "24",
                rx: node.attrs.rx ?? "",
                fill: node.attrs.fill ?? "none",
                stroke: node.attrs.stroke ?? "currentColor",
                strokeWidth: node.attrs["stroke-width"] ?? DEFAULT_STROKE_WIDTH,
            }));
    }

    syncA11y() {
        const labelled = String(this.label || "").trim();
        if (labelled) {
            this.roleAttr = "img";
            this.hiddenAttr = "";
            this.labelAttr = labelled;
        } else {
            this.roleAttr = "";
            this.hiddenAttr = "true";
            this.labelAttr = "";
        }
    }
}
</script>
