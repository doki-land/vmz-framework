<template>
    <div data-vmz-ui="alert" :data-tone="tone" :role="roleName" class="vmz-ui-alert">
        <span class="vmz-ui-alert__icon" aria-hidden="true">
            <Icon :name="toneIcon()" size="md" decorative />
        </span>
        <div class="vmz-ui-alert__content">
            <p v-if="title" class="vmz-ui-alert__title">
                {{ title }}
            </p>
            <p v-if="description" class="vmz-ui-alert__description">
                {{ description }}
            </p>
            <div class="vmz-ui-alert__actions">
                <slot />
            </div>
        </div>
        <button v-if="closable" type="button" class="vmz-ui-alert__close" :aria-label="closeLabel" @click="dismiss">
            <Icon name="action.close" size="md" decorative />
        </button>
    </div>
</template>
<style>
.vmz-ui-alert {
    display: flex;
    align-items: flex-start;
    gap: var(--vmz-space-2, 0.5rem);
    padding: var(--vmz-space-3, 0.75rem) var(--vmz-space-4, 1rem);
    border: 1px solid var(--vmz-status-info-border, var(--vmz-line-default));
    border-radius: var(--vmz-radius-lg, 8px);
    background: var(--vmz-status-info-background, var(--vmz-surface-mist));
    color: var(--vmz-status-info-foreground);
}

.vmz-ui-alert[data-tone="info"] {
    border-color: var(--vmz-status-info-border, var(--vmz-line-default));
    background: var(--vmz-status-info-background, var(--vmz-surface-mist));
    color: var(--vmz-status-info-foreground);
}

.vmz-ui-alert[data-tone="success"] {
    border-color: var(--vmz-status-success-border, var(--vmz-line-default));
    background: var(--vmz-status-success-background, var(--vmz-surface-mist));
    color: var(--vmz-status-success-foreground);
}

.vmz-ui-alert[data-tone="warning"] {
    border-color: var(--vmz-status-warning-border, var(--vmz-line-default));
    background: var(--vmz-status-warning-background, var(--vmz-surface-mist));
    color: var(--vmz-status-warning-foreground);
}

.vmz-ui-alert[data-tone="danger"] {
    border-color: var(--vmz-status-danger-border, var(--vmz-line-default));
    background: var(--vmz-status-danger-background, var(--vmz-surface-mist));
    color: var(--vmz-status-danger-foreground);
}

.vmz-ui-alert[data-tone="info"] .vmz-ui-alert__icon {
    color: var(--vmz-status-info-accent);
}

.vmz-ui-alert[data-tone="success"] .vmz-ui-alert__icon {
    color: var(--vmz-status-success-accent);
}

.vmz-ui-alert[data-tone="warning"] .vmz-ui-alert__icon {
    color: var(--vmz-status-warning-accent);
}

.vmz-ui-alert[data-tone="danger"] .vmz-ui-alert__icon {
    color: var(--vmz-status-danger-accent);
}

.vmz-ui-alert__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
}

.vmz-ui-alert__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-1, 0.25rem);
    min-width: 0;
}

.vmz-ui-alert__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: inherit;
}

.vmz-ui-alert__description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--vmz-text-steel);
}

.vmz-ui-alert__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vmz-space-2, 0.5rem);
    margin-top: var(--vmz-space-1, 0.25rem);
}

.vmz-ui-alert__actions:empty {
    display: none;
}

.vmz-ui-alert__close {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--vmz-radius-sm, 4px);
    background: transparent;
    color: var(--vmz-text-tertiary);
    cursor: pointer;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, cubic-bezier(0.2, 0, 0, 1)),
        background-color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, cubic-bezier(0.2, 0, 0, 1));
}

.vmz-ui-alert__close:hover {
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-mist);
}

.vmz-ui-alert__close:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

:where([data-density="compact"]) .vmz-ui-alert {
    gap: var(--vmz-space-2, 0.5rem);
    padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-3, 0.75rem);
}

:where([data-density="dense"]) .vmz-ui-alert {
    gap: var(--vmz-space-1, 0.25rem);
    padding: var(--vmz-space-1, 0.25rem) var(--vmz-space-2, 0.5rem);
}
</style>
<script client>
/**
 * VMZ UI — Alert (UI4 status tone matrix).
 * tone → status.{info|success|warning|danger}.{accent|foreground|background|border}.
 */
export default class Alert {
    public title: string = "";
    public description: string = "";
    public tone: string = "info";
    public roleName: string = "status";
    public closable: boolean = false;
    public closeLabel: string = "";
    public onClose: (() => void) | null = null;

    toneIcon() {
        const tone = String(this.tone || "").toLowerCase();
        if (tone === "success" || tone === "warning" || tone === "danger") return `status.${tone}`;
        return "status.info";
    }

    dismiss() {
        this.emit("close");
        if (typeof this.onClose === "function") this.onClose();
    }
}
</script>
