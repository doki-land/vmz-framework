<template>
    <section data-vmz-ui="card" :data-size="size" :data-bordered="bordered ? 'true' : 'false'" :data-hoverable="hoverable ? 'true' : 'false'" class="vmz-ui-card">
        <header v-if="title || description" class="vmz-ui-card__header">
            <h2 v-if="title" class="vmz-ui-card__title">
                {{ title }}
            </h2>
            <p v-if="description" class="vmz-ui-card__description">
                {{ description }}
            </p>
        </header>
        <div class="vmz-ui-card__body">
            <slot />
        </div>
        <footer v-if="footer" class="vmz-ui-card__footer">
