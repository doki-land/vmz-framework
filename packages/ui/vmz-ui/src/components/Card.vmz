    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans, inherit);
    box-shadow: none;
}

.vmz-ui-card[data-bordered="false"] {
    border-color: transparent;
}

.vmz-ui-card[data-hoverable="true"] {
    transition: border-color var(--vmz-motion-control-duration, 120ms)
