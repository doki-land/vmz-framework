<template>
  <section class="vmz-ui-card" data-vmz-ui="card" :data-size="size" :data-bordered="bordered ? 'true' : 'false'" :data-hoverable="hoverable ? 'true' : 'false'">
      <header v-if="title" class="vmz-ui-card__header">
        <h2 class="vmz-ui-card__title">{{ title }}</h2>
        <p v-if="description" class="vmz-ui-card__description">{{ description }}</p>
      </header>
      <div class="vmz-ui-card__body">
        <slot />
      </div>
    </section>
</template>

<style>
.vmz-ui-card {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--vmz-line-subtle, var(--vmz-line-default));
  border-radius: var(--vmz-radius-lg, 8px);
  background: var(--vmz-surface-paper);
  color: var(--vmz-text-ink);
  box-shadow: var(--vmz-shadow-card, none);
}
.vmz-ui-card[data-bordered='false'] { border-color: transparent; }
.vmz-ui-card[data-hoverable='true'] { transition: border-color var(--vmz-motion-control-duration, .16s), box-shadow var(--vmz-motion-control-duration, .16s); }
.vmz-ui-card[data-hoverable='true']:hover { box-shadow: var(--vmz-shadow-card-hover, 0 1px 2px -2px rgba(0,0,0,.08), 0 3px 6px 0 rgba(0,0,0,.06)); }
.vmz-ui-card[data-size='small'] { gap: .5rem; padding: .75rem 1rem; }

  :where([data-density='compact']) .vmz-ui-card {
    gap: var(--vmz-density-compact-gap);
    padding: var(--vmz-density-compact-padding-y) var(--vmz-density-compact-padding-x);
  }

  :where([data-density='dense']) .vmz-ui-card {
    gap: var(--vmz-density-dense-gap);
    padding: var(--vmz-density-dense-padding-y) var(--vmz-density-dense-padding-x);
  }

  .vmz-ui-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

.vmz-ui-card__title {
  margin: 0;
  font-family: var(--vmz-font-sans, inherit);
  font-size: 1rem;
  font-weight: 600;
  color: var(--vmz-text-ink);
}

  .vmz-ui-card__description {
    margin: 0;
    color: var(--vmz-text-steel);
    line-height: 1.45;
  }

  .vmz-ui-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-density-control-gap);
  }

  /* Direct hosts wrapping inline chips (Badge) must not introduce a block box (VMZ-10). */
  .vmz-ui-card__body > [data-vmz]:has(> .vmz-ui-badge) {
    display: contents;
  }

  :where([data-density='compact']) .vmz-ui-card__body {
    gap: var(--vmz-density-compact-gap);
  }

  :where([data-density='dense']) .vmz-ui-card__body {
    gap: var(--vmz-density-dense-gap);
  }
</style>

<script client>
/**
* VMZ UI — Card (Commercial Surface).
* Surface container; spacing from density.*; chrome from surface/line/text.
*/
export default class Card {
	public title: string = "";
	public description: string = "";
	public size: string = "middle";
	public bordered: boolean = true;
	public hoverable: boolean = false;
}
</script>
