<template>
    <div data-vmz-ui="list" class="vmz-ui-list">
        <p v-if="label" :id="labelId" class="vmz-ui-list__label">
            {{ label }}
        </p>
        <ul role="listbox" :aria-labelledby="labelId" :aria-label="label" @click="onListClick" :onKeyDown="onListKeyDown" class="vmz-ui-list__items">
            <li v-for="item in items" :key="item.id" role="option" :id="item.id" :data-vmz-list-item="item.id" :aria-selected="selected === item.id ? 'true' : 'false'" :tabindex="selected === item.id ? 0 : -1" class="vmz-ui-list__item">
                {{ item.title }}
            </li>
        </ul>
    </div>
</template>
<style>
.vmz-ui-list {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-2, 0.5rem);
    max-width: 28rem;
}

.vmz-ui-list__label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--vmz-text-ink);
}

.vmz-ui-list__items {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: 1px solid var(--vmz-line-default, var(--vmz-line-strong));
    border-radius: var(--vmz-radius-lg, 8px);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
}

.vmz-ui-list__item {
    display: flex;
    align-items: center;
    min-height: var(--vmz-control-height, 2rem);
    padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-4, 1rem);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
    outline: none;
    transition:
        background-color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, cubic-bezier(0.2, 0, 0, 1)),
        color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, cubic-bezier(0.2, 0, 0, 1));
}

.vmz-ui-list__item + .vmz-ui-list__item {
    border-top: 1px solid var(--vmz-line-subtle, var(--vmz-line-default));
}

.vmz-ui-list__item:hover {
    background: var(--vmz-surface-mist);
}

.vmz-ui-list__item[aria-selected="true"] {
    background: var(--vmz-action-primary-soft, var(--vmz-surface-mist));
    color: var(--vmz-action-primary-active);
    font-weight: 500;
}

.vmz-ui-list__item[aria-selected="true"]:hover {
    background: var(--vmz-action-primary-soft, var(--vmz-surface-mist));
}

.vmz-ui-list__item:focus-visible {
    box-shadow: inset 0 0 0 2px var(--vmz-focus-ring);
}

:where([data-density="compact"]) .vmz-ui-list__item {
    padding: var(--vmz-density-compact-padding-y) var(--vmz-density-compact-padding-x);
}

:where([data-density="dense"]) .vmz-ui-list__item {
    padding: var(--vmz-density-dense-padding-y) var(--vmz-density-dense-padding-x);
}
</style>
<script client>
/**
 * VMZ UI — List (ordinary selectable list).
 * Parent owns `selected` id; click + Arrow/Home/End. Not a DataGrid.
 */
export default class List {
    public label: string = "";
    public labelId: string = "vmz-list-label";
    public selected: string = "";
    /** @type {{ id: string, title: string }[]} */
    public items: {
        id: string;
        title: string;
    }[] = [];
    public onSelect: ((id: string) => void) | null = null;
    select(id) {
        if (typeof this.onSelect === "function") this.onSelect(id);
    }
    onListClick(ev) {
        const t = ev && ev.target;
        const el = t && typeof t.closest === "function" ? t.closest("[data-vmz-list-item]") : null;
        const id =
            el && typeof el.getAttribute === "function"
                ? el.getAttribute("data-vmz-list-item")
                : null;
        if (id) this.select(id);
    }
    onListKeyDown(ev) {
        if (!ev || !this.items?.length) return;
        const ids = this.items.map((it) => it.id);
        const idx = Math.max(0, ids.indexOf(this.selected));
        let next = idx;
        if (ev.key === "ArrowDown") next = (idx + 1) % ids.length;
        else if (ev.key === "ArrowUp") next = (idx - 1 + ids.length) % ids.length;
        else if (ev.key === "Home") next = 0;
        else if (ev.key === "End") next = ids.length - 1;
        else return;
        ev.preventDefault();
        this.select(ids[next]);
    }
}
</script>
