<template>
    <nav data-vmz-ui="pagination" :aria-label="label" class="vmz-ui-pagination">
        <button type="button" :disabled="prevDisabled" :aria-label="prevLabel ? prevLabel : null" @click="onPrevClick" class="vmz-ui-pagination__nav">
            <Icon name="action.chevron-left" size="sm" decorative />
            <span v-if="prevLabel" class="vmz-ui-pagination__nav-label">
                {{ prevLabel }}
            </span>
        </button>
        <ul v-if="pageItems.length" class="vmz-ui-pagination__pages">
            <li v-for="item in pageItems" :key="item.key" class="vmz-ui-pagination__page-item">
                <span v-if="item.gap" aria-hidden="true" class="vmz-ui-pagination__ellipsis">
                    <Icon name="action.more" size="sm" decorative />
                </span>
                <button v-else type="button" :data-vmz-page="item.page" :aria-current="item.page === currentPage ? 'page' : null" :aria-label="pageAria(item.page)" @click="onPageClick(item.page)" class="vmz-ui-pagination__page">
                    {{ item.page }}
                </button>
            </li>
        </ul>
        <p data-vmz-fixture="page-status" class="vmz-ui-pagination__status">
            {{ status }}
        </p>
        <span v-if="pageSizeOptions.length" class="vmz-ui-pagination__size">
            <span v-if="pageSizeLabel" class="vmz-ui-pagination__size-label">
                {{ pageSizeLabel }}
            </span>
            <Select :control-id="pageSizeControlId" :value="pageSize" :options="pageSizeOptions" :on-change="onPageSizeSelect" />
        </span>
        <button type="button" :disabled="nextDisabled" :aria-label="nextLabel ? nextLabel : null" @click="onNextClick" class="vmz-ui-pagination__nav">
            <span v-if="nextLabel" class="vmz-ui-pagination__nav-label">
                {{ nextLabel }}
            </span>
            <Icon name="action.chevron-right" size="sm" decorative />
        </button>
    </nav>
</template>
<style>
.vmz-ui-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--vmz-text-ink);
}

.vmz-ui-pagination__nav,
.vmz-ui-pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    box-sizing: border-box;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    cursor: pointer;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        border-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        background-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-pagination__nav:hover:not(:disabled),
.vmz-ui-pagination__page:hover:not([aria-current="page"]) {
    background: var(--vmz-surface-mist);
    border-color: var(--vmz-line-default);
    color: var(--vmz-action-primary-background);
}

.vmz-ui-pagination__nav:focus-visible,
.vmz-ui-pagination__page:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-pagination__nav:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.vmz-ui-pagination__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.vmz-ui-pagination__page {
    min-width: 2rem;
    padding: 0;
    font-variant-numeric: tabular-nums;
}

.vmz-ui-pagination__page[aria-current="page"] {
    border-color: var(--vmz-action-primary-background);
    background: var(--vmz-action-primary-background);
    color: var(--vmz-action-primary-foreground);
    cursor: default;
}

.vmz-ui-pagination__ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-pagination__status {
    margin: 0 0 0 auto;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--vmz-text-steel);
}

.vmz-ui-pagination__size {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.vmz-ui-pagination__size-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--vmz-text-steel);
    white-space: nowrap;
}

.vmz-ui-pagination__size .vmz-ui-select {
    max-width: 6rem;
}

.vmz-ui-pagination__size .vmz-ui-select__control {
    min-height: 2rem;
    padding-top: 0;
    padding-bottom: 0;
}
</style>
<script client>
/**
 * VMZ UI — Pagination.
 * Parent owns page / pageCount; buttons call onPrev / onNext / onPage.
 * Optional page-size Select renders when `pageSizeOptions` is non-empty.
 */
export default class Pagination {
    public label: string = "";
    public prevLabel: string = "";
    public nextLabel: string = "";
    public status: string = "";
    public prevDisabled: boolean = true;
    public nextDisabled: boolean = true;
    public page: number = 1;
    public pageCount: number = 0;
    /** Normalised numeric page mirror read by the template. */
    public currentPage: number = 1;
    public pageLabel: string = "";
    public pageSize: string = "";
    public pageSizeLabel: string = "";
    public pageSizeControlId: string = "vmz-pagination-size";
    /** @type {{ value: string, label: string }[]} */
    public pageSizeOptions: {
        value: string;
        label: string;
    }[] = [];
    /** @type {{ key: string, page: number, gap: boolean }[]} */
    pageItems: {
        key: string;
        page: number;
        gap: boolean;
    }[] = [];
    public onPrev: (() => void) | null = null;
    public onNext: (() => void) | null = null;
    public onPage: ((page: number) => void) | null = null;
    public onPageSizeChange: ((value: string) => void) | null = null;
    onMount() {
        this._rebuildPages();
    }
    /** Parent-owned prop writes — keep the page window in sync. */
    __vmzOnParentProp(name: string) {
        if (name === "page" || name === "pageCount") this._rebuildPages();
    }
    _rebuildPages() {
        const total = Math.max(0, Math.floor(Number(this.pageCount) || 0));
        const current = Math.min(Math.max(1, Math.floor(Number(this.page) || 1)), Math.max(1, total));
        this.currentPage = current;
        if (total <= 0) {
            this.pageItems = [];
            return;
        }
        const items = [];
        const pageItem = (p) => ({ key: `p-${p}`, page: p, gap: false });
        const gapItem = (k) => ({ key: k, page: 0, gap: true });
        if (total <= 7) {
            for (let p = 1; p <= total; p += 1) items.push(pageItem(p));
        } else {
            items.push(pageItem(1));
            const start = Math.max(2, current - 1);
            const end = Math.min(total - 1, current + 1);
            if (start > 2) items.push(gapItem("gap-start"));
            for (let p = start; p <= end; p += 1) items.push(pageItem(p));
            if (end < total - 1) items.push(gapItem("gap-end"));
            items.push(pageItem(total));
        }
        this.pageItems = items;
    }
    pageAria(p) {
        return this.pageLabel ? `${this.pageLabel} ${p}` : String(p);
    }
    onPageClick(p) {
        if (p === this.currentPage) return;
        if (typeof this.onPage === "function") this.onPage(p);
    }
    onPageSizeSelect(payload) {
        const next = payload && payload.target ? payload.target.value : "";
        if (typeof this.onPageSizeChange === "function") this.onPageSizeChange(next);
    }
    onPrevClick() {
        if (this.prevDisabled) return;
        if (typeof this.onPrev === "function") this.onPrev();
    }
    onNextClick() {
        if (this.nextDisabled) return;
        if (typeof this.onNext === "function") this.onNext();
    }
}
</script>
