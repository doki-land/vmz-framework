<template>
    <div data-vmz-ui="date-picker" :data-mode="mode" :data-invalid="invalidAttr" :class='"vmz-ui-date-picker" + (open ? " is-opened" : "")'>
        <label v-if="label" :for="controlId" class="vmz-ui-date-picker__label">
            {{ label }}
        </label>
        <button type="button" :id="controlId" :disabled="disabled" aria-haspopup="dialog" :aria-expanded="open ? 'true' : 'false'" :aria-controls="panelId" :aria-invalid="error ? 'true' : 'false'" :aria-describedby="describedBy" @click="toggle" :onKeyDown="onTriggerKeyDown" class="vmz-ui-date-picker__control">
            <Icon name="action.calendar" size="md" decorative />
            <span data-vmz-date="value" class="vmz-ui-date-picker__value">
                {{ displayLabel }}
            </span>
            <span class="vmz-ui-date-picker__chev">
                <Icon name="action.chevron-down" size="sm" decorative />
            </span>
        </button>
        <div v-if="open" :id="panelId" role="dialog" aria-modal="false" :aria-label="panelLabel || monthLabel" tabindex="-1" data-vmz-overlay="date-picker" data-vmz-overlay-owner="date-picker" data-vmz-focus="enter" data-vmz-date="panel" :onKeyDown="onPanelKeyDown" class="vmz-ui-date-picker__panel">
            <div class="vmz-ui-date-picker__monthbar">
                <button type="button" data-vmz-date="prev" :aria-label="prevMonthLabel || monthLabel" @click="prevMonth" class="vmz-ui-date-picker__nav">
                    <Icon name="action.chevron-left" size="sm" decorative />
                </button>
                <p data-vmz-date="month" class="vmz-ui-date-picker__month">
                    {{ monthLabel }}
                </p>
                <button type="button" data-vmz-date="next" :aria-label="nextMonthLabel || monthLabel" @click="nextMonth" class="vmz-ui-date-picker__nav">
                    <Icon name="action.chevron-right" size="sm" decorative />
                </button>
            </div>
            <div aria-hidden="true" class="vmz-ui-date-picker__weekdays">
                <span>
                    {{ weekdayLabel(0) }}
                </span>
                <span>
                    {{ weekdayLabel(1) }}
                </span>
                <span>
                    {{ weekdayLabel(2) }}
                </span>
                <span>
                    {{ weekdayLabel(3) }}
                </span>
                <span>
                    {{ weekdayLabel(4) }}
                </span>
                <span>
                    {{ weekdayLabel(5) }}
                </span>
                <span>
                    {{ weekdayLabel(6) }}
                </span>
            </div>
            <div role="grid" :aria-labelledby="panelId" class="vmz-ui-date-picker__grid">
                <button v-for="day in days" :key="day.key" type="button" role="gridcell" :data-vmz-date-iso="day.iso" :aria-selected="day.selected ? 'true' : 'false'" :aria-disabled="day.disabled ? 'true' : 'false'" :disabled="day.disabled" @click="onDayClick" :class='"vmz-ui-date-picker__day" + (day.inMonth ? "" : " is-outside") + (day.selected ? " is-on" : "") + (day.inRange ? " is-in-range" : "") + (day.rangeEdge ? " is-range-edge" : "") + (day.today ? " is-today" : "") + (day.disabled ? " is-disabled" : "")'>
                    {{ day.label }}
                </button>
            </div>
        </div>
        <p v-if="description" :id="descriptionId" class="vmz-ui-date-picker__description">
            {{ description }}
        </p>
        <p v-if="error" :id="errorId" role="alert" class="vmz-ui-date-picker__error">
            {{ error }}
        </p>
    </div>
</template>
<style>
.vmz-ui-date-picker {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    max-width: 28rem;
}

.vmz-ui-date-picker__label {
    font-size: 14px;
    font-weight: 600;
    line-height: 22px;
    color: var(--vmz-text-ink);
}

.vmz-ui-date-picker__control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: var(--vmz-control-height, 32px);
    box-sizing: border-box;
    font: inherit;
    font-size: 14px;
    line-height: 22px;
    text-align: left;
    padding: var(--vmz-density-control-padding-y) var(--vmz-density-control-padding-x);
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    outline: none;
    cursor: pointer;
    transition:
        border-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        box-shadow var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-date-picker__control:hover:not(:disabled) {
    border-color: var(--vmz-action-primary-hover);
}

.vmz-ui-date-picker[data-invalid="true"] .vmz-ui-date-picker__control {
    border-color: var(--vmz-status-danger-accent);
}

.vmz-ui-date-picker__control:focus-visible,
.vmz-ui-date-picker.is-opened .vmz-ui-date-picker__control {
    border-color: var(--vmz-action-primary-background);
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-date-picker__control:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.vmz-ui-date-picker__control .vmz-ui-icon {
    flex: 0 0 auto;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-date-picker__value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--vmz-text-ink);
}

.vmz-ui-date-picker__chev {
    flex: 0 0 auto;
    display: inline-flex;
    transition: transform var(--vmz-motion-control-duration)
        var(--vmz-motion-control-easing);
}

.vmz-ui-date-picker.is-opened .vmz-ui-date-picker__chev {
    transform: rotate(180deg);
}

.vmz-ui-date-picker__panel {
    position: absolute;
    z-index: 40;
    top: calc(100% + 6px);
    left: 0;
    box-sizing: border-box;
    width: 280px;
    max-width: calc(100vw - 32px);
    padding: 12px;
    border: 1px solid var(--vmz-line-subtle);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    box-shadow: var(--vmz-shadow-popup);
    outline: none;
    animation: vmz-ui-date-picker-in var(--vmz-motion-overlay-duration)
        var(--vmz-motion-overlay-easing);
}

.vmz-ui-date-picker__panel:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring), var(--vmz-shadow-popup);
}

.vmz-ui-date-picker__monthbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    margin-bottom: 8px;
}

.vmz-ui-date-picker__month {
    flex: 1 1 auto;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 22px;
    text-align: center;
    color: var(--vmz-text-ink);
}

.vmz-ui-date-picker__nav {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: var(--vmz-radius-md);
    background: transparent;
    color: var(--vmz-text-steel);
    cursor: pointer;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        background-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-date-picker__nav:hover {
    background: var(--vmz-surface-mist);
    color: var(--vmz-text-ink);
}

.vmz-ui-date-picker__nav:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-date-picker__weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    margin-bottom: 4px;
    font-size: 12px;
    line-height: 28px;
    color: var(--vmz-text-tertiary);
    text-align: center;
}

.vmz-ui-date-picker__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
}

.vmz-ui-date-picker__day {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 32px;
    box-sizing: border-box;
    font: inherit;
    font-size: 14px;
    line-height: 22px;
    padding: 0;
    border: 0;
    border-radius: var(--vmz-radius-md);
    background: transparent;
    color: var(--vmz-text-ink);
    cursor: pointer;
    outline: none;
    transition:
        background-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-date-picker__day:hover {
    background: var(--vmz-surface-mist);
}

.vmz-ui-date-picker__day:focus-visible {
    box-shadow: inset 0 0 0 2px var(--vmz-focus-ring);
}

.vmz-ui-date-picker__day.is-outside {
    color: var(--vmz-text-tertiary);
    opacity: 0.6;
}

.vmz-ui-date-picker__day.is-today {
    box-shadow: inset 0 0 0 1px var(--vmz-action-primary-background);
}

.vmz-ui-date-picker__day.is-on,
.vmz-ui-date-picker__day.is-range-edge {
    background: var(--vmz-action-primary-background);
    color: var(--vmz-action-primary-foreground);
    font-weight: 600;
}

.vmz-ui-date-picker__day.is-on:hover,
.vmz-ui-date-picker__day.is-range-edge:hover {
    background: var(--vmz-action-primary-hover);
}

.vmz-ui-date-picker__day.is-in-range {
    background: color-mix(in srgb, var(--vmz-action-primary-background) 12%, transparent);
}

.vmz-ui-date-picker__day.is-disabled,
.vmz-ui-date-picker__day:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    background: transparent;
    box-shadow: none;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-date-picker__description {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-date-picker__error {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--vmz-status-danger-foreground);
}

@keyframes vmz-ui-date-picker-in {
    from {
        opacity: 0;
        transform: translateY(-4px);
    }
    to {
        opacity: 1;
        transform: none;
    }
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-date-picker__panel,
    .vmz-ui-date-picker__control,
    .vmz-ui-date-picker__chev,
    .vmz-ui-date-picker__nav,
    .vmz-ui-date-picker__day {
        animation: none;
        transition: none;
    }
}
</style>
<script client>
/**
 * VMZ UI — DatePicker.
 * Owned calendar overlay (trigger + dialog grid). Never native <input type="date"> popup.
 * Parent owns ISO value (YYYY-MM-DD) via onChange Event-like { target: { value } }.
 * mode=range: parent owns rangeStart + rangeEnd; onChange { target: { value, start, end } }.
 * Not @vmz/ui-scheduler — month grid only; no time / recurrence / resource layout.
 *
 * Localization props: `prevMonthLabel`, `nextMonthLabel`, `panelLabel` and
 * `weekdayLabels` (7 entries, Monday-first). Empty defaults keep visible chrome
 * free of hard-coded copy.
 */
export default class DatePicker {
    public label: string = "";
    public description: string = "";
    public error: string = "";
    public value: string = "";
    /** "date" | "range" */
    public mode: string = "date";
    public rangeStart: string = "";
    public rangeEnd: string = "";
    public min: string = "";
    public max: string = "";
    public disabled: boolean = false;
    public invalidAttr: string = "false";
    public controlId: string = "vmz-date";
    public descriptionId: string = "vmz-date-desc";
    public errorId: string = "vmz-date-err";
    public describedBy: string = "";
    public prevMonthLabel: string = "";
    public nextMonthLabel: string = "";
    public panelLabel: string = "";
    /** Seven Monday-first weekday headings. */
    public weekdayLabels: string[] = [];
    public onInput:
        | ((e: {
              target: {
                  value: string;
                  start: string;
                  end: string;
              };
          }) => void)
        | null = null;
    public onChange:
        | ((e: {
              target: {
                  value: string;
                  start: string;
                  end: string;
              };
          }) => void)
        | null = null;
    open = false;
    displayLabel = "—";
    panelId = "vmz-date-panel";
    monthLabel = "";
    viewYear = 0;
    viewMonth = 0;
    /** Internal first click while completing a range. */
    draftStart = "";
    days: Array<{
        key: string;
        iso: string;
        label: string;
        inMonth: boolean;
        selected: boolean;
        inRange: boolean;
        rangeEdge: boolean;
        today: boolean;
        disabled: boolean;
    }> = [];
    _docKeyHandler = null;
    _docPointerHandler = null;
    _observer = null;
    onMount() {
        this.panelId = `${this.controlId}-panel`;
        this.syncFromValue(true);
        if (typeof document === "undefined" || typeof MutationObserver === "undefined") return;
        const root = this.__vmzDomRoot;
        if (!root || typeof root.querySelector !== "function") return;
        this._observer = new MutationObserver(() => this._syncOverlay());
        this._observer.observe(root, {
            childList: true,
            subtree: true,
        });
    }
    onDestroy() {
        if (this._observer) {
            this._observer.disconnect();
            this._observer = null;
        }
        this._teardownDoc();
    }
    weekdayLabel(index: number) {
        const labels = Array.isArray(this.weekdayLabels) ? this.weekdayLabels : [];
        return labels[index] || "";
    }
    syncFromValue(resetView: boolean) {
        const isRange = String(this.mode) === "range";
        const parsed = this._parseIso(
            isRange ? this.rangeStart || this.rangeEnd || this.value : this.value,
        );
        this._syncDisplay();
        if (resetView) {
            const base = parsed || this._todayParts();
            this.viewYear = base.y;
            this.viewMonth = base.m;
        }
        this._rebuildDays();
    }
    _syncDisplay() {
        if (String(this.mode) === "range") {
            const a = this._parseIso(this.rangeStart) ? this.rangeStart : "";
            const b = this._parseIso(this.rangeEnd) ? this.rangeEnd : "";
            if (a && b) this.displayLabel = `${a} → ${b}`;
            else if (a) this.displayLabel = `${a} → …`;
            else this.displayLabel = "—";
            return;
        }
        this.displayLabel = this._parseIso(this.value) ? this.value : "—";
    }
    openPanel() {
        this.draftStart = "";
        this.syncFromValue(true);
        this.open = true;
    }
    toggle() {
        if (this.disabled) return;
        if (this.open) this.close();
        else this.openPanel();
    }
    close() {
        this.open = false;
        this.draftStart = "";
    }
    prevMonth() {
        if (this.viewMonth <= 1) {
            this.viewYear -= 1;
            this.viewMonth = 12;
        } else {
            this.viewMonth -= 1;
        }
        this._rebuildDays();
    }
    nextMonth() {
        if (this.viewMonth >= 12) {
            this.viewYear += 1;
            this.viewMonth = 1;
        } else {
            this.viewMonth += 1;
        }
        this._rebuildDays();
    }
    choose(iso: string) {
        if (!iso || this._isOutOfRange(iso)) return;
        if (String(this.mode) === "range") {
            if (!this.draftStart) {
                this.draftStart = iso;
                this._rebuildDays();
                return;
            }
            let start = this.draftStart;
            let end = iso;
            if (end < start) {
                const t = start;
                start = end;
                end = t;
            }
            this.draftStart = "";
            this.close();
            const ev = {
                target: {
                    value: `${start}/${end}`,
                    start,
                    end,
                },
            };
            this.emit("change", ev);
            this.emit("input", ev);
            if (typeof this.onChange === "function") this.onChange(ev);
            if (typeof this.onInput === "function") this.onInput(ev);
            return;
        }
        this.close();
        if (iso === this.value) return;
        const ev = {
            target: {
                value: iso,
                start: iso,
                end: iso,
            },
        };
        this.emit("change", ev);
        this.emit("input", ev);
        if (typeof this.onChange === "function") this.onChange(ev);
        if (typeof this.onInput === "function") this.onInput(ev);
    }
    onDayClick(ev: Event) {
        const t = ev?.target as HTMLElement | null;
        const el =
            t && typeof t.closest === "function"
                ? (t.closest("[data-vmz-date-iso]") as HTMLElement | null)
                : ((ev?.currentTarget as HTMLElement | null) ?? null);
        const iso =
            el && typeof el.getAttribute === "function"
                ? el.getAttribute("data-vmz-date-iso")
                : null;
        if (iso) this.choose(iso);
    }
    onTriggerKeyDown(ev: KeyboardEvent) {
        if (!ev || this.disabled) return;
        if ((ev.key === "ArrowDown" || ev.key === "Enter" || ev.key === " ") && !this.open) {
            ev.preventDefault();
            this.openPanel();
        } else if (ev.key === "Escape" && this.open) {
            ev.preventDefault();
            this.close();
        }
    }
    onPanelKeyDown(ev: KeyboardEvent) {
        if (!ev) return;
        if (ev.key === "Escape") {
            ev.preventDefault();
            this.close();
            return;
        }
        const root = this.__vmzDomRoot;
        const panel =
            root && typeof root.querySelector === "function"
                ? root.querySelector('[data-vmz-overlay="date-picker"]')
                : null;
        if (!panel) return;
        const nodes = [...panel.querySelectorAll("[data-vmz-date-iso]")].filter(
            (n) => n instanceof HTMLElement && !(n as HTMLButtonElement).disabled,
        );
        if (!nodes.length) return;
        const idx = nodes.indexOf(document.activeElement as Element);
        if (ev.key === "ArrowRight") {
            ev.preventDefault();
            (nodes[(idx + 1 + nodes.length) % nodes.length] as HTMLElement).focus();
        } else if (ev.key === "ArrowLeft") {
            ev.preventDefault();
            (nodes[(idx - 1 + nodes.length) % nodes.length] as HTMLElement).focus();
        } else if (ev.key === "ArrowDown") {
            ev.preventDefault();
            (nodes[Math.min(idx + 7, nodes.length - 1)] as HTMLElement).focus();
        } else if (ev.key === "ArrowUp") {
            ev.preventDefault();
            (nodes[Math.max(idx - 7, 0)] as HTMLElement).focus();
        } else if (ev.key === "Home") {
            ev.preventDefault();
            (nodes[0] as HTMLElement).focus();
        } else if (ev.key === "End") {
            ev.preventDefault();
            (nodes[nodes.length - 1] as HTMLElement).focus();
        } else if (ev.key === "Enter" || ev.key === " ") {
            const active = document.activeElement as HTMLElement | null;
            const iso = active?.getAttribute?.("data-vmz-date-iso");
            if (iso) {
                ev.preventDefault();
                this.choose(iso);
            }
        }
    }
    _rebuildDays() {
        const y = this.viewYear || this._todayParts().y;
        const m = this.viewMonth || this._todayParts().m;
        this.viewYear = y;
        this.viewMonth = m;
        this.monthLabel = `${this._monthName(m)} ${y}`;
        const today = this._todayParts();
        const todayIso = this._toIso(today.y, today.m, today.d);
        const firstDow = (new Date(y, m - 1, 1).getDay() + 6) % 7;
        const dim = new Date(y, m, 0).getDate();
        const prevDim = new Date(y, m - 1, 0).getDate();
        const cells: typeof this.days = [];
        const isRange = String(this.mode) === "range";
        let start = "";
        let end = "";
        if (isRange) {
            if (this.draftStart) {
                start = this.draftStart;
                end = this.draftStart;
            } else {
                start = this._parseIso(this.rangeStart) ? this.rangeStart : "";
                end = this._parseIso(this.rangeEnd) ? this.rangeEnd : "";
            }
        }
        for (let i = 0; i < 42; i++) {
            let cy = y;
            let cm = m;
            let cd = 0;
            let inMonth = true;
            if (i < firstDow) {
                inMonth = false;
                cd = prevDim - firstDow + i + 1;
                cm = m === 1 ? 12 : m - 1;
                cy = m === 1 ? y - 1 : y;
            } else if (i >= firstDow + dim) {
                inMonth = false;
                cd = i - firstDow - dim + 1;
                cm = m === 12 ? 1 : m + 1;
                cy = m === 12 ? y + 1 : y;
            } else {
                cd = i - firstDow + 1;
            }
            const iso = this._toIso(cy, cm, cd);
            let selected = iso === this.value;
            let inRange = false;
            let rangeEdge = false;
            if (isRange) {
                selected = false;
                if (start && end) {
                    rangeEdge = iso === start || iso === end;
                    inRange = iso >= start && iso <= end;
                    selected = rangeEdge;
                } else if (start) {
                    rangeEdge = iso === start;
                    selected = rangeEdge;
                }
            }
            cells.push({
                key: iso,
                iso,
                label: String(cd),
                inMonth,
                selected,
                inRange: inRange && !rangeEdge,
                rangeEdge,
                today: iso === todayIso,
                disabled: this._isOutOfRange(iso),
            });
        }
        this.days = cells;
        this._syncDisplay();
    }
    _parseIso(iso: string) {
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ""));
        if (!m) return null;
        const y = Number(m[1]);
        const mo = Number(m[2]);
        const d = Number(m[3]);
        if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
        return {
            y,
            m: mo,
            d,
        };
    }
    _toIso(y: number, m: number, d: number) {
        return `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    }
    _todayParts() {
        const now = new Date();
        return {
            y: now.getFullYear(),
            m: now.getMonth() + 1,
            d: now.getDate(),
        };
    }
    _monthName(m: number) {
        const names = [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December",
        ];
        return names[m - 1] || String(m);
    }
    _isOutOfRange(iso: string) {
        if (this.min && iso < this.min) return true;
        if (this.max && iso > this.max) return true;
        return false;
    }
    _syncOverlay() {
        const root = this.__vmzDomRoot;
        const panel =
            root && typeof root.querySelector === "function"
                ? root.querySelector('[data-vmz-overlay="date-picker"][data-vmz-focus="enter"]')
                : null;
        if (panel && this.open) this._bindDoc(panel as HTMLElement);
        else if (!panel) this._teardownDoc();
        this._syncDisplay();
    }
    _bindDoc(panel: HTMLElement) {
        if (typeof document === "undefined") return;
        if (!this._docKeyHandler) {
            this._docKeyHandler = (ev: KeyboardEvent) => {
                if (ev.key === "Escape") {
                    ev.preventDefault();
                    this.close();
                }
            };
            document.addEventListener("keydown", this._docKeyHandler);
        }
        if (!this._docPointerHandler) {
            const root = this.__vmzDomRoot;
            this._docPointerHandler = (ev: Event) => {
                const t = ev.target;
                if (!(t instanceof Node)) return;
                if (root && typeof root.contains === "function" && root.contains(t)) return;
                this.close();
            };
            document.addEventListener("pointerdown", this._docPointerHandler, true);
        }
        const selected = panel.querySelector(
            '[data-vmz-date-iso][aria-selected="true"]:not([disabled])',
        );
        const first = panel.querySelector("[data-vmz-date-iso]:not([disabled])");
        const focusTarget = (selected || first) as HTMLElement | null;
        if (focusTarget) focusTarget.focus();
        else panel.focus();
    }
    _teardownDoc() {
        if (typeof document !== "undefined") {
            if (this._docKeyHandler) document.removeEventListener("keydown", this._docKeyHandler);
            if (this._docPointerHandler) {
                document.removeEventListener("pointerdown", this._docPointerHandler, true);
            }
        }
        this._docKeyHandler = null;
        this._docPointerHandler = null;
    }
}
</script>
