<template>
    <div data-vmz-ui="table" :data-sort-key="sortKey" :data-sort-dir="sortDir" class="vmz-ui-table-wrap">
        <table class="vmz-ui-table">
            <thead @click="onHeadClick">
                <tr>
                    <th v-for="col in columns" :key="col.id" scope="col" :data-vmz-col="col.id">
                        <button type="button" :data-vmz-sort="col.id" class="vmz-ui-table__sort">
                            {{ col.title }}
                        </button>
                    </th>
                    <th v-if="hasRowAction" scope="col">
                        {{ actionTitle }}
                    </th>
                </tr>
            </thead>
            <tbody @click="onBodyClick">
                <tr v-for="row in rows" :key="row.id" :data-vmz-row="row.id">
                    <td v-for="cell in row.cells">
                        {{ cell }}
                    </td>
                    <td v-if="hasRowAction">
                        <button type="button" :data-vmz-row-action="row.id" :disabled="rowActionDisabled" class="vmz-ui-table__row-action">
                            {{ actionLabel }}
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</template>
<style>
.vmz-ui-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--vmz-line-subtle, var(--vmz-line-default));
    border-radius: var(--vmz-radius-lg, 8px);
    background: var(--vmz-surface-paper);
}

.vmz-ui-table {
    width: 100%;
    border-collapse: collapse;
    font: inherit;
    font-size: 0.875rem;
}

.vmz-ui-table th,
.vmz-ui-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--vmz-line-subtle, var(--vmz-line-default));
    vertical-align: middle;
}

/* Header is structure, not brand: quiet ink on a tinted band. */
.vmz-ui-table th {
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--vmz-text-steel);
    background: var(--vmz-surface-mist);
    white-space: nowrap;
}

.vmz-ui-table tbody tr {
    transition: background-color var(--vmz-motion-control-duration, 150ms)
        var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-table tbody tr:hover {
    background: var(--vmz-surface-mist);
}

.vmz-ui-table tbody tr:last-child td {
    border-bottom: 0;
}

.vmz-ui-table__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font: inherit;
    font-weight: 600;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    outline: none;
    border-radius: var(--vmz-radius-xs, 2px);
}

.vmz-ui-table__sort:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-table__row-action {
    font: inherit;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper);
    color: var(--vmz-action-primary-background);
    cursor: pointer;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        border-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        background-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-table__row-action:hover:not(:disabled) {
    color: var(--vmz-action-primary-hover);
    border-color: var(--vmz-action-primary-hover);
}

.vmz-ui-table__row-action:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-table__row-action:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}
</style>
<script client>
/**
 * VMZ UI — Table (UI5 Console Surface).
 * Column header click → onSort; row action → onRowAction; permission via rowActionDisabled.
 */
export default class Table {
    /** @type {{ id: string, title: string }[]} */
    public columns: {
        id: string;
        title: string;
    }[] = [];
    /** @type {{ id: string, cells: string[] }[]} */
    public rows: {
        id: string;
        cells: string[];
    }[] = [];
    public hasRowAction: boolean = false;
    public rowActionDisabled: boolean = false;
    public actionTitle: string = "Action";
    public actionLabel: string = "Open";
    public sortKey: string = "";
    public sortDir: string = "asc";
    public onRowAction: ((rowId: string) => void) | null = null;
    public onSort: ((columnId: string) => void) | null = null;
    onBodyClick(ev) {
        const t = ev && ev.target;
        const el = t && typeof t.closest === "function" ? t.closest("[data-vmz-row-action]") : null;
        if (!el || el.disabled) return;
        const id = el.getAttribute("data-vmz-row-action");
        if (id && typeof this.onRowAction === "function") this.onRowAction(id);
    }
    onHeadClick(ev) {
        const t = ev && ev.target;
        const el = t && typeof t.closest === "function" ? t.closest("[data-vmz-sort]") : null;
        if (!el) return;
        const id = el.getAttribute("data-vmz-sort");
        if (id && typeof this.onSort === "function") this.onSort(id);
    }
}
</script>
