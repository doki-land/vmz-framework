<template>
    <div data-vmz-ui="dialog" :data-vmz-overlay-open="open" class="vmz-ui-dialog-root">
        <div v-if="open" data-vmz-overlay="dialog" data-vmz-overlay-owner="dialog" :data-vmz-overlay-stack="stackLevel" :data-size="size" :data-action-size="actionSize" :data-tone="danger ? 'danger' : 'default'" class="vmz-ui-dialog">
            <button type="button" data-vmz-overlay-layer="backdrop" :aria-label="dismissLabel || closeLabel || label || title" @click="dismiss" class="vmz-ui-dialog__backdrop" />
            <div role="dialog" aria-modal="true" :aria-labelledby="title ? titleId : null" tabindex="-1" data-vmz-overlay-layer="panel" data-vmz-focus="enter" data-vmz-motion="overlay-enter" data-vmz-motion-token="motion.overlay" :onKeyDown="onPanelKeyDown" class="vmz-ui-dialog__panel">
                <header class="vmz-ui-dialog__header">
                    <div class="vmz-ui-dialog__heading">
                        <h2 v-if="title" :id="titleId" class="vmz-ui-dialog__title">
                            {{ title }}
                        </h2>
                        <p v-if="description" class="vmz-ui-dialog__description">
                            {{ description }}
                        </p>
                    </div>
                    <button type="button" data-vmz-focus="close" :aria-label="closeLabel || label || title" @click="dismiss" class="vmz-ui-dialog__close">
                        <Icon name="action.close" size="md" decorative />
                    </button>
                </header>
                <div class="vmz-ui-dialog__body">
                    <slot />
                </div>
                <div class="vmz-ui-dialog__actions">
                    <slot name="actions" />
                </div>
            </div>
        </div>
    </div>
</template>
<style>
.vmz-ui-dialog-root {
    display: block;
}

.vmz-ui-dialog {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    padding: 24px;
}

.vmz-ui-dialog[data-vmz-overlay-stack="1"] {
    z-index: 50;
}

.vmz-ui-dialog[data-vmz-overlay-stack="2"] {
    z-index: 60;
}

.vmz-ui-dialog[data-vmz-overlay-stack="3"] {
    z-index: 70;
}

.vmz-ui-dialog__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: color-mix(in srgb, var(--vmz-surface-ink) 45%, transparent);
    animation: vmz-ui-overlay-fade-in var(--vmz-motion-overlay-duration)
        var(--vmz-motion-overlay-easing);
}

.vmz-ui-dialog__panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: min(520px, 100%);
    max-height: calc(100vh - 48px);
    border: 1px solid var(--vmz-line-subtle);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    box-shadow: var(--vmz-shadow-popup);
    outline: none;
    animation: vmz-ui-overlay-panel-in var(--vmz-motion-overlay-duration)
        var(--vmz-motion-overlay-easing);
}

.vmz-ui-dialog[data-size="sm"] .vmz-ui-dialog__panel {
    width: min(400px, 100%);
}

.vmz-ui-dialog[data-size="lg"] .vmz-ui-dialog__panel {
    width: min(720px, 100%);
}

.vmz-ui-dialog[data-vmz-motion-adopt="true"] .vmz-ui-dialog__backdrop,
.vmz-ui-dialog[data-vmz-motion-adopt="true"] .vmz-ui-dialog__panel {
    animation: none;
}

.vmz-ui-dialog[data-vmz-motion-phase="exit"] .vmz-ui-dialog__backdrop {
    animation: vmz-ui-overlay-fade-out var(--vmz-motion-overlay-duration)
        var(--vmz-motion-overlay-easing);
}

.vmz-ui-dialog[data-vmz-motion-phase="exit"] .vmz-ui-dialog__panel {
    animation: vmz-ui-overlay-panel-out var(--vmz-motion-overlay-duration)
        var(--vmz-motion-overlay-easing);
}

.vmz-ui-dialog__panel:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring), var(--vmz-shadow-popup);
}

.vmz-ui-dialog__header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px 16px;
}

.vmz-ui-dialog__heading {
    flex: 1 1 auto;
    min-width: 0;
}

.vmz-ui-dialog__title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
    color: var(--vmz-text-ink);
}

.vmz-ui-dialog[data-tone="danger"] .vmz-ui-dialog__title {
    color: var(--vmz-status-danger-foreground);
}

.vmz-ui-dialog__description {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-dialog__close {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: -4px -8px 0 0;
    padding: 0;
    border: 0;
    border-radius: var(--vmz-radius-md);
    background: transparent;
    color: var(--vmz-text-steel);
    cursor: pointer;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        background-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-dialog__close:hover {
    background: var(--vmz-surface-mist);
    color: var(--vmz-text-ink);
}

.vmz-ui-dialog__close:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-dialog__body {
    flex: 1 1 auto;
    min-height: 0;
    padding: 0 24px 20px;
    overflow: auto;
    font-size: 14px;
    line-height: 22px;
    color: var(--vmz-text-ink);
}

.vmz-ui-dialog__body :where(a) {
    color: var(--vmz-action-primary-background);
    text-underline-offset: 2px;
}

.vmz-ui-dialog__body :where(a):hover {
    color: var(--vmz-action-primary-hover);
}

.vmz-ui-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 0 24px 20px;
}

.vmz-ui-dialog__actions:empty {
    display: none;
}

.vmz-ui-dialog__actions :where(button, a) {
    min-height: var(--vmz-control-height, 32px);
}

.vmz-ui-dialog[data-action-size="lg"] .vmz-ui-dialog__actions :where(button, a) {
    min-height: 40px;
}

@keyframes vmz-ui-overlay-fade-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes vmz-ui-overlay-panel-in {
    from {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: none;
    }
}

@keyframes vmz-ui-overlay-fade-out {
    from {
        opacity: 1;
    }
    to {
        opacity: 0;
    }
}

@keyframes vmz-ui-overlay-panel-out {
    from {
        opacity: 1;
        transform: none;
    }
    to {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
    }
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-dialog__backdrop,
    .vmz-ui-dialog__panel,
    .vmz-ui-dialog__close,
    .vmz-ui-dialog[data-vmz-motion-phase="exit"] .vmz-ui-dialog__backdrop,
    .vmz-ui-dialog[data-vmz-motion-phase="exit"] .vmz-ui-dialog__panel {
        animation: none;
        transition: none;
    }
}
</style>
<script client>
/**
 * VMZ UI — Dialog (UI1).
 * Live `open` + overlay ownership + focus + Escape/outside dismiss + stackLevel.
 * SSR/resume adopt skips enter replay; dismiss plays overlay-exit then calls onClose.
 *
 * Appearance props: `size` (sm 400 / md 520 / lg 720), `danger` tone,
 * `description`, `actionSize` (md 32 / lg 40 action buttons).
 * Visible copy is author-supplied; `closeLabel` / `dismissLabel` only name the
 * icon button and backdrop for assistive tech.
 */
export default class Dialog {
    public open: boolean = false;
    public title: string = "";
    public label: string = "";
    public description: string = "";
    /** sm | md | lg */
    public size: string = "md";
    /** md | lg */
    public actionSize: string = "md";
    public danger: boolean = false;
    public closeLabel: string = "";
    public dismissLabel: string = "";
    public titleId: string = "vmz-dialog-title";
    public stackLevel: string = "0";
    public onClose: (() => void) | null = null;
    _restoreFocus = null;
    _panel = null;
    _docKeyHandler = null;
    _pointerCapture = null;
    _observer = null;
    _adoptNextEnter = false;
    _exiting = false;
    _exitTimer = null;
    /** Motion generation — exit timer and cancel edges key off this owner counter. */
    _motionGen = 0;
    async onMount() {
        if (typeof document === "undefined" || typeof MutationObserver === "undefined") return;
        const root = this.__vmzDomRoot;
        if (!root || typeof root.querySelector !== "function") return;
        if (root.querySelector('[data-vmz-overlay="dialog"]')) this._adoptNextEnter = true;
        this._observer = new MutationObserver(() => this._syncFromDom());
        this._observer.observe(root, {
            childList: true,
            subtree: true,
        });
        this._ensurePointerCapture();
        this._syncFromDom();
    }
    onDestroy() {
        if (this._exitTimer) {
            clearTimeout(this._exitTimer);
            this._exitTimer = null;
        }
        this._exiting = false;
        if (this._observer) {
            this._observer.disconnect();
            this._observer = null;
        }
        this._exitFocus();
    }
    dismiss() {
        if (!this._isTopmostStack()) return;
        // Reverse / interrupt: second dismiss during exit cancels close (stay open).
        if (this._exiting) {
            this._cancelExit("reverse");
            return;
        }
        const panel = this._panel;
        const overlay =
            panel && typeof panel.closest === "function"
                ? panel.closest('[data-vmz-overlay="dialog"]')
                : null;
        const reduce =
            typeof window !== "undefined" &&
            typeof window.matchMedia === "function" &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (panel && overlay && !reduce) {
            this._exiting = true;
            const exitGen = this._motionGen;
            overlay.setAttribute("data-vmz-motion-phase", "exit");
            overlay.removeAttribute("data-vmz-motion-cancelled");
            panel.setAttribute("data-vmz-motion", "overlay-exit");
            const ms = this._overlayDurationMs(panel);
            this._exitTimer = setTimeout(() => {
                this._exitTimer = null;
                // Stale exit after interrupt/re-enter must not call onClose.
                if (!this._exiting || exitGen !== this._motionGen) return;
                this._exiting = false;
                this._finishDismiss();
            }, ms);
            return;
        }
        this._finishDismiss();
    }
    _finishDismiss() {
        const restore = this._restoreFocus;
        this._restoreFocus = null;
        const opener =
            restore && typeof restore.focus === "function" && document.contains(restore)
                ? restore
                : this._openerElement();
        this._exiting = false;
        if (this._exitTimer) {
            clearTimeout(this._exitTimer);
            this._exitTimer = null;
        }
        this._teardownDocKey();
        this._panel = null;
        this.emit("close");
        if (typeof this.onClose === "function") this.onClose();
        this._refocus(opener, true);
    }
    _refocus(el, sync = false) {
        if (!(el instanceof HTMLElement) || typeof el.focus !== "function") return;
        const focus = () => {
            if (document.contains(el)) el.focus();
        };
        if (sync) {
            focus();
            return;
        }
        if (typeof requestAnimationFrame === "function") {
            requestAnimationFrame(() => requestAnimationFrame(focus));
            return;
        }
        focus();
    }
    _cancelExit(reason) {
        if (this._exitTimer) {
            clearTimeout(this._exitTimer);
            this._exitTimer = null;
        }
        this._exiting = false;
        this._motionGen += 1;
        const panel = this._panel;
        const overlay =
            panel && typeof panel.closest === "function"
                ? panel.closest('[data-vmz-overlay="dialog"]')
                : null;
        if (overlay) {
            overlay.removeAttribute("data-vmz-motion-phase");
            overlay.setAttribute("data-vmz-motion-cancelled", reason || "true");
            overlay.setAttribute("data-vmz-motion-gen", String(this._motionGen));
        }
        if (panel) {
            panel.setAttribute("data-vmz-motion", "overlay-enter");
        }
    }
    _overlayDurationMs(panel) {
        try {
            const raw =
                (
                    getComputedStyle(panel).getPropertyValue("--vmz-motion-overlay-duration") || ""
                ).trim() || "180ms";
            if (raw.endsWith("ms")) return Math.max(0, Number.parseFloat(raw) || 180);
            if (raw.endsWith("s")) return Math.max(0, (Number.parseFloat(raw) || 0.18) * 1e3);
            return 180;
        } catch {
            return 180;
        }
    }
    _isTopmostStack() {
        if (typeof document === "undefined") return true;
        const root = this.__vmzDomRoot;
        const mine =
            root && typeof root.querySelector === "function"
                ? root.querySelector("[data-vmz-overlay][data-vmz-overlay-stack]")
                : null;
        if (!mine) return true;
        const myStack = Number(
            mine.getAttribute("data-vmz-overlay-stack") || this.stackLevel || "0",
        );
        const open = [...document.querySelectorAll("[data-vmz-overlay][data-vmz-overlay-stack]")];
        let max = -Infinity;
        for (const el of open) {
            const n = Number(el.getAttribute("data-vmz-overlay-stack") || "0");
            if (Number.isFinite(n) && n > max) max = n;
        }
        if (!Number.isFinite(max)) return true;
        if ((Number.isFinite(myStack) ? myStack : 0) < max) return false;
        if ((Number.isFinite(myStack) ? myStack : 0) > max) return true;
        const same = open.filter(
            (el) => Number(el.getAttribute("data-vmz-overlay-stack") || "0") === max,
        );
        return same[same.length - 1] === mine;
    }
    onPanelKeyDown(ev) {
        if (!ev || ev.key !== "Tab") return;
        const panel = this._panel;
        if (!panel) return;
        const nodes = panel.querySelectorAll(
            'a[href],button:not([disabled]),textarea:not([disabled]),input:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex="-1"])',
        );
        const list = [];
        for (const n of nodes) {
            if (n instanceof HTMLElement && n.offsetParent !== null) list.push(n);
        }
        if (panel.tabIndex >= 0) list.unshift(panel);
        if (!list.length) {
            ev.preventDefault();
            panel.focus();
            return;
        }
        const first = list[0];
        const last = list[list.length - 1];
        const active = document.activeElement;
        if (ev.shiftKey) {
            if (active === first || active === panel) {
                ev.preventDefault();
                last.focus();
            }
        } else if (active === last) {
            ev.preventDefault();
            first.focus();
        }
    }
    _syncFromDom() {
        const root = this.__vmzDomRoot;
        const panel =
            root && typeof root.querySelector === "function"
                ? root.querySelector('[data-vmz-focus="enter"]')
                : null;
        if (panel && !this._panel) {
            this._enterFocus(panel);
        } else if (!panel && this._panel) {
            this._exitFocus();
        }
    }
    _enterFocus(panel) {
        if (typeof document === "undefined") return;
        const active = document.activeElement;
        if (!this._restoreFocus) {
            if (
                active instanceof HTMLElement &&
                active !== document.body &&
                active !== panel &&
                !(panel instanceof HTMLElement && panel.contains(active))
            ) {
                this._restoreFocus = active;
            }
        }
        this._panel = panel instanceof HTMLElement ? panel : null;
        const overlay =
            this._panel && typeof this._panel.closest === "function"
                ? this._panel.closest('[data-vmz-overlay="dialog"]')
                : null;
        // Owner remount / re-enter cancels any in-flight exit from a prior generation.
        if (this._exiting) {
            this._cancelExit("reenter");
        } else {
            this._motionGen += 1;
        }
        if (overlay) {
            overlay.setAttribute("data-vmz-motion-gen", String(this._motionGen));
        }
        if (this._adoptNextEnter && overlay) {
            overlay.setAttribute("data-vmz-motion-adopt", "true");
            this._panel.setAttribute("data-vmz-motion", "overlay-stable");
            this._adoptNextEnter = false;
        } else if (overlay) {
            overlay.removeAttribute("data-vmz-motion-adopt");
            overlay.removeAttribute("data-vmz-motion-phase");
            overlay.removeAttribute("data-vmz-motion-cancelled");
            this._panel.setAttribute("data-vmz-motion", "overlay-enter");
        }
        if (this._panel && typeof this._panel.focus === "function") {
            this._panel.focus();
        }
        if (!this._docKeyHandler) {
            this._docKeyHandler = (ev) => {
                if (ev.key !== "Escape") return;
                if (ev.defaultPrevented) return;
                if (!this._isTopmostStack()) return;
                ev.preventDefault();
                ev.stopPropagation();
                this.dismiss();
            };
            document.addEventListener("keydown", this._docKeyHandler);
        }
    }
    _exitFocus() {
        if (this._exitTimer) {
            clearTimeout(this._exitTimer);
            this._exitTimer = null;
        }
        this._exiting = false;
        this._teardownDocKey();
        this._panel = null;
        const restore = this._restoreFocus;
        this._restoreFocus = null;
        const focusTarget =
            restore && typeof restore.focus === "function" && document.contains(restore)
                ? restore
                : this._openerElement();
        if (focusTarget && typeof focusTarget.focus === "function") {
            focusTarget.focus();
        }
    }
    _openerElement() {
        if (typeof document === "undefined") return null;
        const byTitle = document.querySelector(`[aria-controls="${this.titleId}"]`);
        if (byTitle instanceof HTMLElement) return byTitle;
        const byTrigger = document.querySelector(
            `[data-vmz-dialog-trigger-for="${this.titleId}"] button, [data-vmz-dialog-trigger-for="${this.titleId}"]`,
        );
        if (byTrigger instanceof HTMLElement) return byTrigger;
        const root = this.__vmzDomRoot;
        if (!(root instanceof HTMLElement)) return null;
        let host = root.parentElement;
        while (host) {
            const buttons = [...host.querySelectorAll("button.vmz-ui-btn")].filter(
                (btn) => btn instanceof HTMLElement,
            );
            if (buttons.length === 1) return buttons[0];
            for (const btn of buttons) {
                if (root.compareDocumentPosition(btn) & Node.DOCUMENT_POSITION_PRECEDING) {
                    return btn;
                }
            }
            host = host.parentElement;
        }
        return null;
    }
    _ensurePointerCapture() {
        if (typeof document === "undefined" || this._pointerCapture) return;
        this._pointerCapture = (ev) => {
            const t =
                ev.target instanceof HTMLElement
                    ? ev.target.closest("button, a[href], input, select, textarea, [tabindex]")
                    : null;
            if (!(t instanceof HTMLElement)) return;
            if (t.closest('[data-vmz-overlay="dialog"]')) return;
            this._restoreFocus = t;
        };
        document.addEventListener("mousedown", this._pointerCapture, true);
    }
    _teardownDocKey() {
        if (typeof document !== "undefined" && this._docKeyHandler) {
            document.removeEventListener("keydown", this._docKeyHandler);
        }
        this._docKeyHandler = null;
    }
}
</script>
