<template>
    <div data-vmz-ui="textarea" :data-invalid="invalidAttr" class="vmz-ui-textarea">
        <label v-if="label" :for="controlId" class="vmz-ui-textarea__label">
            {{ label }}
        </label>
        <textarea :id="controlId" :rows="rows" :value="value" :placeholder="placeholder" :disabled="disabled" :readonly="readonly" :aria-invalid="error ? 'true' : 'false'" :aria-describedby="describedBy" @input="onDomInput" class="vmz-ui-textarea__control" />
        <p v-if="description" :id="descriptionId" class="vmz-ui-textarea__description">
            {{ description }}
        </p>
        <p v-if="error" :id="errorId" role="alert" class="vmz-ui-textarea__error">
            {{ error }}
        </p>
    </div>
</template>
<style>
.vmz-ui-textarea {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-2);
    max-width: none;
    width: 100%;
}

.vmz-ui-textarea__label {
    font: inherit;
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.5715;
    color: var(--vmz-text-ink);
}

.vmz-ui-textarea__control {
    box-sizing: border-box;
    width: 100%;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1.5715;
    padding: var(--vmz-density-control-padding-y) var(--vmz-density-control-padding-x);
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    outline: none;
    resize: vertical;
    transition:
        border-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        box-shadow var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        background-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-textarea__control::placeholder {
    color: var(--vmz-text-tertiary);
    opacity: 1;
}

.vmz-ui-textarea[data-invalid="true"] .vmz-ui-textarea__control {
    border-color: var(--vmz-status-danger-accent);
}

.vmz-ui-textarea[data-invalid="true"] .vmz-ui-textarea__control:hover:not(:disabled),
.vmz-ui-textarea[data-invalid="true"] .vmz-ui-textarea__control:focus-visible {
    border-color: var(--vmz-status-danger-foreground);
}

.vmz-ui-textarea__control:hover:not(:disabled):not(:focus-visible) {
    border-color: var(--vmz-action-primary-hover);
}

.vmz-ui-textarea__control:focus-visible {
    border-color: var(--vmz-action-primary-background);
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-textarea__control:disabled {
    opacity: 0.6;
    color: var(--vmz-text-muted);
    cursor: not-allowed;
    background: var(--vmz-surface-mist);
}

.vmz-ui-textarea__control:read-only {
    cursor: default;
    background: var(--vmz-surface-mist);
}

.vmz-ui-textarea__description {
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: 0.875rem;
    line-height: 1.5715;
}

.vmz-ui-textarea__error {
    margin: 0;
    color: var(--vmz-status-danger-foreground);
    font-size: 0.875rem;
    line-height: 1.5715;
}
</style>
<script client>
/**
 * VMZ UI — TextArea.
 * Same label/description/error ownership contract as Field; parent owns value.
 */
export default class TextArea {
    public label: string = "";
    public description: string = "";
    public error: string = "";
    public value: string = "";
    public placeholder: string = "";
    public rows: number = 4;
    public disabled: boolean = false;
    public readonly: boolean = false;
    public invalidAttr: string = "false";
    public controlId: string = "vmz-textarea";
    public descriptionId: string = "vmz-textarea-desc";
    public errorId: string = "vmz-textarea-err";
    public describedBy: string = "";
    public onInput: ((e: Event) => void) | null = null;
    onDomInput(e: Event) {
        this.emit("input", e);
        if (typeof this.onInput === "function") this.onInput(e);
    }
}
</script>
