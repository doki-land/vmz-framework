<template>
  <div class="vmz-ui-textarea" data-vmz-ui="textarea" data-invalid={invalidAttr}>
    <label if={label} class="vmz-ui-textarea__label" for={controlId}>{label}</label>
    <textarea
      id={controlId}
      class="vmz-ui-textarea__control"
      rows={rows}
      value={value}
      disabled={disabled}
      readonly={readonly}
      aria-invalid={error ? 'true' : 'false'}
      aria-describedby={describedBy}
      onInput={onInput}
    ></textarea>
    <p if={description} id={descriptionId} class="vmz-ui-textarea__description">{description}</p>
    <p if={error} id={errorId} class="vmz-ui-textarea__error" role="alert">{error}</p>
  </div>
</template>

<style>
.vmz-ui-textarea {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  max-width: 28rem;
}

.vmz-ui-textarea__label {
  font: inherit;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.vmz-ui-textarea__control {
  box-sizing: border-box;
  width: 100%;
  font-family: var(--vmz-font-mono, ui-monospace, monospace);
  font-size: 0.95rem;
  line-height: 1.55;
  min-height: 8rem;
  padding: calc(var(--vmz-density-control-padding-y, 0.55rem) + 0.15rem)
    calc(var(--vmz-density-control-padding-x, 0.95rem) + 0.1rem);
  border: 1.5px solid color-mix(in srgb, var(--vmz-action-primary-background) 35%, var(--vmz-line-default, #d9dee3));
  border-left: 4px solid var(--vmz-action-primary-background);
  border-radius: 10px;
  background: color-mix(in srgb, var(--vmz-surface-mist, #f4f6f8) 70%, var(--vmz-surface-paper, #fff));
  color: var(--vmz-text-ink, inherit);
  outline: none;
  resize: vertical;
  box-shadow: inset 0 1px 2px rgba(16, 24, 40, 0.05);
  transition:
    border-color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, linear),
    box-shadow var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, linear),
    background-color var(--vmz-motion-control-duration, 120ms) var(--vmz-motion-control-easing, linear);
}

.vmz-ui-textarea__control::placeholder {
  color: var(--vmz-text-steel, #66707a);
  opacity: 0.85;
}

.vmz-ui-textarea[data-invalid='true'] .vmz-ui-textarea__control {
  border-color: var(--vmz-status-danger-accent);
  border-left-color: var(--vmz-status-danger-accent);
  background: color-mix(in srgb, var(--vmz-status-danger-accent) 8%, var(--vmz-surface-paper, #fff));
}

.vmz-ui-textarea__control:hover:not(:disabled):not(:focus-visible) {
  border-color: color-mix(in srgb, var(--vmz-action-primary-background) 55%, var(--vmz-line-default, #d9dee3));
}

.vmz-ui-textarea__control:focus-visible {
  border-color: var(--vmz-action-primary-background);
  background: var(--vmz-surface-paper, #fff);
  box-shadow:
    inset 0 1px 2px rgba(16, 24, 40, 0.03),
    0 0 0 2px var(--vmz-focus-ring);
}

.vmz-ui-textarea__control:disabled,
.vmz-ui-textarea__control:read-only {
  opacity: 0.72;
  cursor: default;
  background: color-mix(in srgb, var(--vmz-surface-mist, #f4f6f8) 70%, var(--vmz-surface-paper, #fff));
}

.vmz-ui-textarea__control:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.vmz-ui-textarea__description {
  margin: 0;
  color: var(--vmz-text-steel, #66707a);
  font-size: 0.9em;
  line-height: 1.4;
}

.vmz-ui-textarea__error {
  margin: 0;
  color: var(--vmz-status-danger-foreground);
  font-size: 0.9em;
}
</style>

<script client>
/**
 * VMZ UI — TextArea.
 * Same label/description/error ownership contract as Field; parent owns value.
 */
export default class TextArea {
  public label: string = '';
  public description: string = '';
  public error: string = '';
  public value: string = '';
  public rows: number = 4;
  public disabled: boolean = false;
  public readonly: boolean = false;
  public invalidAttr: string = 'false';
  public controlId: string = 'vmz-textarea';
  public descriptionId: string = 'vmz-textarea-desc';
  public errorId: string = 'vmz-textarea-err';
  public describedBy: string = '';
  public onInput: ((e: Event) => void) | null = null;
}
</script>
