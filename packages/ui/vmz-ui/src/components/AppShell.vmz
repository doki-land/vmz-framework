<template>
    <div data-vmz-ui="app-shell" class="vmz-ui-app-shell">
        <header data-vmz-shell="header" :onKeyDown="onHeaderKeyDown" class="vmz-ui-app-shell__header">
            <div class="vmz-ui-app-shell__header-inner">
                <a v-if="brand" :href="homeHref" class="vmz-ui-app-shell__brand">
                    {{ brand }}
                </a>
                <nav :id="navId" :aria-label="navLabel" :data-open="menuOpen ? 'true' : null" class="vmz-ui-app-shell__nav">
                    <a v-for="item in nav" :key="item.id" :href="item.href" :data-vmz-nav="item.id" :data-active="item.id === activeId ? 'true' : 'false'" :aria-current="item.id === activeId ? 'page' : null" @click="closeMenu" class="vmz-ui-app-shell__nav-item">
                        {{ item.title }}
                    </a>
                </nav>
                <div class="vmz-ui-app-shell__actions">
                    <slot name="actions" />
                </div>
                <button type="button" :aria-label="menuLabel ? menuLabel : navLabel" :aria-expanded="menuOpen ? 'true' : 'false'" :aria-controls="navId" @click="toggleMenu" class="vmz-ui-app-shell__menu">
                    <Icon :name="menuOpen ? 'action.close' : 'action.menu'" size="md" decorative />
                </button>
            </div>
        </header>
        <main data-vmz-shell="main" class="vmz-ui-app-shell__main">
            <slot />
        </main>
        <footer v-if="footer" data-vmz-shell="footer" class="vmz-ui-app-shell__footer">
            {{ footer }}
        </footer>
    </div>
</template>
<style>
.vmz-ui-app-shell {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-page);
    font-family: var(--vmz-font-sans);
}

.vmz-ui-app-shell__header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-paper);
}

.vmz-ui-app-shell__header-inner {
    width: min(var(--vmz-layout-max-width, 75rem), calc(100% - (var(--vmz-layout-gutter, 1rem) * 2)));
    height: var(--vmz-layout-header-height, 4rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--vmz-space-6, 2rem);
}

.vmz-ui-app-shell__brand {
    flex: none;
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--vmz-radius-sm, 4px);
    outline: none;
    transition: color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-app-shell__brand:hover {
    color: var(--vmz-action-primary-background);
}

.vmz-ui-app-shell__brand:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-app-shell__nav {
    flex: 0 1 auto;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--vmz-space-5, 1.5rem);
}

.vmz-ui-app-shell__nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
    box-sizing: border-box;
    border-bottom: 2px solid transparent;
    color: var(--vmz-text-steel);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        border-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-app-shell__nav-item:hover {
    color: var(--vmz-action-primary-background);
}

.vmz-ui-app-shell__nav-item[data-active="true"] {
    color: var(--vmz-action-primary-background);
    border-bottom-color: var(--vmz-action-primary-background);
}

.vmz-ui-app-shell__nav-item:focus-visible {
    border-radius: var(--vmz-radius-sm, 4px);
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-app-shell__actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--vmz-space-2, 0.5rem);
    margin-left: auto;
}

.vmz-ui-app-shell__menu {
    display: none;
}

.vmz-ui-app-shell__main {
    flex: 1;
    box-sizing: border-box;
    width: min(var(--vmz-layout-max-width, 75rem), calc(100% - (var(--vmz-layout-gutter, 1rem) * 2)));
    margin: 0 auto;
    padding: var(--vmz-space-6, 2rem) 0 var(--vmz-space-8, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-6, 2rem);
}

.vmz-ui-app-shell__footer {
    border-top: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-paper);
    padding: var(--vmz-space-6, 2rem) var(--vmz-space-5, 1.5rem);
    color: var(--vmz-text-tertiary);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
}

@media (max-width: 720px) {
    .vmz-ui-app-shell__header-inner {
        height: var(--vmz-layout-header-height-compact, 3.5rem);
        gap: var(--vmz-space-3, 0.75rem);
    }
    .vmz-ui-app-shell__nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: auto;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: var(--vmz-space-2, 0.5rem) var(--vmz-layout-gutter, 1rem) var(--vmz-space-4, 1rem);
        border-bottom: 1px solid var(--vmz-line-subtle);
        background: var(--vmz-surface-paper);
        box-shadow: var(--vmz-shadow-popup);
    }
    .vmz-ui-app-shell__nav[data-open="true"] {
        display: flex;
    }
    .vmz-ui-app-shell__nav-item {
        height: 2.5rem;
        padding: 0 var(--vmz-space-1, 0.25rem);
        border-bottom: 0;
    }
    .vmz-ui-app-shell__menu {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border: 0;
        border-radius: var(--vmz-radius-md, 6px);
        background: transparent;
        color: var(--vmz-text-ink);
        cursor: pointer;
        outline: none;
        transition: background-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
    }
    .vmz-ui-app-shell__menu:hover {
        background: var(--vmz-surface-mist);
    }
    .vmz-ui-app-shell__menu:focus-visible {
        box-shadow: 0 0 0 3px var(--vmz-focus-ring);
    }
    .vmz-ui-app-shell__main {
        padding: var(--vmz-space-5, 1.5rem) 0 var(--vmz-space-7, 3rem);
        gap: var(--vmz-space-5, 1.5rem);
    }
}
</style>
<script client>
/**
 * VMZ UI — AppShell (Commercial composition).
 * Landmark header/nav + main slot. `nav` stays flat link-only; non-nav controls
 * go into the named `actions` slot. Parent supplies copy; no private theme.
 */
export default class AppShell {
    public brand: string = "";
    public homeHref: string = "/";
    public navLabel: string = "";
    public menuLabel: string = "";
    /** Id of the nav item representing the current page, for `aria-current` + marker. */
    public activeId: string = "";
    public navId: string = "vmz-ui-app-shell-nav";
    /** Optional footer copy; the footer band only renders when supplied. */
    public footer: string = "";
    /** @type {{ id: string, title: string, href: string }[]} */
    public nav: {
        id: string;
        title: string;
        href: string;
    }[] = [];
    menuOpen = false;

    toggleMenu() {
        this.menuOpen = !this.menuOpen;
    }

    closeMenu() {
        if (this.menuOpen) this.menuOpen = false;
    }

    onHeaderKeyDown(e) {
        if (e && e.key === "Escape") this.closeMenu();
    }
}
</script>
