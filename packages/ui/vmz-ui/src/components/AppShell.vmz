    min-height: 100%;
    color: var(--vmz-text-ink);
    background: transparent;
}

.vmz-ui-app-shell__header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--vmz-line-subtle, var(--vmz-line-default));
    background: color-mix(in srgb, var(--vmz-surface-paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(0.5rem);
    -webkit-backdrop-filter: saturate(180%) blur(0.5rem);
}

.vmz-ui-app-shell__header-inner {
    width: min(var(--vmz-layout-max-width, 75rem), calc(100% - 2rem));
    min-height: 3.5rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

