}

.vmz-ui-app-shell__nav-item:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

/* Current section: ink emphasis plus a hairline marker, no brand fill. */
.vmz-ui-app-shell__nav-item[data-active="true"] {
    color: var(--vmz-text-ink);
    font-weight: 600;
}

.vmz-ui-app-shell__nav-item[data-active="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0.75rem 0;
    height: 2px;
    border-radius: var(--vmz-radius-pill, 999px);
    background: var(--vmz-action-primary-background);
}

.vmz-ui-app-shell__actions {
    flex: none;
    display: flex;
