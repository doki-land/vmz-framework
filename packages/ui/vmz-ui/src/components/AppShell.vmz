<script client>
/**
 * VMZ UI — AppShell (Commercial composition).
 * Landmark header/nav + main slot. `nav` stays flat link-only; non-nav controls
 * go into the named `actions` slot. Parent supplies copy; no private theme.
 */
export default class AppShell {
    public brand: string = "VMZ";
    public homeHref: string = "/";
    public navLabel: string = "Primary";
    /** Id of the nav item representing the current page, for `aria-current` + marker. */
    public activeId: string = "";
    /** @type {{ id: string, title: string, href: string }[]} */
    public nav: {
        id: string;
        title: string;
        href: string;
    }[] = [];
}
</script>
