<template>
    <div data-vmz-ui="app-shell" class="vmz-ui-app-shell">
        <header data-vmz-shell="header" class="vmz-ui-app-shell__header">
            <div class="vmz-ui-app-shell__header-inner">
                <a :href="homeHref" class="vmz-ui-app-shell__brand">
                    {{ brand }}
                </a>
                <nav :aria-label="navLabel" class="vmz-ui-app-shell__nav">
                    <a v-for="item in nav" :key="item.id" :href="item.href" :data-vmz-nav="item.id" :data-active="item.id === activeId ? 'true' : 'false'" :aria-current="item.id === activeId ? 'page' : null" class="vmz-ui-app-shell__nav-item">
                        {{ item.title }}
                    </a>
                </nav>
                <div class="vmz-ui-app-shell__actions">
                    <slot name="actions" />
                </div>
            </div>
        </header>
        <main data-vmz-shell="main" class="vmz-ui-app-shell__main">
            <slot />
        </main>
    </div>
</template>
