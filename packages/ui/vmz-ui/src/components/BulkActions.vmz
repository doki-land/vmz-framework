      role="region"
      aria-label={label}
    >
      <p class="vmz-ui-bulk-actions__count" data-vmz-fixture="bulk-count">{countLabel}</p>
      <div class="vmz-ui-bulk-actions__actions">
        <slot />
      </div>
    </div>
</template>

<style>
  .vmz-ui-bulk-actions {
