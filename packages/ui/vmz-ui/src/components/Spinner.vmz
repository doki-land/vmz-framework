<template>
    <span data-vmz-ui="spinner" role="status" :aria-label="label" class="vmz-ui-spinner" />
</template>
<style>
.vmz-ui-spinner {
    display: inline-block;
    box-sizing: border-box;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--vmz-action-primary-soft);
    border-top-color: var(--vmz-action-primary-background);
    border-radius: var(--vmz-radius-pill);
    vertical-align: -0.15em;
    animation: vmz-ui-spin var(--vmz-motion-control-duration) var(--vmz-motion-control-easing)
        infinite;
}

@keyframes vmz-ui-spin {
    to {
        transform: rotate(360deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-spinner {
        animation: none;
        border-color: var(--vmz-action-primary-background);
        opacity: 0.55;
    }
}
</style>
<script client>
/**
 * VMZ UI — Spinner (Foundation).
 * Loading indicator; reduced-motion keeps static feedback.
 */
export default class Spinner {
    public label: string = "";
}
</script>
