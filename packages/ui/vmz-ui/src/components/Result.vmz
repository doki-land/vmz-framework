<template>
    <section data-vmz-ui="result" :data-status="status" class="vmz-ui-result">
        <span aria-hidden="true" class="vmz-ui-result__icon">
            <Icon :name="statusIcon()" size="lg" decorative />
        </span>
        <p v-if="title" class="vmz-ui-result__title">
            {{ title }}
        </p>
        <p v-if="description" class="vmz-ui-result__description">
            {{ description }}
        </p>
        <div class="vmz-ui-result__actions">
            <slot />
        </div>
    </section>
</template>
<style>
.vmz-ui-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vmz-space-2, 0.5rem);
    padding: var(--vmz-space-6, 2rem) var(--vmz-space-5, 1.5rem);
    border: 1px solid var(--vmz-line-default, var(--vmz-line-strong));
    border-radius: var(--vmz-radius-lg, 8px);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    text-align: center;
}

.vmz-ui-result__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--vmz-space-1, 0.25rem);
}

.vmz-ui-result__icon .vmz-ui-icon[data-size] {
    font-size: 2.5rem;
}

.vmz-ui-result[data-status="info"] .vmz-ui-result__icon {
    color: var(--vmz-status-info-accent);
}

.vmz-ui-result[data-status="success"] .vmz-ui-result__icon {
    color: var(--vmz-status-success-accent);
}

.vmz-ui-result[data-status="warning"] .vmz-ui-result__icon {
    color: var(--vmz-status-warning-accent);
}

.vmz-ui-result[data-status="danger"] .vmz-ui-result__icon,
.vmz-ui-result[data-status="error"] .vmz-ui-result__icon {
    color: var(--vmz-status-danger-accent);
}

.vmz-ui-result__title {
    margin: 0;
    font-family: var(--vmz-font-sans, inherit);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.32;
    color: var(--vmz-text-ink);
}

.vmz-ui-result__description {
    margin: 0;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--vmz-text-tertiary);
}

.vmz-ui-result__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--vmz-space-3, 0.75rem);
    margin-top: var(--vmz-space-2, 0.5rem);
}

.vmz-ui-result__actions:empty {
    display: none;
}

:where([data-density="compact"]) .vmz-ui-result {
    gap: var(--vmz-space-1, 0.25rem);
    padding: var(--vmz-space-5, 1.5rem) var(--vmz-space-4, 1rem);
}

:where([data-density="dense"]) .vmz-ui-result {
    gap: var(--vmz-space-1, 0.25rem);
    padding: var(--vmz-space-4, 1rem);
}
</style>
<script client>
/**
 * VMZ UI — Result (UI4 Commercial Surface).
 * Outcome block for success/error flows; status → status.* accent tokens.
 */
export default class Result {
    public title: string = "";
    public description: string = "";
    public status: string = "info";

    statusIcon() {
        const status = String(this.status || "").toLowerCase();
        if (status === "success" || status === "warning") return `status.${status}`;
        if (status === "danger" || status === "error") return "status.danger";
        return "status.info";
    }
}
</script>
