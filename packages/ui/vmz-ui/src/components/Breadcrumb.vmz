<template>
    <nav data-vmz-ui="breadcrumb" :aria-label="label" class="vmz-ui-breadcrumb">
        <ol class="vmz-ui-breadcrumb__list">
            <li v-for="(item, index) in items" :key="item.id" :data-vmz-crumb="item.id" class="vmz-ui-breadcrumb__item">
                <a v-if="item.href" :href="item.href" class="vmz-ui-breadcrumb__link">
                    {{ item.title }}
                </a>
                <span v-if="!item.href" aria-current="page" class="vmz-ui-breadcrumb__current">
                    {{ item.title }}
                </span>
                <span v-if="index < items.length - 1" aria-hidden="true" class="vmz-ui-breadcrumb__sep">
                    <Icon name="action.chevron-right" size="xs" decorative />
                </span>
            </li>
        </ol>
    </nav>
</template>
<style>
.vmz-ui-breadcrumb {
    font: inherit;
    font-size: 0.875rem;
    color: var(--vmz-text-steel);
}

.vmz-ui-breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: center;
}

.vmz-ui-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
}

.vmz-ui-breadcrumb__link {
    color: var(--vmz-text-steel);
    text-decoration: none;
    border-radius: var(--vmz-radius-xs, 2px);
    transition: color var(--vmz-motion-control-duration, 150ms)
        var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-breadcrumb__link:hover {
    color: var(--vmz-action-primary-background);
}

.vmz-ui-breadcrumb__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-breadcrumb__current {
    color: var(--vmz-text-ink);
    font-weight: 500;
}

.vmz-ui-breadcrumb__sep {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--vmz-text-tertiary);
}
</style>
<script client>
/**
 * VMZ UI — Breadcrumb (commercial path).
 * Parent owns items; last crumb typically has no href (current page).
 * Separators use the shared chevron-right Icon (no CSS pseudo-elements).
 */
export default class Breadcrumb {
    public label: string = "";
    /** @type {{ id: string, title: string, href?: string }[]} */
    public items: {
        id: string;
        title: string;
        href?: string;
    }[] = [];
}
</script>
