<template>
    <div data-vmz-ui="console-shell" :onKeyDown="onShellKeyDown" class="vmz-ui-console-shell">
        <aside data-vmz-shell="sidebar" :aria-label="navLabel" class="vmz-ui-console-shell__sidebar">
            <div class="vmz-ui-console-shell__sidebar-top">
                <a v-if="brand" :href="homeHref" class="vmz-ui-console-shell__brand">
                    {{ brand }}
                </a>
                <button v-if="nav.length" type="button" :aria-label="menuLabel || navLabel" :aria-expanded="menuOpen ? 'true' : 'false'" aria-controls="vmz-console-shell-nav" @click="toggleMenu" class="vmz-ui-console-shell__menu">
                    <Icon :name="menuOpen ? 'action.close' : 'action.menu'" size="md" decorative />
                </button>
            </div>
            <nav id="vmz-console-shell-nav" :data-open="menuOpen ? 'true' : null" class="vmz-ui-console-shell__nav">
                <a v-for="item in nav" :key="item.id" :href="item.href" :data-vmz-nav="item.id" :data-active="item.id === activeNavId ? 'true' : null" :aria-current="item.id === activeNavId ? 'page' : null">
                    {{ item.title }}
                </a>
            </nav>
        </aside>
        <div class="vmz-ui-console-shell__body">
            <header data-vmz-shell="header" class="vmz-ui-console-shell__header">
                <a v-if="backLabel && backHref" :href="backHref" class="vmz-ui-console-shell__back">
                    {{ backLabel }}
                </a>
                <div class="vmz-ui-console-shell__header-copy">
                    <p v-if="breadcrumbLabel" data-vmz-shell="breadcrumb" class="vmz-ui-console-shell__breadcrumb">
                        {{ breadcrumbLabel }}
                    </p>
                    <h1 v-if="title" class="vmz-ui-console-shell__title">
                        {{ title }}
                    </h1>
                    <p v-if="subtitle" class="vmz-ui-console-shell__subtitle">
                        {{ subtitle }}
                    </p>
                </div>
                <a v-if="primaryActionLabel && primaryActionHref" :href="primaryActionHref" class="vmz-ui-console-shell__action">
                    {{ primaryActionLabel }}
                </a>
            </header>
            <main data-vmz-shell="main" class="vmz-ui-console-shell__main">
                <div class="vmz-ui-console-shell__panel">
                    <slot />
                </div>
            </main>
            <footer v-if="footer" data-vmz-shell="footer" class="vmz-ui-console-shell__footer">
                {{ footer }}
            </footer>
        </div>
    </div>
</template>
<style>
.vmz-ui-console-shell {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    grid-template-rows: minmax(100%, 100%);
    min-height: 100vh;
    min-height: 100dvh;
    height: 100dvh;
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-page);
    font-family: var(--vmz-font-sans);
}

.vmz-ui-console-shell__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-4, 1rem);
    padding: var(--vmz-space-3, 0.75rem);
    border-right: 1px solid var(--vmz-line-subtle);
    min-height: 100%;
    align-self: stretch;
    background: var(--vmz-surface-paper);
}

.vmz-ui-console-shell__sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--vmz-space-2, 0.5rem);
}

.vmz-ui-console-shell__menu {
    display: none;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--vmz-control-height, 2rem);
    min-height: var(--vmz-control-height, 2rem);
    padding: 0;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    cursor: pointer;
    outline: none;
}

.vmz-ui-console-shell__menu:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-console-shell__brand {
    padding: var(--vmz-space-1, 0.25rem) var(--vmz-space-3, 0.75rem);
    color: var(--vmz-text-ink);
    font-size: var(--vmz-type-body);
    font-weight: var(--vmz-type-weight-semibold);
    line-height: var(--vmz-type-line-height-body);
    letter-spacing: 0;
    text-decoration: none;
    outline: none;
    border-radius: var(--vmz-radius-md, 6px);
}

.vmz-ui-console-shell__brand:hover {
    color: var(--vmz-action-primary-background);
}

.vmz-ui-console-shell__brand:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-console-shell__nav {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-1, 0.25rem);
    flex: 1;
}

.vmz-ui-console-shell__nav a {
    display: flex;
    align-items: center;
    min-height: calc(var(--vmz-control-height) * 1.125);
    padding: 0 var(--vmz-space-3, 0.75rem);
    border-radius: var(--vmz-radius-md, 6px);
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-code);
    font-weight: var(--vmz-type-weight-medium);
    line-height: var(--vmz-type-line-height-caption);
    text-decoration: none;
    outline: none;
    transition:
        color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1)),
        background-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-console-shell__nav a:hover {
    color: var(--vmz-text-ink);
    background: var(--vmz-surface-mist);
}

.vmz-ui-console-shell__nav a[data-active="true"] {
    color: var(--vmz-action-primary-background);
    background: var(--vmz-action-primary-soft);
    font-weight: var(--vmz-type-weight-semibold);
    box-shadow: inset 2px 0 0 var(--vmz-action-primary-background);
}

.vmz-ui-console-shell__nav a:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-console-shell__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: auto;
    background: var(--vmz-surface-page);
}

.vmz-ui-console-shell__header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--vmz-space-4, 1rem);
    min-height: var(--vmz-layout-header-height-compact, 3.5rem);
    padding: 0 var(--vmz-space-5, 1.5rem);
    border-bottom: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-paper);
}

.vmz-ui-console-shell__back {
    display: none;
    align-items: center;
    flex: none;
    min-height: var(--vmz-control-height, 2rem);
    color: var(--vmz-action-link-foreground);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
    text-decoration: none;
    white-space: nowrap;
    outline: none;
}

.vmz-ui-console-shell__back:hover {
    color: var(--vmz-action-link-hover);
}

.vmz-ui-console-shell__back:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-console-shell__header-copy {
    display: grid;
    gap: var(--vmz-space-1, 0.25rem);
    min-width: 0;
}

.vmz-ui-console-shell__breadcrumb {
    margin: 0;
    color: var(--vmz-text-tertiary);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}

.vmz-ui-console-shell__title {
    margin: 0;
    color: var(--vmz-text-ink);
    font-size: var(--vmz-type-subtitle);
    line-height: var(--vmz-type-line-height-title);
    font-weight: var(--vmz-type-weight-semibold);
}

.vmz-ui-console-shell__subtitle {
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}

.vmz-ui-console-shell__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-height: var(--vmz-control-height);
    padding: 0 var(--vmz-space-3, 0.75rem);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-action-primary-background);
    color: var(--vmz-action-primary-foreground);
    font-size: var(--vmz-type-code);
    font-weight: var(--vmz-type-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    outline: none;
    transition: background-color var(--vmz-motion-control-duration, 150ms) var(--vmz-motion-control-easing, cubic-bezier(0.4, 0, 0.2, 1));
}

.vmz-ui-console-shell__action:hover {
    background: var(--vmz-action-primary-hover);
}

.vmz-ui-console-shell__action:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

.vmz-ui-console-shell__main {
    flex: 1 1 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
}

/* The shell owns the page axis, not a card boundary. Pages place their own
   workspace panel so header and content share one left edge. */
.vmz-ui-console-shell__panel {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-4, 1rem);
    padding: var(--vmz-space-5, 1.5rem);
}

.vmz-ui-console-shell__footer {
    margin-top: auto;
    padding: var(--vmz-space-4, 1rem) var(--vmz-space-5, 1.5rem);
    border-top: 1px solid var(--vmz-line-subtle);
    color: var(--vmz-text-tertiary);
    font-size: var(--vmz-type-caption);
    background: var(--vmz-surface-paper);
}

@media (max-width: 720px) {
    .vmz-ui-console-shell {
        grid-template-columns: 1fr;
        grid-template-rows: auto minmax(0, 1fr);
        height: auto;
        min-height: 100dvh;
    }

    .vmz-ui-console-shell__sidebar {
        position: relative;
        border-right: 0;
        border-bottom: 1px solid var(--vmz-line-subtle);
        gap: var(--vmz-space-2, 0.5rem);
        padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-4, 1rem);
    }

    .vmz-ui-console-shell__menu {
        display: inline-flex;
        width: var(--vmz-control-height-mobile);
        min-height: var(--vmz-control-height-mobile);
    }

    .vmz-ui-console-shell__nav {
        display: none;
        flex-direction: column;
        gap: var(--vmz-space-1, 0.25rem);
        flex: none;
    }

    /* The menu overlays the page instead of inserting a new row, so opening
       it never moves the current task down. */
    .vmz-ui-console-shell__nav[data-open="true"] {
        display: flex;
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        z-index: 30;
        padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-4, 1rem);
        border-bottom: 1px solid var(--vmz-line-subtle);
        background: var(--vmz-surface-paper);
        box-shadow: var(--vmz-shadow-popup);
    }

    .vmz-ui-console-shell__nav a {
        min-height: var(--vmz-control-height-mobile);
        white-space: normal;
    }

    .vmz-ui-console-shell__header {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--vmz-space-2, 0.5rem);
        min-height: var(--vmz-control-height-mobile);
        padding: var(--vmz-space-3, 0.75rem) var(--vmz-space-4, 1rem);
    }

    .vmz-ui-console-shell__back {
        display: inline-flex;
        grid-column: 1;
        min-height: var(--vmz-control-height-mobile);
    }

    .vmz-ui-console-shell__header-copy {
        grid-column: 2;
        gap: 0;
    }

    .vmz-ui-console-shell__breadcrumb,
    .vmz-ui-console-shell__subtitle {
        display: none;
    }

    .vmz-ui-console-shell__title {
        font-size: var(--vmz-type-subtitle);
        line-height: var(--vmz-type-line-height-title);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vmz-ui-console-shell__action {
        grid-column: 3;
        justify-self: end;
        min-height: var(--vmz-control-height-mobile);
    }

    .vmz-ui-console-shell__main {
        padding: 0;
    }

    .vmz-ui-console-shell__panel {
        padding: var(--vmz-space-4, 1rem);
    }
}
</style>
<script client>
/**
 * VMZ UI — ConsoleShell (Console composition).
 * Sidebar + 56px sticky header + white panel + optional footer. Parent owns nav/copy.
 */
export default class ConsoleShell {
    public brand: string = "";
    public homeHref: string = "/";
    public title: string = "";
    public subtitle: string = "";
    public breadcrumbLabel: string = "";
    public primaryActionLabel: string = "";
    public primaryActionHref: string = "";
    public backLabel: string = "";
    public backHref: string = "";
    public activeNavId: string = "";
    public navLabel: string = "";
    public menuLabel: string = "";
    public footer: string = "";
    public menuOpen: boolean = false;
    /** @type {{ id: string, title: string, href: string }[]} */
    public nav: {
        id: string;
        title: string;
        href: string;
    }[] = [];
    _onDocumentClick = null;
    onMount() {
        this._onDocumentClick = (ev) => {
            if (!this.menuOpen) return;
            const target = ev.target;
            if (target && target.closest && target.closest('[data-vmz-shell="sidebar"]')) return;
            this.menuOpen = false;
        };
        document.addEventListener("click", this._onDocumentClick);
    }
    onDestroy() {
        if (this._onDocumentClick) document.removeEventListener("click", this._onDocumentClick);
        this._onDocumentClick = null;
    }
    toggleMenu() {
        this.menuOpen = !this.menuOpen;
    }
    onShellKeyDown(ev) {
        if (ev && ev.key === "Escape" && this.menuOpen) {
            this.menuOpen = false;
        }
    }
}
</script>
