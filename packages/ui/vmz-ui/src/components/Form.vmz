<template>
    <form data-vmz-ui="form" :data-disabled="disabledAttr" data-novalidate="true" :aria-label="label" :aria-describedby="describedBy" @submit="onSubmitGuard" @reset="onResetGuard" class="vmz-ui-form">
        <div v-if="errorSummary" :id="summaryId" role="alert" data-vmz-form="summary" class="vmz-ui-form__summary">
            {{ errorSummary }}
        </div>
        <slot />
    </form>
</template>
<style>
.vmz-ui-form {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-density-control-gap);
    max-width: 36rem;
}

.vmz-ui-form[data-disabled="true"] {
    opacity: 0.72;
    pointer-events: none;
}

.vmz-ui-form__summary {
    margin: 0;
    padding: var(--vmz-density-control-padding-y) var(--vmz-density-control-padding-x);
    border: 1px solid var(--vmz-status-danger-accent);
    border-left-width: 1px;
    border-radius: var(--vmz-radius-md, 6px);
    background: color-mix(in srgb, var(--vmz-status-danger-accent) 12%, transparent);
    color: var(--vmz-status-danger-foreground);
    font-weight: 600;
}
</style>
<script client>
/**
 * VMZ UI — Form (hand-written commercial form shell).
 * Parent owns field values + validation presentation; no parallel form store.
 * `rules` + `values` are evaluated at submit only: failures emit `invalid`
 * (field -> rule key: required | min | max | pattern | custom) and suppress
 * `submit`. Copy stays author-supplied.
 * Native submit/reset guarded; browser HTML5 validation left off (data-novalidate + preventDefault).
 */
export default class Form {
    public label: string = "Form";
    public errorSummary: string = "";
    public summaryId: string = "vmz-form-summary";
    public describedBy: string = "";
    public disabled: boolean = false;
    public disabledAttr: string = "false";
    public rules: Record<string, {
        required?: boolean;
        minLength?: number;
        maxLength?: number;
        pattern?: string;
        test?: (value: string, values: Record<string, unknown>) => boolean;
    }> = {};
    public values: Record<string, unknown> = {};
    public onSubmit: (() => void) | null = null;
    public onReset: (() => void) | null = null;
    public onInvalid: ((errors: Record<string, string>) => void) | null = null;
    onSubmitGuard(ev) {
        if (ev && typeof ev.preventDefault === "function") ev.preventDefault();
        if (this.disabled) return;
        const errors = this.collectErrors();
        if (Object.keys(errors).length > 0) {
            this.emit("invalid", errors);
            if (typeof this.onInvalid === "function") this.onInvalid(errors);
            return;
        }
        this.emit("submit");
        if (typeof this.onSubmit === "function") this.onSubmit();
    }
    collectErrors() {
        const errors: Record<string, string> = {};
        const rules = this.rules || {};
        const values = this.values || {};
        for (const field of Object.keys(rules)) {
            const rule = rules[field] || {};
            const raw = values[field];
            const text = raw == null ? "" : String(raw);
            const filled = text.trim().length > 0;
            if (rule.required && !filled) {
                errors[field] = "required";
            } else if (rule.minLength && filled && text.length < Number(rule.minLength)) {
                errors[field] = "min";
            } else if (rule.maxLength && text.length > Number(rule.maxLength)) {
                errors[field] = "max";
            } else if (rule.pattern && filled && !new RegExp(String(rule.pattern)).test(text)) {
                errors[field] = "pattern";
            } else if (typeof rule.test === "function" && !rule.test(text, values)) {
                errors[field] = "custom";
            }
        }
        return errors;
    }
    onResetGuard(ev) {
        if (ev && typeof ev.preventDefault === "function") ev.preventDefault();
        if (this.disabled) return;
        this.emit("reset");
        if (typeof this.onReset === "function") this.onReset();
    }
}
</script>
