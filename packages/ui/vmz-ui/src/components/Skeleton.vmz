<template>
    <div data-vmz-ui="skeleton" :data-loading="loadingAttr" role="status" aria-live="polite" :aria-busy="loadingAttr" class="vmz-ui-skeleton">
        <div v-if="loading" data-vmz-skeleton="block" class="vmz-ui-skeleton__block" />
        <div v-if="loading" data-vmz-skeleton="line" class="vmz-ui-skeleton__line" />
        <div v-if="loading" data-vmz-skeleton="line" class="vmz-ui-skeleton__line" />
        <div v-if="!loading" class="vmz-ui-skeleton__content">
            <slot />
        </div>
    </div>
</template>
<style>
.vmz-ui-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-density-compact-gap);
    min-height: calc(var(--vmz-space-8) + var(--vmz-space-2));
}

.vmz-ui-skeleton__block,
.vmz-ui-skeleton__line {
    background: var(--vmz-surface-mist);
    animation: vmz-ui-skeleton-pulse calc(var(--vmz-motion-control-duration) * 10)
        var(--vmz-motion-control-easing) infinite alternate;
}

.vmz-ui-skeleton__block {
    width: 100%;
    height: var(--vmz-control-height-lg);
    border-radius: var(--vmz-radius-lg);
}

.vmz-ui-skeleton__line {
    width: 72%;
    height: var(--vmz-space-3);
    border-radius: var(--vmz-radius-sm);
}

.vmz-ui-skeleton__line + .vmz-ui-skeleton__line {
    width: 48%;
}

.vmz-ui-skeleton__content {
    display: flex;
    flex-direction: column;
    gap: inherit;
}

@keyframes vmz-ui-skeleton-pulse {
    from {
        opacity: 0.55;
    }
    to {
        opacity: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-skeleton__block,
    .vmz-ui-skeleton__line {
        animation: none;
        opacity: 0.75;
    }
}
</style>
<script client>
/**
 * VMZ UI — Skeleton (UI5 Console Surface).
 * Loading placeholder with stable min-height (CLS guard); parent owns loading.
 */
export default class Skeleton {
    public loading: boolean = true;
    public loadingAttr: string = "true";
}
</script>
