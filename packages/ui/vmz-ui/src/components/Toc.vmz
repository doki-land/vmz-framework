  }
</style>

<script client>
/**
* VMZ UI — Toc (Document/Product composition).
* In-page outline; parent supplies items. Readable without JS.
*/
export default class Toc {
	public label: string = "On this page";
	/** @type {{ id: string, title: string, href: string }[]} */
	public items: {
		id: string;
		title: string;
		href: string;
	}[] = [];
}
</script>
