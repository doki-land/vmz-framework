<template>
    <div data-vmz-ui="accordion" :aria-label="label" class="vmz-ui-accordion">
        <div v-for="item in items" :key="item.id" :data-vmz-accordion="item.id" class="vmz-ui-accordion__item">
            <h3 class="vmz-ui-accordion__heading">
                <button type="button" :id="item.triggerId" :data-vmz-accordion-trigger="item.id" :aria-expanded="openId === item.id ? 'true' : 'false'" :aria-controls="item.panelId" @click="toggle(item.id)" class="vmz-ui-accordion__trigger">
                    <span class="vmz-ui-accordion__title">
                        {{ item.title }}
                    </span>
                    <Icon name="action.chevron-down" size="sm" decorative />
                </button>
            </h3>
            <div v-if="openId === item.id" :id="item.panelId" role="region" :data-vmz-accordion-panel="item.id" :aria-labelledby="item.triggerId" class="vmz-ui-accordion__panel">
                {{ item.body }}
            </div>
        </div>
    </div>
</template>
<style>
.vmz-ui-accordion {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    overflow: hidden;
}

.vmz-ui-accordion__item {
    border-bottom: 1px solid var(--vmz-line-subtle);
}

.vmz-ui-accordion__item:last-child {
    border-bottom: none;
}

.vmz-ui-accordion__heading {
    margin: 0;
    font: inherit;
}

.vmz-ui-accordion__trigger {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 40px;
    box-sizing: border-box;
    text-align: start;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 22px;
    padding: var(--vmz-density-control-padding-y) var(--vmz-density-control-padding-x);
    border: 0;
    background: transparent;
    color: var(--vmz-text-ink);
    cursor: pointer;
    outline: none;
    transition: background-color var(--vmz-motion-control-duration)
        var(--vmz-motion-control-easing);
}

.vmz-ui-accordion__title {
    flex: 1 1 auto;
    min-width: 0;
}

.vmz-ui-accordion__trigger .vmz-ui-icon {
    flex: 0 0 auto;
    color: var(--vmz-text-tertiary);
    transition:
        color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        transform var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-accordion__trigger[aria-expanded="true"] .vmz-ui-icon {
    color: var(--vmz-action-primary-active);
    transform: rotate(180deg);
}

.vmz-ui-accordion__trigger:hover {
    background: var(--vmz-surface-mist);
}

.vmz-ui-accordion__trigger:focus-visible {
    box-shadow: inset 0 0 0 2px var(--vmz-focus-ring);
}

.vmz-ui-accordion__panel {
    padding: 0 16px 16px;
    font-size: 14px;
    line-height: 26px;
    color: var(--vmz-text-steel);
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-accordion__trigger,
    .vmz-ui-accordion__trigger .vmz-ui-icon {
        transition: none;
    }
}
</style>
<script client>
/**
 * VMZ UI — Accordion.
 * Exclusive open: parent owns `openId`. Toggle same id closes.
 * Panel body lives on items (no per-panel slot runtime).
 */
export default class Accordion {
    public label: string = "";
    public openId: string = "";
    /** @type {{ id: string, title: string, body: string, triggerId: string, panelId: string }[]} */
    public items: {
        id: string;
        title: string;
        body: string;
        triggerId: string;
        panelId: string;
    }[] = [];
    public onToggle: ((id: string) => void) | null = null;
    toggle(id) {
        if (typeof this.onToggle === "function") this.onToggle(id);
    }
}
</script>
