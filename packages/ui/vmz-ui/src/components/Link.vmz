<template>
    <a data-vmz-ui="link" :data-variant="variant" :href="href" :target="target" :rel="rel" class="vmz-ui-link">
        <slot />
    </a>
</template>
<style>
.vmz-ui-link {
    font: inherit;
    font-weight: 500;
    color: var(--vmz-action-link-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-color: currentColor;
    outline: none;
    border-radius: var(--vmz-radius-sm);
    transition:
        color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing),
        text-decoration-color var(--vmz-motion-control-duration) var(--vmz-motion-control-easing);
}

.vmz-ui-link:hover {
    color: var(--vmz-action-link-hover);
}

.vmz-ui-link:active {
    color: var(--vmz-action-primary-active);
}

.vmz-ui-link:focus-visible {
    box-shadow: 0 0 0 3px var(--vmz-focus-ring);
}

/* Quiet inline link: neutral ink, underline appears only on intent. */
.vmz-ui-link[data-variant="muted"] {
    color: var(--vmz-text-steel);
    text-decoration-color: transparent;
}

.vmz-ui-link[data-variant="muted"]:hover {
    color: var(--vmz-action-link-hover);
    text-decoration-color: currentColor;
}

/* Navigation link: chrome, not prose — underline is the hover affordance. */
.vmz-ui-link[data-variant="nav"] {
    font-weight: 500;
    color: var(--vmz-text-ink);
    text-decoration: none;
    text-decoration-color: transparent;
}

.vmz-ui-link[data-variant="nav"]:hover {
    color: var(--vmz-action-link-hover);
    text-decoration: underline;
    text-decoration-color: currentColor;
}

.vmz-ui-link[data-variant="nav"]:active {
    color: var(--vmz-action-primary-active);
}

@media (prefers-reduced-motion: reduce) {
    .vmz-ui-link {
        transition: none;
    }
}
</style>
<script client>
/**
 * VMZ UI — Link (Foundation).
 * Navigation / inline text link; tokens only, no brand hex.
 */
export default class Link {
    static __vmzHostBox = "contents";
    public href: string = "#";
    public target: string = "";
    public rel: string = "";
    /**
     * `default` inline prose link · `muted` quiet inline link · `nav` chrome link.
     * Appearance/semantic hint only: navigation, `href`, `target` and `rel` are
     * unaffected, and unknown values render as `default` without error.
     */
    public variant: string = "default";
}
</script>
