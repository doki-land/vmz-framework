{
    "schema": "vmz.ui.preset.v0",
    "id": "web-surface",
    "package": "@vmz/ui",
    "materialize": "Copy or resolve into application /designs Style Theme (tokens/*.json + themes/*.json). Preset is not a second runtime theme.",
    "files": {
        "root": "presets/web-surface",
        "theme": "theme.json",
        "tokens": [
            "tokens/brand.json",
            "tokens/semantic-action.json",
            "tokens/semantic-density.json",
            "tokens/semantic-layout.json",
            "tokens/semantic-motion.json",
            "tokens/semantic-status.json"
        ],
        "themes": ["themes/dark.json", "themes/high-contrast.json"]
    },
    "foundation": {
        "radius": {
            "xs": "2px",
            "sm": "4px",
            "md": "6px",
            "lg": "8px",
            "xl": "12px",
            "pill": "999px"
        },
        "controlHeight": { "sm": "1.5rem", "middle": "2rem", "lg": "2.5rem", "mobile": "2.75rem" },
        "layoutMaxWidth": "75rem",
        "surfacePage": "#F5F6F8",
        "surfaceFill": "#FAFBFC",
        "textTertiary": "#646A73",
        "textMuted": "#8A9099",
        "lineDefault": "#E5E6EB",
        "lineSubtle": "#F0F1F3",
        "shadowCard": "none",
        "shadowCardHover": "none",
        "shadowPopup": "0 12px 32px 0 rgba(15,23,42,.12), 0 2px 8px 0 rgba(15,23,42,.06)",
        "elevation": {
            "note": "Floating layers only. Cards stay flat per visualIntent; interactive surfaces lift on hover, never at rest.",
            "float-sm": "0 1px 2px 0 rgba(15,23,42,.04), 0 1px 4px -1px rgba(15,23,42,.03)",
            "float-md": "0 4px 12px 0 rgba(15,23,42,.08), 0 1px 3px 0 rgba(15,23,42,.04)",
            "float-lg": "0 12px 32px 0 rgba(15,23,42,.12), 0 2px 8px 0 rgba(15,23,42,.06)"
        }
    },
    "density": {
        "control": {
            "padding-y": "0.25rem",
            "padding-x": "0.75rem",
            "gap": "0.5rem"
        },
        "compact": {
            "padding-y": "0.125rem",
            "padding-x": "0.625rem",
            "gap": "0.375rem"
        },
        "dense": {
            "padding-y": "0",
            "padding-x": "0.4375rem",
            "gap": "0.25rem"
        }
    },
    "activation": {
        "densityAttr": "data-density",
        "densityValues": ["comfortable", "compact", "dense"],
        "themeAttr": "data-theme",
        "dirValues": ["ltr", "rtl"]
    },
    "themes": {
        "default": "application tokens base",
        "dark": "themes/dark.json overlay",
        "high-contrast": "themes/high-contrast.json overlay — stronger ink/line/focus"
    },
    "visualIntent": "Modern commercial product chrome: neutral structure borders (never brand outline on every box), flat cards, soft focus rings, quiet page fill. Brand color is for actions/selection — not scaffolding. Elevation is reserved for floating layers and hover lift; nothing casts a resting shadow. Motion eases, never jumps: control transitions use a decelerate curve, overlays use a fast-in curve, and reduced-motion is honored."
}
