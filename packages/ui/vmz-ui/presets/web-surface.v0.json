{
    "schema": "vmz.ui.preset.v0",
    "id": "web-surface",
    "package": "@vmz/ui",
    "materialize": "Copy or resolve into application /designs Style Theme (tokens/*.json + themes/*.json). Preset is not a second runtime theme.",
    "density": {
        "control": {
            "padding-y": "0.55rem",
            "padding-x": "0.95rem",
            "gap": "0.75rem"
        },
        "compact": {
            "padding-y": "0.35rem",
            "padding-x": "0.65rem",
            "gap": "0.45rem"
        },
        "dense": {
            "padding-y": "0.2rem",
            "padding-x": "0.45rem",
            "gap": "0.3rem"
        }
    },
    "activation": {
        "densityAttr": "data-density",
        "densityValues": ["comfortable", "compact", "dense"],
        "themeAttr": "data-theme",
        "dirValues": ["ltr", "rtl"]
    },
    "themes": {
        "default": "application tokens base",
        "dark": "themes/dark.json overlay",
        "high-contrast": "themes/high-contrast.json overlay — stronger ink/line/focus"
    }
}
