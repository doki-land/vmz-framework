{
    "name": "@vmz/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "VMZ production runtime core — DOM / SSR / HTTP / WriteBarrier (no compiler)",
    "exports": {
        ".": {
            "types": "./dist/faces/index.d.ts",
            "default": "./dist/faces/server.js"
        },
        "./dom": {
            "types": "./dist/faces/dom.d.ts",
            "default": "./dist/faces/dom.js"
        },
        "./dom/client": {
            "types": "./dist/faces/dom.client.d.ts",
            "default": "./dist/faces/dom.client.js"
        },
        "./dom/browser": {
            "types": "./dist/faces/dom.browser.d.ts",
            "default": "./dist/faces/dom.browser.js"
        },
        "./server": {
            "types": "./dist/faces/server.d.ts",
            "default": "./dist/faces/server.js"
        },
        "./http": {
            "types": "./dist/faces/http.d.ts",
            "default": "./dist/faces/http.js"
        },
        "./client-nav": {
            "types": "./dist/browser/client-nav.d.ts",
            "default": "./dist/browser/client-nav.js"
        },
        "./component-registry": {
            "types": "./dist/host/list-client-components.d.ts",
            "default": "./dist/host/list-client-components.js"
        },
        "./render-host": {
            "types": "./dist/host/render-host.d.ts",
            "default": "./dist/host/render-host.js"
        },
        "./route-layout-chain": {
            "types": "./dist/host/route-layout-chain.d.ts",
            "default": "./dist/host/route-layout-chain.js"
        },
        "./localize-body-links": {
            "types": "./dist/host/localize-body-links.d.ts",
            "default": "./dist/host/localize-body-links.js"
        },
        "./position-context": {
            "types": "./dist/browser/position-context.d.ts",
            "default": "./dist/browser/position-context.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "vmz",
        "runtime"
    ],
    "main": "./dist/faces/server.js",
    "types": "./dist/faces/index.d.ts",
    "scripts": {
        "build": "node ../../../scripts/build/clean-package-dist.mjs packages/runtimes/vmz-runtime/dist && tsc -p tsconfig.json && node ../../../scripts/build/copy-serve-host-mjs.mjs"
    },
    "dependencies": {
        "linkedom": "^0.18.13"
    },
    "optionalDependencies": {
        "@vmz/vmz-win32-x64": "workspace:*",
        "@vmz/vmz-win32-arm64": "workspace:*",
        "@vmz/vmz-darwin-x64": "workspace:*",
        "@vmz/vmz-darwin-arm64": "workspace:*",
        "@vmz/vmz-linux-x64": "workspace:*",
        "@vmz/vmz-linux-arm64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    }
}
