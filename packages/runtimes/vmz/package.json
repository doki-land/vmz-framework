{
    "name": "vmz",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "VMZ Node toolchain — N-API workspace session + CLI (publish name @vmz/vmz)",
    "license": "MIT",
    "bin": {
        "vmz": "./bin/vmz.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./dev-session": {
            "types": "./dist/dev-session.d.ts",
            "default": "./dist/dev-session.js"
        },
        "./plugin-host": {
            "types": "./dist/plugin-host.d.ts",
            "default": "./dist/plugin-host.js"
        },
        "./bundler-adapter": {
            "types": "./dist/bundler-adapter.d.ts",
            "default": "./dist/bundler-adapter.js"
        },
        "./test-protocol": {
            "types": "./dist/test-protocol.d.ts",
            "default": "./dist/test-protocol.js"
        },
        "./test-discover": {
            "types": "./dist/test-discover.d.ts",
            "default": "./dist/test-discover.js"
        },
        "./document-check": {
            "types": "./dist/document-check.d.ts",
            "default": "./dist/document-check.js"
        },
        "./document-schema": {
            "types": "./dist/document-schema.d.ts",
            "default": "./dist/document-schema.js"
        }
    },
    "dependencies": {
        "@vmz/commander": "workspace:*",
        "@vmz/core": "workspace:*",
        "@vmz/diagnostic": "workspace:*",
        "@vmz/plugin": "workspace:*",
        "@vmz/protocol": "workspace:*",
        "jiti": "^2.6.1"
    },
    "peerDependencies": {
        "@vmz/plugin-markdown-it": "workspace:*",
        "@vmz/test": "workspace:*",
        "typescript": "^5.8.3"
    },
    "peerDependenciesMeta": {
        "@vmz/plugin-markdown-it": {
            "optional": true
        },
        "@vmz/test": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "files": [
        "bin",
        "dist",
        "README.md"
    ],
    "scripts": {
        "build:native": "node ../../../scripts/build/napi.mjs",
        "build": "pnpm run build:native && pnpm run build:js",
        "test": "node --experimental-strip-types ./tests/run-node-tests.ts",
        "verify": "node --import ../../../scripts/test/resolve-ts-from-js.mjs --experimental-strip-types ./tests/conformance/run.ts",
        "verify:list": "node --import ../../../scripts/test/resolve-ts-from-js.mjs --experimental-strip-types ./tests/conformance/run.ts --list",
        "build:js": "tsc -p tsconfig.json && node ../../../scripts/build/copy-vmz-public-api.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@vmz/plugin": "workspace:*",
        "@vmz/plugin-katex": "workspace:*",
        "@vmz/plugin-markdown-it": "workspace:*",
        "@vmz/plugin-shiki": "workspace:*",
        "@vmz/test": "workspace:*",
        "linkedom": "^0.18.13",
        "typescript": "^5.8.3",
        "vmz-plugin-conformance": "workspace:*"
    },
    "keywords": [
        "vmz",
        "napi",
        "compiler",
        "cli"
    ],
    "optionalDependencies": {
        "@vmz/vmz-win32-x64": "workspace:*",
        "@vmz/vmz-win32-arm64": "workspace:*",
        "@vmz/vmz-darwin-x64": "workspace:*",
        "@vmz/vmz-darwin-arm64": "workspace:*",
        "@vmz/vmz-linux-x64": "workspace:*",
        "@vmz/vmz-linux-arm64": "workspace:*"
    }
}
