{
    "name": "vmz",
    "displayName": "VMZ",
    "description": "VMZ language support — TextMate grammar + LSP via `vmz lsp`",
    "version": "0.1.0",
    "private": true,
    "publisher": "vmz-framework",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:vmz"
    ],
    "main": "./extension.js",
    "scripts": {
        "sync": "node ../../../scripts/dev/sync-vscode-textmate.mjs",
        "prepackage": "pnpm sync",
        "package": "echo \"run vsce package after pnpm sync\""
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1",
        "vmz-textmate": "workspace:*"
    },
    "contributes": {
        "configuration": {
            "title": "VMZ",
            "properties": {
                "vmz.lsp.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Absolute path to the **native** `vmz` binary (vmz-tools). Empty = auto-detect (`VMZ_NATIVE`, workspace `target/{release,debug}/vmz`, then `vmz` on PATH)."
                },
                "vmz.lsp.arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra arguments after `lsp` (for example `--out-dir dist`)."
                },
                "vmz.lsp.trace": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VS Code and `vmz lsp`."
                }
            }
        },
        "languages": [
            {
                "id": "vmz",
                "aliases": [
                    "VMZ",
                    "vmz"
                ],
                "extensions": [
                    ".vmz"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "vmz",
                "scopeName": "source.vmz",
                "path": "./syntaxes/vmz.tmLanguage.json",
                "embeddedLanguages": {
                    "source.ts": "typescript",
                    "source.css": "css",
                    "text.html.derivative.vmz": "html",
                    "meta.interpolation.vmz": "typescript",
                    "meta.embedded.expression.vmz": "typescript"
                },
                "tokenTypes": {
                    "meta.interpolation.vmz": "other",
                    "meta.embedded.expression.vmz": "other"
                }
            },
            {
                "scopeName": "markdown.vmz.codeblock",
                "path": "./syntaxes/vmz-markdown-injection.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.vmz": "vmz"
                }
            }
        ]
    }
}
