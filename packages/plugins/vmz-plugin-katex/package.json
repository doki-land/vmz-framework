{
    "name": "@vmz/plugin-katex",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/plugins/vmz-plugin-katex"
    },
    "version": "0.3.12",
    "type": "module",
    "description": "VMZ KaTeX adapter - <Katex> + math engine registration",
    "license": "MIT",
    "main": "./dist/vmz.plugin.js",
    "types": "./dist/vmz.plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vmz.plugin.d.ts",
            "default": "./dist/vmz.plugin.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "default": "./dist/runtime.js"
        }
    },
    "files": [
        "dist",
        "components",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "engines": {
        "node": ">=24.12.0"
    },
    "dependencies": {
        "@vmz/plugin": "workspace:*",
        "katex": "0.18.4"
    },
    "peerDependencies": {
        "katex": ">=0.16"
    },
    "peerDependenciesMeta": {
        "katex": {
            "optional": false
        }
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    },
    "keywords": [
        "vmz",
        "plugin",
        "katex",
        "math"
    ]
}
