{
    "name": "@vmz/plugin-shiki",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "VMZ Shiki adapter - <Shiki> + code engine registration",
    "license": "MIT",
    "main": "./dist/vmz.plugin.js",
    "types": "./dist/vmz.plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vmz.plugin.d.ts",
            "default": "./dist/vmz.plugin.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "default": "./dist/runtime.js"
        }
    },
    "files": [
        "dist",
        "components",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@vmz/plugin": "workspace:*"
    },
    "peerDependencies": {
        "shiki": ">=3",
        "vmz-textmate": "*"
    },
    "peerDependenciesMeta": {
        "shiki": {
            "optional": false
        },
        "vmz-textmate": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "shiki": "^3.12.2",
        "typescript": "^5.8.3",
        "vmz-textmate": "workspace:*"
    },
    "keywords": [
        "vmz",
        "plugin",
        "shiki",
        "code"
    ]
}
