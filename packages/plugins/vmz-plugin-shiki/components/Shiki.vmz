<template>
    <div v-html="html != null ? html : highlightSync(code, lang, theme)" class="shiki-host" />
</template>
<script client>
import { highlight, highlightSync } from "@vmz/plugin-shiki/runtime";

export default class Shiki {
    public code: string = "";
    public lang: string = "text";
    public theme: string = "vitesse-dark";

    /**
     * `null` means "no client payload": the sync path only fills it on the
     * server (or after prewarm). Keeping it null lets the resumed host keep the
     * SSR payload instead of replacing tokenized markup with a fallback shell.
     */
    html: string | null = null;

    async onMount() {
        const next = await highlight(this.code, this.lang, this.theme);
        // A degraded payload must not replace the server's tokenized markup:
        // only an actual highlight is an improvement over what SSR wrote.
        if (!next.includes('shiki-fallback')) this.html = next;
    }
}
</script>
