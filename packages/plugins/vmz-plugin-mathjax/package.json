{
    "name": "@vmz/plugin-mathjax",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/plugins/vmz-plugin-mathjax"
    },
    "version": "0.3.7",
    "type": "module",
    "description": "VMZ MathJax adapter - <Mathjax> + math engine",
    "license": "MIT",
    "main": "./vmz.plugin.ts",
    "types": "./vmz.plugin.ts",
    "exports": {
        ".": {
            "types": "./vmz.plugin.ts",
