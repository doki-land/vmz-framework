{
    "name": "@vmz/plugin-mathjax",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "VMZ MathJax adapter - <Mathjax> + math engine",
    "license": "MIT",
    "main": "./vmz.plugin.ts",
    "types": "./vmz.plugin.ts",
    "exports": {
        ".": {
            "types": "./vmz.plugin.ts",
            "default": "./vmz.plugin.ts"
        },
        "./runtime": {
            "types": "./runtime.ts",
            "default": "./runtime.ts"
        }
    },
    "dependencies": {
        "@vmz/plugin": "workspace:*"
    },
    "peerDependencies": {
        "@mathjax/src": ">=4"
    },
    "peerDependenciesMeta": {
        "@mathjax/src": {
            "optional": false
        }
    },
    "devDependencies": {
        "@mathjax/src": "^4.1.3"
    },
    "keywords": [
        "vmz",
        "plugin",
        "mathjax",
        "math"
    ]
}
