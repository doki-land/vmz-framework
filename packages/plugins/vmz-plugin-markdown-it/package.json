{
    "name": "@vmz/plugin-markdown-it",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/plugins/vmz-plugin-markdown-it"
    },
    "version": "0.3.7",
    "type": "module",
    "description": "VMZ markdown-it adapter — MarkdownIt + engines.markdown registration",
    "license": "MIT",
    "main": "./dist/vmz.plugin.js",
    "types": "./dist/vmz.plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vmz.plugin.d.ts",
            "default": "./dist/vmz.plugin.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "default": "./dist/runtime.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "components",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@vmz/plugin": "workspace:*",
        "markdown-it": "^14.1.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    },
    "keywords": [
        "vmz",
        "plugin",
        "markdown",
        "markdown-it"
    ],
    "publishConfig": {
        "access": "public"
    }
}
