{
    "name": "@vmz/plugin-codemirror",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "VMZ CodeMirror 6 editor adapter - <Codemirror>",
    "license": "MIT",
    "main": "./vmz.plugin.ts",
    "types": "./vmz.plugin.ts",
    "exports": {
        ".": {
            "types": "./vmz.plugin.ts",
