{
    "name": "@doki-land/davinci-diagram",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/davinci/davinci-diagram"
    },
    "version": "0.0.0",
    "type": "module",
    "description": "DaVinci Diagram domain: DiagramSpec -> DiagramLayoutPlan -> SemanticScene -> DisplayScene.",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./spec": {
            "types": "./dist/spec.d.ts",
            "default": "./dist/spec.js"
        },
        "./layout": {
            "types": "./dist/layout.d.ts",
            "default": "./dist/layout.js"
        },
        "./mermaid": {
            "types": "./dist/mermaid.d.ts",
