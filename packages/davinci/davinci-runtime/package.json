{
    "name": "@doki-land/davinci-runtime",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/davinci/davinci-runtime"
    },
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "DaVinci Runtime: RuntimeState, normalized events, reducer, invalidation graph, hit test.",
