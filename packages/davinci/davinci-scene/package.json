{
    "name": "@doki-land/davinci-scene",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/vmz-framework.git",
        "directory": "packages/davinci/davinci-scene"
    },
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "DaVinci Scene: SemanticScene / DisplayScene separation, resolve pipeline, stable ids.",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./semantic": {
            "types": "./dist/semantic.d.ts",
            "default": "./dist/semantic.js"
        },
        "./display": {
            "types": "./dist/display.d.ts",
            "default": "./dist/display.js"
        },
        "./resolve": {
            "types": "./dist/resolve.d.ts",
            "default": "./dist/resolve.js"
        },
        "./svg": {
            "types": "./dist/svg.d.ts",
            "default": "./dist/svg.js"
        }
    },
    "files": [
        "src",
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@doki-land/davinci-types": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.8.3"
    },
    "keywords": [
        "vmz",
        "davinci",
        "scene",
        "semantic",
        "display"
    ]
}
