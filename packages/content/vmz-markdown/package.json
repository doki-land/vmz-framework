        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "typescript": "^5.8.3"
    },
    "keywords": [
        "vmz",
        "markdown"
    ]
}
