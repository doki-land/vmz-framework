{
    "name": "@vmz/markdown",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Replaceable markdown render surface (plain safe subset; no markdown-it default)",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
