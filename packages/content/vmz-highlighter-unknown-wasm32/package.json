{
    "name": "@vmz/highlighter-unknown-wasm32",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "wasm32-oriented unknown-language highlighter fallback (thin stub; no .wasm binary required)",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@vmz/highlighter": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.8.3"
    },
    "keywords": [
        "vmz",
        "highlighter",
        "wasm32"
    ]
}
