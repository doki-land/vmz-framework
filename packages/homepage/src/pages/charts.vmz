<template>
    <SiteShell page="charts" variant="charts-gallery-page">
        <main id="main" class="charts-gallery">
            <header class="charts-gallery__head">
                <p class="kicker">
                    <span aria-hidden="true" class="kicker__dot" />
                    {{ kickerLabel }}
                </p>
                <h1>
                    {{ titleLabel }}
                </h1>
                <p class="charts-gallery__lead">
                    {{ leadLabel }}
                </p>
                <div role="group" :aria-label="sizeLabel" class="charts-gallery__sizes">
                    <button type="button" :data-active="chartWidth === 480 ? 'true' : 'false'" @click="() => setChartWidth(480)" class="charts-gallery__size">
                        480 px
                    </button>
                    <button type="button" :data-active="chartWidth === 720 ? 'true' : 'false'" @click="() => setChartWidth(720)" class="charts-gallery__size">
                        720 px
                    </button>
                </div>
            </header>
            <section v-for="item in examples" :key="item.id" class="chart-card">
                <header class="chart-card__head">
                    <h2>
                        {{ item.title }}
                    </h2>
                    <button type="button" :aria-expanded="activeDetail === item.id ? 'true' : 'false'" @click="() => toggleDetail(item.id)" class="chart-card__toggle">
                        {{ getToggleLabel(item.id) }}
                    </button>
                </header>
                <div class="chart-card__body">
                    <div class="chart-card__canvas">
                        <Chart :spec="item.spec" :data="item.rows" :width="chartWidth" :height="chartHeight" />
                    </div>
                    <div v-if="activeDetail === item.id" class="chart-card__detail">
                        <h3>
                            {{ specTitleLabel }}
                        </h3>
                        <pre class="chart-card__code">
                            <code>
                                {{ item.specText }}
                            </code>
                        </pre>
                        <h3>
                            {{ dataTitleLabel }}
                        </h3>
                        <pre class="chart-card__code">
                            <code>
                                {{ item.dataText }}
                            </code>
                        </pre>
                    </div>
                </div>
            </section>
            <section class="chart-card">
                <header class="chart-card__head">
                    <h2>
                        {{ diagramTitle }}
                    </h2>
                </header>
                <div class="chart-card__body">
                    <div class="chart-card__canvas">
                        <Diagram :spec="diagramSpec" />
                    </div>
                    <div class="chart-card__detail">
                        <h3>
                            {{ diagramSpecTitleLabel }}
                        </h3>
                        <pre class="chart-card__code">
                            <code>
                                {{ diagramSpecText }}
                            </code>
                        </pre>
                    </div>
                </div>
            </section>
        </main>
    </SiteShell>
</template>
<style>
.charts-gallery {
    width: min(calc(100% - var(--site-gutter) * 2), var(--vmz-layout-max-width));
    margin: 0 auto;
    padding: calc(var(--site-section-pad) * 0.9) 0 var(--site-section-pad);
}
.charts-gallery__head {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
    margin-bottom: 2rem;
}
.charts-gallery__head h1 {
    margin: 0;
    color: var(--vmz-text-ink);
    font: 600 clamp(2rem, 4vw, 2.75rem) / 1.2 var(--vmz-font-display);
}
.charts-gallery__lead {
    margin: 0;
    color: var(--vmz-text-steel);
    font: 400 1rem / 1.7 var(--vmz-font-sans);
}
.charts-gallery__sizes {
    display: flex;
    gap: 0.5rem;
}
.charts-gallery__size {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    font: 500 0.8rem / 1 var(--vmz-font-sans);
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease;
}
.charts-gallery__size[data-active="true"] {
    border-color: var(--vmz-text-ink);
    color: var(--vmz-text-ink);
}
.charts-gallery__size:hover {
    border-color: var(--vmz-text-steel);
    color: var(--vmz-text-ink);
}
.chart-card {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
}
.chart-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
}
.chart-card__head h2 {
    margin: 0;
    color: var(--vmz-text-ink);
    font: 600 1.15rem / 1.6 var(--vmz-font-display);
}
.chart-card__toggle {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    font: 500 0.8rem / 1 var(--vmz-font-sans);
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease;
}
.chart-card__toggle:hover {
    border-color: var(--vmz-text-steel);
    color: var(--vmz-text-ink);
}
.chart-card__body {
    display: grid;
    gap: 1rem;
}
.chart-card__canvas {
    padding: 1rem;
    border: 1px dashed var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
    background: var(--vmz-surface-paper);
}
.chart-card__detail {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--vmz-line-default);
}
.chart-card__detail h3 {
    margin: 0;
    color: var(--vmz-text-ink);
    font: 600 0.9rem / 1.4 var(--vmz-font-display);
}
.chart-card__code {
    margin: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-fill);
    overflow-x: auto;
    font: 400 0.78rem / 1.55 var(--vmz-font-mono);
    color: var(--vmz-text-ink);
    white-space: pre;
}
</style>
<script client>
/**
 * 图表预览页。
 *
 * 作者面只消费 `@vmz/ui-charts` 的 `<Chart />` 与 `<Diagram />`，不导入
 * `@doki-land/davinci/*`，也不自行拼接 SVG。演示输入只存在于同页
 * `<script server>` 与 `../demo/chart-gallery.ts`（构建期输入），一份 spec /
 * rows 同时驱动渲染与展示文本。
 */
import {
    chartGalleryDiagram,
    chartGalleryExamples,
    type ChartGalleryDiagram,
    type ChartGalleryExample,
} from "../demo/chart-gallery.ts";
import { pageMeta } from "../page-meta.ts";

export default class ChartGalleryPage {
    static meta = pageMeta(
        "图表预览 · VMZ",
        "Chart gallery · VMZ",
        "VMZ 图表预览，消费公开 UI 作者面 @vmz/ui-charts 的 Chart 与 Diagram 组件。",
        "VMZ chart gallery consuming the public @vmz/ui-charts Chart and Diagram components.",
    );

    /** 构建期与 SSR 取数：读同一份演示输入，静态预渲染不依赖 `#server` RPC。 */
    static load() {
        const examples = chartGalleryExamples();
        const diagram = chartGalleryDiagram();
        return {
            examples,
            diagramTitle: diagram.title,
            diagramSpec: diagram.spec,
            diagramSpecText: diagram.specText,
        };
    }

    kickerLabel = "VMZ · DaVinci Charts";
    titleLabel = "图表预览";
    leadLabel = "预览消费公开 UI 作者面 @vmz/ui-charts，由它绑定 @doki-land/davinci 引擎完成编译、场景解析与 SVG 呈现。";
    specTitleLabel = "ChartSpec";
    dataTitleLabel = "示例数据";
    diagramSpecTitleLabel = "DiagramSpec";
    sizeLabel = "图表尺寸";
    showSpecLabel = "查看规格";
    hideSpecLabel = "收起规格";

    activeDetail = "";
    chartWidth = 480;
    chartHeight = 260;

    /** 由 `static load` 注入的示例输入（public = 页面 props）。 */
    public examples: ChartGalleryExample[] = [];
    public diagramTitle = "";
    public diagramSpec: ChartGalleryDiagram["spec"] | null = null;
    public diagramSpecText = "";

    setChartWidth(width: number) {
        this.chartWidth = width;
    }

    toggleDetail(id: string) {
        this.activeDetail = this.activeDetail === id ? "" : id;
    }

    getToggleLabel(id: string): string {
        return this.activeDetail === id ? this.hideSpecLabel : this.showSpecLabel;
    }
}
</script>
<script server>
/**
 * 图表预览的服务端取数能力。spec / rows 与展示文本来自
 * `../../demo/chart-gallery.ts` 的同一份构建期输入，页面不在作者面另写常量。
 */
import { chartGalleryDiagram, chartGalleryExamples } from "../../demo/chart-gallery.ts";

export default class ChartGalleryPageServer {
    getExamples() {
        return chartGalleryExamples();
    }

    getDiagram() {
        return chartGalleryDiagram();
    }
}
</script>
