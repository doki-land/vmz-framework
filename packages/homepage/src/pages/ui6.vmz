<template>
  <div data-vmz-fixture="ui6" :data-density="density" :dir="dir">
    <AppShell brand="VMZ" home-href="/" nav-label="UI6" :nav="navItems">
      <Alert
        tone="info"
        role-name="status"
        title="UI6 Density / RTL / Preset"
        description="comfortable → compact → dense; dir ltr/rtl; high-contrast theme overlay from /designs."
      />

      <p data-vmz-fixture="ui6-state">density:{{ density }};dir:{{ dir }};theme:{{ theme }}</p>
      <div class="vmz-ui6-actions">
        <Button type="button" @click="cycleDensity">Cycle density</Button>
        <Button type="button" variant="secondary" @click="toggleDir">Toggle RTL</Button>
        <Button type="button" variant="ghost" @click="toggleTheme">Toggle high-contrast</Button>
      </div>

      <Card title="Density sample" description="Button padding follows data-density; chrome from Style Theme.">
        <Field
          label="Sample field"
          description="Control spacing from density tokens"
          control-id="home-ui6-sample"
          description-id="home-ui6-sample-desc"
          :value="sample"
          @input="onSample"
        />
        <Button type="button">Probe control</Button>
      </Card>
    </AppShell>
  </div>
</template>

<style>
.vmz-ui6-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem 0.75rem;
}
</style>

<script client>
export default class Ui6Page {
  density = 'comfortable';
  dir = 'ltr';
  theme = 'default';
  sample = '';
  navItems = [
    { id: 'ui6', title: 'UI6', href: '/ui6' },
    { id: 'ui4', title: 'UI4', href: '/ui4' },
    { id: 'ui5', title: 'UI5', href: '/ui5' },
    { id: 'commercial', title: 'Commercial', href: '/commercial' },
  ];

  cycleDensity() {
    if (this.density === 'comfortable') this.density = 'compact';
    else if (this.density === 'compact') this.density = 'dense';
    else this.density = 'comfortable';
  }

  toggleDir() {
    this.dir = this.dir === 'rtl' ? 'ltr' : 'rtl';
  }

  toggleTheme() {
    const next = this.theme === 'high-contrast' ? 'default' : 'high-contrast';
    this.theme = next;
    if (typeof document !== 'undefined') {
      document.documentElement.setAttribute('data-theme', next);
    }
  }

  onSample(e) {
    const t = e?.target;
    this.sample = t && 'value' in t ? String(t.value) : '';
  }
}
</script>
