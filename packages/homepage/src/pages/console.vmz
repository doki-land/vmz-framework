<template>
  <div data-vmz-fixture="console" class="vmz-console-page">
    <ConsoleShell
      brand="VMZ"
      home-href="/"
      title="运营控制台"
      nav-label="Console"
      :nav="navItems"
    >
      <section class="vmz-console-summary" aria-label="Operations summary">
        <Card title="活跃服务" description="过去 24 小时">
          <strong class="vmz-console-stat">12</strong>
          <Badge tone="success">稳定</Badge>
        </Card>
        <Card title="待处理发布" description="Release queue">
          <strong class="vmz-console-stat">3</strong>
          <Badge tone="warning">需关注</Badge>
        </Card>
        <Card title="受影响区域" description="最近编译">
          <strong class="vmz-console-stat">1</strong>
          <Badge tone="info">Direct</Badge>
        </Card>
        <Card title="告警" description="Open incidents">
          <strong class="vmz-console-stat">0</strong>
          <Badge tone="success">正常</Badge>
        </Card>
      </section>

      <FilterBar label="Query">
        <Field
          label="名称包含"
          control-id="home-console-query"
          description-id="home-console-query-desc"
          error-id="home-console-query-err"
          described-by="home-console-query-desc"
          :value="query"
          @input="(e) => (query = e.target.value)"
        />
        <Button type="button" @click="applyFilter">Apply</Button>
        <Button type="button" @click="selectVisible">Select visible</Button>
      </FilterBar>

      <p class="vmz-sr-only" data-vmz-fixture="console-query">query:{{ query }}</p>

      <BulkActions
        label="Bulk actions"
        :selected-count="selectedCount"
        :count-label="bulkLabel"
      />
      <Button type="button" @click="() => (selectedCount = 0)">Clear selection</Button>

      <Table
        :columns="columns"
        :rows="rows"
        :has-row-action="rowAction"
        action-title="Detail"
        action-label="Open"
        :on-row-action="openDetail"
      />

      <Pagination
        label="Rows"
        :status="pageStatus"
        :prev-disabled="prevDisabled"
        :next-disabled="nextDisabled"
        :on-prev="goPrev"
        :on-next="goNext"
      />

      <Drawer
        :open="drawerOpen"
        title="Row detail"
        title-id="home-console-drawer-title"
        :on-close="() => (drawerOpen = false)"
      >
        <p data-vmz-fixture="console-drawer-body">detail:{{ detailId }}</p>
      </Drawer>
    </ConsoleShell>
  </div>
</template>

<style>
.vmz-console-page .vmz-ui-console-shell__main {
  display: grid;
  gap: 0.85rem;
  align-content: start;
}

.vmz-console-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.55rem;
}

.vmz-console-summary .vmz-ui-card {
  min-height: 0;
  padding: 0.75rem 0.9rem;
}

.vmz-console-summary .vmz-ui-card__title {
  font-size: 0.92rem;
}

.vmz-console-summary .vmz-ui-card__description {
  font-size: 0.78rem;
}

.vmz-console-stat {
  display: block;
  margin: 0.2rem 0 0.35rem;
  font-family: var(--vmz-font-display);
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1;
  color: var(--vmz-text-ink);
}

.vmz-console-page .vmz-ui-filter-bar,
.vmz-console-page .vmz-ui-table-wrap {
  margin-top: 0;
}

@media (max-width: 900px) {
  .vmz-console-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .vmz-console-summary {
    grid-template-columns: 1fr;
  }
}
</style>

<script client>
export default class ConsolePage {
  query = '';
  appliedQuery = '';
  selectedCount = 0;
  bulkLabel = '';
  drawerOpen = false;
  detailId = '';
  page = 1;
  pageCount = 1;
  pageStatus = 'Page 1 / 1';
  prevDisabled = true;
  nextDisabled = true;
  rowAction = true;
  columns = [
    { id: 'name', title: '名称' },
    { id: 'owner', title: '负责人' },
    { id: 'status', title: '状态' },
    { id: 'updated', title: '更新时间' },
  ];
  allRows = [
    { id: 'r1', cells: ['Alpha', 'Platform', 'Active', '2m ago'] },
    { id: 'r2', cells: ['docs-portal', 'Docs', 'Paused', '18m ago'] },
    { id: 'r3', cells: ['edge-gateway', 'Infra', 'Active', '41m ago'] },
    { id: 'r4', cells: ['billing-ui', 'Growth', 'Draft', '1h ago'] },
    { id: 'r5', cells: ['status-page', 'Ops', 'Active', '3h ago'] },
    { id: 'r6', cells: ['internal-tools', 'Platform', 'Active', '6h ago'] },
  ];
  rows = [
    { id: 'r1', cells: ['Alpha', 'Platform', 'Active', '2m ago'] },
    { id: 'r2', cells: ['docs-portal', 'Docs', 'Paused', '18m ago'] },
    { id: 'r3', cells: ['edge-gateway', 'Infra', 'Active', '41m ago'] },
    { id: 'r4', cells: ['billing-ui', 'Growth', 'Draft', '1h ago'] },
  ];
  navItems = [
    { id: 'console', title: 'Console', href: '/console' },
    { id: 'commercial', title: 'Commercial', href: '/commercial' },
    { id: 'home', title: 'Homepage', href: '/' },
  ];

  onMount() {
    this.refreshPage();
  }

  applyFilter() {
    this.appliedQuery = this.query;
    const q = (this.query || '').trim().toLowerCase();
    const filtered = !q
      ? this.allRows.slice()
      : this.allRows.filter((row) =>
          row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
        );
    this.page = 1;
    this.refreshPage(filtered);
    this.clearSelection();
  }

  filteredRows() {
    const q = (this.appliedQuery || '').trim().toLowerCase();
    if (!q) return this.allRows.slice();
    return this.allRows.filter((row) =>
      row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
    );
  }

  refreshPage(source) {
    const list = source || this.filteredRows();
    const pageSize = 4;
    this.pageCount = Math.max(1, Math.ceil(list.length / pageSize) || 1);
    if (this.page > this.pageCount) this.page = this.pageCount;
    if (this.page < 1) this.page = 1;
    const start = (this.page - 1) * pageSize;
    this.rows = list.slice(start, start + pageSize);
    this.pageStatus = `Page ${this.page} / ${this.pageCount}`;
    this.prevDisabled = this.page <= 1;
    this.nextDisabled = this.page >= this.pageCount;
  }

  goPrev() {
    if (this.page <= 1) return;
    this.page -= 1;
    this.refreshPage();
  }

  goNext() {
    if (this.page >= this.pageCount) return;
    this.page += 1;
    this.refreshPage();
  }

  selectVisible() {
    this.selectedCount = this.rows.length;
    this.bulkLabel = `${this.selectedCount} selected`;
  }

  clearSelection() {
    this.selectedCount = 0;
    this.bulkLabel = '';
  }

  openDetail(id) {
    this.detailId = id;
    this.drawerOpen = true;
  }
}
</script>
