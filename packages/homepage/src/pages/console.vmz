<template>
    <div data-vmz-fixture="console" class="vmz-console-page">
        <ConsoleShell brand="VMZ" home-href="/" :active-nav-id="activeId" :title="consoleTitleLabel" :subtitle="consoleSubtitleLabel" :breadcrumb-label="consoleBreadcrumbLabel" :primary-action-label="consolePrimaryActionLabel" primary-action-href="/commercial" :nav-label="consoleNavLabel" :nav="navItems">
            <div class="vmz-console-content">
                <section :aria-label="consoleWorkspaceAriaLabel" class="vmz-console-workspace">
                    <div :aria-label="consoleSummaryAriaLabel" role="group" class="vmz-console-summary">
                        <div class="vmz-console-summary__primary">
                            <span class="vmz-console-summary__label">
                                {{ consoleStatAffectedRegionsLabel }}
                            </span>
                            <strong class="vmz-console-summary__value">
                                {{ summaryFailed }}
                            </strong>
                        </div>
                        <dl class="vmz-console-summary__secondary">
                            <div class="vmz-console-summary__metric">
                                <dt>
                                    {{ consoleStatPendingReleasesLabel }}
                                </dt>
                                <dd>
                                    {{ summaryRunning }}
                                </dd>
                            </div>
                            <div class="vmz-console-summary__metric">
                                <dt>
                                    {{ consoleStatActiveServicesLabel }}
                                </dt>
                                <dd>
                                    {{ summaryTotal }}
                                </dd>
                            </div>
                        </dl>
                        <p class="vmz-console-demo-note">
                            {{ demoNote }}
                        </p>
                    </div>
                    <div class="vmz-console-body">
                        <p v-if="loading" role="status" class="vmz-console-state">
                            {{ loadingLabel }}
                        </p>
                        <p v-if="loadError" role="alert" class="vmz-console-state">
                            {{ loadErrorLabel }}
                        </p>
                        <div v-if="!loading && !loadError" class="vmz-console-stream">
                            <FilterBar :label="consoleFilterLabel">
                                <Field :label="consoleFieldNameLabel" :placeholder="consoleFieldNamePlaceholder" control-id="home-console-query" description-id="home-console-query-desc" error-id="home-console-query-err" described-by="home-console-query-desc" :value="query" @input="((e) => query = e.target.value)" />
                                <Field :label="consoleFieldStatusLabel" :placeholder="consoleFieldStatusPlaceholder" control-id="home-console-status" description-id="home-console-status-desc" error-id="home-console-status-err" described-by="home-console-status-desc" :value="statusQuery" @input="((e) => statusQuery = e.target.value)" />
                                <div class="vmz-console-filter-actions">
                                    <Button type="button" variant="primary" @click="applyFilter">
                                        {{ consoleApplyLabel }}
                                    </Button>
                                    <div id="home-console-filter-more" class="vmz-console-filter-more">
                                        <Button type="button" variant="secondary" @click="resetFilter">
                                            {{ consoleResetLabel }}
                                        </Button>
                                        <Button type="button" variant="ghost" @click="selectVisible">
                                            {{ consoleSelectVisibleLabel }}
                                        </Button>
                                    </div>
                                </div>
                            </FilterBar>
                            <p data-vmz-fixture="console-query" class="vmz-sr-only">
                                query:
                                {{ query }}
                            </p>
                            <BulkActions :label="consoleBulkActionsLabel" :selected-count="selectedCount" :count-label="bulkLabel">
                                <Button type="button" variant="ghost" @click="clearSelection">
                                    {{ consoleClearSelectionLabel }}
                                </Button>
                            </BulkActions>
                            <div v-if="filterEmpty" data-vmz-fixture="console-filter-empty" role="status" class="vmz-console-empty">
                                <strong>
                                    {{ consoleFilterEmptyTitleLabel }}
                                </strong>
                                <p>
                                    {{ consoleFilterEmptyBodyLabel }}
                                </p>
                                <Button type="button" variant="secondary" @click="resetFilter">
                                    {{ consoleResetLabel }}
                                </Button>
                            </div>
                            <Table v-if="!filterEmpty" :columns="columns" :rows="rows" :has-row-action="rowAction" :action-title="consoleActionTitleLabel" :action-label="consoleActionLabel" :on-row-action="openDetail" />
                            <div v-if="!filterEmpty" class="vmz-console-footer">
                                <Pagination :label="consolePaginationLabel" :prev-label="consolePagePrevLabel" :next-label="consolePageNextLabel" :status="pageStatus" :prev-disabled="prevDisabled" :next-disabled="nextDisabled" :on-prev="goPrev" :on-next="goNext" />
                            </div>
                        </div>
                    </div>
                </section>
                <Drawer v-if="drawerOpen" :open="drawerOpen" :title="consoleDrawerTitleLabel" title-id="home-console-drawer-title" :on-close="(() => drawerOpen = false)">
                    <div class="vmz-console-drawer-content">
                        <Descriptions columns="1" :items="drawerItems" />
                        <div class="vmz-console-note">
                            <TextArea :label="noteLabel" :description="noteDescription" control-id="home-console-note" description-id="home-console-note-desc" error-id="home-console-note-err" described-by="home-console-note-desc" :value="noteDraft" :error="noteError" @input="onNoteInput" />
                            <Button type="button" variant="primary" @click="saveNote">
                                {{ noteSaveLabel }}
                            </Button>
                            <Message v-if="noteSaved" :title="noteSavedLabel" tone="success" :on-close="(() => noteSaved = false)" />
                        </div>
                    </div>
                </Drawer>
            </div>
        </ConsoleShell>
    </div>
</template>
<style>
.vmz-console-page {
    min-width: 0;
}

.vmz-console-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    align-content: start;
    min-width: 0;
}

.vmz-console-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
}

.vmz-console-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--vmz-space-2) var(--vmz-space-5);
    padding: var(--vmz-space-4) var(--vmz-space-5);
    border-bottom: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-mist);
}

.vmz-console-summary__primary {
    display: flex;
    align-items: baseline;
    gap: var(--vmz-space-2);
}

.vmz-console-summary__label {
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}

.vmz-console-summary__value {
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-display);
    font-size: var(--vmz-type-title);
    font-weight: var(--vmz-type-weight-semibold);
    line-height: var(--vmz-type-line-height-title);
    font-variant-numeric: tabular-nums;
}

.vmz-console-summary__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vmz-space-2) var(--vmz-space-5);
    margin: 0;
}

.vmz-console-summary__metric {
    display: flex;
    align-items: baseline;
    gap: var(--vmz-space-2);
}

.vmz-console-summary__metric dt {
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}

.vmz-console-summary__metric dd {
    margin: 0;
    color: var(--vmz-text-ink);
    font-size: var(--vmz-type-body);
    font-weight: var(--vmz-type-weight-medium);
    line-height: var(--vmz-type-line-height-body);
    font-variant-numeric: tabular-nums;
}

.vmz-console-demo-note {
    margin: 0 0 0 auto;
    color: var(--vmz-text-muted);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}

.vmz-console-body,
.vmz-console-stream {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    min-width: 0;
}

.vmz-console-stream .vmz-ui-filter-bar {
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--vmz-line-subtle);
    border-radius: 0;
    background: var(--vmz-surface-paper);
}

.vmz-console-filter-actions,
.vmz-console-filter-more {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--vmz-space-2);
}

.vmz-console-stream .vmz-ui-bulk-actions {
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--vmz-line-subtle);
    border-radius: 0;
    background: var(--vmz-surface-mist);
}

.vmz-console-stream .vmz-ui-table-wrap {
    margin: 0;
    border: 0;
    border-radius: 0;
}

.vmz-console-footer {
    padding: var(--vmz-space-3) var(--vmz-space-5);
    border-top: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-paper);
}

.vmz-console-footer .vmz-ui-pagination {
    margin: 0;
}

.vmz-console-state {
    margin: 0;
    padding: var(--vmz-space-5);
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-body);
    line-height: var(--vmz-type-line-height-body);
}

.vmz-console-empty {
    display: grid;
    justify-items: start;
    gap: var(--vmz-space-3);
    margin: 0;
    padding: var(--vmz-space-5);
    border-top: 1px solid var(--vmz-line-subtle);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-body);
    line-height: var(--vmz-type-line-height-body);
}

.vmz-console-empty strong {
    color: var(--vmz-text-ink);
    font-weight: var(--vmz-type-weight-semibold);
}

.vmz-console-empty p {
    margin: 0;
}

.vmz-console-drawer-content {
    display: grid;
    gap: var(--vmz-space-4);
}

.vmz-console-note {
    display: grid;
    justify-items: start;
    gap: var(--vmz-space-3);
    margin-top: var(--vmz-space-5);
    padding-top: var(--vmz-space-5);
    border-top: 1px solid var(--vmz-line-subtle);
}

.vmz-console-note .vmz-ui-textarea {
    width: 100%;
}
</style>
<script client>
import {
    consoleNavLabel,
    consoleTitle,
    consoleSubtitle,
    consoleBreadcrumb,
    consolePrimaryAction,
    consoleSummaryAria,
    consoleWorkspaceAria,
    consoleStatActiveServices,
    consoleStatPendingReleases,
    consoleStatAffectedRegions,
    consoleFilterLabel,
    consoleFilterEmptyTitle,
    consoleFilterEmptyBody,
    consoleFieldNameLabel,
    consoleFieldNamePlaceholder,
    consoleFieldStatusLabel,
    consoleFieldStatusPlaceholder,
    consoleApply,
    consoleReset,
    consoleSelectVisible,
    consoleBulkActions,
    consoleClearSelection,
    consoleBulkSelected,
    consoleColName,
    consoleColTarget,
    consoleColStatus,
    consoleColActor,
    consoleColUpdated,
    consoleActionTitle,
    consoleActionLabel,
    consolePaginationLabel,
    consolePagePrev,
    consolePageNext,
    consoleDrawerTitle,
    consoleDrawerProject,
    consoleDrawerTarget,
    consoleDrawerStatus,
    consoleDrawerActor,
    consoleDrawerUpdated,
    consoleDrawerBranch,
    consolePageStatus,
    navAbout,
    navDocs,
    navLab,
    navProduct,
    navShowcase,
} from "#locales/common";
import ConsolePageServer from "#server/pages/console";
import {
    applyStatusToRow,
    statusAfterHandlingNote,
    summarizeTicketRows,
} from "../demo/ticket-rows.ts";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";
import { activeNavId, shellNav, siteNavItems } from "../nav.ts";

const initialConsoleSummary = { total: 0, running: 0, failed: 0 };
const initialConsoleRows = [];

import { pageMeta } from "../page-meta.ts";

export default class ConsolePage {
    static meta = pageMeta("客户请求 · VMZ", "Customer requests · VMZ");

    summaryTotal = initialConsoleSummary.total;
    loading = true;
    filterEmpty = false;
    loadError = false;
    demoNote = "";
    loadingLabel = "";
    loadErrorLabel = "";
    noteLabel = "";
    noteDescription = "";
    noteSaveLabel = "";
    noteSavedLabel = "";
    noteDraft = "";
    noteError = "";
    noteSaved = false;
    selectedTicketId = "";
    notes = {};
    statusOverrides = {};
    summaryRunning = initialConsoleSummary.running;
    summaryFailed = initialConsoleSummary.failed;
    query = "";
    statusQuery = "";
    appliedQuery = "";
    appliedStatusQuery = "";
    selectedCount = 0;
    bulkLabel = "";
    drawerOpen = false;
    drawerItems = [];
    detailProject = "";
    detailTarget = "";
    detailStatus = "";
    detailActor = "";
    detailUpdated = "";
    detailBranch = "";
    page = 1;
    pageCount = 1;
    pageStatus = "Page 1 / 1";
    prevDisabled = true;
    nextDisabled = true;
    rowAction = true;
    consoleNavLabel = "";
    consoleTitleLabel = "";
    consoleSubtitleLabel = "";
    consoleBreadcrumbLabel = "";
    consolePrimaryActionLabel = "";
    consoleSummaryAriaLabel = "";
    consoleWorkspaceAriaLabel = "";
    consoleStatActiveServicesLabel = "";
    consoleStatPendingReleasesLabel = "";
    consoleStatAffectedRegionsLabel = "";
    consoleFilterLabel = "";
    consoleFilterEmptyTitleLabel = "";
    consoleFilterEmptyBodyLabel = "";
    consoleFieldNameLabel = "";
    consoleFieldNamePlaceholder = "";
    consoleFieldStatusLabel = "";
    consoleFieldStatusPlaceholder = "";
    consoleApplyLabel = "";
    consoleResetLabel = "";
    consoleSelectVisibleLabel = "";
    consoleBulkActionsLabel = "";
    consoleClearSelectionLabel = "";
    consoleActionTitleLabel = "";
    consoleActionLabel = "";
    consolePaginationLabel = "";
    consolePagePrevLabel = "";
    consolePageNextLabel = "";
    consoleDrawerTitleLabel = "";
    consoleDrawerProjectLabel = "";
    consoleDrawerTargetLabel = "";
    consoleDrawerStatusLabel = "";
    consoleDrawerActorLabel = "";
    consoleDrawerUpdatedLabel = "";
    consoleDrawerBranchLabel = "";
    columns = [];
    allRows = initialConsoleRows.map((row) => ({
        id: row.id,
        status: row.status,
        cells: row.cells.map((cell) => String(cell)),
    }));
    rows = [];
    navItems = [];
    activeId = "showcase";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
        this.refreshPage();
        this.loadDemoData();
    }

    async loadDemoData() {
        try {
            const rows = await ConsolePageServer.getConsoleRows(readLocaleId());
            const summary = await ConsolePageServer.getSummary();
            if (Array.isArray(rows) && rows.length) {
                this.allRows = rows.map((row) => this.applyRowOverrides(row));
            }
            if (
                summary &&
                typeof summary === "object" &&
                !Object.keys(this.statusOverrides).length
            ) {
                this.summaryTotal = Number(summary.total) || this.summaryTotal;
                this.summaryRunning = Number(summary.running) || this.summaryRunning;
                this.summaryFailed = Number(summary.failed) || this.summaryFailed;
            } else {
                this.recomputeSummary();
            }
            this.loading = false;
            this.refreshPage();
        } catch (error) {
            console.error("Failed to load request demo", error);
            this.loading = false;
            this.loadError = true;
        }
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        const english = readLocaleId() === "en-us";
        this.demoNote = english
            ? "Interactive workspace · Server provided sample records. No customer data is changed."
            : "演示工作台 · 数据来自服务端示例，不会修改真实客户记录。";
        this.loadingLabel = english ? "Loading requests…" : "正在加载请求…";
        this.loadErrorLabel = english
            ? "Requests are temporarily unavailable. Refresh to try again."
            : "请求暂时无法加载，请刷新页面重试。";
        this.noteLabel = english ? "Handling note" : "处理备注";
        this.noteDescription = english
            ? "Saved only in this browser session. No customer is notified."
            : "仅保留在当前浏览器会话，不会通知客户。";
        this.noteSaveLabel = english ? "Save note" : "保存备注";
        this.noteSavedLabel = english
            ? "Note saved. Request status updated for this demo session."
            : "备注已保存，示例请求状态已在当前演示会话内更新。";
        this.consoleNavLabel = consoleNavLabel();
        this.consoleTitleLabel = consoleTitle();
        this.consoleSubtitleLabel = consoleSubtitle();
        this.consoleBreadcrumbLabel = consoleBreadcrumb();
        this.consolePrimaryActionLabel = consolePrimaryAction();
        this.consoleSummaryAriaLabel = consoleSummaryAria();
        this.consoleWorkspaceAriaLabel = consoleWorkspaceAria();
        this.consoleStatActiveServicesLabel = consoleStatActiveServices();
        this.consoleStatPendingReleasesLabel = consoleStatPendingReleases();
        this.consoleStatAffectedRegionsLabel = consoleStatAffectedRegions();
        this.consoleFilterLabel = consoleFilterLabel();
        this.consoleFilterEmptyTitleLabel = consoleFilterEmptyTitle();
        this.consoleFilterEmptyBodyLabel = consoleFilterEmptyBody();
        this.consoleFieldNameLabel = consoleFieldNameLabel();
        this.consoleFieldNamePlaceholder = consoleFieldNamePlaceholder();
        this.consoleFieldStatusLabel = consoleFieldStatusLabel();
        this.consoleFieldStatusPlaceholder = consoleFieldStatusPlaceholder();
        this.consoleApplyLabel = consoleApply();
        this.consoleResetLabel = consoleReset();
        this.consoleSelectVisibleLabel = consoleSelectVisible();
        this.consoleBulkActionsLabel = consoleBulkActions();
        this.consoleClearSelectionLabel = consoleClearSelection();
        this.consoleActionTitleLabel = consoleActionTitle();
        this.consoleActionLabel = consoleActionLabel();
        this.consolePaginationLabel = consolePaginationLabel();
        this.consolePagePrevLabel = consolePagePrev();
        this.consolePageNextLabel = consolePageNext();
        this.consoleDrawerTitleLabel = consoleDrawerTitle();
        this.consoleDrawerProjectLabel = consoleDrawerProject();
        this.consoleDrawerTargetLabel = consoleDrawerTarget();
        this.consoleDrawerStatusLabel = consoleDrawerStatus();
        this.consoleDrawerActorLabel = consoleDrawerActor();
        this.consoleDrawerUpdatedLabel = consoleDrawerUpdated();
        this.consoleDrawerBranchLabel = consoleDrawerBranch();
        this.rebuildDrawerItems();
        this.columns = [
            { id: "name", title: consoleColName() },
            { id: "target", title: consoleColTarget() },
            { id: "status", title: consoleColStatus() },
            { id: "actor", title: consoleColActor() },
            { id: "updated", title: consoleColUpdated() },
        ];
        this.navItems = shellNav(
            siteNavItems(
                this.localeId,
                {
                    product: navProduct(),
                    docs: navDocs(),
                    showcase: navShowcase(),
                    lab: navLab(),
                    about: navAbout(),
                },
                docsPaths(this.localeId).docsRootHref,
            ),
        );
        this.activeId = activeNavId(this.currentPath(), this.localeId);
        if (this.selectedCount > 0) {
            this.bulkLabel = consoleBulkSelected().replace("{count}", String(this.selectedCount));
        }
        this.refreshPageStatus();
    }

    currentPath() {
        if (typeof window === "undefined" || !window.location) return "/console";
        return window.location.pathname || "/console";
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
        if (preferred && !this.loading) this.loadDemoData();
    }

    formatPageStatus(page, pageCount) {
        return consolePageStatus()
            .replace("{page}", String(page))
            .replace("{count}", String(pageCount));
    }

    refreshPageStatus() {
        this.pageStatus = this.formatPageStatus(this.page, this.pageCount);
    }

    applyFilter() {
        this.appliedQuery = this.query;
        this.appliedStatusQuery = this.statusQuery;
        this.page = 1;
        this.refreshPage();
        this.clearSelection();
    }

    resetFilter() {
        this.query = "";
        this.statusQuery = "";
        this.appliedQuery = "";
        this.appliedStatusQuery = "";
        this.page = 1;
        this.refreshPage();
        this.clearSelection();
    }

    filteredRows() {
        const nameQ = (this.appliedQuery || "").trim().toLowerCase();
        const statusQ = (this.appliedStatusQuery || "").trim().toLowerCase();
        return this.allRows.filter((row) => {
            const project = String(row.cells[0] || "").toLowerCase();
            const status = String(row.cells[2] || "").toLowerCase();
            if (nameQ && !project.includes(nameQ)) return false;
            if (statusQ && !status.includes(statusQ)) return false;
            return true;
        });
    }

    refreshPage(source) {
        const list = source || this.filteredRows();
        this.filterEmpty = this.allRows.length > 0 && list.length === 0;
        const pageSize = 5;
        this.pageCount = Math.max(1, Math.ceil(list.length / pageSize) || 1);
        if (this.page > this.pageCount) this.page = this.pageCount;
        if (this.page < 1) this.page = 1;
        const start = (this.page - 1) * pageSize;
        this.rows = list.slice(start, start + pageSize);
        this.refreshPageStatus();
        this.prevDisabled = this.page <= 1;
        this.nextDisabled = this.page >= this.pageCount;
    }

    goPrev() {
        if (this.page <= 1) return;
        this.page -= 1;
        this.refreshPage();
    }

    goNext() {
        if (this.page >= this.pageCount) return;
        this.page += 1;
        this.refreshPage();
    }

    selectVisible() {
        this.selectedCount = this.rows.length;
        this.bulkLabel = consoleBulkSelected().replace("{count}", String(this.selectedCount));
    }

    clearSelection() {
        this.selectedCount = 0;
        this.bulkLabel = "";
    }

    async openDetail(id) {
        this.selectedTicketId = id;
        this.noteDraft = this.notes[id] || "";
        this.noteError = "";
        this.noteSaved = false;
        this.drawerOpen = true;
        const row = this.allRows.find((entry) => entry.id === id);
        try {
            const detail = await ConsolePageServer.getTicketDetail(id, readLocaleId());
            if (detail && typeof detail === "object") {
                this.detailProject = String(detail.subject || "");
                this.detailTarget = String(detail.priorityLabel || "");
                this.detailStatus = row
                    ? String(row.cells[2] || "")
                    : String(detail.statusLabel || "");
                this.detailActor = String(detail.owner || "");
                this.detailUpdated = String(detail.updated || "");
                this.detailBranch = String(detail.context || "");
                this.rebuildDrawerItems();
                return;
            }
        } catch {
            /* fall back to visible row cells */
        }
        if (!row) return;
        this.detailProject = String(row.cells[0] || "");
        this.detailTarget = String(row.cells[1] || "");
        this.detailStatus = String(row.cells[2] || "");
        this.detailActor = String(row.cells[3] || "");
        this.detailUpdated = String(row.cells[4] || "");
        this.detailBranch = "";
        this.rebuildDrawerItems();
    }

    onNoteInput(event) {
        this.noteDraft = event.target.value;
        this.noteError = "";
        this.noteSaved = false;
    }

    effectiveStatus(row) {
        return this.statusOverrides[row.id] || row.status;
    }

    applyRowOverrides(row) {
        const status = this.effectiveStatus(row);
        return applyStatusToRow(row, status, readLocaleId());
    }

    recomputeSummary() {
        const summary = summarizeTicketRows(
            this.allRows.map((row) => ({ status: this.effectiveStatus(row) })),
        );
        this.summaryTotal = summary.total;
        this.summaryRunning = summary.running;
        this.summaryFailed = summary.failed;
    }

    syncTicketStatuses() {
        this.allRows = this.allRows.map((row) => this.applyRowOverrides(row));
        this.recomputeSummary();
        if (this.drawerOpen && this.selectedTicketId) {
            const row = this.allRows.find((entry) => entry.id === this.selectedTicketId);
            if (row) this.detailStatus = row.cells[2];
        }
        this.refreshPage();
    }

    rebuildDrawerItems() {
        this.drawerItems = [
            { term: this.consoleDrawerProjectLabel, detail: this.detailProject, fixture: "console-drawer-project" },
            { term: this.consoleDrawerTargetLabel, detail: this.detailTarget, fixture: "console-drawer-target" },
            { term: this.consoleDrawerStatusLabel, detail: this.detailStatus, fixture: "console-drawer-status" },
            { term: this.consoleDrawerActorLabel, detail: this.detailActor, fixture: "console-drawer-actor" },
            { term: this.consoleDrawerUpdatedLabel, detail: this.detailUpdated, fixture: "console-drawer-updated" },
            { term: this.consoleDrawerBranchLabel, detail: this.detailBranch, fixture: "console-drawer-branch" },
        ];
    }

    saveNote() {
        if (this.noteDraft.trim().length < 4) {
            this.noteError =
                readLocaleId() === "en-us"
                    ? "Enter at least four characters."
                    : "请至少填写四个字。";
            this.noteSaved = false;
            return;
        }
        this.notes = { ...this.notes, [this.selectedTicketId]: this.noteDraft.trim() };
        this.noteError = "";
        this.noteSaved = true;
        const row = this.allRows.find((entry) => entry.id === this.selectedTicketId);
        if (!row) return;
        const nextStatus = statusAfterHandlingNote(this.effectiveStatus(row));
        if (nextStatus !== this.effectiveStatus(row)) {
            this.statusOverrides = { ...this.statusOverrides, [row.id]: nextStatus };
            this.syncTicketStatuses();
        }
    }
}
</script>
<script server>
import {
    formatPriority,
    formatStatus,
    mapTicketRow,
    summarizeTicketRows,
} from "../../demo/ticket-rows.ts";
import TicketDemo from "#server/demo/TicketDemo";

export default class ConsolePageServer {
    getConsoleRows(locale) {
        return new TicketDemo().list(locale).map((ticket) => mapTicketRow(ticket, locale));
    }

    getSummary() {
        const rows = new TicketDemo().list().map((ticket) => mapTicketRow(ticket, "zh-hans"));
        return summarizeTicketRows(rows);
    }

    getTicketDetail(id, locale) {
        const ticket = new TicketDemo().list(locale).find((item) => item.id === id);
        if (!ticket) return null;
        return {
            ...ticket,
            priorityLabel: formatPriority(ticket.priority, locale),
            statusLabel: formatStatus(ticket.status, locale),
        };
    }
}
</script>
