<template>
  <div data-vmz-fixture="console" class="vmz-console-page">
    <ConsoleShell
      brand="VMZ"
      home-href="/"
      :title="consoleTitleLabel"
      :nav-label="consoleNavLabel"
      :nav="navItems"
    >
      <section class="vmz-console-summary" :aria-label="consoleSummaryAriaLabel">
        <Card :title="consoleStatActiveServicesLabel" :description="consoleStatActiveServicesDescLabel">
          <strong class="vmz-console-stat">{{ summaryTotal }}</strong>
          <Badge tone="success">{{ consoleStatStableLabel }}</Badge>
        </Card>
        <Card :title="consoleStatPendingReleasesLabel" :description="consoleStatPendingReleasesDescLabel">
          <strong class="vmz-console-stat">{{ summaryRunning }}</strong>
          <Badge tone="warning">{{ consoleStatNeedsAttentionLabel }}</Badge>
        </Card>
        <Card :title="consoleStatAffectedRegionsLabel" :description="consoleStatAffectedRegionsDescLabel">
          <strong class="vmz-console-stat">{{ summaryFailed }}</strong>
          <Badge tone="info">{{ consoleStatDirectLabel }}</Badge>
        </Card>
        <Card :title="consoleStatAlertsLabel" :description="consoleStatAlertsDescLabel">
          <strong class="vmz-console-stat">{{ summaryAlerts }}</strong>
          <Badge tone="success">{{ consoleStatNormalLabel }}</Badge>
        </Card>
      </section>

      <FilterBar :label="consoleFilterLabel">
        <Field
          :label="consoleFieldNameLabel"
          control-id="home-console-query"
          description-id="home-console-query-desc"
          error-id="home-console-query-err"
          described-by="home-console-query-desc"
          :value="query"
          @input="(e) => (query = e.target.value)"
        />
        <Button type="button" @click="applyFilter">{{ consoleApplyLabel }}</Button>
        <Button type="button" @click="selectVisible">{{ consoleSelectVisibleLabel }}</Button>
      </FilterBar>

      <p class="vmz-sr-only" data-vmz-fixture="console-query">query:{{ query }}</p>

      <BulkActions
        :label="consoleBulkActionsLabel"
        :selected-count="selectedCount"
        :count-label="bulkLabel"
      />
      <Button type="button" @click="() => (selectedCount = 0)">{{ consoleClearSelectionLabel }}</Button>

      <Table
        :columns="columns"
        :rows="rows"
        :has-row-action="rowAction"
        :action-title="consoleActionTitleLabel"
        :action-label="consoleActionLabel"
        :on-row-action="openDetail"
      />

      <Pagination
        :label="consolePaginationLabel"
        :status="pageStatus"
        :prev-disabled="prevDisabled"
        :next-disabled="nextDisabled"
        :on-prev="goPrev"
        :on-next="goNext"
      />

      <Drawer
        :open="drawerOpen"
        :title="consoleDrawerTitleLabel"
        title-id="home-console-drawer-title"
        :on-close="() => (drawerOpen = false)"
      >
        <p data-vmz-fixture="console-drawer-body">detail:{{ detailId }}</p>
      </Drawer>
    </ConsoleShell>
  </div>
</template>

<style>
.vmz-console-page .vmz-ui-console-shell__main {
  display: grid;
  gap: 0.85rem;
  align-content: start;
}

.vmz-console-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.55rem;
}

.vmz-console-summary .vmz-ui-card {
  min-height: 0;
  padding: 0.75rem 0.9rem;
}

.vmz-console-summary .vmz-ui-card__title {
  font-size: 0.92rem;
}

.vmz-console-summary .vmz-ui-card__description {
  font-size: 0.78rem;
}

.vmz-console-stat {
  display: block;
  margin: 0.2rem 0 0.35rem;
  font-family: var(--vmz-font-display);
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1;
  color: var(--vmz-text-ink);
}

.vmz-console-page .vmz-ui-filter-bar,
.vmz-console-page .vmz-ui-table-wrap {
  margin-top: 0;
}

@media (max-width: 900px) {
  .vmz-console-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .vmz-console-summary {
    grid-template-columns: 1fr;
  }
}
</style>

<script client>
import {
  consoleNavLabel,
  consoleTitle,
  consoleSummaryAria,
  consoleStatActiveServices,
  consoleStatActiveServicesDesc,
  consoleStatStable,
  consoleStatPendingReleases,
  consoleStatPendingReleasesDesc,
  consoleStatNeedsAttention,
  consoleStatAffectedRegions,
  consoleStatAffectedRegionsDesc,
  consoleStatDirect,
  consoleStatAlerts,
  consoleStatAlertsDesc,
  consoleStatNormal,
  consoleFilterLabel,
  consoleFieldNameLabel,
  consoleApply,
  consoleSelectVisible,
  consoleBulkActions,
  consoleClearSelection,
  consoleBulkSelected,
  consoleColName,
  consoleColOwner,
  consoleColStatus,
  consoleColUpdated,
  consoleActionTitle,
  consoleActionLabel,
  consolePaginationLabel,
  consoleDrawerTitle,
  consolePageStatus,
  commercialNavCommercial,
  commercialNavConsole,
  commercialNavHome,
} from '#locales/common';
import ConsolePageServer from '#server/pages/console';
import { readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class ConsolePage {
  summaryTotal = 6;
  summaryRunning = 2;
  summaryFailed = 1;
  summaryAlerts = 0;
  query = '';
  appliedQuery = '';
  selectedCount = 0;
  bulkLabel = '';
  drawerOpen = false;
  detailId = '';
  page = 1;
  pageCount = 1;
  pageStatus = 'Page 1 / 1';
  prevDisabled = true;
  nextDisabled = true;
  rowAction = true;
  consoleNavLabel = '';
  consoleTitleLabel = '';
  consoleSummaryAriaLabel = '';
  consoleStatActiveServicesLabel = '';
  consoleStatActiveServicesDescLabel = '';
  consoleStatStableLabel = '';
  consoleStatPendingReleasesLabel = '';
  consoleStatPendingReleasesDescLabel = '';
  consoleStatNeedsAttentionLabel = '';
  consoleStatAffectedRegionsLabel = '';
  consoleStatAffectedRegionsDescLabel = '';
  consoleStatDirectLabel = '';
  consoleStatAlertsLabel = '';
  consoleStatAlertsDescLabel = '';
  consoleStatNormalLabel = '';
  consoleFilterLabel = '';
  consoleFieldNameLabel = '';
  consoleApplyLabel = '';
  consoleSelectVisibleLabel = '';
  consoleBulkActionsLabel = '';
  consoleClearSelectionLabel = '';
  consoleActionTitleLabel = '';
  consoleActionLabel = '';
  consolePaginationLabel = '';
  consoleDrawerTitleLabel = '';
  columns = [];
  allRows = [
    { id: 'r1', cells: ['docs-site', 'Web + SSR', 'Succeeded', '12m ago'] },
    { id: 'r2', cells: ['docs-site', 'Edge', 'Running', '18m ago'] },
    { id: 'r3', cells: ['vmz-homepage', 'Web', 'Succeeded', '41m ago'] },
    { id: 'r4', cells: ['component-gallery', 'SSR', 'Queued', '1h ago'] },
    { id: 'r5', cells: ['docs-site', 'Native', 'Failed', '3h ago'] },
    { id: 'r6', cells: ['deploy-planner', 'Web', 'Succeeded', '6h ago'] },
  ];
  rows = [
    { id: 'r1', cells: ['docs-site', 'Web + SSR', 'Succeeded', '12m ago'] },
    { id: 'r2', cells: ['docs-site', 'Edge', 'Running', '18m ago'] },
    { id: 'r3', cells: ['vmz-homepage', 'Web', 'Succeeded', '41m ago'] },
    { id: 'r4', cells: ['component-gallery', 'SSR', 'Queued', '1h ago'] },
  ];
  navItems = [];
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    this.refreshPage();
    this.loadDemoData();
  }

  async loadDemoData() {
    try {
      const server = new ConsolePageServer();
      const rows = await server.getConsoleRows();
      const summary = await server.getSummary();
      if (Array.isArray(rows) && rows.length) {
        this.allRows = rows;
      }
      if (summary && typeof summary === 'object') {
        this.summaryTotal = Number(summary.total) || this.summaryTotal;
        this.summaryRunning = Number(summary.running) || this.summaryRunning;
        this.summaryFailed = Number(summary.failed) || this.summaryFailed;
      }
      this.refreshPage();
    } catch {
      /* SSR defaults remain the server fixture mirror */
    }
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.consoleNavLabel = consoleNavLabel();
    this.consoleTitleLabel = consoleTitle();
    this.consoleSummaryAriaLabel = consoleSummaryAria();
    this.consoleStatActiveServicesLabel = consoleStatActiveServices();
    this.consoleStatActiveServicesDescLabel = consoleStatActiveServicesDesc();
    this.consoleStatStableLabel = consoleStatStable();
    this.consoleStatPendingReleasesLabel = consoleStatPendingReleases();
    this.consoleStatPendingReleasesDescLabel = consoleStatPendingReleasesDesc();
    this.consoleStatNeedsAttentionLabel = consoleStatNeedsAttention();
    this.consoleStatAffectedRegionsLabel = consoleStatAffectedRegions();
    this.consoleStatAffectedRegionsDescLabel = consoleStatAffectedRegionsDesc();
    this.consoleStatDirectLabel = consoleStatDirect();
    this.consoleStatAlertsLabel = consoleStatAlerts();
    this.consoleStatAlertsDescLabel = consoleStatAlertsDesc();
    this.consoleStatNormalLabel = consoleStatNormal();
    this.consoleFilterLabel = consoleFilterLabel();
    this.consoleFieldNameLabel = consoleFieldNameLabel();
    this.consoleApplyLabel = consoleApply();
    this.consoleSelectVisibleLabel = consoleSelectVisible();
    this.consoleBulkActionsLabel = consoleBulkActions();
    this.consoleClearSelectionLabel = consoleClearSelection();
    this.consoleActionTitleLabel = consoleActionTitle();
    this.consoleActionLabel = consoleActionLabel();
    this.consolePaginationLabel = consolePaginationLabel();
    this.consoleDrawerTitleLabel = consoleDrawerTitle();
    this.columns = [
      { id: 'name', title: consoleColName() },
      { id: 'owner', title: consoleColOwner() },
      { id: 'status', title: consoleColStatus() },
      { id: 'updated', title: consoleColUpdated() },
    ];
    this.navItems = [
      { id: 'console', title: commercialNavConsole(), href: '/console' },
      { id: 'commercial', title: commercialNavCommercial(), href: '/commercial' },
      { id: 'home', title: commercialNavHome(), href: '/' },
    ];
    if (this.selectedCount > 0) {
      this.bulkLabel = consoleBulkSelected().replace('{count}', String(this.selectedCount));
    }
    this.refreshPageStatus();
  }

  applyLocaleCopy(preferred) {
    withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
  }

  formatPageStatus(page, pageCount) {
    return consolePageStatus().replace('{page}', String(page)).replace('{count}', String(pageCount));
  }

  refreshPageStatus() {
    this.pageStatus = this.formatPageStatus(this.page, this.pageCount);
  }

  applyFilter() {
    this.appliedQuery = this.query;
    const q = (this.query || '').trim().toLowerCase();
    const filtered = !q
      ? this.allRows.slice()
      : this.allRows.filter((row) =>
          row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
        );
    this.page = 1;
    this.refreshPage(filtered);
    this.clearSelection();
  }

  filteredRows() {
    const q = (this.appliedQuery || '').trim().toLowerCase();
    if (!q) return this.allRows.slice();
    return this.allRows.filter((row) =>
      row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
    );
  }

  refreshPage(source) {
    const list = source || this.filteredRows();
    const pageSize = 4;
    this.pageCount = Math.max(1, Math.ceil(list.length / pageSize) || 1);
    if (this.page > this.pageCount) this.page = this.pageCount;
    if (this.page < 1) this.page = 1;
    const start = (this.page - 1) * pageSize;
    this.rows = list.slice(start, start + pageSize);
    this.refreshPageStatus();
    this.prevDisabled = this.page <= 1;
    this.nextDisabled = this.page >= this.pageCount;
  }

  goPrev() {
    if (this.page <= 1) return;
    this.page -= 1;
    this.refreshPage();
  }

  goNext() {
    if (this.page >= this.pageCount) return;
    this.page += 1;
    this.refreshPage();
  }

  selectVisible() {
    this.selectedCount = this.rows.length;
    this.bulkLabel = consoleBulkSelected().replace('{count}', String(this.selectedCount));
  }

  clearSelection() {
    this.selectedCount = 0;
    this.bulkLabel = '';
  }

  openDetail(id) {
    this.detailId = id;
    this.drawerOpen = true;
  }
}
</script>

<script server>
import ReleaseDemo from '#server/demo/ReleaseDemo';

export default class ConsolePageServer {
  getConsoleRows() {
    return new ReleaseDemo().getConsoleRows();
  }

  getSummary() {
    return new ReleaseDemo().getSummary();
  }
}
</script>
