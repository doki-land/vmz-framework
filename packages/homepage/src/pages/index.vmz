                <h2 id="start-title" data-vmz-fixture="landing-start-title">
                    {{ startTitleLabel }}
                </h2>
                <p data-vmz-fixture="landing-start-lede">
                    {{ startLedeLabel }}
                </p>
                <div class="v2-actions">
                    <a data-vmz-fixture="landing-start-cta" :href="guideHref" class="v2-button v2-button--light">
                        {{ startLabel }}
                    </a>
                </div>
            </section>
        </main>
        <SiteFooter />
    </div>
</template>
<script client>
import {
    readDocs,
    gettingStartedGuide,
    start,
    heroKicker,
    heroTitleLead,
    heroTitleEm,
    heroLede,
    heroFootnote,
    heroPrimaryCta,
    viewProductUi,
    heroPreviewDemoLabel,
    heroPreviewReleaseCenter,
    heroPreviewProductionReady,
    statementIndex,
    statementTitleLead,
    statementTitleEm,
    statementBody,
    featuresAria,
    feature1Title,
    feature1Body,
    feature2Title,
    feature2Body,
    feature3Title,
    feature3Body,
    flowIndex,
    flowTitle,
    flowStep1Title,
    flowStep1Desc,
    flowStep2Title,
    flowStep2Desc,
    flowStep3Title,
    flowStep3Desc,
    showcaseIndex,
    showcaseTitle,
    showcaseBody,
    productCloudName,
    productNavOverview,
    productNavProjects,
    productNavMonitor,
    productWorkspaceLabel,
    productCreateRelease,
    showcaseTabSource,
    startIndex,
    startTitle,
    startLede,
} from "#locales/common";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

export default class IndexPage {
    sampleCount = 0;
    localeId = "zh-hans";
    heroKickerLabel = "";
    heroTitleLeadLabel = "";
    heroTitleEmLabel = "";
    heroLedeLabel = "";
    heroFootnoteLabel = "";
    heroPrimaryCtaLabel = "";
    viewProductUiLabel = "";
    heroPreviewDemoLabelText = "";
    heroPreviewReleaseCenterLabel = "";
    heroPreviewProductionReadyLabel = "";
    statementIndexLabel = "";
    statementTitleLeadLabel = "";
    statementTitleEmLabel = "";
    statementBodyLabel = "";
    featuresAriaLabel = "";
    feature1TitleLabel = "";
    feature1BodyLabel = "";
    feature2TitleLabel = "";
    feature2BodyLabel = "";
    feature3TitleLabel = "";
    feature3BodyLabel = "";
    flowIndexLabel = "";
    flowTitleLabel = "";
    flowStep1TitleLabel = "";
    flowStep1DescLabel = "";
    flowStep2TitleLabel = "";
    flowStep2DescLabel = "";
    flowStep3TitleLabel = "";
    flowStep3DescLabel = "";
    showcaseIndexLabel = "";
    showcaseTitleLabel = "";
    showcaseBodyLabel = "";
    productCloudNameLabel = "";
    productNavOverviewLabel = "";
    productNavProjectsLabel = "";
    productNavMonitorLabel = "";
    productWorkspaceLabel = "";
    productCreateReleaseLabel = "";
    showcaseTabSourceLabel = "";
    startIndexLabel = "";
    startTitleLabel = "";
    startLedeLabel = "";
    readDocsLabel = "";
    gettingStartedGuideLabel = "";
    startLabel = "";
    docsRootHref = "/d/zh-hans/";
    guideHref = "/d/zh-hans/guide/";
    _unwatchLocale = null;
    codeSample =
        '<template>\n  <Button @click="() => (count += 1)">\n    Count {{ count }}\n  </Button>\n</template>\n\n<script client>\nexport default class Counter {\n  count = 0;\n}\n</scr' +
        "ipt>";

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        const bump = (key) => {
            this[key] = "\u200b";
        };
        const keys = [
            "heroKickerLabel",
            "heroTitleLeadLabel",
            "heroTitleEmLabel",
            "heroLedeLabel",
            "heroFootnoteLabel",
            "heroPrimaryCtaLabel",
            "viewProductUiLabel",
            "heroPreviewDemoLabelText",
            "heroPreviewReleaseCenterLabel",
            "heroPreviewProductionReadyLabel",
            "statementIndexLabel",
            "statementTitleLeadLabel",
            "statementTitleEmLabel",
            "statementBodyLabel",
            "featuresAriaLabel",
            "feature1TitleLabel",
            "feature1BodyLabel",
            "feature2TitleLabel",
            "feature2BodyLabel",
            "feature3TitleLabel",
            "feature3BodyLabel",
            "flowIndexLabel",
            "flowTitleLabel",
            "flowStep1TitleLabel",
            "flowStep1DescLabel",
            "flowStep2TitleLabel",
            "flowStep2DescLabel",
            "flowStep3TitleLabel",
            "flowStep3DescLabel",
            "showcaseIndexLabel",
            "showcaseTitleLabel",
            "showcaseBodyLabel",
            "productCloudNameLabel",
            "productNavOverviewLabel",
            "productNavProjectsLabel",
            "productNavMonitorLabel",
            "productWorkspaceLabel",
            "productCreateReleaseLabel",
            "showcaseTabSourceLabel",
            "startIndexLabel",
            "startTitleLabel",
            "startLedeLabel",
            "readDocsLabel",
            "gettingStartedGuideLabel",
            "startLabel",
        ];
        for (const k of keys) bump(k);

        this.heroKickerLabel = heroKicker();
        this.heroTitleLeadLabel = heroTitleLead();
        this.heroTitleEmLabel = heroTitleEm();
        this.heroLedeLabel = heroLede();
        this.heroFootnoteLabel = heroFootnote();
        this.heroPrimaryCtaLabel = heroPrimaryCta();
        this.viewProductUiLabel = viewProductUi();
        this.heroPreviewDemoLabelText = heroPreviewDemoLabel();
        this.heroPreviewReleaseCenterLabel = heroPreviewReleaseCenter();
        this.heroPreviewProductionReadyLabel = heroPreviewProductionReady();
        this.statementIndexLabel = statementIndex();
        this.statementTitleLeadLabel = statementTitleLead();
        this.statementTitleEmLabel = statementTitleEm();
        this.statementBodyLabel = statementBody();
        this.featuresAriaLabel = featuresAria();
        this.feature1TitleLabel = feature1Title();
        this.feature1BodyLabel = feature1Body();
        this.feature2TitleLabel = feature2Title();
        this.feature2BodyLabel = feature2Body();
        this.feature3TitleLabel = feature3Title();
        this.feature3BodyLabel = feature3Body();
        this.flowIndexLabel = flowIndex();
        this.flowTitleLabel = flowTitle();
        this.flowStep1TitleLabel = flowStep1Title();
        this.flowStep1DescLabel = flowStep1Desc();
        this.flowStep2TitleLabel = flowStep2Title();
        this.flowStep2DescLabel = flowStep2Desc();
        this.flowStep3TitleLabel = flowStep3Title();
        this.flowStep3DescLabel = flowStep3Desc();
        this.showcaseIndexLabel = showcaseIndex();
        this.showcaseTitleLabel = showcaseTitle();
        this.showcaseBodyLabel = showcaseBody();
        this.productCloudNameLabel = productCloudName();
        this.productNavOverviewLabel = productNavOverview();
        this.productNavProjectsLabel = productNavProjects();
        this.productNavMonitorLabel = productNavMonitor();
        this.productWorkspaceLabel = productWorkspaceLabel();
        this.productCreateReleaseLabel = productCreateRelease();
        this.showcaseTabSourceLabel = showcaseTabSource();
        this.startIndexLabel = startIndex();
        this.startTitleLabel = startTitle();
        this.startLedeLabel = startLede();
        this.readDocsLabel = readDocs();
        this.gettingStartedGuideLabel = gettingStartedGuide();
        this.startLabel = start();

        const paths = docsPaths(this.localeId);
        this.docsRootHref = paths.docsRootHref;
        this.guideHref = paths.guideHref;
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
    }
}
</script>
