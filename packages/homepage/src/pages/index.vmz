      <section class="v2-flow" aria-labelledby="flow-title">
        <div class="v2-signal" :aria-label="heroSignalAriaLabel">
          <div><small>{{ heroSignalAuthorLabel }}</small><strong>{{ heroSignalAuthorValueLabel }}</strong></div>
