  startLede,
  copyCommand,
  copiedCommand,
  consoleStatActiveServices,
  consoleStatPendingReleases,
  consoleStatAffectedRegions,
  consoleSummaryAria,
} from '#locales/common';
import IndexPageServer from '#server/pages/index';
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class IndexPage {
  showcaseTab = 'source';
  copied = false;
  localeId = 'zh-hans';
  heroKickerLabel = '';
  heroTitleLeadLabel = '';
  heroTitleEmLabel = '';
  heroLedeLabel = '';
  heroFootnoteLabel = '';
  viewProductUiLabel = '';
  heroPreviewDemoLabelText = '';
  heroPreviewSiteNameLabel = '';
  heroPreviewAriaLabel = '';
  heroPreviewReleaseCenterLabel = '';
  heroPreviewProductionReadyLabel = '';
  heroPreviewPathLabel = 'vmz-docs / docs-site';
  heroPreviewSummaryLine = 'main · Web + SSR + Edge · 12m ago';
  showcasePathLabel = 'vmz-docs / docs-site';
  showcaseSummaryLine = 'main · Web + SSR + Edge · 12m ago';
  showcaseSummaryTotal = 6;
  showcaseSummaryRunning = 2;
  showcaseSummaryFailed = 1;
  showcaseSummaryTotalLabel = '';
  showcaseSummaryRunningLabel = '';
  showcaseSummaryFailedLabel = '';
  showcaseSummaryAriaLabel = '';
  heroPreviewTargets = [
    { id: 'browser', name: 'Browser', result: 'Static shell', status: 'succeeded', statusLabel: 'Ready' },
    { id: 'ssr', name: 'SSR', result: 'Hydration bundle', status: 'succeeded', statusLabel: 'Ready' },
    { id: 'edge', name: 'Edge', result: 'Worker route', status: 'running', statusLabel: 'Running' },
