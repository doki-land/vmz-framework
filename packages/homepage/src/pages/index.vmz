  heroSignalUnderstandValueLabel = '';
  heroSignalDeliverLabel = '';
  heroSignalDeliverValueLabel = '';
  statementIndexLabel = '';
  statementTitleLeadLabel = '';
  statementTitleEmLabel = '';
  statementBodyLabel = '';
  featuresAriaLabel = '';
  feature1TitleLabel = '';
  feature1BodyLabel = '';
  feature1TagLabel = '';
  feature2TitleLabel = '';
