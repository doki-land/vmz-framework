<template>
  <div class="site landing-page landing-v2">
    <SiteHeader />
    <main>
      <section class="v2-hero" aria-labelledby="landing-title" data-vmz-fixture="landing-brand">
        <p class="v2-kicker" data-vmz-fixture="landing-hero-kicker">{{ heroKickerLabel }}</p>
        <h1 id="landing-title" data-vmz-fixture="landing-hero-title">{{ heroTitleLeadLabel }}<br /><em>{{ heroTitleEmLabel }}</em></h1>
        <p class="v2-lede" data-vmz-fixture="landing-hero-lede">{{ heroLedeLabel }}</p>
        <div class="v2-actions">
          <a class="v2-button v2-button--primary" data-vmz-fixture="landing-primary-cta" :href="guideHref">{{ buildLabel }}</a>
          <a class="v2-button v2-button--text" data-vmz-fixture="landing-secondary-cta" :href="docsRootHref">{{ readDocsLabel }} <span aria-hidden="true">→</span></a>
        </div>
        <div class="v2-signal" aria-label="VMZ compilation model">
          <div><small>Author</small><strong>Components</strong></div>
          <i aria-hidden="true"></i>
          <div class="is-core"><small>Understand</small><strong>Program Graph</strong></div>
          <i aria-hidden="true"></i>
          <div><small>Deliver</small><strong>Every surface</strong></div>
        </div>
      </section>

      <section class="v2-statement" aria-labelledby="statement-title">
        <p class="v2-index">01 / WHY VMZ</p>
        <div>
          <h2 id="statement-title" data-vmz-fixture="landing-statement-title">{{ statementTitleLeadLabel }}<br /><em>{{ statementTitleEmLabel }}</em></h2>
          <p data-vmz-fixture="landing-statement-body">{{ statementBodyLabel }}</p>
        </div>
      </section>

      <section class="v2-features" aria-label="VMZ core capabilities">
        <article class="v2-feature v2-feature--dark">
          <span class="v2-feature__number">01</span>
          <div class="v2-feature__icon">↯</div>
          <h3>修改之后，快速回来</h3>
          <p>文件变化沿依赖图传播。重分析、重编译和页面更新只覆盖真正受影响的区域。</p>
          <small>Incremental analysis</small>
        </article>
        <article class="v2-feature v2-feature--lime">
          <span class="v2-feature__number">02</span>
          <div class="v2-feature__icon">◎</div>
          <h3>浏览器只接手必要工作</h3>
          <p>能在生成阶段确定的依赖、调度和事件边界，不再交给通用客户端运行时重复判断。</p>
          <small>Direct update</small>
        </article>
        <article class="v2-feature v2-feature--paper">
          <span class="v2-feature__number">03</span>
          <div class="v2-feature__icon">⌁</div>
          <h3>服务端与客户端共享模型</h3>
          <p>HTML 可以先到达，交互可以稍后恢复；无需为两端维护互相漂移的应用逻辑。</p>
          <small>SSR resume</small>
        </article>
        <article class="v2-feature v2-feature--coral">
          <span class="v2-feature__number">04</span>
          <div class="v2-feature__icon">◇</div>
          <h3>一份程序，多种交付结果</h3>
          <p>同一份应用语义可以面向 Browser、SSR、Native 与 Edge 生成不同 Host Profile。</p>
          <small>Multi-platform</small>
        </article>
      </section>

      <section class="v2-feedback" aria-labelledby="feedback-title">
        <div class="v2-feedback__copy">
          <p class="v2-index">02 / DEVELOPMENT</p>
          <h2 id="feedback-title">保持思路，<br />不用等待整套应用。</h2>
          <p>保存组件后，VMZ 先定位受影响的依赖，再生成局部结果。反馈路径围绕程序图工作，而不是重新遍历所有内容。</p>
        </div>
        <ol class="v2-activity">
          <li><span>Changed</span><strong>Counter.vmz</strong><small>Source saved</small></li>
          <li><span>Analyzed</span><strong>1 affected region</strong><small>Dependency graph updated</small></li>
          <li class="is-current"><span>Delivered</span><strong>Browser is ready</strong><small>Only affected nodes updated</small></li>
        </ol>
      </section>

      <section class="v2-flow" aria-labelledby="flow-title">
        <div class="v2-section-head"><p class="v2-index">03 / COMPILER PIPELINE</p><h2 id="flow-title">从编写到交付，一条连续路径。</h2></div>
        <ol>
          <li><b>Write</b><span>单文件组件</span></li>
          <li><b>Analyze</b><span>依赖与边界</span></li>
          <li><b>Compile</b><span>精确更新计划</span></li>
          <li><b>Render</b><span>HTML 与静态输出</span></li>
          <li><b>Resume</b><span>按需恢复交互</span></li>
          <li><b>Deploy</b><span>多环境交付</span></li>
        </ol>
      </section>

      <section id="showcase" class="v2-showcase" aria-labelledby="showcase-title">
        <div class="v2-section-head">
          <p class="v2-index">04 / @VMZ/UI</p>
          <h2 id="showcase-title">构建产品界面，也用我们自己的组件。</h2>
          <p>下面的状态、切换、表格和通知全部由 <code>@vmz/ui</code> 组成。它面向需要长期维护的商业应用，而不只是组件演示。</p>
        </div>
        <div class="v2-product">
          <aside class="v2-product__side">
            <div class="v2-product__identity"><span class="v2-product__logo">V</span><strong>VMZ Cloud</strong></div>
            <nav aria-label="Product navigation"><a class="is-active" href="#showcase">概览</a><a href="#showcase">项目</a><a href="/deploy-planner">部署</a><a href="#showcase">监控</a></nav>
            <small>Production workspace</small>
          </aside>
          <div class="v2-product__work">
          <div class="v2-product__bar"><div><span>Projects / vmz-site</span><strong>Release Center</strong></div><Button type="button" @click="() => (notifyOpen = true)">创建发布</Button></div>
          <Tabs label="Product views" :selected="showcaseTab" panel-id="landing-showcase-panel" :items="showcaseTabs" :on-select="(id) => (showcaseTab = id)">
            <div v-if="showcaseTab === 'overview'" class="v2-dashboard">
              <div class="v2-metrics"><Card title="Build" description="main · latest"><Badge tone="success">Ready</Badge><strong>Production</strong></Card><Card title="Affected scope" description="Last compilation"><Badge tone="info">Direct</Badge><strong>1 region</strong></Card><Card title="Targets" description="Current profile"><Badge tone="brand">4 active</Badge><strong>Web to Edge</strong></Card></div>
              <div class="v2-table"><Table :columns="surfaceColumns" :rows="surfaceRows" sort-key="surface" sort-dir="asc" :has-row-action="false" /></div>
            </div>
            <div v-if="showcaseTab === 'source'" class="v2-source"><CodeBlock :code="codeSample" language="vmz" title="Counter.vmz" /></div>
            <div v-if="showcaseTab === 'activity'" class="v2-empty"><Badge tone="success">All systems ready</Badge><h3>最近的变更已经交付。</h3><p>Program Graph 与所有目标环境保持同步。</p></div>
          </Tabs></div>
        </div>
        <div v-if="notifyOpen" class="v2-notification"><Notification tone="success" role-name="status" title="发布已创建" description="Web、SSR、Native 与 Edge 目标正在生成。"><Button type="button" variant="ghost" @click="() => (notifyOpen = false)">关闭</Button></Notification></div>
      </section>

      <section class="v2-start" aria-labelledby="start-title">
        <p class="v2-index">05 / GET STARTED</p>
        <h2 id="start-title" data-vmz-fixture="landing-start-title">{{ startTitleLabel }}</h2>
        <p data-vmz-fixture="landing-start-lede">{{ startLedeLabel }}</p>
        <div class="v2-command"><code>pnpm create vmz-app my-app</code><Button type="button" variant="secondary" @click="copyCommand">{{ copied ? '已复制' : '复制' }}</Button></div>
        <div class="v2-actions"><a class="v2-button v2-button--light" data-vmz-fixture="landing-start-cta" :href="guideHref">{{ startLabel }}</a><a class="v2-button v2-button--dark-text" href="/deploy-planner">{{ deployPlannerLabel }} →</a></div>
      </section>
    </main>
    <SiteFooter />
  </div>
</template>

<script client>
import {
  build,
  readDocs,
  start,
  deployPlanner,
  heroKicker,
  heroTitleLead,
  heroTitleEm,
  heroLede,
  statementTitleLead,
  statementTitleEm,
  statementBody,
  startTitle,
  startLede,
} from '#locales/common';
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class IndexPage {
  showcaseTab = 'overview';
  notifyOpen = false;
  copied = false;
  localeId = 'zh-hans';
  heroKickerLabel = '';
  heroTitleLeadLabel = '';
  heroTitleEmLabel = '';
  heroLedeLabel = '';
  statementTitleLeadLabel = '';
  statementTitleEmLabel = '';
  statementBodyLabel = '';
  startTitleLabel = '';
  startLedeLabel = '';
  buildLabel = '';
  readDocsLabel = '';
  startLabel = '';
  deployPlannerLabel = '';
  docsRootHref = '/d/zh-hans/';
  guideHref = '/d/zh-hans/guide/';
  _unwatchLocale = null;
  showcaseTabs = [{ id: 'overview', title: '概览', controls: 'landing-showcase-panel' }, { id: 'source', title: '源码', controls: 'landing-showcase-panel' }, { id: 'activity', title: '活动', controls: 'landing-showcase-panel' }];
  codeSample = '<template>\n  <Button @click="increment">\n    Count {{ count }}\n  </Button>\n</template>';
  surfaceColumns = [{ id: 'surface', title: '目标' }, { id: 'result', title: '交付结果' }, { id: 'status', title: '状态' }];
  surfaceRows = [{ id: 'browser', cells: ['Browser', 'Direct DOM update', 'Ready'] }, { id: 'ssr', cells: ['SSR', 'HTML + resume', 'Ready'] }, { id: 'native', cells: ['Native', 'Host operations', 'Ready'] }, { id: 'edge', cells: ['Edge', 'Server capabilities', 'Ready'] }];

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    // Force dirty writes: soft-nav / resume can leave text nodes empty while the
    // next catalog string equals the previous reactive value (e.g. shared kickers).
    this.heroKickerLabel = '\u200b';
    this.heroTitleLeadLabel = '\u200b';
    this.heroTitleEmLabel = '\u200b';
    this.heroLedeLabel = '\u200b';
    this.statementTitleLeadLabel = '\u200b';
    this.statementTitleEmLabel = '\u200b';
    this.statementBodyLabel = '\u200b';
    this.startTitleLabel = '\u200b';
    this.startLedeLabel = '\u200b';
    this.buildLabel = '\u200b';
    this.readDocsLabel = '\u200b';
    this.startLabel = '\u200b';
    this.deployPlannerLabel = '\u200b';
    this.heroKickerLabel = heroKicker();
    this.heroTitleLeadLabel = heroTitleLead();
    this.heroTitleEmLabel = heroTitleEm();
    this.heroLedeLabel = heroLede();
    this.statementTitleLeadLabel = statementTitleLead();
    this.statementTitleEmLabel = statementTitleEm();
    this.statementBodyLabel = statementBody();
    this.startTitleLabel = startTitle();
    this.startLedeLabel = startLede();
    this.buildLabel = build();
    this.readDocsLabel = readDocs();
    this.startLabel = start();
    this.deployPlannerLabel = deployPlanner();
    const paths = docsPaths(this.localeId);
    this.docsRootHref = paths.docsRootHref;
    this.guideHref = paths.guideHref;
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  copyCommand() {
    const text = 'pnpm create vmz-app my-app';
    const ok = () => {
      this.copied = true;
    };
    const fail = () => {
      this.copied = false;
    };
    if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(ok, fail);
      return;
    }
    fail();
  }
}
</script>
