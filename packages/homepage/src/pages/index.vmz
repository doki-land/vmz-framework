  copiedCommandLabel = '';
  docsRootHref = '/d/zh-hans/';
  guideHref = '/d/zh-hans/guide/';
  _unwatchLocale = null;
  showcaseTabs = [];
  codeSample = '<template>\n  <Button @click="increment">\n    Count {{ count }}\n  </Button>\n</template>';
  surfaceColumns = [];
  surfaceRows = [];

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    this.loadDemoFixture();
  }

  applyHeroPreview(preview) {
    if (!preview || typeof preview !== 'object') return;
    const workspace = String(preview.workspace || '').trim();
    const project = String(preview.project || '').trim();
    if (workspace && project) {
      this.heroPreviewPathLabel = `${workspace} / ${project}`;
    }
    if (preview.summaryLine) {
      this.heroPreviewSummaryLine = String(preview.summaryLine);
    }
    if (Array.isArray(preview.targets) && preview.targets.length) {
      this.heroPreviewTargets = preview.targets.map((target) => ({
        id: String(target.id || ''),
        name: String(target.name || ''),
        result: String(target.result || ''),
        status: String(target.status || ''),
        statusLabel: String(target.statusLabel || ''),
      }));
    }
  }

  applyShowcaseOverview(showcase) {
    if (!showcase || typeof showcase !== 'object') return;
    if (showcase.pathLabel) {
      this.showcasePathLabel = String(showcase.pathLabel);
    }
    if (showcase.summaryLine) {
      this.showcaseSummaryLine = String(showcase.summaryLine);
    }
    if (showcase.summary && typeof showcase.summary === 'object') {
      this.showcaseSummaryTotal = Number(showcase.summary.total) || this.showcaseSummaryTotal;
      this.showcaseSummaryRunning = Number(showcase.summary.running) || this.showcaseSummaryRunning;
      this.showcaseSummaryFailed = Number(showcase.summary.failed) || this.showcaseSummaryFailed;
    }
    if (Array.isArray(showcase.surfaceRows) && showcase.surfaceRows.length) {
      this.surfaceRows = showcase.surfaceRows.map((row) => ({
        id: String(row.id || ''),
        cells: Array.isArray(row.cells) ? row.cells.map((cell) => String(cell)) : [],
      }));
    }
  }

  async loadDemoFixture() {
    try {
      const server = new IndexPageServer();
      const preview = await server.getHeroPreview();
      const showcase = await server.getShowcaseOverview();
      this.applyHeroPreview(preview);
      this.applyShowcaseOverview(showcase);
    } catch {
      /* SSR defaults mirror the server fixture */
    }
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    const bump = (key) => {
      this[key] = '\u200b';
    };
    const keys = [
      'heroKickerLabel', 'heroTitleLeadLabel', 'heroTitleEmLabel', 'heroLedeLabel', 'heroFootnoteLabel', 'viewProductUiLabel',
      'heroPreviewDemoLabelText', 'heroPreviewSiteNameLabel',
      'heroPreviewAriaLabel', 'heroPreviewReleaseCenterLabel', 'heroPreviewProductionReadyLabel',
      'heroPreviewMetricBuildLabel', 'heroPreviewMetricScopeLabel', 'heroPreviewMetricTargetsLabel',
      'heroPreviewBranchMainLabel', 'heroPreviewScopeOneRegionLabel', 'heroPreviewTargetsActiveLabel',
      'heroPreviewStatusReadyLabel', 'heroPreviewStatusDirectLabel', 'heroPreviewStatusWebToEdgeLabel',
      'heroPreviewTableAriaLabel', 'heroPreviewColTargetLabel', 'heroPreviewColResultLabel', 'heroPreviewColStatusLabel',
      'heroPreviewRowBrowserLabel', 'heroPreviewRowBrowserResultLabel', 'heroPreviewRowSsrLabel', 'heroPreviewRowSsrResultLabel',
      'heroSignalAriaLabel', 'heroSignalAuthorLabel', 'heroSignalAuthorValueLabel', 'heroSignalUnderstandLabel',
      'heroSignalUnderstandValueLabel', 'heroSignalDeliverLabel', 'heroSignalDeliverValueLabel',
      'statementIndexLabel', 'statementTitleLeadLabel', 'statementTitleEmLabel', 'statementBodyLabel',
      'featuresAriaLabel', 'feature1TitleLabel', 'feature1BodyLabel', 'feature1TagLabel',
      'feature2TitleLabel', 'feature2BodyLabel', 'feature2TagLabel', 'feature3TitleLabel', 'feature3BodyLabel', 'feature3TagLabel',
      'flowIndexLabel', 'flowTitleLabel', 'flowStep1TitleLabel', 'flowStep1DescLabel', 'flowStep2TitleLabel', 'flowStep2DescLabel',
      'flowStep3TitleLabel', 'flowStep3DescLabel', 'flowStep4TitleLabel', 'flowStep4DescLabel', 'flowStep5TitleLabel', 'flowStep5DescLabel',
      'flowStep6TitleLabel', 'flowStep6DescLabel',
      'showcaseIndexLabel', 'showcaseTitleLabel', 'showcaseBodyLabel', 'productCloudNameLabel',
      'productNavOverviewLabel', 'productNavProjectsLabel', 'productNavMonitorLabel',
      'productWorkspaceLabel', 'productCreateReleaseLabel', 'showcaseTabsLabel',
      'showcaseMetricBuildLabel', 'showcaseMetricBuildDescLabel', 'showcaseMetricScopeLabel', 'showcaseMetricScopeDescLabel',
      'showcaseMetricTargetsLabel', 'showcaseMetricTargetsDescLabel', 'showcaseBadgeProductionLabel', 'showcaseBadgeDirectLabel',
      'showcaseBadgeActiveLabel', 'showcaseBadgeWebToEdgeLabel', 'showcaseStatusReadyLabel',
      'showcaseEmptyBadgeLabel', 'showcaseEmptyTitleLabel', 'showcaseEmptyBodyLabel', 'showcaseTabSourceLabel',
      'startIndexLabel', 'startTitleLabel', 'startLedeLabel', 'buildLabel', 'readDocsLabel', 'gettingStartedGuideLabel', 'startLabel',
      'copyCommandLabel', 'copiedCommandLabel',
    ];
    for (const k of keys) bump(k);

    this.heroKickerLabel = heroKicker();
    this.heroTitleLeadLabel = heroTitleLead();
    this.heroTitleEmLabel = heroTitleEm();
    this.heroLedeLabel = heroLede();
    this.heroFootnoteLabel = heroFootnote();
    this.viewProductUiLabel = viewProductUi();
    this.heroPreviewDemoLabelText = heroPreviewDemoLabel();
    this.heroPreviewSiteNameLabel = heroPreviewSiteName();
    this.heroPreviewAriaLabel = heroPreviewAria();
    this.heroPreviewReleaseCenterLabel = heroPreviewReleaseCenter();
    this.heroPreviewProductionReadyLabel = heroPreviewProductionReady();
    this.heroPreviewMetricBuildLabel = heroPreviewMetricBuild();
    this.heroPreviewMetricScopeLabel = heroPreviewMetricScope();
    this.heroPreviewMetricTargetsLabel = heroPreviewMetricTargets();
    this.heroPreviewBranchMainLabel = heroPreviewBranchMain();
    this.heroPreviewScopeOneRegionLabel = heroPreviewScopeOneRegion();
    this.heroPreviewTargetsActiveLabel = heroPreviewTargetsActive();
    this.heroPreviewStatusReadyLabel = heroPreviewStatusReady();
    this.heroPreviewStatusDirectLabel = heroPreviewStatusDirect();
    this.heroPreviewStatusWebToEdgeLabel = heroPreviewStatusWebToEdge();
    this.heroPreviewTableAriaLabel = heroPreviewTableAria();
    this.heroPreviewColTargetLabel = heroPreviewColTarget();
    this.heroPreviewColResultLabel = heroPreviewColResult();
    this.heroPreviewColStatusLabel = heroPreviewColStatus();
    this.heroPreviewRowBrowserLabel = heroPreviewRowBrowser();
    this.heroPreviewRowBrowserResultLabel = heroPreviewRowBrowserResult();
    this.heroPreviewRowSsrLabel = heroPreviewRowSsr();
    this.heroPreviewRowSsrResultLabel = heroPreviewRowSsrResult();
    this.heroSignalAriaLabel = heroSignalAria();
    this.heroSignalAuthorLabel = heroSignalAuthor();
    this.heroSignalAuthorValueLabel = heroSignalAuthorValue();
    this.heroSignalUnderstandLabel = heroSignalUnderstand();
    this.heroSignalUnderstandValueLabel = heroSignalUnderstandValue();
    this.heroSignalDeliverLabel = heroSignalDeliver();
    this.heroSignalDeliverValueLabel = heroSignalDeliverValue();
    this.statementIndexLabel = statementIndex();
    this.statementTitleLeadLabel = statementTitleLead();
    this.statementTitleEmLabel = statementTitleEm();
    this.statementBodyLabel = statementBody();
    this.featuresAriaLabel = featuresAria();
    this.feature1TitleLabel = feature1Title();
    this.feature1BodyLabel = feature1Body();
    this.feature1TagLabel = feature1Tag();
    this.feature2TitleLabel = feature2Title();
