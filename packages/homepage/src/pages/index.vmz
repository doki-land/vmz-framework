  feature2TagLabel = '';
  feature3TitleLabel = '';
  feature3BodyLabel = '';
  feature3TagLabel = '';
  flowIndexLabel = '';
  flowTitleLabel = '';
  flowStep1TitleLabel = '';
  flowStep1DescLabel = '';
  flowStep2TitleLabel = '';
  flowStep2DescLabel = '';
  flowStep3TitleLabel = '';
  flowStep3DescLabel = '';
  flowStep4TitleLabel = '';
  flowStep4DescLabel = '';
  flowStep5TitleLabel = '';
  flowStep5DescLabel = '';
  flowStep6TitleLabel = '';
