            <p class="v2-lede" data-vmz-fixture="landing-hero-lede">{{ heroLedeLabel }}</p>
            <div class="v2-actions">
              <a class="v2-button v2-button--primary" data-vmz-fixture="landing-primary-cta" :href="guideHref">{{ buildLabel }}</a>
              <a class="v2-button v2-button--text" data-vmz-fixture="landing-secondary-cta" href="/commercial">{{ viewProductUiLabel }}</a>
