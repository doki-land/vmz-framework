      <section class="v2-start" aria-labelledby="start-title">
        <p class="v2-index">{{ startIndexLabel }}</p>
        <h2 id="start-title" data-vmz-fixture="landing-start-title">{{ startTitleLabel }}</h2>
        <p data-vmz-fixture="landing-start-lede">{{ startLedeLabel }}</p>
        <div class="v2-command"><code>pnpm create vmz-app my-app</code><Button type="button" variant="secondary" @click="copyCommand">{{ copied ? copiedCommandLabel : copyCommandLabel }}</Button></div>
        <div class="v2-actions"><a class="v2-button v2-button--light" data-vmz-fixture="landing-start-cta" :href="guideHref">{{ startLabel }}</a></div>
      </section>
    </main>
    <SiteFooter />
  </div>
</template>

<script client>
import {
