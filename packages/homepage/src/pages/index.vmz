        <article class="v2-feature">
          <div class="v2-feature__icon"><Icon name="feature.deploy" size="md" /></div>
          <h3>{{ feature3TitleLabel }}</h3>
          <p>{{ feature3BodyLabel }}</p>
        </article>
      </section>

      <section id="showcase" class="v2-showcase" aria-labelledby="showcase-title">
        <div class="v2-section-head">
          <p class="v2-index">{{ showcaseIndexLabel }}</p>
          <h2 id="showcase-title">{{ showcaseTitleLabel }}</h2>
          <p>{{ showcaseBodyLabel }}</p>
        </div>
        <div class="v2-product">
          <aside class="v2-product__side">
            <div class="v2-product__identity"><span class="v2-product__logo">V</span><strong>{{ productCloudNameLabel }}</strong></div>
            <nav :aria-label="productNavOverviewLabel"><a href="/console">{{ productNavOverviewLabel }}</a><a href="#showcase">{{ productNavProjectsLabel }}</a><a href="/commercial">{{ productNavMonitorLabel }}</a></nav>
            <small>{{ productWorkspaceLabel }}</small>
          </aside>
          <div class="v2-product__work">
          <div class="v2-product__bar"><div><span>{{ showcasePathLabel }}</span><strong>{{ showcaseTabSourceLabel }}</strong></div><Link href="/console">{{ productCreateReleaseLabel }}</Link></div>
          <Tabs :label="showcaseTabsLabel" :selected="showcaseTab" panel-id="landing-showcase-panel" :items="showcaseTabs" :on-select="(id) => (showcaseTab = id)">
            <div v-if="showcaseTab === 'overview'" class="v2-dashboard">
              <p class="v2-showcase-summary-line">{{ showcaseSummaryLine }}</p>
              <div class="v2-showcase-summary" :aria-label="showcaseSummaryAriaLabel">
                <div>
                  <small>{{ showcaseSummaryTotalLabel }}</small>
                  <strong>{{ showcaseSummaryTotal }}</strong>
                </div>
                <div>
                  <small>{{ showcaseSummaryRunningLabel }}</small>
                  <strong>{{ showcaseSummaryRunning }}</strong>
                </div>
                <div>
                  <small>{{ showcaseSummaryFailedLabel }}</small>
                  <strong :class="showcaseSummaryFailed > 0 ? 'is-failed' : ''">{{ showcaseSummaryFailed }}</strong>
                </div>
              </div>
              <div class="v2-table"><Table :columns="surfaceColumns" :rows="surfaceRows" sort-key="surface" sort-dir="asc" :has-row-action="false" /></div>
            </div>
            <div v-if="showcaseTab === 'source'" class="v2-source"><CodeBlock :code="codeSample" language="vmz" title="Counter.vmz" /></div>
            <div v-if="showcaseTab === 'activity'" class="v2-empty"><Badge tone="success">{{ showcaseEmptyBadgeLabel }}</Badge><h3>{{ showcaseEmptyTitleLabel }}</h3><p>{{ showcaseEmptyBodyLabel }}</p></div>
          </Tabs></div>
        </div>
