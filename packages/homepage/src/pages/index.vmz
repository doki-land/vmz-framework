                </div>
                <div v-for="target in heroPreviewTargets" :key="target.id" class="v2-hero-preview__row" role="row">
                  <span role="cell">{{ target.name }}</span><span role="cell">{{ target.result }}</span><span role="cell" :class="target.status === 'running' ? 'is-running' : ''">{{ target.statusLabel }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
