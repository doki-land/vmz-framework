                <p class="v2-index">
                    {{ statementIndexLabel }}
                </p>
                <div>
                    <h2 id="statement-title" data-vmz-fixture="landing-statement-title">
                        {{ statementTitleLeadLabel }}
                        <br />
                        <em>
                            {{ statementTitleEmLabel }}
                        </em>
                    </h2>
                    <p data-vmz-fixture="landing-statement-body">
                        {{ statementBodyLabel }}
                    </p>
                    <div class="v2-statement__actions">
                        <a :href="docsRootHref" class="v2-button v2-button--text">
                            {{ readDocsLabel }}
                        </a>
                        <a :href="guideHref" class="v2-button v2-button--text">
                            {{ gettingStartedGuideLabel }}
                        </a>
                    </div>
