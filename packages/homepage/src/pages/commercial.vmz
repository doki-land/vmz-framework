                <p class="vmz-commercial-status__note">
                    {{ demoNote }}
                </p>
            </section>
            <section :aria-label="commercialWorkspaceAriaLabel" class="vmz-commercial-workspace">
                <div data-vmz-fixture="commercial-task-browse" aria-labelledby="commercial-task-browse-title" class="vmz-commercial-step">
                    <div class="vmz-commercial-step__copy">
                        <span aria-hidden="true" class="vmz-commercial-step__index">
