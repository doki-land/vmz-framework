                <div data-vmz-fixture="commercial-task-action" aria-labelledby="commercial-task-action-title" class="vmz-commercial-step">
                    <div class="vmz-commercial-step__copy">
                        <span aria-hidden="true" class="vmz-commercial-step__index">
