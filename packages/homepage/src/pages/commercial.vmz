<template>
    <div data-vmz-fixture="commercial">
        <AppShell brand="VMZ" home-href="/" :nav-label="commercialNavLabel" :nav="navItems">
            <div class="vmz-commercial-content">
                <section data-vmz-fixture="commercial-hero" aria-labelledby="commercial-hero-title" class="vmz-commercial-hero">
                    <div class="vmz-commercial-hero__copy">
                        <p class="vmz-commercial-hero__eyebrow">
                            {{ commercialNavLabel }}
                        </p>
                        <h1 id="commercial-hero-title" class="vmz-commercial-hero__title">
                            {{ commercialHeroTitleLabel }}
                        </h1>
                        <p class="vmz-commercial-hero__lead">
                            {{ commercialHeroLeadLabel }}
                        </p>
                        <div class="vmz-commercial-hero__actions">
                            <Link href="/console">
                                {{ commercialCtaContactLabel }}
                            </Link>
                            <Link :href="guideHref">
                                {{ commercialCtaDocsLabel }}
                            </Link>
                        </div>
                        <p class="vmz-commercial-demo-note">
                            {{ demoNote }}
                        </p>
                    </div>
                    <div :aria-label="previewAriaLabel" class="vmz-commercial-hero__preview">
                        <div class="vmz-commercial-hero__preview-head">
                            <span>
                                {{ featuredId }}
                            </span>
                            <span>
                                {{ featuredStatusLabel }}
                            </span>
                        </div>
                        <strong>
                            {{ browseLoading ? loadingLabel : browseError ? loadErrorLabel : featuredSubjectLabel }}
                        </strong>
                        <p v-if="!browseLoading && !browseError">
                            {{ featuredContextLabel }}
                        </p>
                        <div class="vmz-commercial-hero__preview-foot">
                            <span>
                                {{ featuredOwnerLabel }}
                            </span>
                            <Button type="button" variant="secondary" @click="openFeaturedDetail">
                                {{ commercialDetailOpenLabel }}
                            </Button>
                        </div>
                    </div>
                </section>
                <section data-vmz-fixture="commercial-task-browse" aria-labelledby="commercial-task-browse-title" class="vmz-commercial-task">
                    <div class="vmz-commercial-task__copy">
                        <h2 id="commercial-task-browse-title">
                            {{ commercialFeature1TitleLabel }}
                        </h2>
                        <p>
                            {{ commercialFeature1DescLabel }}
                        </p>
                    </div>
                    <div class="vmz-commercial-task__demo vmz-commercial-panel">
                        <FilterBar :label="commercialBrowseFilterLabel">
                            <Field :label="commercialBrowseFieldLabel" control-id="home-commercial-browse-query" description-id="home-commercial-browse-desc" error-id="home-commercial-browse-err" described-by="home-commercial-browse-desc" :value="browseQuery" @input="((e) => browseQuery = e.target.value)" />
                            <Button type="button" variant="primary" @click="applyBrowseFilter">
                                {{ commercialBrowseApplyLabel }}
                            </Button>
                            <Button type="button" variant="secondary" @click="resetBrowseFilter">
                                {{ commercialBrowseResetLabel }}
                            </Button>
                        </FilterBar>
                        <p v-if="browseLoading" role="status" class="vmz-commercial-loading">
                            {{ loadingLabel }}
                        </p>
                        <p v-if="browseError" role="alert" class="vmz-commercial-loading">
                            {{ loadErrorLabel }}
                        </p>
                        <p v-if="!browseLoading && !browseError" class="vmz-commercial-scroll-hint">
                            {{ scrollHint }}
                        </p>
                        <Table v-if="!browseLoading && !browseError" :columns="browseColumns" :rows="browseRows" :has-row-action="false" />
                    </div>
                </section>
                <section data-vmz-fixture="commercial-task-detail" aria-labelledby="commercial-task-detail-title" class="vmz-commercial-task">
                    <div class="vmz-commercial-task__copy">
                        <h2 id="commercial-task-detail-title">
                            {{ commercialFeature2TitleLabel }}
                        </h2>
                        <p>
                            {{ commercialFeature2DescLabel }}
                        </p>
                    </div>
                    <div class="vmz-commercial-task__demo vmz-commercial-panel">
                        <p v-if="featuredId" class="vmz-commercial-detail-line">
                            {{ featuredId }}
                            ·
                            {{ featuredSubjectLabel }}
                            ·
                            {{ featuredStatusLabel }}
                        </p>
                        <p v-if="!featuredId" class="vmz-commercial-detail-line">
                            {{ loadingLabel }}
                        </p>
                        <div data-vmz-fixture="commercial-drawer-open">
                            <Button type="button" variant="secondary" @click="openFeaturedDetail">
                                {{ commercialDetailOpenLabel }}
                            </Button>
                        </div>
                        <Drawer v-if="drawerOpen" :open="drawerOpen" :title="commercialDrawerTitleLabel" title-id="home-commercial-drawer-title" :on-close="(() => drawerOpen = false)">
                            <div class="vmz-commercial-drawer-content">
                                <dl data-vmz-fixture="commercial-drawer-body" class="vmz-commercial-detail">
                                    <div>
                                        <dt>
                                            {{ commercialDrawerProjectLabel }}
                                        </dt>
                                        <dd data-vmz-fixture="commercial-drawer-project">
                                            {{ detailProject }}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>
                                            {{ commercialDrawerTargetLabel }}
                                        </dt>
                                        <dd data-vmz-fixture="commercial-drawer-target">
                                            {{ detailTarget }}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>
                                            {{ commercialDrawerStatusLabel }}
                                        </dt>
                                        <dd data-vmz-fixture="commercial-drawer-status">
                                            {{ detailStatus }}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>
                                            {{ commercialDrawerActorLabel }}
                                        </dt>
                                        <dd data-vmz-fixture="commercial-drawer-actor">
                                            {{ detailActor }}
                                        </dd>
                                    </div>
                                </dl>
                                <Link href="/console">
                                    {{ commercialOpenConsoleLabel }}
                                </Link>
                            </div>
                        </Drawer>
                    </div>
                </section>
                <section data-vmz-fixture="commercial-task-action" aria-labelledby="commercial-task-action-title" class="vmz-commercial-task">
                    <div class="vmz-commercial-task__copy">
                        <h2 id="commercial-task-action-title">
                            {{ commercialFeature3TitleLabel }}
                        </h2>
                        <p>
                            {{ commercialFeature3DescLabel }}
                        </p>
                    </div>
                    <div class="vmz-commercial-task__demo vmz-commercial-panel">
                        <Form :label="commercialFormLabel" :error-summary="actionSummary" summary-id="home-commercial-summary" :described-by="actionDescribedBy" @submit="confirmReview" @reset="resetReview">
                            <Field :label="commercialReviewNoteLabel" :description="commercialReviewNoteDescLabel" control-id="home-commercial-review" description-id="home-commercial-review-desc" error-id="home-commercial-review-err" :described-by="reviewDescribedBy" :error="reviewError" :invalid-attr="reviewInvalid" :value="reviewNote" @input="onReviewNote" />
                            <p data-vmz-fixture="commercial-review-note" class="vmz-sr-only">
                                note:
                                {{ reviewNote }}
                            </p>
                            <div data-vmz-fixture="commercial-form-actions" class="vmz-commercial-actions">
                                <Button type="submit">
                                    {{ commercialConfirmLabel }}
                                </Button>
                                <Button type="reset" variant="secondary">
                                    {{ commercialResetLabel }}
                                </Button>
                            </div>
                        </Form>
                        <div v-if="reviewSuccess" data-vmz-fixture="commercial-notify">
                            <Notification tone="success" role-name="status" :title="commercialNotifyTitleLabel" :description="commercialNotifyDescLabel">
                                <Button type="button" variant="ghost" @click="(() => reviewSuccess = false)">
                                    {{ commercialNotifyCloseLabel }}
                                </Button>
                            </Notification>
                        </div>
                    </div>
                </section>
            </div>
        </AppShell>
    </div>
</template>
<style>
.vmz-commercial-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 3rem;
    margin: 1rem 0 2.5rem;
    padding: 3rem;
    border: 1px solid #e5e6eb;
    border-radius: 10px;
    background: #f8fafc;
}
.vmz-commercial-hero__copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
}
.vmz-commercial-hero__eyebrow {
    margin: 0;
    color: #0958d9;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
}
.vmz-commercial-hero__preview {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid #dce3ec;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 12px 28px rgb(31 35 41 / 6%);
}
.vmz-commercial-hero__preview-head,
.vmz-commercial-hero__preview-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}
.vmz-commercial-hero__preview-head {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e5e6eb;
    color: #646a73;
    font: 500 0.8rem var(--vmz-font-mono);
}
.vmz-commercial-hero__preview-head span:last-child {
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    color: #8d4f00;
    background: #fff7e6;
    font: 500 0.75rem var(--vmz-font-sans);
}
.vmz-commercial-hero__preview strong {
    color: #1f2329;
    font: 600 1.15rem/1.4 var(--vmz-font-display);
}
.vmz-commercial-hero__preview p {
    margin: 0;
    color: #51565d;
    font-size: 0.875rem;
    line-height: 1.6;
}
.vmz-commercial-hero__preview-foot {
    padding-top: 1rem;
    border-top: 1px solid #e5e6eb;
    color: #646a73;
    font-size: 0.8125rem;
}
.vmz-commercial-content {
    width: 100%;
    min-width: 0;
}

.vmz-commercial-hero__title {
    margin: 0;
    font-family: var(--vmz-font-display);
    font-size: clamp(1.5rem, 3.6vw, 1.875rem);
    font-weight: 600;
    line-height: 1.35;
    color: #1f2329;
    max-width: 24ch;
}

.vmz-commercial-hero__lead {
    margin: 0;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.625;
    color: #51565d;
}

.vmz-commercial-hero__actions,
.vmz-commercial-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
}
.vmz-commercial-hero__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    color: #0958d9;
    font-weight: 600;
    text-decoration: none;
}
.vmz-commercial-hero__actions a:first-child {
    color: #fff;
    background: #1677ff;
}
.vmz-commercial-hero__actions a:first-child:hover {
    background: #0958d9;
}
.vmz-commercial-hero__actions a:not(:first-child):hover {
    background: #e6f4ff;
}

.vmz-commercial-task {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 0;
    border-top: 1px solid #e5e6eb;
}

.vmz-commercial-task__copy {
    display: grid;
    gap: 0.75rem;
}

.vmz-commercial-task__copy h2 {
    margin: 0;
    font-family: var(--vmz-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    color: #1f2329;
}

.vmz-commercial-task__copy p {
    margin: 0;
    color: #51565d;
    font-size: 0.875rem;
    line-height: 1.375rem;
}

.vmz-commercial-panel {
    display: grid;
    gap: 0;
    overflow: hidden;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    background: #fff;
}

.vmz-commercial-panel .vmz-ui-filter-bar {
    margin: 0;
    border: 0;
    border-bottom: 1px solid #e5e6eb;
    border-radius: 0;
}

.vmz-commercial-panel .vmz-ui-table-wrap {
    margin: 0;
    border: 0;
    border-radius: 0;
}
.vmz-commercial-panel .vmz-ui-table th,
.vmz-commercial-panel .vmz-ui-table td {
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
}

.vmz-commercial-panel .vmz-ui-form,
.vmz-commercial-panel .vmz-commercial-actions,
.vmz-commercial-panel .vmz-commercial-detail-line,
.vmz-commercial-panel [data-vmz-fixture="commercial-drawer-open"],
.vmz-commercial-panel [data-vmz-fixture="commercial-notify"] {
    padding: 1rem;
}

.vmz-commercial-detail-line {
    margin: 0;
    color: #51565d;
    font-size: 0.875rem;
    line-height: 1.375rem;
}

.vmz-commercial-detail {
    display: grid;
    gap: 0.85rem;
    margin: 0 0 1rem;
}

.vmz-commercial-detail > div {
    display: grid;
    gap: 0.2rem;
}

.vmz-commercial-detail dt {
    margin: 0;
    color: #646a73;
    font-size: 0.8125rem;
    line-height: 1.25rem;
}

.vmz-commercial-detail dd {
    margin: 0;
    color: #1f2329;
    font-size: 0.875rem;
    line-height: 1.375rem;
}

@media (max-width: 768px) {
    .vmz-commercial-hero {
        grid-template-columns: 1fr;
        gap: 1.75rem;
        padding: 1.5rem;
    }
    .vmz-commercial-task {
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
}
.vmz-commercial-demo-note {
    margin: 0.25rem 0 0;
    color: #646a73;
    font-size: 0.82rem;
}
.vmz-commercial-loading {
    margin: 0;
    padding: 1.5rem;
    color: #646a73;
}
.vmz-commercial-scroll-hint {
    display: none;
    margin: 0;
    padding: 0.65rem 1rem 0;
    color: #646a73;
    font-size: 0.75rem;
}
@media (max-width: 720px) {
    .vmz-commercial-scroll-hint {
        display: block;
    }
    .vmz-commercial-panel .vmz-ui-table {
        min-width: 42rem;
    }
}
</style>
<script client>
import {
    commercialNavLabel,
    commercialNavCommercial,
    commercialNavConsole,
    commercialNavHome,
    commercialHeroTitle,
    commercialHeroLead,
    commercialCtaContact,
    commercialCtaDocs,
    commercialFeature1Title,
    commercialFeature1Desc,
    commercialFeature2Title,
    commercialFeature2Desc,
    commercialFeature3Title,
    commercialFeature3Desc,
    commercialBrowseFilterLabel,
    commercialBrowseFieldLabel,
    commercialBrowseApply,
    commercialBrowseReset,
    commercialDetailSummary,
    commercialDetailOpen,
    commercialFormLabel,
    commercialReviewNoteLabel,
    commercialReviewNoteDesc,
    commercialConfirm,
    commercialReset,
    commercialNotifyTitle,
    commercialNotifyDesc,
    commercialNotifyClose,
    commercialDrawerTitle,
    commercialDrawerProject,
    commercialDrawerTarget,
    commercialDrawerStatus,
    commercialDrawerActor,
    commercialOpenConsole,
    commercialReviewError,
    commercialContactSummaryError,
    consoleColName,
    consoleColTarget,
    consoleColStatus,
    consoleColActor,
    consoleColUpdated,
} from "#locales/common";
import CommercialPageServer from "#server/pages/commercial";
import { applyStatusToRow, statusAfterHandlingNote } from "../demo/ticket-rows.ts";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

const initialBrowseRows = [];

export default class CommercialPage {
    browseQuery = "";
    appliedBrowseQuery = "";
    reviewNote = "";
    reviewError = "";
    reviewInvalid = "false";
    reviewDescribedBy = "home-commercial-review-desc";
    actionSummary = "";
    actionDescribedBy = "";
    reviewSuccess = false;
    statusOverrides = {};
    drawerOpen = false;
    detailProject = "";
    detailTarget = "";
    detailStatus = "";
    detailActor = "";
    localeId = "zh-hans";
    guideHref = "/d/zh-hans/guide/";
    commercialNavLabel = "";
    commercialHeroTitleLabel = "";
    commercialHeroLeadLabel = "";
    commercialCtaContactLabel = "";
    commercialCtaDocsLabel = "";
    commercialFeature1TitleLabel = "";
    commercialFeature1DescLabel = "";
    commercialFeature2TitleLabel = "";
    commercialFeature2DescLabel = "";
    commercialFeature3TitleLabel = "";
    commercialFeature3DescLabel = "";
    commercialBrowseFilterLabel = "";
    commercialBrowseFieldLabel = "";
    commercialBrowseApplyLabel = "";
    commercialBrowseResetLabel = "";
    commercialDetailSummaryLabel = "";
    commercialDetailOpenLabel = "";
    commercialFormLabel = "";
    commercialReviewNoteLabel = "";
    commercialReviewNoteDescLabel = "";
    commercialConfirmLabel = "";
    commercialResetLabel = "";
    commercialNotifyTitleLabel = "";
    commercialNotifyDescLabel = "";
    commercialNotifyCloseLabel = "";
    commercialDrawerTitleLabel = "";
    commercialDrawerProjectLabel = "";
    commercialDrawerTargetLabel = "";
    commercialDrawerStatusLabel = "";
    commercialDrawerActorLabel = "";
    commercialOpenConsoleLabel = "";
    browseColumns = [];
    allBrowseRows = initialBrowseRows.map((row) => ({
        id: row.id,
        status: row.status,
        cells: row.cells.map((cell) => String(cell)),
    }));
    browseRows = [];
    browseLoading = true;
    browseError = false;
    demoNote = "";
    loadingLabel = "";
    loadErrorLabel = "";
    scrollHint = "";
    previewAriaLabel = "";
    featuredId = "";
    featuredSubjectLabel = "";
    featuredContextLabel = "";
    featuredStatusLabel = "";
    featuredOwnerLabel = "";
    navItems = [];
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
        this.refreshBrowseRows();
        this.loadDemoData();
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    async loadDemoData() {
        this.browseError = false;
        try {
            const rows = await CommercialPageServer.getConsoleRows(readLocaleId());
            if (Array.isArray(rows) && rows.length) {
                this.allBrowseRows = rows.map((row) => this.applyRowOverrides(row));
                this.refreshBrowseRows();
                const featured = this.allBrowseRows[0];
                const detail = await CommercialPageServer.getTicketDetail(
                    featured.id,
                    readLocaleId(),
                );
                if (detail) {
                    this.featuredId = detail.id;
                    this.featuredSubjectLabel = detail.subject;
                    this.featuredContextLabel = detail.context;
                    this.featuredStatusLabel = featured.cells[2];
                    this.featuredOwnerLabel = detail.owner;
                }
            }
        } catch {
            this.browseError = true;
        } finally {
            this.browseLoading = false;
        }
    }

    refreshCopy() {
        const english = readLocaleId() === "en-us";
        this.demoNote = english
            ? "Interactive example · Server provided sample requests. Notes stay on this page."
            : "交互演示 · 使用服务端示例记录，处理备注只保留在当前页面。";
        this.loadingLabel = english ? "Loading sample requests…" : "正在加载演示请求…";
        this.loadErrorLabel = english
            ? "Sample requests are unavailable. Refresh to try again."
            : "示例请求暂时无法加载，请刷新页面重试。";
        this.scrollHint = english
            ? "Swipe the table to see all columns."
            : "左右滑动表格，查看完整字段。";
        this.previewAriaLabel = english ? "Sample request" : "示例请求";
        this.commercialNavLabel = commercialNavLabel();
        this.commercialHeroTitleLabel = commercialHeroTitle();
        this.commercialHeroLeadLabel = commercialHeroLead();
        this.commercialCtaContactLabel = commercialCtaContact();
        this.commercialCtaDocsLabel = commercialCtaDocs();
        this.commercialFeature1TitleLabel = commercialFeature1Title();
        this.commercialFeature1DescLabel = commercialFeature1Desc();
        this.commercialFeature2TitleLabel = commercialFeature2Title();
        this.commercialFeature2DescLabel = commercialFeature2Desc();
        this.commercialFeature3TitleLabel = commercialFeature3Title();
        this.commercialFeature3DescLabel = commercialFeature3Desc();
        this.commercialBrowseFilterLabel = commercialBrowseFilterLabel();
        this.commercialBrowseFieldLabel = commercialBrowseFieldLabel();
        this.commercialBrowseApplyLabel = commercialBrowseApply();
        this.commercialBrowseResetLabel = commercialBrowseReset();
        this.commercialDetailSummaryLabel = commercialDetailSummary();
        this.commercialDetailOpenLabel = commercialDetailOpen();
        this.commercialFormLabel = commercialFormLabel();
        this.commercialReviewNoteLabel = commercialReviewNoteLabel();
        this.commercialReviewNoteDescLabel = commercialReviewNoteDesc();
        this.commercialConfirmLabel = commercialConfirm();
        this.commercialResetLabel = commercialReset();
        this.commercialNotifyTitleLabel = commercialNotifyTitle();
        this.commercialNotifyDescLabel = commercialNotifyDesc();
        this.commercialNotifyCloseLabel = commercialNotifyClose();
        this.commercialDrawerTitleLabel = commercialDrawerTitle();
        this.commercialDrawerProjectLabel = commercialDrawerProject();
        this.commercialDrawerTargetLabel = commercialDrawerTarget();
        this.commercialDrawerStatusLabel = commercialDrawerStatus();
        this.commercialDrawerActorLabel = commercialDrawerActor();
        this.commercialOpenConsoleLabel = commercialOpenConsole();
        this.browseColumns = [
            { id: "name", title: consoleColName() },
            { id: "target", title: consoleColTarget() },
            { id: "status", title: consoleColStatus() },
            { id: "actor", title: consoleColActor() },
            { id: "updated", title: consoleColUpdated() },
        ];
        this.navItems = [
            { id: "commercial", title: commercialNavCommercial(), href: "/commercial" },
            { id: "console", title: commercialNavConsole(), href: "/console" },
            { id: "home", title: commercialNavHome(), href: "/" },
        ];
        const paths = docsPaths(this.localeId);
        this.guideHref = paths.guideHref;
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
        if (preferred && !this.browseLoading) this.loadDemoData();
    }

    refreshBrowseRows() {
        const q = (this.appliedBrowseQuery || "").trim().toLowerCase();
        const filtered = !q
            ? this.allBrowseRows.slice()
            : this.allBrowseRows.filter((row) =>
                  row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
              );
        this.browseRows = filtered.slice(0, 4);
    }

    applyBrowseFilter() {
        this.appliedBrowseQuery = this.browseQuery;
        this.refreshBrowseRows();
    }

    resetBrowseFilter() {
        this.browseQuery = "";
        this.appliedBrowseQuery = "";
        this.refreshBrowseRows();
    }

    effectiveStatus(row) {
        return this.statusOverrides[row.id] || row.status;
    }

    applyRowOverrides(row) {
        const status = this.effectiveStatus(row);
        return applyStatusToRow(row, status, readLocaleId());
    }

    syncFeaturedFromRow(id) {
        const row = this.allBrowseRows.find((entry) => entry.id === id);
        if (!row) return;
        this.featuredStatusLabel = row.cells[2];
    }

    syncTicketStatuses() {
        this.allBrowseRows = this.allBrowseRows.map((row) => this.applyRowOverrides(row));
        this.refreshBrowseRows();
        this.syncFeaturedFromRow(this.featuredId);
        if (this.drawerOpen) {
            const row = this.allBrowseRows.find((entry) => entry.id === this.featuredId);
            if (row) this.detailStatus = row.cells[2];
        }
    }

    async openFeaturedDetail() {
        this.drawerOpen = true;
        const row =
            this.allBrowseRows.find((entry) => entry.id === this.featuredId) ||
            this.allBrowseRows[0];
        try {
            const detail = await CommercialPageServer.getTicketDetail(
                this.featuredId,
                readLocaleId(),
            );
            if (detail && typeof detail === "object") {
                this.detailProject = String(detail.subject || "");
                this.detailTarget = String(detail.priorityLabel || "");
                this.detailStatus = row ? String(row.cells[2] || "") : String(detail.statusLabel || "");
                this.detailActor = String(detail.owner || "");
                return;
            }
        } catch {
            /* fall back below */
        }
        if (!row) return;
        this.detailProject = String(row.cells[0] || "");
        this.detailTarget = String(row.cells[1] || "");
        this.detailStatus = String(row.cells[2] || "");
        this.detailActor = String(row.cells[3] || "");
    }

    onReviewNote(e) {
        this.reviewNote = e && e.target ? e.target.value : "";
        if (this.reviewError) {
            this.reviewError = "";
            this.reviewInvalid = "false";
            this.reviewDescribedBy = "home-commercial-review-desc";
            this.actionSummary = "";
            this.actionDescribedBy = "";
        }
    }

    confirmReview() {
        const ok = String(this.reviewNote || "").trim().length >= 4;
        if (!ok) {
            this.reviewError = commercialReviewError();
            this.reviewInvalid = "true";
            this.reviewDescribedBy = "home-commercial-review-desc home-commercial-review-err";
            this.actionSummary = commercialContactSummaryError();
            this.actionDescribedBy = "home-commercial-summary";
            this.reviewSuccess = false;
            return;
        }
        this.reviewError = "";
        this.reviewInvalid = "false";
        this.reviewDescribedBy = "home-commercial-review-desc";
        this.actionSummary = "";
        this.actionDescribedBy = "";
        this.reviewSuccess = true;
        const targetId = this.featuredId || this.allBrowseRows[0]?.id;
        if (!targetId) return;
        const row = this.allBrowseRows.find((entry) => entry.id === targetId);
        if (!row) return;
        const nextStatus = statusAfterHandlingNote(this.effectiveStatus(row));
        if (nextStatus === this.effectiveStatus(row)) return;
        this.statusOverrides = { ...this.statusOverrides, [row.id]: nextStatus };
        this.syncTicketStatuses();
    }

    resetReview() {
        this.reviewNote = "";
        this.reviewError = "";
        this.reviewInvalid = "false";
        this.reviewDescribedBy = "home-commercial-review-desc";
        this.actionSummary = "";
        this.actionDescribedBy = "";
        this.reviewSuccess = false;
    }
}
</script>
<script server>
import { formatPriority, formatStatus, mapTicketRow } from "../demo/ticket-rows.ts";
import TicketDemo from "#server/demo/TicketDemo";

export default class CommercialPageServer {
    getConsoleRows(locale) {
        return new TicketDemo().list(locale).map((ticket) => mapTicketRow(ticket, locale));
    }

    getTicketDetail(id, locale) {
        const ticket = new TicketDemo().list(locale).find((item) => item.id === id);
        if (!ticket) return null;
        return {
            ...ticket,
            priorityLabel: formatPriority(ticket.priority, locale),
            statusLabel: formatStatus(ticket.status, locale),
        };
    }
}
</script>
