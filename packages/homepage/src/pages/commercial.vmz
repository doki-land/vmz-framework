                </p>
                <dl v-if="!browseLoading && !browseError" class="vmz-commercial-status__meta">
                    <div>
                        <dt>
                            {{ commercialDrawerTargetLabel }}
                        </dt>
                        <dd>
                            {{ featuredPriorityLabel }}
                        </dd>
                    </div>
                    <div>
                        <dt>
