                        </span>
                        <h2 id="commercial-task-browse-title">
                            {{ commercialFeature1TitleLabel }}
                        </h2>
                        <p>
                            {{ commercialFeature1DescLabel }}
                        </p>
                    </div>
                    <div class="vmz-commercial-step__demo">
                        <FilterBar :label="commercialBrowseFilterLabel">
                            <Field :label="commercialBrowseFieldLabel" :placeholder="commercialBrowsePlaceholder" control-id="home-commercial-browse-query" description-id="home-commercial-browse-desc" error-id="home-commercial-browse-err" described-by="home-commercial-browse-desc" :value="browseQuery" @input="((e) => browseQuery = e.target.value)" />
                            <Button type="button" variant="primary" @click="applyBrowseFilter">
                                {{ commercialBrowseApplyLabel }}
                            </Button>
                            <Button type="button" variant="secondary" @click="resetBrowseFilter">
                                {{ commercialBrowseResetLabel }}
                            </Button>
                        </FilterBar>
                        <p v-if="browseLoading" role="status" class="vmz-commercial-loading">
                            {{ loadingLabel }}
                        </p>
                        <p v-if="browseError" role="alert" class="vmz-commercial-loading">
                            {{ loadErrorLabel }}
                        </p>
                        <p v-if="!browseLoading && !browseError && !browseFilterEmpty" class="vmz-commercial-scroll-hint">
                            {{ scrollHint }}
                        </p>
                        <div v-if="browseFilterEmpty && !browseLoading && !browseError" data-vmz-fixture="commercial-browse-empty" role="status" class="vmz-commercial-empty">
                            <strong>
                                {{ commercialBrowseFilterEmptyTitleLabel }}
                            </strong>
                            <p>
                                {{ commercialBrowseFilterEmptyBodyLabel }}
                            </p>
                            <Button type="button" variant="secondary" @click="resetBrowseFilter">
                                {{ commercialBrowseResetLabel }}
                            </Button>
                        </div>
                        <Table v-if="!browseLoading && !browseError && !browseFilterEmpty" :columns="browseColumns" :rows="browseRows" :has-row-action="false" />
                    </div>
                </div>
                <div data-vmz-fixture="commercial-task-detail" aria-labelledby="commercial-task-detail-title" class="vmz-commercial-step">
                    <div class="vmz-commercial-step__copy">
                        <span aria-hidden="true" class="vmz-commercial-step__index">
                            02
                        </span>
                        <h2 id="commercial-task-detail-title">
                            {{ commercialFeature2TitleLabel }}
                        </h2>
                        <p>
                            {{ commercialFeature2DescLabel }}
                        </p>
                    </div>
                    <div class="vmz-commercial-step__demo">
                        <p v-if="featuredId" class="vmz-commercial-detail-line">
                            {{ featuredId }}
                            ·
                            {{ featuredSubjectLabel }}
                            ·
                            {{ featuredStatusLabel }}
                        </p>
                        <p v-if="!featuredId" class="vmz-commercial-detail-line">
                            {{ loadingLabel }}
                        </p>
                        <div data-vmz-fixture="commercial-drawer-open">
                            <Button type="button" variant="secondary" @click="openFeaturedDetail">
                                {{ commercialDetailOpenLabel }}
                            </Button>
                        </div>
                        <Drawer v-if="drawerOpen" :open="drawerOpen" :title="commercialDrawerTitleLabel" title-id="home-commercial-drawer-title" :on-close="(() => drawerOpen = false)">
                            <div class="vmz-commercial-drawer-content">
                                <div data-vmz-fixture="commercial-drawer-project" class="vmz-commercial-drawer-detail">
                                    <Descriptions columns="1" :items="drawerItems" />
                                </div>
                                <Link href="/console">
                                    {{ commercialOpenConsoleLabel }}
                                </Link>
                            </div>
                        </Drawer>
                    </div>
