    <SiteShell page="commercial" variant="commercial-page">
        <main id="main" data-vmz-fixture="commercial" class="vmz-commercial-content">
            <section data-vmz-fixture="commercial-hero" aria-labelledby="commercial-hero-title" class="vmz-commercial-hero">
                <a :href="homeHref" class="vmz-commercial-hero__back">
                    {{ commercialNavHomeLabel }}
