<template>
  <div data-vmz-fixture="commercial">
    <AppShell brand="VMZ" home-href="/" :nav-label="commercialNavLabel" :nav="navItems">
      <section class="vmz-commercial-hero" data-vmz-fixture="commercial-hero" aria-labelledby="commercial-hero-title">
        <Badge tone="brand">{{ commercialHeroBadgeLabel }}</Badge>
        <h1 id="commercial-hero-title" class="vmz-commercial-hero__title">{{ commercialHeroTitleLabel }}</h1>
        <p class="vmz-commercial-hero__lead">{{ commercialHeroLeadLabel }}</p>
        <div class="vmz-commercial-hero__actions">
          <Button type="button" @click="scrollContact">{{ commercialCtaContactLabel }}</Button>
          <Button type="button" variant="secondary" @click="() => (drawerOpen = true)">{{ commercialCtaChecklistLabel }}</Button>
          <Link :href="guideHref">{{ deployGuideLabel }}</Link>
        </div>
      </section>

      <Alert
        tone="info"
        role-name="status"
        :title="commercialAlertTitleLabel"
        :description="commercialAlertDescLabel"
      />

      <section data-vmz-fixture="commercial-features" aria-labelledby="commercial-features-title">
        <h2 id="commercial-features-title" class="vmz-commercial-section-title">{{ commercialFeaturesTitleLabel }}</h2>
        <div class="vmz-commercial-grid">
          <Card :title="commercialFeature1TitleLabel" :description="commercialFeature1DescLabel" />
          <Card :title="commercialFeature2TitleLabel" :description="commercialFeature2DescLabel" />
          <Card :title="commercialFeature3TitleLabel" :description="commercialFeature3DescLabel" />
        </div>
      </section>

      <section data-vmz-fixture="commercial-pricing" aria-labelledby="commercial-pricing-title">
        <h2 id="commercial-pricing-title" class="vmz-commercial-section-title">{{ commercialPricingTitleLabel }}</h2>
        <div class="vmz-commercial-grid vmz-commercial-grid--pricing">
          <Card :title="commercialPlanOpenTitleLabel" :description="commercialPlanOpenDescLabel">
            <p class="vmz-commercial-price"><span>{{ commercialPlanPriceLabel }}</span>{{ commercialPlanOpenPriceLabel }}</p>
            <Badge tone="info">{{ commercialPlanOpenBadgeLabel }}</Badge>
            <Button type="button" variant="secondary" @click="scrollContact">{{ commercialPlanOpenCtaLabel }}</Button>
          </Card>
          <Card :title="commercialPlanTeamTitleLabel" :description="commercialPlanTeamDescLabel">
            <p class="vmz-commercial-price"><span>{{ commercialPlanPriceLabel }}</span>{{ commercialPlanTeamPriceLabel }}</p>
            <Badge tone="success">{{ commercialPlanTeamBadgeLabel }}</Badge>
            <Button type="button" @click="scrollContact">{{ commercialPlanTeamCtaLabel }}</Button>
          </Card>
        </div>
      </section>

      <Card :title="commercialContactTitleLabel" :description="commercialContactDescLabel">
        <Form
          :label="commercialFormLabel"
          :error-summary="contactSummary"
          summary-id="home-commercial-summary"
          :described-by="contactDescribedBy"
          @submit="confirmContact"
          @reset="resetContact"
        >
          <Field
            :label="commercialEmailLabel"
            :description="commercialEmailDescLabel"
            control-id="home-commercial-email"
            description-id="home-commercial-email-desc"
            error-id="home-commercial-email-err"
            :described-by="emailDescribedBy"
            :error="emailError"
            :invalid-attr="emailInvalid"
            :value="email"
            @input="onEmail"
          />
          <p class="vmz-sr-only" data-vmz-fixture="commercial-email">email:{{ email }}</p>
          <div data-vmz-fixture="commercial-form-actions" class="vmz-commercial-actions">
            <Button type="submit">{{ commercialConfirmLabel }}</Button>
            <Button type="reset" variant="secondary">{{ commercialResetLabel }}</Button>
            <span v-if="submitting" data-vmz-fixture="commercial-spinner">
              <Spinner :label="commercialSendingLabel" />
            </span>
          </div>
        </Form>
        <Dialog
          :open="dialogOpen"
          :title="commercialDialogTitleLabel"
          title-id="home-commercial-dialog-title"
          :on-close="() => (dialogOpen = false)"
        >
          <p data-vmz-fixture="commercial-dialog-body">{{ commercialDialogBodyLeadLabel }} {{ email }} {{ commercialDialogBodyTailLabel }}</p>
        </Dialog>
      </Card>

      <Card :title="commercialWorkspaceTitleLabel" :description="commercialWorkspaceDescLabel">
        <div v-if="showEmpty">
          <Empty :title="commercialEmptyTitleLabel" :description="commercialEmptyDescLabel">
            <div data-vmz-fixture="commercial-create">
              <Button type="button" @click="createProject">{{ commercialCreateProjectLabel }}</Button>
            </div>
          </Empty>
        </div>
        <div v-else data-vmz-fixture="commercial-ready">
          <div data-vmz-fixture="commercial-notify">
            <Notification
              tone="success"
              role-name="status"
              :title="commercialNotifyTitleLabel"
              :description="commercialNotifyDescLabel"
            >
              <Button type="button" variant="ghost" @click="resetWorkspace">{{ commercialNotifyCloseLabel }}</Button>
            </Notification>
          </div>
          <Alert
            tone="success"
            role-name="status"
            :title="commercialProjectCreatedTitleLabel"
            :description="commercialProjectCreatedDescLabel"
          />
        </div>
        <div data-vmz-fixture="commercial-drawer-open">
          <Button type="button" variant="secondary" @click="() => (drawerOpen = true)">{{ commercialCtaChecklistLabel }}</Button>
        </div>
        <Drawer
          :open="drawerOpen"
          :title="commercialDrawerTitleLabel"
          title-id="home-commercial-drawer-title"
          :on-close="() => (drawerOpen = false)"
        >
          <p data-vmz-fixture="commercial-drawer-body">{{ commercialDrawerBodyLabel }}</p>
          <Link href="/console">{{ commercialOpenConsoleLabel }}</Link>
        </Drawer>
      </Card>
    </AppShell>
  </div>
</template>

<style>
.vmz-commercial-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 1.75rem 0 0.5rem;
}

.vmz-commercial-hero__title {
  margin: 0;
  font-family: var(--vmz-font-display);
  font-size: clamp(2rem, 4.8vw, 2.8rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.12;
  color: var(--vmz-text-ink);
  max-width: 22ch;
}

.vmz-commercial-hero__lead {
  margin: 0;
  max-width: 40rem;
  font-size: 1.02rem;
  line-height: 1.65;
  color: var(--vmz-text-steel);
}

.vmz-commercial-hero__actions,
.vmz-commercial-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem 0.85rem;
}

.vmz-commercial-section-title {
  margin: 0 0 0.85rem;
  font-family: var(--vmz-font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--vmz-text-ink);
}

.vmz-commercial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 0.85rem;
}

.vmz-commercial-grid--pricing {
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
}

.vmz-commercial-price {
  margin: 0;
  font-family: var(--vmz-font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--vmz-action-primary-active);
}

.vmz-commercial-price span {
  display: block;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--vmz-text-steel);
}
</style>

<script client>
import {
  deployGuide,
  commercialNavLabel,
  commercialNavCommercial,
  commercialNavConsole,
  commercialNavHome,
  commercialHeroBadge,
  commercialHeroTitle,
  commercialHeroLead,
  commercialCtaContact,
  commercialCtaChecklist,
  commercialAlertTitle,
  commercialAlertDesc,
  commercialFeaturesTitle,
  commercialFeature1Title,
  commercialFeature1Desc,
  commercialFeature2Title,
  commercialFeature2Desc,
  commercialFeature3Title,
  commercialFeature3Desc,
  commercialPricingTitle,
  commercialPlanOpenTitle,
  commercialPlanOpenDesc,
  commercialPlanPriceLabel,
  commercialPlanOpenPrice,
  commercialPlanOpenBadge,
  commercialPlanOpenCta,
  commercialPlanTeamTitle,
  commercialPlanTeamDesc,
  commercialPlanTeamPrice,
  commercialPlanTeamBadge,
  commercialPlanTeamCta,
  commercialContactTitle,
  commercialContactDesc,
  commercialFormLabel,
  commercialEmailLabel,
  commercialEmailDesc,
  commercialConfirm,
  commercialReset,
  commercialSending,
  commercialDialogTitle,
  commercialDialogBodyLead,
  commercialDialogBodyTail,
  commercialWorkspaceTitle,
  commercialWorkspaceDesc,
  commercialEmptyTitle,
  commercialEmptyDesc,
  commercialCreateProject,
  commercialNotifyTitle,
  commercialNotifyDesc,
  commercialNotifyClose,
  commercialProjectCreatedTitle,
  commercialProjectCreatedDesc,
  commercialDrawerTitle,
  commercialDrawerBody,
  commercialOpenConsole,
  commercialEmailError,
  commercialContactSummaryError,
} from '#locales/common';
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class CommercialPage {
  email = '';
  emailError = '';
  emailInvalid = 'false';
  emailDescribedBy = 'home-commercial-email-desc';
  contactSummary = '';
  contactDescribedBy = '';
  dialogOpen = false;
  drawerOpen = false;
  showEmpty = true;
  submitting = false;
  localeId = 'zh-hans';
  guideHref = '/d/zh-hans/guide/';
  deployGuideLabel = '';
  commercialNavLabel = '';
  commercialHeroBadgeLabel = '';
  commercialHeroTitleLabel = '';
  commercialHeroLeadLabel = '';
  commercialCtaContactLabel = '';
  commercialCtaChecklistLabel = '';
  commercialAlertTitleLabel = '';
  commercialAlertDescLabel = '';
  commercialFeaturesTitleLabel = '';
  commercialFeature1TitleLabel = '';
  commercialFeature1DescLabel = '';
  commercialFeature2TitleLabel = '';
  commercialFeature2DescLabel = '';
  commercialFeature3TitleLabel = '';
  commercialFeature3DescLabel = '';
  commercialPricingTitleLabel = '';
  commercialPlanOpenTitleLabel = '';
  commercialPlanOpenDescLabel = '';
  commercialPlanPriceLabel = '';
  commercialPlanOpenPriceLabel = '';
  commercialPlanOpenBadgeLabel = '';
  commercialPlanOpenCtaLabel = '';
  commercialPlanTeamTitleLabel = '';
  commercialPlanTeamDescLabel = '';
  commercialPlanTeamPriceLabel = '';
  commercialPlanTeamBadgeLabel = '';
  commercialPlanTeamCtaLabel = '';
  commercialContactTitleLabel = '';
  commercialContactDescLabel = '';
  commercialFormLabel = '';
  commercialEmailLabel = '';
  commercialEmailDescLabel = '';
  commercialConfirmLabel = '';
  commercialResetLabel = '';
  commercialSendingLabel = '';
  commercialDialogTitleLabel = '';
  commercialDialogBodyLeadLabel = '';
  commercialDialogBodyTailLabel = '';
  commercialWorkspaceTitleLabel = '';
  commercialWorkspaceDescLabel = '';
  commercialEmptyTitleLabel = '';
  commercialEmptyDescLabel = '';
  commercialCreateProjectLabel = '';
  commercialNotifyTitleLabel = '';
  commercialNotifyDescLabel = '';
  commercialNotifyCloseLabel = '';
  commercialProjectCreatedTitleLabel = '';
  commercialProjectCreatedDescLabel = '';
  commercialDrawerTitleLabel = '';
  commercialDrawerBodyLabel = '';
  commercialOpenConsoleLabel = '';
  navItems = [];
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.deployGuideLabel = deployGuide();
    this.commercialNavLabel = commercialNavLabel();
    this.commercialHeroBadgeLabel = commercialHeroBadge();
    this.commercialHeroTitleLabel = commercialHeroTitle();
    this.commercialHeroLeadLabel = commercialHeroLead();
    this.commercialCtaContactLabel = commercialCtaContact();
    this.commercialCtaChecklistLabel = commercialCtaChecklist();
    this.commercialAlertTitleLabel = commercialAlertTitle();
    this.commercialAlertDescLabel = commercialAlertDesc();
    this.commercialFeaturesTitleLabel = commercialFeaturesTitle();
    this.commercialFeature1TitleLabel = commercialFeature1Title();
    this.commercialFeature1DescLabel = commercialFeature1Desc();
    this.commercialFeature2TitleLabel = commercialFeature2Title();
    this.commercialFeature2DescLabel = commercialFeature2Desc();
    this.commercialFeature3TitleLabel = commercialFeature3Title();
    this.commercialFeature3DescLabel = commercialFeature3Desc();
    this.commercialPricingTitleLabel = commercialPricingTitle();
    this.commercialPlanOpenTitleLabel = commercialPlanOpenTitle();
    this.commercialPlanOpenDescLabel = commercialPlanOpenDesc();
    this.commercialPlanPriceLabel = commercialPlanPriceLabel();
    this.commercialPlanOpenPriceLabel = commercialPlanOpenPrice();
    this.commercialPlanOpenBadgeLabel = commercialPlanOpenBadge();
    this.commercialPlanOpenCtaLabel = commercialPlanOpenCta();
    this.commercialPlanTeamTitleLabel = commercialPlanTeamTitle();
    this.commercialPlanTeamDescLabel = commercialPlanTeamDesc();
    this.commercialPlanTeamPriceLabel = commercialPlanTeamPrice();
    this.commercialPlanTeamBadgeLabel = commercialPlanTeamBadge();
    this.commercialPlanTeamCtaLabel = commercialPlanTeamCta();
    this.commercialContactTitleLabel = commercialContactTitle();
    this.commercialContactDescLabel = commercialContactDesc();
    this.commercialFormLabel = commercialFormLabel();
    this.commercialEmailLabel = commercialEmailLabel();
    this.commercialEmailDescLabel = commercialEmailDesc();
    this.commercialConfirmLabel = commercialConfirm();
    this.commercialResetLabel = commercialReset();
    this.commercialSendingLabel = commercialSending();
    this.commercialDialogTitleLabel = commercialDialogTitle();
    this.commercialDialogBodyLeadLabel = commercialDialogBodyLead();
    this.commercialDialogBodyTailLabel = commercialDialogBodyTail();
    this.commercialWorkspaceTitleLabel = commercialWorkspaceTitle();
    this.commercialWorkspaceDescLabel = commercialWorkspaceDesc();
    this.commercialEmptyTitleLabel = commercialEmptyTitle();
    this.commercialEmptyDescLabel = commercialEmptyDesc();
    this.commercialCreateProjectLabel = commercialCreateProject();
    this.commercialNotifyTitleLabel = commercialNotifyTitle();
    this.commercialNotifyDescLabel = commercialNotifyDesc();
    this.commercialNotifyCloseLabel = commercialNotifyClose();
    this.commercialProjectCreatedTitleLabel = commercialProjectCreatedTitle();
    this.commercialProjectCreatedDescLabel = commercialProjectCreatedDesc();
    this.commercialDrawerTitleLabel = commercialDrawerTitle();
    this.commercialDrawerBodyLabel = commercialDrawerBody();
    this.commercialOpenConsoleLabel = commercialOpenConsole();
    this.navItems = [
      { id: 'commercial', title: commercialNavCommercial(), href: '/commercial' },
      { id: 'console', title: commercialNavConsole(), href: '/console' },
      { id: 'home', title: commercialNavHome(), href: '/' },
    ];
    const paths = docsPaths(this.localeId);
    this.guideHref = paths.guideHref;
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  scrollContact() {
    const el = document.getElementById('home-commercial-email');
    if (el && typeof el.focus === 'function') el.focus();
  }

  onEmail(e) {
    this.email = e && e.target ? e.target.value : '';
    if (this.emailError) {
      this.emailError = '';
      this.emailInvalid = 'false';
      this.emailDescribedBy = 'home-commercial-email-desc';
      this.contactSummary = '';
      this.contactDescribedBy = '';
    }
  }

  confirmContact() {
    const ok = /.+@.+\..+/.test(String(this.email || '').trim());
    if (!ok) {
      this.emailError = commercialEmailError();
      this.emailInvalid = 'true';
      this.emailDescribedBy = 'home-commercial-email-desc home-commercial-email-err';
      this.contactSummary = commercialContactSummaryError();
      this.contactDescribedBy = 'home-commercial-summary';
      this.dialogOpen = false;
      return;
    }
    this.emailError = '';
    this.emailInvalid = 'false';
    this.emailDescribedBy = 'home-commercial-email-desc';
    this.contactSummary = '';
    this.contactDescribedBy = '';
    this.dialogOpen = true;
  }

  createProject() {
    this.showEmpty = false;
  }

  resetWorkspace() {
    this.showEmpty = true;
  }

  resetContact() {
    this.email = '';
    this.emailError = '';
    this.emailInvalid = 'false';
    this.emailDescribedBy = 'home-commercial-email-desc';
    this.contactSummary = '';
    this.contactDescribedBy = '';
    this.dialogOpen = false;
  }
}
</script>
