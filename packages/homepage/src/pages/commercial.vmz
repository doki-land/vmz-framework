                        </p>
                    </div>
                    <div class="vmz-commercial-step__demo">
                        <Form :label="commercialFormLabel" :error-summary="actionSummary" summary-id="home-commercial-summary" :described-by="actionDescribedBy" :rules="reviewRules" :values="reviewValues" @submit="confirmReview" @invalid="onReviewInvalid" @reset="resetReview">
                            <Field :label="commercialReviewNoteLabel" :placeholder="commercialReviewPlaceholder" :description="commercialReviewNoteDescLabel" control-id="home-commercial-review" description-id="home-commercial-review-desc" error-id="home-commercial-review-err" :described-by="reviewDescribedBy" :error="reviewError" :value="reviewNote" @input="onReviewNote" />
                            <p data-vmz-fixture="commercial-review-note" class="vmz-sr-only">
                                note:
                                {{ reviewNote }}
                            </p>
                            <div data-vmz-fixture="commercial-form-actions" class="vmz-commercial-actions">
                                <Button type="submit">
                                    {{ commercialConfirmLabel }}
                                </Button>
                                <Button type="reset" variant="secondary">
                                    {{ commercialResetLabel }}
                                </Button>
                            </div>
                        </Form>
                        <div v-if="reviewSuccess" data-vmz-fixture="commercial-notify">
                            <Notification tone="success" role-name="status" :title="commercialNotifyTitleLabel" :description="commercialNotifyDescLabel">
                                <Button type="button" variant="ghost" @click="(() => reviewSuccess = false)">
                                    {{ commercialNotifyCloseLabel }}
                                </Button>
                            </Notification>
                        </div>
                    </div>
                </div>
                <footer class="vmz-commercial-workspace__foot">
                    <Link :href="guideHref">
                        {{ commercialCtaDocsLabel }}
                    </Link>
                </footer>
            </section>
        </main>
    </SiteShell>
</template>
<style>
/* Commercial puts one task and one primary action in front of the reader:
   page navigation and the external link move into the menu, and the global
   start CTA yields to the page CTA. Preferences and language stay in the
   header as secondary utilities. */
.commercial-page .site-nav__links,
.commercial-page .site-nav__cta {
    display: none;
}
.commercial-page .site-nav a.site-nav__github {
    display: none;
}
.commercial-page .site-nav-mobile {
    display: block;
}

.vmz-commercial-hero {
    display: grid;
    gap: var(--vmz-space-4);
    margin: 0 0 var(--vmz-space-6);
    padding: 0;
}
.vmz-commercial-hero__back {
    display: none;
    align-items: center;
    gap: var(--vmz-space-2);
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
    text-decoration: none;
}
.vmz-commercial-hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--vmz-space-3);
    max-width: 48rem;
}
.vmz-commercial-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vmz-space-2);
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-hero__crumbs a {
    color: inherit;
    text-decoration: none;
}
.vmz-commercial-hero__crumbs a:hover {
    color: var(--vmz-text-ink);
}
.vmz-commercial-hero__title {
    max-width: 24ch;
    margin: 0;
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-display);
    font-size: var(--vmz-type-display);
    font-weight: var(--vmz-type-weight-semibold);
    line-height: var(--vmz-type-line-height-display);
}
.vmz-commercial-hero__lead {
    max-width: 40rem;
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-body);
    line-height: var(--vmz-type-line-height-body);
}
.vmz-commercial-hero__actions,
.vmz-commercial-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vmz-space-3);
}
.vmz-commercial-hero__action {
    display: contents;
}
.vmz-commercial-hero__action a {
    display: inline-flex;
    align-items: center;
    min-height: var(--vmz-control-height);
    padding: var(--vmz-density-control-padding-y) var(--vmz-space-4);
    border: 1px solid transparent;
    border-radius: var(--vmz-radius-md);
    font-size: var(--vmz-type-body);
    font-weight: var(--vmz-type-weight-medium);
    text-decoration: none;
}
.vmz-commercial-hero__action.is-primary a {
    color: var(--vmz-action-primary-foreground);
    background: var(--vmz-action-primary-background);
}
.vmz-commercial-hero__action.is-primary a:hover {
    background: var(--vmz-action-primary-hover);
}

.vmz-commercial-status {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--vmz-space-2) var(--vmz-space-5);
    margin: 0 0 var(--vmz-space-6);
    padding: var(--vmz-space-4) 0;
    border-top: 1px solid var(--vmz-line-subtle);
    border-bottom: 1px solid var(--vmz-line-subtle);
}
.vmz-commercial-status__id {
    display: flex;
    align-items: center;
    gap: var(--vmz-space-2);
    margin: 0;
    color: var(--vmz-text-steel);
    font-family: var(--vmz-font-mono);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-status__state {
    color: var(--vmz-status-warning-foreground);
    font-family: var(--vmz-font-sans);
    font-weight: var(--vmz-type-weight-medium);
}
.vmz-commercial-status__subject {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--vmz-text-ink);
    font-size: var(--vmz-type-subtitle);
    font-weight: var(--vmz-type-weight-medium);
    line-height: var(--vmz-type-line-height-title);
    text-overflow: ellipsis;
    white-space: nowrap;
}
.vmz-commercial-status__meta {
    display: flex;
    gap: var(--vmz-space-4);
    margin: 0;
}
.vmz-commercial-status__meta div {
    display: flex;
    align-items: baseline;
    gap: var(--vmz-space-2);
}
.vmz-commercial-status__meta dt {
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-status__meta dd {
    margin: 0;
    color: var(--vmz-text-ink);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-status__actions {
    display: flex;
    justify-content: flex-end;
}
.vmz-commercial-status__note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--vmz-text-muted);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-content {
    min-width: 0;
}

.vmz-commercial-workspace {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
}
.vmz-commercial-step {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    align-items: start;
    gap: var(--vmz-space-7);
    padding: var(--vmz-space-6);
    border-top: 1px solid var(--vmz-line-subtle);
}
.vmz-commercial-step:first-child {
    border-top: 0;
}
.vmz-commercial-step__copy {
    display: grid;
    gap: var(--vmz-space-2);
}
.vmz-commercial-step__index {
    color: var(--vmz-text-muted);
    font-family: var(--vmz-font-mono);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-step__copy h2 {
    margin: 0;
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-display);
    font-size: var(--vmz-type-subtitle);
    font-weight: var(--vmz-type-weight-semibold);
    line-height: var(--vmz-type-line-height-title);
}
.vmz-commercial-step__copy p {
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-body);
}
.vmz-commercial-step__demo {
    display: grid;
    min-width: 0;
}
.vmz-commercial-workspace__foot {
    display: flex;
    justify-content: flex-end;
    padding: var(--vmz-space-3) var(--vmz-space-6);
    border-top: 1px solid var(--vmz-line-subtle);
}

.vmz-commercial-step .vmz-ui-filter-bar {
    margin: 0;
    padding: 0 0 var(--vmz-space-3);
    border: 0;
    border-bottom: 1px solid var(--vmz-line-subtle);
    border-radius: 0;
    background: transparent;
}
.vmz-commercial-step .vmz-ui-table-wrap {
    margin: 0;
    border: 0;
    border-radius: 0;
}
.vmz-commercial-step .vmz-ui-table th,
.vmz-commercial-step .vmz-ui-table td {
    padding-top: var(--vmz-density-compact-padding-y);
    padding-bottom: var(--vmz-density-compact-padding-y);
}
.vmz-commercial-detail-line {
    margin: 0 0 var(--vmz-space-3);
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-body);
}
[data-vmz-fixture="commercial-drawer-open"] {
    display: flex;
    padding-top: var(--vmz-space-3);
    border-top: 1px solid var(--vmz-line-subtle);
}
[data-vmz-fixture="commercial-task-action"] .vmz-commercial-actions {
    padding-top: var(--vmz-space-2);
}
[data-vmz-fixture="commercial-task-action"] [data-vmz-fixture="commercial-notify"] {
    padding-top: var(--vmz-space-4);
}
.vmz-commercial-drawer-detail {
    margin-bottom: var(--vmz-space-4);
}
.vmz-commercial-loading {
    margin: 0;
    padding: var(--vmz-space-4) 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
.vmz-commercial-empty {
    display: grid;
    justify-items: start;
    gap: var(--vmz-space-3);
    margin: 0;
    padding: var(--vmz-space-5) 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-body);
}
.vmz-commercial-empty strong {
    color: var(--vmz-text-ink);
    font-weight: var(--vmz-type-weight-semibold);
}
.vmz-commercial-empty p {
    margin: 0;
}
.vmz-commercial-scroll-hint {
    display: none;
    margin: 0;
    padding: var(--vmz-space-2) 0 0;
    color: var(--vmz-text-steel);
    font-size: var(--vmz-type-caption);
    line-height: var(--vmz-type-line-height-caption);
}
@media (max-width: 720px) {
    .vmz-commercial-status {
        grid-template-columns: minmax(0, 1fr) auto;
    }
    .vmz-commercial-status__id {
        grid-column: 1 / -1;
    }
    .vmz-commercial-step {
        grid-template-columns: minmax(0, 1fr);
    }
}
</style>
<script client>
import {
    home,
    commercialNavLabel,
    commercialNavHome,
    commercialWorkspaceAria,
    commercialHeroTitle,
    commercialHeroLead,
    commercialCtaContact,
    commercialCtaDocs,
    commercialFeature1Title,
    commercialFeature1Desc,
    commercialFeature2Title,
    commercialFeature2Desc,
    commercialFeature3Title,
    commercialFeature3Desc,
    commercialBrowseFilterLabel,
    commercialBrowseFilterEmptyTitle,
    commercialBrowseFilterEmptyBody,
    commercialBrowseFieldLabel,
    commercialBrowsePlaceholder,
    commercialBrowseApply,
    commercialBrowseReset,
    commercialDetailSummary,
    commercialDetailOpen,
    commercialFormLabel,
    commercialReviewNoteLabel,
    commercialReviewPlaceholder,
    commercialReviewNoteDesc,
    commercialConfirm,
    commercialReset,
    commercialNotifyTitle,
    commercialNotifyDesc,
    commercialNotifyClose,
    commercialDrawerTitle,
    commercialDrawerProject,
    commercialDrawerTarget,
    commercialDrawerStatus,
    commercialDrawerActor,
    commercialOpenConsole,
    commercialReviewError,
    commercialContactSummaryError,
    consoleColName,
    consoleColTarget,
    consoleColStatus,
    consoleColActor,
    consoleColUpdated,
} from "#locales/common";
import CommercialPageServer from "#server/pages/commercial";
import { applyStatusToRow, statusAfterHandlingNote } from "../demo/ticket-rows.ts";
import { siteHomeHref } from "../nav.ts";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

const initialBrowseRows = [];

import { pageMeta } from "../page-meta.ts";

export default class CommercialPage {
    static meta = pageMeta("应用案例 · VMZ", "Case study · VMZ");

    browseQuery = "";
    appliedBrowseQuery = "";
    reviewNote = "";
    reviewError = "";
    reviewValues = { note: "" };
    reviewRules = { note: { required: true, minLength: 4 } };
    reviewDescribedBy = "home-commercial-review-desc";
    actionSummary = "";
    actionDescribedBy = "";
    reviewSuccess = false;
    statusOverrides = {};
    drawerOpen = false;
    drawerItems = [];
    detailProject = "";
    detailTarget = "";
    detailStatus = "";
    detailActor = "";
    localeId = "zh-hans";
    guideHref = "/d/zh-hans/guide/";
    homeHref = "/";
    homeLabel = "";
    commercialNavLabel = "";
    commercialNavHomeLabel = "";
    commercialWorkspaceAriaLabel = "";
    commercialHeroTitleLabel = "";
    commercialHeroLeadLabel = "";
    commercialCtaContactLabel = "";
    commercialCtaDocsLabel = "";
    commercialFeature1TitleLabel = "";
    commercialFeature1DescLabel = "";
    commercialFeature2TitleLabel = "";
    commercialFeature2DescLabel = "";
    commercialFeature3TitleLabel = "";
    commercialFeature3DescLabel = "";
    commercialBrowseFilterLabel = "";
    commercialBrowseFilterEmptyTitleLabel = "";
    commercialBrowseFilterEmptyBodyLabel = "";
    commercialBrowseFieldLabel = "";
    commercialBrowsePlaceholder = "";
    commercialBrowseApplyLabel = "";
    commercialBrowseResetLabel = "";
    commercialDetailSummaryLabel = "";
    commercialDetailOpenLabel = "";
    commercialFormLabel = "";
    commercialReviewNoteLabel = "";
    commercialReviewPlaceholder = "";
    commercialReviewNoteDescLabel = "";
    commercialConfirmLabel = "";
    commercialResetLabel = "";
    commercialNotifyTitleLabel = "";
    commercialNotifyDescLabel = "";
    commercialNotifyCloseLabel = "";
    commercialDrawerTitleLabel = "";
    commercialDrawerProjectLabel = "";
    commercialDrawerTargetLabel = "";
    commercialDrawerStatusLabel = "";
    commercialDrawerActorLabel = "";
    commercialOpenConsoleLabel = "";
    browseColumns = [];
    allBrowseRows = initialBrowseRows.map((row) => ({
        id: row.id,
        status: row.status,
        cells: row.cells.map((cell) => String(cell)),
    }));
    browseRows = [];
    browseFilterEmpty = false;
    browseLoading = true;
    browseError = false;
    demoNote = "";
    loadingLabel = "";
    loadErrorLabel = "";
    scrollHint = "";
    previewAriaLabel = "";
    featuredId = "";
    featuredSubjectLabel = "";
    featuredStatusLabel = "";
    featuredPriorityLabel = "";
    featuredOwnerLabel = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
        this.refreshBrowseRows();
        this.loadDemoData();
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    async loadDemoData() {
        this.browseError = false;
        try {
            const rows = await CommercialPageServer.getConsoleRows(readLocaleId());
            if (Array.isArray(rows) && rows.length) {
                this.allBrowseRows = rows.map((row) => this.applyRowOverrides(row));
                this.refreshBrowseRows();
                const featured = this.allBrowseRows[0];
                this.featuredId = featured.id;
                this.featuredSubjectLabel = featured.cells[0];
                this.featuredPriorityLabel = featured.cells[1];
                this.featuredStatusLabel = featured.cells[2];
                this.featuredOwnerLabel = featured.cells[3];
                const detail = await CommercialPageServer.getTicketDetail(
                    featured.id,
                    readLocaleId(),
                );
                if (detail) {
                    this.featuredId = detail.id;
                    this.featuredSubjectLabel = detail.subject;
                    this.featuredStatusLabel = featured.cells[2];
                    this.featuredPriorityLabel = detail.priorityLabel;
                    this.featuredOwnerLabel = detail.owner;
                }
            }
        } catch {
            this.browseError = true;
        } finally {
            this.browseLoading = false;
        }
    }

    refreshCopy() {
        const english = readLocaleId() === "en-us";
        this.demoNote = english
            ? "Interactive example · Server provided sample requests. Notes stay on this page."
            : "交互演示 · 使用服务端示例记录，处理备注只保留在当前页面。";
        this.loadingLabel = english ? "Loading sample requests…" : "正在加载演示请求…";
        this.loadErrorLabel = english
            ? "Sample requests are unavailable. Refresh to try again."
            : "示例请求暂时无法加载，请刷新页面重试。";
        this.scrollHint = english
            ? "Swipe the table to see all columns."
            : "左右滑动表格，查看完整字段。";
        this.previewAriaLabel = english ? "Sample request" : "示例请求";
        this.homeLabel = home();
        this.commercialNavLabel = commercialNavLabel();
        this.commercialNavHomeLabel = commercialNavHome();
        this.commercialWorkspaceAriaLabel = commercialWorkspaceAria();
        this.commercialHeroTitleLabel = commercialHeroTitle();
        this.commercialHeroLeadLabel = commercialHeroLead();
        this.commercialCtaContactLabel = commercialCtaContact();
        this.commercialCtaDocsLabel = commercialCtaDocs();
        this.commercialFeature1TitleLabel = commercialFeature1Title();
        this.commercialFeature1DescLabel = commercialFeature1Desc();
        this.commercialFeature2TitleLabel = commercialFeature2Title();
        this.commercialFeature2DescLabel = commercialFeature2Desc();
        this.commercialFeature3TitleLabel = commercialFeature3Title();
        this.commercialFeature3DescLabel = commercialFeature3Desc();
        this.commercialBrowseFilterLabel = commercialBrowseFilterLabel();
        this.commercialBrowseFilterEmptyTitleLabel = commercialBrowseFilterEmptyTitle();
        this.commercialBrowseFilterEmptyBodyLabel = commercialBrowseFilterEmptyBody();
        this.commercialBrowseFieldLabel = commercialBrowseFieldLabel();
        this.commercialBrowsePlaceholder = commercialBrowsePlaceholder();
        this.commercialBrowseApplyLabel = commercialBrowseApply();
        this.commercialBrowseResetLabel = commercialBrowseReset();
        this.commercialDetailSummaryLabel = commercialDetailSummary();
        this.commercialDetailOpenLabel = commercialDetailOpen();
        this.commercialFormLabel = commercialFormLabel();
        this.commercialReviewNoteLabel = commercialReviewNoteLabel();
        this.commercialReviewPlaceholder = commercialReviewPlaceholder();
        this.commercialReviewNoteDescLabel = commercialReviewNoteDesc();
        this.commercialConfirmLabel = commercialConfirm();
        this.commercialResetLabel = commercialReset();
        this.commercialNotifyTitleLabel = commercialNotifyTitle();
        this.commercialNotifyDescLabel = commercialNotifyDesc();
        this.commercialNotifyCloseLabel = commercialNotifyClose();
        this.commercialDrawerTitleLabel = commercialDrawerTitle();
        this.commercialDrawerProjectLabel = commercialDrawerProject();
        this.commercialDrawerTargetLabel = commercialDrawerTarget();
        this.commercialDrawerStatusLabel = commercialDrawerStatus();
        this.commercialDrawerActorLabel = commercialDrawerActor();
        this.commercialOpenConsoleLabel = commercialOpenConsole();
        this.rebuildDrawerItems();
        this.browseColumns = [
            { id: "name", title: consoleColName() },
            { id: "target", title: consoleColTarget() },
            { id: "status", title: consoleColStatus() },
            { id: "actor", title: consoleColActor() },
            { id: "updated", title: consoleColUpdated() },
        ];
        const paths = docsPaths(this.localeId);
        this.guideHref = paths.guideHref;
        this.homeHref = siteHomeHref(this.localeId);
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
        if (preferred && !this.browseLoading) this.loadDemoData();
    }

    refreshBrowseRows() {
        const q = (this.appliedBrowseQuery || "").trim().toLowerCase();
        const filtered = !q
            ? this.allBrowseRows.slice()
            : this.allBrowseRows.filter((row) =>
                  row.cells.some((cell) => String(cell).toLowerCase().includes(q)),
              );
        this.browseFilterEmpty = this.allBrowseRows.length > 0 && filtered.length === 0;
        this.browseRows = filtered.slice(0, 4);
    }

    applyBrowseFilter() {
        this.appliedBrowseQuery = this.browseQuery;
        this.refreshBrowseRows();
    }

    resetBrowseFilter() {
        this.browseQuery = "";
        this.appliedBrowseQuery = "";
        this.refreshBrowseRows();
    }

    effectiveStatus(row) {
        return this.statusOverrides[row.id] || row.status;
    }

    applyRowOverrides(row) {
        const status = this.effectiveStatus(row);
        return applyStatusToRow(row, status, readLocaleId());
    }

    syncFeaturedFromRow(id) {
        const row = this.allBrowseRows.find((entry) => entry.id === id);
        if (!row) return;
        this.featuredStatusLabel = row.cells[2];
    }

    syncTicketStatuses() {
        this.allBrowseRows = this.allBrowseRows.map((row) => this.applyRowOverrides(row));
        this.refreshBrowseRows();
        this.syncFeaturedFromRow(this.featuredId);
        if (this.drawerOpen) {
            const row = this.allBrowseRows.find((entry) => entry.id === this.featuredId);
            if (row) this.detailStatus = row.cells[2];
        }
    }

    async openFeaturedDetail() {
        this.drawerOpen = true;
        const row =
            this.allBrowseRows.find((entry) => entry.id === this.featuredId) ||
            this.allBrowseRows[0];
        try {
            const detail = await CommercialPageServer.getTicketDetail(
                this.featuredId,
                readLocaleId(),
            );
            if (detail && typeof detail === "object") {
                this.detailProject = String(detail.subject || "");
                this.detailTarget = String(detail.priorityLabel || "");
                this.detailStatus = row
                    ? String(row.cells[2] || "")
                    : String(detail.statusLabel || "");
                this.detailActor = String(detail.owner || "");
                this.rebuildDrawerItems();
                return;
            }
        } catch {
            /* fall back below */
        }
        if (!row) return;
        this.detailProject = String(row.cells[0] || "");
        this.detailTarget = String(row.cells[1] || "");
        this.detailStatus = String(row.cells[2] || "");
        this.detailActor = String(row.cells[3] || "");
        this.rebuildDrawerItems();
    }

    rebuildDrawerItems() {
        this.drawerItems = [
            { term: this.commercialDrawerProjectLabel, detail: this.detailProject },
            { term: this.commercialDrawerTargetLabel, detail: this.detailTarget },
            { term: this.commercialDrawerStatusLabel, detail: this.detailStatus },
            { term: this.commercialDrawerActorLabel, detail: this.detailActor },
        ];
    }

    onReviewNote(e) {
        this.reviewNote = e && e.target ? e.target.value : "";
        this.reviewValues = { note: this.reviewNote };
        if (this.reviewError) {
            this.reviewError = "";
            this.reviewDescribedBy = "home-commercial-review-desc";
            this.actionSummary = "";
            this.actionDescribedBy = "";
        }
    }

    onReviewInvalid() {
        this.reviewError = commercialReviewError();
        this.reviewDescribedBy = "home-commercial-review-desc home-commercial-review-err";
        this.actionSummary = commercialContactSummaryError();
        this.actionDescribedBy = "home-commercial-summary";
        this.reviewSuccess = false;
    }

    confirmReview() {
        this.reviewError = "";
        this.reviewDescribedBy = "home-commercial-review-desc";
        this.actionSummary = "";
        this.actionDescribedBy = "";
        this.reviewSuccess = true;
        const targetId = this.featuredId || this.allBrowseRows[0]?.id;
        if (!targetId) return;
        const row = this.allBrowseRows.find((entry) => entry.id === targetId);
        if (!row) return;
        const nextStatus = statusAfterHandlingNote(this.effectiveStatus(row));
        if (nextStatus === this.effectiveStatus(row)) return;
        this.statusOverrides = { ...this.statusOverrides, [row.id]: nextStatus };
        this.syncTicketStatuses();
    }

    resetReview() {
        this.reviewNote = "";
        this.reviewError = "";
        this.reviewValues = { note: "" };
        this.reviewDescribedBy = "home-commercial-review-desc";
        this.actionSummary = "";
        this.actionDescribedBy = "";
        this.reviewSuccess = false;
    }
}
</script>
<script server>
import { formatPriority, formatStatus, mapTicketRow } from "../../demo/ticket-rows.ts";
import TicketDemo from "#server/demo/TicketDemo";

export default class CommercialPageServer {
    getConsoleRows(locale) {
        return new TicketDemo().list(locale).map((ticket) => mapTicketRow(ticket, locale));
    }

    getTicketDetail(id, locale) {
        const ticket = new TicketDemo().list(locale).find((item) => item.id === id);
        if (!ticket) return null;
        return {
            ...ticket,
            priorityLabel: formatPriority(ticket.priority, locale),
            statusLabel: formatStatus(ticket.status, locale),
        };
    }
}
</script>
