                <div class="vmz-commercial-hero__copy">
                    <nav :aria-label="commercialNavLabel" class="vmz-commercial-hero__crumbs">
                        <Link :href="homeHref">
                            {{ homeLabel }}
                        </Link>
                        <span aria-hidden="true">
                            /
                        </span>
                        <span>
                            {{ commercialNavLabel }}
                        </span>
                    </nav>
                    <h1 id="commercial-hero-title" class="vmz-commercial-hero__title">
