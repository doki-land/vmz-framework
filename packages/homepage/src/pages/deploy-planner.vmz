<template>
    <div class="site planner-page">
        <SiteHeader />
        <main class="planner">
            <header class="planner__hero">
                <p class="planner__kicker">
                    <span />
                    交付前自查
                </p>
                <h1 id="planner-title">
                    部署计划器
                </h1>
                <p class="planner__lede">
                    回答几个部署问题，生成一份可直接交给 AI 编码助手的实施提示词。
                    提示词负责说明怎么装；能否跑通仍以
                    <code>
                        vmz check
                    </code>
                    /
                    <code>
                        vmz build
                    </code>
                    为准，不必手写 JSON。
                </p>
            </header>
            <div class="planner__grid">
                <section aria-labelledby="quiz-title" class="planner__quiz">
                    <h2 id="quiz-title">
                        部署问卷
                    </h2>
                    <fieldset class="planner__field">
                        <legend>
                            密钥与会话是否必须留在可信服务器？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setSecrets("none"))' :class="secretsNoneClass">
                                无（公开内容）
                            </button>
                            <button type="button" @click='(() => setSecrets("yes"))' :class="secretsYesClass">
                                是（需要可信服务端）
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            首屏 HTML 从哪来？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setHtml("cdn-prebuild"))' :class="htmlCdnClass">
                                CDN 预生成
                            </button>
                            <button type="button" @click='(() => setHtml("request-ssr"))' :class="htmlSsrClass">
                                请求时 SSR
                            </button>
                            <button type="button" @click='(() => setHtml("browser-only"))' :class="htmlBrowserClass">
                                纯浏览器
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            静态资源放在哪里？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setAssets("same-host"))' :class="assetsSameClass">
                                同机
                            </button>
                            <button type="button" @click='(() => setAssets("cdn"))' :class="assetsCdnClass">
                                CDN
                            </button>
                            <button type="button" @click='(() => setAssets("embedded-binary"))' :class="assetsEmbedClass">
                                嵌进二进制
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            需要服务端进程吗？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setServer("none"))' :class="serverNoneClass">
                                无
                            </button>
                            <button type="button" @click='(() => setServer("node"))' :class="serverNodeClass">
                                Node
                            </button>
                            <button type="button" @click='(() => setServer("worker"))' :class="serverWorkerClass">
                                Worker
                            </button>
                            <button type="button" @click='(() => setServer("rust-host"))' :class="serverRustClass">
                                Rust
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            需要嵌入基线 + 远程整包更新吗？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setUpdate("no"))' :class="updateNoClass">
                                否
                            </button>
                            <button type="button" @click='(() => setUpdate("release-fallback"))' :class="updateYesClass">
                                是（基线 + 整包回退）
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            怎么发布？
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setShip("git-ci"))' :class="shipCiClass">
                                Git CI（配流水线 + push）
                            </button>
                            <button type="button" @click='(() => setShip("direct-upload"))' :class="shipUploadClass">
                                本机直传
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            部署到哪个平台？（可多选）
                        </legend>
                        <div role="group" class="planner__chips planner__chips--wrap">
                            <button type="button" @click='(() => toggleVendor("cloudflare-pages"))' :class="vendorPagesClass">
                                Cloudflare Pages
                            </button>
                            <button type="button" @click='(() => toggleVendor("github-pages"))' :class="vendorGhPagesClass">
                                GitHub Pages
                            </button>
                            <button type="button" @click='(() => toggleVendor("vercel"))' :class="vendorVercelClass">
                                Vercel
                            </button>
                            <button type="button" @click='(() => toggleVendor("netlify"))' :class="vendorNetlifyClass">
                                Netlify
                            </button>
                            <button type="button" @click='(() => toggleVendor("tencent-edgeone"))' :class="vendorEdgeoneClass">
                                腾讯 EdgeOne
                            </button>
                            <button type="button" @click='(() => toggleVendor("cloudflare-workers"))' :class="vendorWorkersClass">
                                CF Workers
                            </button>
                            <button type="button" @click='(() => toggleVendor("s3-cloudfront"))' :class="vendorS3Class">
                                S3 + CloudFront
                            </button>
                            <button type="button" @click='(() => toggleVendor("node-vps"))' :class="vendorNodeClass">
                                自建 Node
                            </button>
                            <button type="button" @click='(() => toggleVendor("rust-bin"))' :class="vendorRustClass">
                                Rust 二进制
                            </button>
                        </div>
                    </fieldset>
                </section>
                <section aria-labelledby="plan-title" class="planner__result">
                    <div class="planner__result-head">
                        <h2 id="plan-title">
                            实施提示词
                        </h2>
                        <div class="planner__copy-row">
                            <Button type="button" variant="secondary" @click="copyPrompt">
                                {{ copyLabel }}
                            </Button>
                        </div>
                    </div>
                    <p role="note" class="planner__disclaimer">
                        {{ disclaimer }}
                    </p>
                    <p v-if="promptCopyFailed" role="alert" class="planner__copy-error">
                        复制失败：请手动选中下方提示词，或检查剪贴板权限。
                    </p>
                    <dl class="planner__meta">
                        <div>
                            <dt>
                                交付配方
                            </dt>
                            <dd>
                                {{ profileLabel }}
                                <code>
                                    {{ profileId }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                组装方式
                            </dt>
                            <dd>
                                {{ assemblyLabel }}
                                <code>
                                    {{ assembly }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                发布方式
                            </dt>
                            <dd>
                                {{ shipLabel }}
                                <code>
                                    {{ ship }}
                                </code>
                            </dd>
                        </div>
                        <div v-if="hasServerRuntime">
                            <dt>
                                服务端运行时
                            </dt>
                            <dd>
                                {{ serverRuntimeLabel }}
                                <code>
                                    {{ serverRuntime }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                需要配置的环境变量名
                            </dt>
                            <dd>
                                <code>
                                    {{ requiredEnvLabel }}
                                </code>
                            </dd>
                        </div>
                    </dl>
                    <div v-if="hasCautions" role="status" class="planner__cautions">
                        <h3>
                            选型警告
                        </h3>
                        <ul>
                            <li v-for="item in cautionItems" :key="item.id">
                                {{ item.text }}
                            </li>
                        </ul>
                    </div>
                    <h3>
                        完整提示词
                    </h3>
                    <pre class="planner__code planner__code--prompt">
                        <code>
                            {{ agentPrompt }}
                        </code>
                    </pre>
                    <details class="planner__summary">
                        <summary>
                            摘要：建议命令、外部清单与 delivery 配置
                        </summary>
                        <h4>
                            建议命令
                        </h4>
                        <ul class="planner__commands">
                            <li v-for="item in commandItems" :key="item.id">
                                <code>
                                    {{ item.text }}
                                </code>
                            </li>
                        </ul>
                        <h4>
                            外部填写清单
                        </h4>
                        <div class="planner__steps">
                            <article v-for="step in stepItems" :key="step.id" class="planner__step">
                                <h5>
                                    {{ step.title }}
                                </h5>
                                <p class="planner__axis-label">
                                    控制台
                                </p>
                                <ul>
                                    <li v-for="field in step.console">
                                        {{ field }}
                                    </li>
                                </ul>
                                <p class="planner__axis-label">
                                    Git CI
                                </p>
                                <ul>
                                    <li v-for="field in step.ci">
                                        {{ field }}
                                    </li>
                                </ul>
                                <p class="planner__axis-label">
                                    本机直传
                                </p>
                                <ul>
                                    <li v-for="field in step.localPush">
                                        {{ field }}
                                    </li>
                                </ul>
                            </article>
                        </div>
                        <h4>
                            delivery 配置
                        </h4>
                        <pre class="planner__code">
                            <code>
                                {{ vmzConfigSnippet }}
                            </code>
                        </pre>
                    </details>
                    <h3>
                        相关文档
                    </h3>
                    <ul class="planner__links">
                        <li v-for="link in deepLinkItems" :key="link.href">
                            <a :href="link.href">
                                {{ link.label }}
                            </a>
                        </li>
                    </ul>
                </section>
            </div>
        </main>
        <SiteFooter />
    </div>
</template>
<style>
.planner-page {
    background: var(--vmz-surface-paper);
}
.planner {
    width: min(calc(100% - 2rem), 80rem);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
}
.planner__hero {
    max-width: 40rem;
    margin-bottom: 2.5rem;
}
.planner__kicker {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.85rem;
    color: var(--vmz-text-steel);
    font: 500 0.73rem/1.2 var(--vmz-font-mono);
    text-transform: uppercase;
}
.planner__kicker span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: var(--vmz-radius-xs);
    background: var(--vmz-brand-energy);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--vmz-brand-energy) 14%, transparent);
}
.planner__hero h1 {
    margin: 0 0 0.75rem;
    font-family: var(--vmz-font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: -0.03em;
    color: var(--vmz-text-ink);
}
.planner__lede {
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: 1.05rem;
    line-height: 1.65;
}
.planner__grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
}
.planner__quiz,
.planner__result {
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-mist);
    padding: 1.25rem 1.35rem 1.5rem;
}
.planner__result {
    background: var(--vmz-surface-paper);
}
.planner__quiz h2,
.planner__result h2 {
    margin: 0 0 1rem;
    font-family: var(--vmz-font-display);
    font-size: 1.25rem;
}
.planner__result h3 {
    margin: 1.35rem 0 0.55rem;
    font-size: 0.85rem;
    font-family: var(--vmz-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--vmz-text-steel);
}
.planner__field {
    margin: 0 0 1.15rem;
    padding: 0;
    border: 0;
}
.planner__field legend {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--vmz-text-ink);
}
.planner__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
}
.planner__chips button {
    appearance: none;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    padding: 0.5rem 0.75rem;
    font: 500 0.86rem/1.2 var(--vmz-font-sans);
    cursor: pointer;
}
.planner__chips button:hover {
    border-color: color-mix(in srgb, var(--vmz-action-primary-background) 40%, var(--vmz-surface-paper));
    color: var(--vmz-action-link-foreground);
}
.planner__chips button.is-active {
    border-color: var(--vmz-action-primary-background);
    background: color-mix(in srgb, var(--vmz-action-primary-background) 10%, var(--vmz-surface-paper));
    color: var(--vmz-action-link-foreground);
}
.planner__result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}
.planner__copy-row {
    display: flex;
    flex-wrap: wrap;
