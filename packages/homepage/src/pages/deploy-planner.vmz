<template>
    <SiteShell page="deploy-planner" variant="planner-page">
        <main id="main" class="planner">
            <header class="planner__hero">
                <p class="v2-kicker">
                    <span aria-hidden="true" class="v2-kicker__dot" />
                    {{ kicker }}
                </p>
                <h1 id="planner-title">
                    {{ titleText }}
                </h1>
                <p class="planner__lede">
                    {{ ledeLead }}
                    <code>
                        vmz check
                    </code>
                    /
                    <code>
                        vmz build
                    </code>
                    {{ ledeTail }}
                </p>
            </header>
            <div class="planner__grid">
                <section aria-labelledby="quiz-title" class="planner__quiz">
                    <h2 id="quiz-title">
                        {{ quizTitle }}
                    </h2>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qSecrets }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setSecrets("none"))' :class="secretsNoneClass">
                                {{ optSecretsNone }}
                            </button>
                            <button type="button" @click='(() => setSecrets("yes"))' :class="secretsYesClass">
                                {{ optSecretsYes }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qHtml }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setHtml("cdn-prebuild"))' :class="htmlCdnClass">
                                {{ optHtmlCdn }}
                            </button>
                            <button type="button" @click='(() => setHtml("request-ssr"))' :class="htmlSsrClass">
                                {{ optHtmlSsr }}
                            </button>
                            <button type="button" @click='(() => setHtml("browser-only"))' :class="htmlBrowserClass">
                                {{ optHtmlBrowser }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qAssets }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setAssets("same-host"))' :class="assetsSameClass">
                                {{ optAssetsSame }}
                            </button>
                            <button type="button" @click='(() => setAssets("cdn"))' :class="assetsCdnClass">
                                {{ optAssetsCdn }}
                            </button>
                            <button type="button" @click='(() => setAssets("embedded-binary"))' :class="assetsEmbedClass">
                                {{ optAssetsEmbed }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qServer }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setServer("none"))' :class="serverNoneClass">
                                {{ optNone }}
                            </button>
                            <button type="button" @click='(() => setServer("node"))' :class="serverNodeClass">
                                {{ optNode }}
                            </button>
                            <button type="button" @click='(() => setServer("worker"))' :class="serverWorkerClass">
                                {{ optWorker }}
                            </button>
                            <button type="button" @click='(() => setServer("rust-host"))' :class="serverRustClass">
                                {{ optRust }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qUpdate }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setUpdate("no"))' :class="updateNoClass">
                                {{ optNo }}
                            </button>
                            <button type="button" @click='(() => setUpdate("release-fallback"))' :class="updateYesClass">
                                {{ optUpdateYes }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qShip }}
                        </legend>
                        <div role="group" class="planner__chips">
                            <button type="button" @click='(() => setShip("git-ci"))' :class="shipCiClass">
                                {{ optShipCi }}
                            </button>
                            <button type="button" @click='(() => setShip("direct-upload"))' :class="shipUploadClass">
                                {{ optShipUpload }}
                            </button>
                        </div>
                    </fieldset>
                    <fieldset class="planner__field">
                        <legend>
                            {{ qVendor }}
                        </legend>
                        <div role="group" class="planner__chips planner__chips--wrap">
                            <button type="button" @click='(() => toggleVendor("cloudflare-pages"))' :class="vendorPagesClass">
                                Cloudflare Pages
                            </button>
                            <button type="button" @click='(() => toggleVendor("github-pages"))' :class="vendorGhPagesClass">
                                GitHub Pages
                            </button>
                            <button type="button" @click='(() => toggleVendor("vercel"))' :class="vendorVercelClass">
                                Vercel
                            </button>
                            <button type="button" @click='(() => toggleVendor("netlify"))' :class="vendorNetlifyClass">
                                Netlify
                            </button>
                            <button type="button" @click='(() => toggleVendor("tencent-edgeone"))' :class="vendorEdgeoneClass">
                                {{ vendorEdgeone }}
                            </button>
                            <button type="button" @click='(() => toggleVendor("cloudflare-workers"))' :class="vendorWorkersClass">
                                CF Workers
                            </button>
                            <button type="button" @click='(() => toggleVendor("s3-cloudfront"))' :class="vendorS3Class">
                                S3 + CloudFront
                            </button>
                            <button type="button" @click='(() => toggleVendor("node-vps"))' :class="vendorNodeClass">
                                {{ vendorNode }}
                            </button>
                            <button type="button" @click='(() => toggleVendor("rust-bin"))' :class="vendorRustClass">
                                {{ vendorRust }}
                            </button>
                        </div>
                    </fieldset>
                </section>
                <section aria-labelledby="plan-title" class="planner__result">
                    <div class="planner__result-head">
                        <h2 id="plan-title">
                            {{ resultTitle }}
                        </h2>
                        <div class="planner__copy-row">
                            <Button type="button" variant="secondary" @click="copyPrompt">
                                {{ copyLabel }}
                            </Button>
                        </div>
                    </div>
                    <p role="note" class="planner__disclaimer">
                        {{ disclaimer }}
                    </p>
                    <p v-if="promptCopyFailed" role="alert" class="planner__copy-error">
                        {{ copyError }}
                    </p>
                    <dl class="planner__meta">
                        <div>
                            <dt>
                                {{ metaProfile }}
                            </dt>
                            <dd>
                                {{ profileLabel }}
                                <code>
                                    {{ profileId }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                {{ metaAssembly }}
                            </dt>
                            <dd>
                                {{ assemblyLabel }}
                                <code>
                                    {{ assembly }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                {{ metaShip }}
                            </dt>
                            <dd>
                                {{ shipLabel }}
                                <code>
                                    {{ ship }}
                                </code>
                            </dd>
                        </div>
                        <div v-if="hasServerRuntime">
                            <dt>
                                {{ metaRuntime }}
                            </dt>
                            <dd>
                                {{ serverRuntimeLabel }}
                                <code>
                                    {{ serverRuntime }}
                                </code>
                            </dd>
                        </div>
                        <div>
                            <dt>
                                {{ metaEnv }}
                            </dt>
                            <dd>
                                <code>
                                    {{ requiredEnvLabel }}
                                </code>
                            </dd>
                        </div>
                    </dl>
                    <div v-if="hasCautions" role="status" class="planner__cautions">
                        <h3>
                            {{ cautionsTitle }}
                        </h3>
                        <ul>
                            <li v-for="item in cautionItems" :key="item.id">
                                {{ item.text }}
                            </li>
                        </ul>
                    </div>
                    <h3>
                        {{ promptHeading }}
                    </h3>
                    <pre class="planner__code planner__code--prompt">
                        <code>
                            {{ agentPrompt }}
                        </code>
                    </pre>
                    <details class="planner__summary">
                        <summary>
                            {{ summary }}
                        </summary>
                        <h4>
                            {{ commandsHeading }}
                        </h4>
                        <ul class="planner__commands">
                            <li v-for="item in commandItems" :key="item.id">
                                <code>
                                    {{ item.text }}
                                </code>
                            </li>
                        </ul>
                        <h4>
                            {{ externalHeading }}
                        </h4>
                        <div class="planner__steps">
                            <article v-for="step in stepItems" :key="step.id" class="planner__step">
                                <h5>
                                    {{ step.title }}
                                </h5>
                                <p class="planner__axis-label">
                                    {{ axisConsole }}
                                </p>
                                <ul>
                                    <li v-for="field in step.console">
                                        {{ field }}
                                    </li>
                                </ul>
                                <p class="planner__axis-label">
                                    {{ axisCi }}
                                </p>
                                <ul>
                                    <li v-for="field in step.ci">
                                        {{ field }}
                                    </li>
                                </ul>
                                <p class="planner__axis-label">
                                    {{ axisUpload }}
                                </p>
                                <ul>
                                    <li v-for="field in step.localPush">
                                        {{ field }}
                                    </li>
                                </ul>
                            </article>
                        </div>
                        <h4>
                            {{ deliveryHeading }}
                        </h4>
                        <pre class="planner__code">
                            <code>
                                {{ vmzConfigSnippet }}
                            </code>
                        </pre>
                    </details>
                    <h3>
                        {{ docsHeading }}
                    </h3>
                    <ul class="planner__links">
                        <li v-for="link in deepLinkItems" :key="link.href">
                            <a :href="link.href">
                                {{ link.label }}
                            </a>
                        </li>
                    </ul>
                </section>
            </div>
        </main>
    </SiteShell>
</template>
<style>
.planner-page {
    background: var(--vmz-surface-paper);
}
.planner {
    width: min(calc(100% - 2rem), 80rem);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
}
.planner__hero {
    max-width: 44rem;
    margin-bottom: 2.5rem;
}
.planner__hero .v2-kicker {
    margin-bottom: 0.85rem;
}
.planner__hero h1 {
    margin: 0 0 0.85rem;
    font-family: var(--vmz-font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--vmz-text-ink);
}
.planner__lede {
    margin: 0;
    color: var(--vmz-text-steel);
    font-size: 1.05rem;
    line-height: 1.65;
}
.planner__grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
}
.planner__quiz,
.planner__result {
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-mist);
    padding: 1.25rem 1.35rem 1.5rem;
}
.planner__result {
    background: var(--vmz-surface-paper);
}
.planner__quiz h2,
.planner__result h2 {
    margin: 0 0 1rem;
    font-family: var(--vmz-font-display);
    font-size: 1.25rem;
}
.planner__result h3 {
    margin: 1.35rem 0 0.55rem;
    font-size: 0.85rem;
    font-family: var(--vmz-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--vmz-text-steel);
}
.planner__field {
    margin: 0 0 1.15rem;
    padding: 0;
    border: 0;
}
.planner__field legend {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--vmz-text-ink);
}
.planner__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
}
.planner__chips button {
    appearance: none;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-steel);
    padding: 0.5rem 0.75rem;
    font: 500 0.86rem/1.2 var(--vmz-font-sans);
    cursor: pointer;
}
.planner__chips button:hover {
    border-color: color-mix(in srgb, var(--vmz-action-primary-background) 40%, var(--vmz-surface-paper));
    color: var(--vmz-action-link-foreground);
}
.planner__chips button.is-active {
    border-color: var(--vmz-action-primary-background);
    background: color-mix(in srgb, var(--vmz-action-primary-background) 10%, var(--vmz-surface-paper));
    color: var(--vmz-action-link-foreground);
}
.planner__result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}
.planner__copy-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}
.planner__disclaimer {
    margin: 0.85rem 0 1rem;
    padding: 0.75rem 0.9rem;
    border-left: 3px solid var(--vmz-brand-energy);
    background: color-mix(in srgb, var(--vmz-status-warning-accent) 12%, var(--vmz-surface-paper));
    color: var(--vmz-status-warning-foreground);
    font-size: 0.9rem;
    line-height: 1.5;
}
.planner__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1rem;
    margin: 0;
}
.planner__meta div {
    margin: 0;
}
.planner__meta dt {
    margin: 0;
    font: 500 0.7rem/1.2 var(--vmz-font-mono);
    text-transform: uppercase;
    color: var(--vmz-text-steel);
}
.planner__meta dd {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
}
.planner__meta dd code {
    margin-inline-start: 0.35rem;
}
.planner__cautions {
    margin-top: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--vmz-status-warning-accent) 35%, var(--vmz-surface-paper));
    border-radius: var(--vmz-radius-sm);
    background: color-mix(in srgb, var(--vmz-status-warning-accent) 12%, var(--vmz-surface-paper));
}
.planner__cautions h3 {
    margin: 0 0 0.4rem;
    color: var(--vmz-status-warning-foreground);
}
.planner__cautions ul,
.planner__commands,
.planner__links,
.planner__step ul {
    margin: 0;
    padding-left: 1.15rem;
}
.planner__cautions li,
.planner__commands li,
.planner__links li,
.planner__step li {
    margin: 0.25rem 0;
    line-height: 1.45;
}
.planner__code {
    margin: 0;
    padding: 0.9rem 1rem;
    overflow: auto;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-code);
    color: var(--vmz-text-on-inverse);
    font: 0.82rem/1.5 var(--vmz-font-mono);
    white-space: pre-wrap;
}
.planner__code--prompt {
    max-height: min(70vh, 42rem);
}
.planner__copy-error {
    margin: 0 0 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--vmz-radius-sm);
    background: color-mix(in srgb, var(--vmz-status-danger-accent) 8%, var(--vmz-surface-paper));
    color: var(--vmz-status-danger-foreground);
    font-size: 0.88rem;
}
.planner__summary {
    margin: 1.25rem 0 0;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-mist);
}
.planner__summary summary {
    cursor: pointer;
    font: 600 0.85rem/1.4 var(--vmz-font-mono);
    color: var(--vmz-text-steel);
}
.planner__summary h4 {
    margin: 1rem 0 0.45rem;
    font-size: 0.8rem;
    font-family: var(--vmz-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--vmz-text-steel);
}
.planner__summary h5 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
}
.planner__steps {
    display: grid;
    gap: 0.75rem;
}
.planner__step {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-paper);
}
.planner__axis-label {
    margin: 0.55rem 0 0.2rem;
    font: 600 0.7rem/1.2 var(--vmz-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--vmz-text-steel);
}
.planner__commands {
    margin: 0;
    padding-left: 1.15rem;
}
@media (max-width: 900px) {
    .planner__grid {
        grid-template-columns: 1fr;
    }
    .planner__meta {
        grid-template-columns: 1fr;
    }
}
</style>
<script client>
import {
    plannerKicker,
    plannerTitle,
    plannerLedeLead,
    plannerLedeTail,
    plannerQuizTitle,
    plannerQSecrets,
    plannerOptSecretsNone,
    plannerOptSecretsYes,
    plannerQHtml,
    plannerOptHtmlCdn,
    plannerOptHtmlSsr,
    plannerOptHtmlBrowser,
    plannerQAssets,
    plannerOptAssetsSame,
    plannerOptAssetsCdn,
    plannerOptAssetsEmbed,
    plannerQServer,
    plannerOptNone,
    plannerOptNode,
    plannerOptWorker,
    plannerOptRust,
    plannerQUpdate,
    plannerOptNo,
    plannerOptUpdateYes,
    plannerQShip,
    plannerOptShipCi,
    plannerOptShipUpload,
    plannerQVendor,
    plannerVendorEdgeone,
    plannerVendorNode,
    plannerVendorRust,
    plannerResultTitle,
    plannerCopy,
    plannerCopied,
    plannerCopyFailedLabel,
    plannerCopyError,
    plannerMetaProfile,
    plannerMetaAssembly,
    plannerMetaShip,
    plannerMetaRuntime,
    plannerMetaEnv,
    plannerCautionsTitle,
    plannerPromptHeading,
    plannerSummary,
    plannerCommands,
    plannerExternal,
    plannerDelivery,
    plannerDocs,
    plannerAxisConsole,
    plannerAxisCi,
    plannerAxisUpload,
} from "#locales/planner";
import { buildDeployPlan, DEFAULT_ANSWERS } from "../deploy/planner.ts";
import { plannerCopy as plannerLabels } from "../deploy/planner-copy.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

export default class DeployPlannerPage {
    localeId = readLocaleId();
    _unwatchLocale = null;

    secrets = DEFAULT_ANSWERS.secrets;
    html = DEFAULT_ANSWERS.html;
    assets = DEFAULT_ANSWERS.assets;
    server = DEFAULT_ANSWERS.server;
    update = DEFAULT_ANSWERS.update;
    ship = DEFAULT_ANSWERS.ship;

    vendorPages = false;
    vendorGhPages = false;
    vendorVercel = false;
    vendorNetlify = false;
    vendorEdgeone = false;
    vendorCfWorkers = false;
    vendorS3 = false;
    vendorNode = false;
    vendorRust = false;

    kicker = "";
    titleText = "";
    ledeLead = "";
    ledeTail = "";
    quizTitle = "";
    qSecrets = "";
    optSecretsNone = "";
    optSecretsYes = "";
    qHtml = "";
    optHtmlCdn = "";
    optHtmlSsr = "";
    optHtmlBrowser = "";
    qAssets = "";
    optAssetsSame = "";
    optAssetsCdn = "";
    optAssetsEmbed = "";
    qServer = "";
    optNone = "";
    optNode = "";
    optWorker = "";
    optRust = "";
    qUpdate = "";
    optNo = "";
    optUpdateYes = "";
    qShip = "";
    optShipCi = "";
    optShipUpload = "";
    qVendor = "";
    vendorEdgeone = "";
    vendorNode = "";
    vendorRust = "";
    resultTitle = "";
    copyError = "";
    metaProfile = "";
    metaAssembly = "";
    metaShip = "";
    metaRuntime = "";
    metaEnv = "";
    cautionsTitle = "";
    promptHeading = "";
    summary = "";
    commandsHeading = "";
    externalHeading = "";
    deliveryHeading = "";
    docsHeading = "";
    axisConsole = "";
    axisCi = "";
    axisUpload = "";

    profileId = "";
    assembly = "";
    serverRuntime = "";
    hasServerRuntime = false;
    profileLabel = "";
    assemblyLabel = "";
    shipLabel = "";
    serverRuntimeLabel = "";
    requiredEnvLabel = "";
    agentPrompt = "";
    vmzConfigSnippet = "";
    disclaimer = "";
    hasCautions = false;
    cautionItems = [];
    commandItems = [];
    stepItems = [];
    deepLinkItems = [];
    promptCopied = false;
    promptCopyFailed = false;
    copyLabel = "";
    copyLabelDefault = "";

    secretsNoneClass = "is-active";
    secretsYesClass = "";
    htmlCdnClass = "is-active";
    htmlSsrClass = "";
    htmlBrowserClass = "";
    assetsSameClass = "";
    assetsCdnClass = "is-active";
    assetsEmbedClass = "";
    serverNoneClass = "is-active";
    serverNodeClass = "";
    serverWorkerClass = "";
    serverRustClass = "";
    updateNoClass = "is-active";
    updateYesClass = "";
    shipCiClass = "is-active";
    shipUploadClass = "";
    vendorPagesClass = "";
    vendorGhPagesClass = "";
    vendorVercelClass = "";
    vendorNetlifyClass = "";
    vendorEdgeoneClass = "";
    vendorWorkersClass = "";
    vendorS3Class = "";
    vendorNodeClass = "";
    vendorRustClass = "";

    /** Localized chrome must exist before first render for SSR. */
    copyReady = this.applyLocale(this.localeId);

    /**
     * Derived plan must exist before the first render: the route render path
     * evaluates field initializers, so a constructor-only call would leave the
     * whole result panel empty in the server HTML.
     */
    planReady = this.refresh();

    onMount() {
        this.applyLocale(readLocaleId());
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocale(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    applyLocale(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
        this.refresh();
    }

    refreshCopy() {
        this.kicker = plannerKicker();
        this.titleText = plannerTitle();
        this.ledeLead = plannerLedeLead();
        this.ledeTail = plannerLedeTail();
        this.quizTitle = plannerQuizTitle();
        this.qSecrets = plannerQSecrets();
        this.optSecretsNone = plannerOptSecretsNone();
        this.optSecretsYes = plannerOptSecretsYes();
        this.qHtml = plannerQHtml();
        this.optHtmlCdn = plannerOptHtmlCdn();
        this.optHtmlSsr = plannerOptHtmlSsr();
        this.optHtmlBrowser = plannerOptHtmlBrowser();
        this.qAssets = plannerQAssets();
        this.optAssetsSame = plannerOptAssetsSame();
        this.optAssetsCdn = plannerOptAssetsCdn();
        this.optAssetsEmbed = plannerOptAssetsEmbed();
        this.qServer = plannerQServer();
        this.optNone = plannerOptNone();
        this.optNode = plannerOptNode();
        this.optWorker = plannerOptWorker();
        this.optRust = plannerOptRust();
        this.qUpdate = plannerQUpdate();
        this.optNo = plannerOptNo();
        this.optUpdateYes = plannerOptUpdateYes();
        this.qShip = plannerQShip();
        this.optShipCi = plannerOptShipCi();
        this.optShipUpload = plannerOptShipUpload();
        this.qVendor = plannerQVendor();
        this.vendorEdgeone = plannerVendorEdgeone();
        this.vendorNode = plannerVendorNode();
        this.vendorRust = plannerVendorRust();
        this.resultTitle = plannerResultTitle();
        this.copyError = plannerCopyError();
        this.metaProfile = plannerMetaProfile();
        this.metaAssembly = plannerMetaAssembly();
        this.metaShip = plannerMetaShip();
        this.metaRuntime = plannerMetaRuntime();
        this.metaEnv = plannerMetaEnv();
        this.cautionsTitle = plannerCautionsTitle();
        this.promptHeading = plannerPromptHeading();
        this.summary = plannerSummary();
        this.commandsHeading = plannerCommands();
        this.externalHeading = plannerExternal();
        this.deliveryHeading = plannerDelivery();
        this.docsHeading = plannerDocs();
        this.axisConsole = plannerAxisConsole();
        this.axisCi = plannerAxisCi();
        this.axisUpload = plannerAxisUpload();
        this.copyLabelDefault = plannerCopy();
        this.copyLabel = this.copyLabelDefault;
    }

    vendors() {
        const list = [];
        if (this.vendorPages) list.push("cloudflare-pages");
        if (this.vendorGhPages) list.push("github-pages");
        if (this.vendorVercel) list.push("vercel");
        if (this.vendorNetlify) list.push("netlify");
        if (this.vendorEdgeone) list.push("tencent-edgeone");
        if (this.vendorCfWorkers) list.push("cloudflare-workers");
        if (this.vendorS3) list.push("s3-cloudfront");
        if (this.vendorNode) list.push("node-vps");
        if (this.vendorRust) list.push("rust-bin");
        return list;
    }

    refreshChipClasses() {
        this.secretsNoneClass = this.secrets === "none" ? "is-active" : "";
        this.secretsYesClass = this.secrets === "yes" ? "is-active" : "";
        this.htmlCdnClass = this.html === "cdn-prebuild" ? "is-active" : "";
        this.htmlSsrClass = this.html === "request-ssr" ? "is-active" : "";
        this.htmlBrowserClass = this.html === "browser-only" ? "is-active" : "";
        this.assetsSameClass = this.assets === "same-host" ? "is-active" : "";
        this.assetsCdnClass = this.assets === "cdn" ? "is-active" : "";
        this.assetsEmbedClass = this.assets === "embedded-binary" ? "is-active" : "";
        this.serverNoneClass = this.server === "none" ? "is-active" : "";
        this.serverNodeClass = this.server === "node" ? "is-active" : "";
        this.serverWorkerClass = this.server === "worker" ? "is-active" : "";
        this.serverRustClass = this.server === "rust-host" ? "is-active" : "";
        this.updateNoClass = this.update === "no" ? "is-active" : "";
        this.updateYesClass = this.update === "release-fallback" ? "is-active" : "";
        this.shipCiClass = this.ship === "git-ci" ? "is-active" : "";
        this.shipUploadClass = this.ship === "direct-upload" ? "is-active" : "";
        this.vendorPagesClass = this.vendorPages ? "is-active" : "";
        this.vendorGhPagesClass = this.vendorGhPages ? "is-active" : "";
        this.vendorVercelClass = this.vendorVercel ? "is-active" : "";
        this.vendorNetlifyClass = this.vendorNetlify ? "is-active" : "";
        this.vendorEdgeoneClass = this.vendorEdgeone ? "is-active" : "";
        this.vendorWorkersClass = this.vendorCfWorkers ? "is-active" : "";
        this.vendorS3Class = this.vendorS3 ? "is-active" : "";
        this.vendorNodeClass = this.vendorNode ? "is-active" : "";
        this.vendorRustClass = this.vendorRust ? "is-active" : "";
    }

    refresh() {
        this.refreshChipClasses();
        const labels = plannerLabels(this.localeId);
        const plan = buildDeployPlan({
            secrets: this.secrets,
            html: this.html,
            assets: this.assets,
            server: this.server,
            update: this.update,
            ship: this.ship,
            vendors: this.vendors(),
            locale: this.localeId,
        });
        this.profileId = plan.profileId;
        this.assembly = plan.assembly;
        this.ship = plan.ship;
        this.serverRuntime = plan.serverRuntime || "";
        this.hasServerRuntime = !!plan.serverRuntime;
        this.profileLabel = labels.labels.profiles[plan.profileId] || labels.labels.customProfile;
        this.assemblyLabel = labels.labels.assemblies[plan.assembly] || labels.labels.customAssembly;
        this.shipLabel = plan.ship === "git-ci" ? labels.labels.shipGitCi : labels.labels.shipUpload;
        this.serverRuntimeLabel =
            labels.labels.runtimes[plan.serverRuntime] || labels.labels.customRuntime;
        this.requiredEnvLabel =
            plan.requiredEnv.length > 0 ? plan.requiredEnv.join(labels.listSeparator) : labels.labels.none;
        this.agentPrompt = plan.agentPrompt;
        this.vmzConfigSnippet = plan.vmzConfigSnippet;
        // Prompt keeps markdown backticks; the page shows plain prose.
        this.disclaimer = plan.disclaimer.split("`").join("");
        this.hasCautions = plan.cautions.length > 0;
        this.cautionItems = plan.cautions.map((text, i) => ({ id: `c${i}`, text: text.split("`").join("") }));
        this.commandItems = plan.commandsSuggested.map((text, i) => ({ id: `cmd${i}`, text }));
        this.stepItems = plan.externalSteps.map((step) => ({
            id: step.id,
            title: step.title,
            console: step.console,
            ci: step.ci,
            localPush: step.localPush,
        }));
        this.deepLinkItems = plan.deepLinks;
        this.promptCopied = false;
        this.promptCopyFailed = false;
        this.copyLabel = this.copyLabelDefault;
    }

    setSecrets(v) {
        this.secrets = v;
        this.refresh();
    }
    setHtml(v) {
        this.html = v;
        this.refresh();
    }
    setAssets(v) {
        this.assets = v;
        this.refresh();
    }
    setServer(v) {
        this.server = v;
        this.refresh();
    }
    setUpdate(v) {
        this.update = v;
        this.refresh();
    }
    setShip(v) {
        this.ship = v;
        this.refresh();
    }

    toggleVendor(id) {
        if (id === "cloudflare-pages") this.vendorPages = !this.vendorPages;
        if (id === "github-pages") this.vendorGhPages = !this.vendorGhPages;
        if (id === "vercel") this.vendorVercel = !this.vendorVercel;
        if (id === "netlify") this.vendorNetlify = !this.vendorNetlify;
        if (id === "tencent-edgeone") this.vendorEdgeone = !this.vendorEdgeone;
        if (id === "cloudflare-workers") this.vendorCfWorkers = !this.vendorCfWorkers;
        if (id === "s3-cloudfront") this.vendorS3 = !this.vendorS3;
        if (id === "node-vps") this.vendorNode = !this.vendorNode;
        if (id === "rust-bin") this.vendorRust = !this.vendorRust;
        this.refresh();
    }

    copyPrompt() {
        const text = this.agentPrompt;
        const ok = () => {
            this.promptCopied = true;
            this.promptCopyFailed = false;
            withLocaleHint(this.localeId, () => {
                this.copyLabel = plannerCopied();
            });
        };
        const fail = () => {
            this.promptCopied = false;
            this.promptCopyFailed = true;
            withLocaleHint(this.localeId, () => {
                this.copyLabel = plannerCopyFailedLabel();
            });
        };
        if (
            typeof navigator !== "undefined" &&
            navigator.clipboard &&
            navigator.clipboard.writeText
        ) {
            navigator.clipboard.writeText(text).then(ok, fail);
            return;
        }
        fail();
    }
}
</script>
