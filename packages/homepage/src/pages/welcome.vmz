<template>
    <SiteShell page="welcome" variant="welcome-shell">
        <main id="main" aria-labelledby="welcome-title" class="welcome-v2">
            <section class="welcome-v2__main">
                <div class="welcome-v2__intro">
                    <p class="v2-kicker">
                        <span aria-hidden="true" class="v2-kicker__dot" />
                        {{ kickerLabel }}
                    </p>
                    <h1 id="welcome-title">
                        {{ titleLeadLabel }}
                        <br />
                        <em>
                            {{ titleEmLabel }}
                        </em>
                    </h1>
                    <p class="welcome-v2__lede">
                        {{ ledeLabel }}
                    </p>
                    <div class="welcome-v2__actions">
                        <a href="/" class="welcome-v2__primary">
                            {{ exploreLabel }}
                        </a>
                        <a data-vmz-fixture="welcome-start" :href="guideHref" class="welcome-v2__secondary">
                            {{ startLabel }}
                            <span aria-hidden="true">
                                →
                            </span>
                        </a>
                    </div>
                </div>
                <aside data-vmz-fixture="welcome-start-panel" :aria-label="startTitleLabel" class="welcome-v2__start">
                    <h2>
                        {{ startTitleLabel }}
                    </h2>
                    <div class="welcome-v2__start-block">
                        <span class="welcome-v2__start-label">
                            {{ installLabel }}
                        </span>
                        <pre><code>pnpm add @vmz/ui</code></pre>
                    </div>
                    <p class="welcome-v2__start-note">
                        {{ installNote }}
                    </p>
                    <div class="welcome-v2__start-block">
                        <span class="welcome-v2__start-label">
                            {{ exampleLabel }}
                        </span>
                        <pre><code>{{ exampleCode }}</code></pre>
                    </div>
                    <nav :aria-label="docsLabel" class="welcome-v2__docs">
                        <a :href="guideHref">
                            {{ docsGuideLabel }}
                            <span aria-hidden="true">
                                →
                            </span>
                        </a>
                        <a :href="deployDocHref">
                            {{ docsDeployLabel }}
                            <span aria-hidden="true">
                                →
                            </span>
                        </a>
                        <a href="/lab/components">
                            {{ docsComponentsLabel }}
                            <span aria-hidden="true">
                                →
                            </span>
                        </a>
                    </nav>
                </aside>
            </section>
            <div :aria-label="railAriaLabel" class="welcome-v2__rail">
                <div>
                    <span>
                        01
                    </span>
                    <strong>
                        {{ rail1TitleLabel }}
                    </strong>
                    <small>
                        {{ rail1DescLabel }}
                    </small>
                </div>
                <div>
                    <span>
                        02
                    </span>
                    <strong>
                        {{ rail2TitleLabel }}
                    </strong>
                    <small>
                        {{ rail2DescLabel }}
                    </small>
                </div>
                <div>
                    <span>
                        03
                    </span>
                    <strong>
                        {{ rail3TitleLabel }}
                    </strong>
                    <small>
                        {{ rail3DescLabel }}
                    </small>
                </div>
            </div>
        </main>
    </SiteShell>
</template>
<style>
.welcome-v2 { display: grid; grid-template-rows: 1fr auto; min-height: 100vh; padding: 0 max(1.5rem, calc((100% - var(--v2-content)) / 2)); overflow: hidden; color: var(--v2-ink); background: var(--v2-canvas); }
.welcome-v2__main { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2rem, 5vw, 4.5rem); align-content: center; align-items: center; padding: 4rem 0; }
.welcome-v2__intro { display: grid; align-content: center; justify-items: start; }
.welcome-v2__main .v2-kicker { margin-bottom: 1.6rem; }
.welcome-v2 h1 { margin: 0; max-width: 16ch; font: 600 clamp(2.75rem, 4.6vw, 4.5rem)/1.1 var(--vmz-font-display); letter-spacing: -0.01em; }
.welcome-v2 h1 em { color: var(--v2-blue); font-style: normal; }
.welcome-v2__lede { max-width: 46rem; margin: 1.7rem 0 0; color: var(--v2-muted); font-size: 1.12rem; line-height: 1.75; }
.welcome-v2__actions { display: flex; gap: .75rem; margin-top: 2.2rem; }
.welcome-v2__actions a { display: inline-flex; align-items: center; justify-content: center; min-height: 2.9rem; padding: .75rem 1.15rem; border-radius: var(--v2-radius); text-decoration: none; font-size: .92rem; font-weight: 600; }
.welcome-v2__primary { color: var(--vmz-action-primary-foreground); background: var(--v2-blue); box-shadow: 0 6px 16px color-mix(in srgb, var(--v2-blue) 24%, transparent); }
.welcome-v2__primary:hover { color: var(--v2-surface); background: var(--vmz-action-primary-hover); }
.welcome-v2__secondary { color: var(--v2-ink); background: var(--v2-surface); border: 1px solid var(--v2-line); }
.welcome-v2__secondary:hover { color: var(--v2-blue); border-color: var(--vmz-action-primary-hover); }
.welcome-v2__start { display: grid; align-content: start; gap: .85rem; min-width: 0; padding: 1.5rem; border: 1px solid var(--v2-line); border-radius: var(--v2-radius-lg); background: var(--v2-surface); box-shadow: var(--v2-elevation-2); }
.welcome-v2__start h2 { margin: 0; font: 600 1.05rem var(--vmz-font-display); }
.welcome-v2__start-block { display: grid; gap: .4rem; min-width: 0; }
.welcome-v2__start-label { color: var(--v2-subtle); font-size: .74rem; letter-spacing: .04em; text-transform: uppercase; }
.welcome-v2__start pre { margin: 0; padding: .8rem .9rem; overflow-x: auto; border: 1px solid var(--vmz-line-subtle); border-radius: var(--vmz-radius-md); background: var(--v2-code); }
.welcome-v2__start code { color: var(--vmz-text-on-brand); font: .82rem/1.55 var(--vmz-font-mono); white-space: pre; }
.welcome-v2__start-note { margin: 0; color: var(--v2-muted); font-size: .86rem; line-height: 1.6; }
.welcome-v2__docs { display: grid; gap: .3rem; padding-top: .8rem; border-top: 1px solid var(--vmz-line-subtle); }
.welcome-v2__docs a { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .5rem .6rem; border-radius: var(--vmz-radius-sm); color: var(--v2-ink); font-size: .88rem; text-decoration: none; }
.welcome-v2__docs a:hover { color: var(--v2-blue); background: var(--v2-mist); }
.welcome-v2__rail { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--vmz-line-subtle); }
.welcome-v2__rail > div { display: grid; align-content: start; grid-template-columns: auto 1fr; gap: .25rem .8rem; padding: 1.4rem 1.4rem 1.5rem 0; }
.welcome-v2__rail > div + div { padding-left: 1.4rem; border-left: 1px solid var(--vmz-line-subtle); }
.welcome-v2__rail span { grid-row: 1 / 3; color: var(--v2-blue); font: .7rem var(--vmz-font-mono); }
.welcome-v2__rail strong { font: 600 .95rem var(--vmz-font-display); }
.welcome-v2__rail small { color: var(--v2-muted); font-size: .9rem; line-height: 1.55; }
@media (max-width: 1023px) {
  .welcome-v2__main { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
}
@media (max-width: 900px) {
  .welcome-v2__rail { grid-template-columns: 1fr; }
  .welcome-v2__rail > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--vmz-line-subtle); }
}
</style>
<script client>
import {
    brand,
    docs,
    explore,
    start,
    welcomeDocsComponents,
    welcomeDocsDeploy,
    welcomeDocsGuide,
    welcomeExampleLabel,
    welcomeInstallLabel,
    welcomeInstallNote,
    welcomeKicker,
    welcomeLede,
    welcomeRail1Desc,
    welcomeRail1Title,
    welcomeRail2Desc,
    welcomeRail2Title,
    welcomeRail3Desc,
    welcomeRail3Title,
    welcomeRailAria,
    welcomeStartTitle,
    welcomeTitleEm,
    welcomeTitleLead,
} from "#locales/common";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

import { pageMeta } from "../page-meta.ts";

export default class WelcomePage {
    static meta = pageMeta("关于 VMZ", "About VMZ");

    localeId = "zh-hans";
    brandLabel = "";
    docsLabel = "";
    exploreLabel = "";
    startLabel = "";
    kickerLabel = "";
    titleLeadLabel = "";
    titleEmLabel = "";
    ledeLabel = "";
    railAriaLabel = "";
    rail1TitleLabel = "";
    rail1DescLabel = "";
    rail2TitleLabel = "";
    rail2DescLabel = "";
    rail3TitleLabel = "";
    rail3DescLabel = "";
    startTitleLabel = "";
    installLabel = "";
    installNote = "";
    exampleLabel = "";
    docsGuideLabel = "";
    docsDeployLabel = "";
    docsComponentsLabel = "";
    /** Minimal counter: one template branch, one state field, no build steps. */
    exampleCode = [
        '<template>',
        '    <Button @click="count++">{{ count }}</Button>',
        '</template>',
        '<script client>',
        'export default class Counter {',
        '    count = 0;',
        '}',
        '<\/script>',
    ].join("\n");
    docsRootHref = "/d/zh-hans/";
    guideHref = "/d/zh-hans/guide/";
    deployDocHref = "/d/zh-hans/guide/deploy/";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.brandLabel = brand();
        this.docsLabel = docs();
        this.exploreLabel = explore();
        this.startLabel = start();
        this.kickerLabel = welcomeKicker();
        this.titleLeadLabel = welcomeTitleLead();
        this.titleEmLabel = welcomeTitleEm();
        this.ledeLabel = welcomeLede();
        this.railAriaLabel = welcomeRailAria();
        this.rail1TitleLabel = welcomeRail1Title();
        this.rail1DescLabel = welcomeRail1Desc();
        this.rail2TitleLabel = welcomeRail2Title();
        this.rail2DescLabel = welcomeRail2Desc();
        this.rail3TitleLabel = welcomeRail3Title();
        this.rail3DescLabel = welcomeRail3Desc();
        this.startTitleLabel = welcomeStartTitle();
        this.installLabel = welcomeInstallLabel();
        this.installNote = welcomeInstallNote();
        this.exampleLabel = welcomeExampleLabel();
        this.docsGuideLabel = welcomeDocsGuide();
        this.docsDeployLabel = welcomeDocsDeploy();
        this.docsComponentsLabel = welcomeDocsComponents();
        const paths = docsPaths(this.localeId);
        this.docsRootHref = paths.docsRootHref;
        this.guideHref = paths.guideHref;
        this.deployDocHref = paths.deployDocHref;
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
    }
}
</script>
