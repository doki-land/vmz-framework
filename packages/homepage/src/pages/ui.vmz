<template>
  <main class="ui-lab" data-vmz-fixture="ui-lab">
    <h1>UI lab</h1>
    <p>@vmz/ui UI1 + UI2 Form / Disclosure lab.</p>

    <section>
      <Field
        label="Display name"
        description="Shown on public profile"
        controlId="home-ui-name"
        descriptionId="home-ui-name-desc"
        errorId="home-ui-name-err"
        describedBy="home-ui-name-desc"
        :value="name"
        @input="(e) => (name = e.target.value)"
      />
      <p data-vmz-fixture="field-value">value:{{ name }}</p>
    </section>

    <section data-vmz-fixture="ui2-form">
      <Checkbox
        label="Accept terms"
        controlId="home-ui-agree"
        :checked="agree"
        @change="(e) => (agree = e.target.checked)"
      />
      <p data-vmz-fixture="checkbox-value">agree:{{ agree ? 'yes' : 'no' }}</p>
      <Switch
        label="Email notifications"
        controlId="home-ui-notify"
        :checked="notify"
        @change="(v) => (notify = v)"
      />
      <p data-vmz-fixture="switch-value">notify:{{ notify ? 'on' : 'off' }}</p>
    </section>

    <section data-vmz-fixture="ui2-tabs">
      <Tabs
        label="Profile sections"
        :selected="tab"
        panelId="home-ui-tabs-panel"
        :items="tabItems"
        :onSelect="(id) => (tab = id)"
      >
        <p data-vmz-fixture="tab-panel">panel:{{ tab }}</p>
      </Tabs>
    </section>

    <section data-vmz-fixture="ui2-menu">
      <Menu
        label="Actions"
        menuId="home-ui-menu"
        :open="menuOpen"
        :items="menuItems"
        :onOpenChange="(v) => (menuOpen = v)"
        :onSelect="(id) => (menuChoice = id)"
      />
      <p data-vmz-fixture="menu-choice">menu:{{ menuChoice || 'none' }}</p>
    </section>

    <section data-vmz-fixture="ui1-dialog">
      <Button type="button" @click="() => (open = true)">Open dialog</Button>
      <Dialog :open="open" title="Confirm" titleId="home-ui-dialog-title" :onClose="() => (open = false)">
        <p data-vmz-fixture="dialog-body">Dialog body for UI lab.</p>
      </Dialog>
    </section>

    <section data-vmz-fixture="ui2-drawer">
      <Button type="button" @click="() => (drawerOpen = true)">Open drawer</Button>
      <Drawer :open="drawerOpen" title="Details" titleId="home-ui-drawer-title" :onClose="() => (drawerOpen = false)">
        <p data-vmz-fixture="drawer-body">Drawer body for UI lab.</p>
      </Drawer>
    </section>

    <section data-vmz-fixture="ui2-popover">
      <Button type="button" @click="() => (popoverOpen = true)">Open popover</Button>
      <Popover :open="popoverOpen" title="Hint" titleId="home-ui-popover-title" :onClose="() => (popoverOpen = false)">
        <p data-vmz-fixture="popover-body">Popover body for UI lab.</p>
      </Popover>
    </section>
  </main>
</template>

<script client>
export default class UiLabPage {
  name = '';
  open = false;
  agree = false;
  notify = false;
  tab = 'home-ui-tab-profile';
  tabItems = [
    { id: 'home-ui-tab-profile', title: 'Profile', controls: 'home-ui-tabs-panel' },
    { id: 'home-ui-tab-security', title: 'Security', controls: 'home-ui-tabs-panel' },
    { id: 'home-ui-tab-billing', title: 'Billing', controls: 'home-ui-tabs-panel' },
