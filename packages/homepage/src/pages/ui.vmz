<template>
    <div data-vmz-fixture="ui-lab" class="ui-lab-page">
        <AppShell brand="VMZ" home-href="/" :nav-label="uiLabNavLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Alert tone="info" role-name="status" :title="uiLabAlertTitleLabel" :description="uiLabAlertDescLabel" />
                <header class="ui-lab-page__head">
                    <h1>
                        {{ uiLabPageTitleLabel }}
                    </h1>
                    <p>
                        {{ uiLabPageLeadLabel }}
                    </p>
                </header>
                <div class="ui-lab-page__grid">
                    <Card :title="uiLabCardFieldTitleLabel" :description="uiLabCardFieldDescLabel">
                        <Field :label="uiLabFieldLabelLabel" :description="uiLabFieldDescLabel" control-id="home-ui-name" description-id="home-ui-name-desc" error-id="home-ui-name-err" described-by="home-ui-name-desc" :value="name" @input="((e) => name = e.target.value)" />
                        <p data-vmz-fixture="field-value" class="vmz-sr-only">
                            value:
                            {{ name }}
                        </p>
                    </Card>
                    <div data-vmz-fixture="ui2-form">
                        <Card :title="uiLabCardChoiceTitleLabel" :description="uiLabCardChoiceDescLabel">
                            <Checkbox :label="uiLabCheckboxLabel" control-id="home-ui-agree" :checked="agree" @change="((v) => agree = v)" />
                            <p data-vmz-fixture="checkbox-value" class="vmz-sr-only">
                                agree:
                                {{ agree ? 'yes' : 'no' }}
                            </p>
                            <Switch :label="uiLabSwitchLabel" control-id="home-ui-notify" :checked="notify" @change="((v) => notify = v)" />
                            <p data-vmz-fixture="switch-value" class="vmz-sr-only">
                                notify:
                                {{ notify ? 'on' : 'off' }}
                            </p>
                        </Card>
                    </div>
                    <div data-vmz-fixture="ui2-tabs">
                        <Card :title="uiLabCardTabsTitleLabel" :description="uiLabCardTabsDescLabel">
                            <Tabs :label="uiLabTabsLabel" :selected="tab" panel-id="home-ui-tabs-panel" :items="tabItems" :on-select="((id) => tab = id)">
                                <p class="ui-lab-page__panel-copy">
                                    {{ uiLabTabPanelCopyLabel }}
                                </p>
                                <p data-vmz-fixture="tab-panel" class="vmz-sr-only">
                                    panel:
                                    {{ tab }}
                                </p>
                            </Tabs>
                        </Card>
                    </div>
                    <div data-vmz-fixture="ui2-menu">
                        <Card :title="uiLabCardMenuTitleLabel" :description="uiLabCardMenuDescLabel">
                            <Menu :label="uiLabMenuLabel" menu-id="home-ui-menu" :open="menuOpen" :items="menuItems" :on-open-change="((v) => menuOpen = v)" :on-select="((id) => menuChoice = id)" />
                            <p data-vmz-fixture="menu-choice" class="vmz-sr-only">
                                menu:
                                {{ menuChoice || 'none' }}
                            </p>
                        </Card>
                    </div>
                    <div data-vmz-fixture="ui1-dialog">
                        <Card :title="uiLabCardDialogTitleLabel" :description="uiLabCardDialogDescLabel">
                            <div data-vmz-dialog-trigger-for="home-ui-dialog-title">
                                <Button type="button" aria-haspopup="dialog" aria-controls="home-ui-dialog-title" @click="(() => open = true)">
                                    {{ uiLabOpenDialogLabel }}
                                </Button>
                            </div>
                            <Dialog :open="open" :title="uiLabDialogTitleLabel" title-id="home-ui-dialog-title" :on-close="(() => open = false)">
                                <p data-vmz-fixture="dialog-body">
                                    {{ uiLabDialogBodyLabel }}
                                </p>
                            </Dialog>
                        </Card>
                    </div>
                    <Card :title="uiLabCardOverlayTitleLabel" :description="uiLabCardOverlayDescLabel">
                        <div data-vmz-fixture="ui2-drawer" class="ui-lab-page__actions">
                            <Button type="button" variant="secondary" @click="(() => drawerOpen = true)">
                                {{ uiLabOpenDrawerLabel }}
                            </Button>
                            <Drawer :open="drawerOpen" :title="uiLabDrawerTitleLabel" title-id="home-ui-drawer-title" :on-close="(() => drawerOpen = false)">
                                <p data-vmz-fixture="drawer-body">
                                    {{ uiLabDrawerBodyLabel }}
                                </p>
                            </Drawer>
                        </div>
                        <div data-vmz-fixture="ui2-popover" class="ui-lab-page__actions">
                            <Button type="button" variant="secondary" @click="(() => popoverOpen = true)">
                                {{ uiLabOpenPopoverLabel }}
                            </Button>
                            <Popover v-if="popoverOpen" :open="popoverOpen" :title="uiLabPopoverTitleLabel" title-id="home-ui-popover-title" :on-close="(() => popoverOpen = false)">
                                <p data-vmz-fixture="popover-body">
                                    {{ uiLabPopoverBodyLabel }}
                                </p>
                            </Popover>
                        </div>
                    </Card>
                </div>
            </div>
        </AppShell>
    </div>
</template>
<style>
.ui-lab-page__head {
    display: grid;
    gap: 0.45rem;
    margin: 0.5rem 0 1rem;
}

.ui-lab-page__head h1 {
    margin: 0;
    font-family: var(--vmz-font-display);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--vmz-text-ink);
}

.ui-lab-page__head p {
    margin: 0;
    max-width: 40rem;
    color: var(--vmz-text-steel);
    line-height: 1.55;
}

.ui-lab-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.85rem;
}

.ui-lab-page__panel-copy {
    margin: 0.75rem 0 0;
    color: var(--vmz-text-steel);
    font-size: 0.92rem;
}

.ui-lab-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.65rem;
}
</style>
<script client>
import {
    uiLabNavLabel,
    uiLabAlertTitle,
    uiLabAlertDesc,
    uiLabPageTitle,
    uiLabPageLead,
    uiLabCardFieldTitle,
    uiLabCardFieldDesc,
    uiLabCardChoiceTitle,
    uiLabCardChoiceDesc,
    uiLabCardTabsTitle,
    uiLabCardTabsDesc,
    uiLabCardMenuTitle,
    uiLabCardMenuDesc,
    uiLabCardDialogTitle,
    uiLabCardDialogDesc,
    uiLabCardOverlayTitle,
    uiLabCardOverlayDesc,
    uiLabTabPanelCopy,
    uiLabFieldLabel,
    uiLabFieldDesc,
    uiLabCheckboxLabel,
    uiLabSwitchLabel,
    uiLabTabsLabel,
    uiLabTabProfile,
    uiLabTabSecurity,
    uiLabTabBilling,
    uiLabMenuLabel,
    uiLabMenuEdit,
    uiLabMenuShare,
    uiLabMenuArchive,
    uiLabOpenDialog,
    uiLabDialogTitle,
    uiLabDialogBody,
    uiLabOpenDrawer,
    uiLabDrawerTitle,
    uiLabDrawerBody,
    uiLabOpenPopover,
    uiLabPopoverTitle,
    uiLabPopoverBody,
    commercialNavCommercial,
    commercialNavConsole,
    commercialNavHome,
} from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";

export default class UiLabPage {
    name = "";
    open = false;
    agree = false;
    notify = false;
    tab = "home-ui-tab-profile";
    tabItems = [
        { id: "home-ui-tab-profile", title: "Profile", controls: "home-ui-tabs-panel" },
        { id: "home-ui-tab-security", title: "Security", controls: "home-ui-tabs-panel" },
        { id: "home-ui-tab-billing", title: "Billing", controls: "home-ui-tabs-panel" },
    ];
    menuOpen = false;
    menuChoice = "";
    menuItems = [
        { id: "edit", title: "Edit" },
        { id: "share", title: "Share" },
        { id: "archive", title: "Archive" },
    ];
    drawerOpen = false;
    popoverOpen = false;
    navItems = [];
    uiLabNavLabel = "UI lab";
    uiLabAlertTitleLabel = "Internal component lab";
    uiLabAlertDescLabel = "";
    uiLabPageTitleLabel = "UI lab";
    uiLabPageLeadLabel = "";
    uiLabCardFieldTitleLabel = "";
    uiLabCardFieldDescLabel = "";
    uiLabCardChoiceTitleLabel = "";
    uiLabCardChoiceDescLabel = "";
    uiLabCardTabsTitleLabel = "";
    uiLabCardTabsDescLabel = "";
    uiLabCardMenuTitleLabel = "";
    uiLabCardMenuDescLabel = "";
    uiLabCardDialogTitleLabel = "";
    uiLabCardDialogDescLabel = "";
    uiLabCardOverlayTitleLabel = "";
    uiLabCardOverlayDescLabel = "";
    uiLabTabPanelCopyLabel = "";
    uiLabFieldLabelLabel = "Display name";
    uiLabFieldDescLabel = "Shown on public profile";
    uiLabCheckboxLabel = "Accept terms";
    uiLabSwitchLabel = "Email notifications";
    uiLabTabsLabel = "Profile sections";
    uiLabMenuLabel = "Actions";
    uiLabOpenDialogLabel = "Open dialog";
    uiLabDialogTitleLabel = "Confirm";
    uiLabDialogBodyLabel = "";
    uiLabOpenDrawerLabel = "Open drawer";
    uiLabDrawerTitleLabel = "Details";
    uiLabDrawerBodyLabel = "";
    uiLabOpenPopoverLabel = "Open popover";
    uiLabPopoverTitleLabel = "Hint";
    uiLabPopoverBodyLabel = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.uiLabNavLabel = uiLabNavLabel();
        this.uiLabAlertTitleLabel = uiLabAlertTitle();
        this.uiLabAlertDescLabel = uiLabAlertDesc();
        this.uiLabPageTitleLabel = uiLabPageTitle();
        this.uiLabPageLeadLabel = uiLabPageLead();
        this.uiLabCardFieldTitleLabel = uiLabCardFieldTitle();
        this.uiLabCardFieldDescLabel = uiLabCardFieldDesc();
        this.uiLabCardChoiceTitleLabel = uiLabCardChoiceTitle();
        this.uiLabCardChoiceDescLabel = uiLabCardChoiceDesc();
        this.uiLabCardTabsTitleLabel = uiLabCardTabsTitle();
        this.uiLabCardTabsDescLabel = uiLabCardTabsDesc();
        this.uiLabCardMenuTitleLabel = uiLabCardMenuTitle();
        this.uiLabCardMenuDescLabel = uiLabCardMenuDesc();
        this.uiLabCardDialogTitleLabel = uiLabCardDialogTitle();
        this.uiLabCardDialogDescLabel = uiLabCardDialogDesc();
        this.uiLabCardOverlayTitleLabel = uiLabCardOverlayTitle();
        this.uiLabCardOverlayDescLabel = uiLabCardOverlayDesc();
        this.uiLabTabPanelCopyLabel = uiLabTabPanelCopy();
        this.uiLabFieldLabelLabel = uiLabFieldLabel();
        this.uiLabFieldDescLabel = uiLabFieldDesc();
        this.uiLabCheckboxLabel = uiLabCheckboxLabel();
        this.uiLabSwitchLabel = uiLabSwitchLabel();
        this.uiLabTabsLabel = uiLabTabsLabel();
        this.uiLabMenuLabel = uiLabMenuLabel();
        this.uiLabOpenDialogLabel = uiLabOpenDialog();
        this.uiLabDialogTitleLabel = uiLabDialogTitle();
        this.uiLabDialogBodyLabel = uiLabDialogBody();
        this.uiLabOpenDrawerLabel = uiLabOpenDrawer();
        this.uiLabDrawerTitleLabel = uiLabDrawerTitle();
        this.uiLabDrawerBodyLabel = uiLabDrawerBody();
        this.uiLabOpenPopoverLabel = uiLabOpenPopover();
        this.uiLabPopoverTitleLabel = uiLabPopoverTitle();
        this.uiLabPopoverBodyLabel = uiLabPopoverBody();
        this.tabItems = [
            { id: "home-ui-tab-profile", title: uiLabTabProfile(), controls: "home-ui-tabs-panel" },
            {
                id: "home-ui-tab-security",
                title: uiLabTabSecurity(),
                controls: "home-ui-tabs-panel",
            },
            { id: "home-ui-tab-billing", title: uiLabTabBilling(), controls: "home-ui-tabs-panel" },
        ];
        this.menuItems = [
            { id: "edit", title: uiLabMenuEdit() },
            { id: "share", title: uiLabMenuShare() },
            { id: "archive", title: uiLabMenuArchive() },
        ];
        this.navItems = [
            { id: "commercial", title: commercialNavCommercial(), href: "/commercial" },
            { id: "console", title: commercialNavConsole(), href: "/console" },
            { id: "home", title: commercialNavHome(), href: "/" },
        ];
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }
}
</script>
