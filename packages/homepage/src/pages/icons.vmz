    font: 500 0.875rem / 1 var(--vmz-font-sans);
    color: var(--vmz-text-steel);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--vmz-surface-fill);
}
.icons-group__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.75rem;
}
.icon-card {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0.6rem 0.6rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    cursor: pointer;
    text-align: center;
    transition: border-color 160ms ease, box-shadow 160ms ease;
}
.icon-card:hover {
