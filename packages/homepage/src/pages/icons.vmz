<template>
    <SiteShell page="icons" variant="icons-gallery-page">
        <main id="main" class="icons-gallery">
            <header class="icons-gallery__head">
                <p class="kicker">
                    <span aria-hidden="true" class="kicker__dot" />
                    {{ kickerLabel }}
                </p>
                <h1>
                    {{ titleLabel }}
                </h1>
                <p class="icons-gallery__lead">
                    {{ leadLabel }}
                </p>
            </header>

            <section class="icons-gallery__toolbar" aria-label="Icon gallery controls">
                <label class="icons-gallery__search">
                    <span class="sr-only">搜索图标</span>
                    <input
                        type="search"
                        placeholder="{{ searchPlaceholderLabel }}"
                        :value="searchQuery"
                        @input="(e) => (searchQuery = (e.target as HTMLInputElement).value)"
                    />
                </label>

                <div class="icons-gallery__size-switch" role="group" :aria-label="sizeAriaLabel">
                    <button
                        v-for="sz in sizeOptions"
                        :key="sz.value"
                        type="button"
                        class="icons-gallery__size-btn"
                        :data-active="sizePx === sz.value ? 'true' : 'false'"
                        :aria-pressed="sizePx === sz.value ? 'true' : 'false'"
                        @click="() => (sizePx = sz.value)"
                    >
                        {{ sz.label }}
                    </button>
                </div>

                <div class="icons-gallery__theme-switch" role="group" :aria-label="themeAriaLabel">
                    <button
                        type="button"
                        class="icons-gallery__theme-btn"
                        :data-active="themeMode === 'light' ? 'true' : 'false'"
                        :aria-pressed="themeMode === 'light' ? 'true' : 'false'"
                        @click="() => (themeMode = 'light')"
                    >
                        {{ themeLightLabel }}
                    </button>
                    <button
                        type="button"
                        class="icons-gallery__theme-btn"
                        :data-active="themeMode === 'night' ? 'true' : 'false'"
                        :aria-pressed="themeMode === 'night' ? 'true' : 'false'"
                        @click="() => (themeMode = 'night')"
                    >
                        {{ themeNightLabel }}
                    </button>
                </div>
            </section>

            <section
                v-for="group in filteredGroups"
                :key="group.prefix"
                :aria-labelledby="'icons-group-' + group.prefix"
                class="icons-group"
            >
                <h2 :id="'icons-group-' + group.prefix">
                    {{ group.label }}
                    <span class="icons-group__count">{{ group.items.length }}</span>
                </h2>
                <div class="icons-group__grid">
                    <button
                        v-for="entry in group.items"
                        :key="entry.name"
                        type="button"
                        class="icon-card"
                        :data-active="selectedName === entry.name ? 'true' : 'false'"
                        @click="() => (selectedName = entry.name)"
                    >
                        <span class="icon-card__glyph" :style="{ fontSize: sizePx + 'px' }">
                            <Icon :name="entry.name" :size="sizeToken" />
                        </span>
                        <span class="icon-card__name">{{ entry.name }}</span>
                    </button>
                </div>
            </section>

            <section v-if="selectedEntry" class="icons-gallery__detail" aria-live="polite">
                <h2>
                    {{ detailTitleLabel }}
                </h2>
                <div class="icons-gallery__detail-body">
                    <div class="icons-gallery__detail-preview" :style="{ fontSize: (sizePx * 2) + 'px' }">
                        <Icon :name="selectedEntry.name" :size="sizeToken" />
                    </div>
                    <dl class="icons-gallery__detail-meta">
                        <dt>{{ detailNameLabel }}</dt>
                        <dd><code>{{ selectedEntry.name }}</code></dd>
                        <dt>{{ detailKindLabel }}</dt>
                        <dd><code>{{ selectedEntry.def.kind }}</code></dd>
                    </dl>
                    <pre class="icons-gallery__code"><code>{{ usageCode }}</code></pre>
                </div>
            </section>

            <p v-if="filteredGroups.length === 0" class="icons-gallery__empty">
                {{ emptyLabel }}
            </p>
        </main>
    </SiteShell>
</template>
<style>
