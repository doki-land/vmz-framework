<template>
    <SiteShell page="icons" variant="icons-gallery-page">
        <main id="main" class="icons-gallery">
            <header class="icons-gallery__head">
                <p class="kicker">
                    <span aria-hidden="true" class="kicker__dot" />
                    {{ kickerLabel }}
                </p>
                <h1>
                    {{ titleLabel }}
                </h1>
                <p class="icons-gallery__lead">
                    {{ leadLabel }}
                </p>
            </header>
            <section :aria-label="toolbarAriaLabel" class="icons-gallery__toolbar">
                <label class="icons-gallery__search">
                    <span class="sr-only">
                        搜索图标
                    </span>
                    <input type="search" :placeholder="searchPlaceholderLabel" :value="searchQuery" @input="(e) => (searchQuery = (e.target as HTMLInputElement).value)" />
                </label>
                <div role="group" :aria-label="categoryAriaLabel" class="icons-gallery__categories">
                    <button type="button" :data-active="activeCategory === '' ? 'true' : 'false'" :aria-pressed="activeCategory === '' ? 'true' : 'false'" @click="() => (activeCategory = '')" class="icons-gallery__category">
                        {{ allCategoriesLabel }}
                        <span class="icons-gallery__category-count">
                            {{ totalCount }}
                        </span>
                    </button>
                    <button v-for="cat in categoryFilters" :key="cat.prefix" type="button" :data-active="activeCategory === cat.prefix ? 'true' : 'false'" :aria-pressed="activeCategory === cat.prefix ? 'true' : 'false'" @click="() => (activeCategory = cat.prefix)" class="icons-gallery__category">
                        {{ cat.label }}
                        <span class="icons-gallery__category-count">
                            {{ cat.count }}
                        </span>
                    </button>
                </div>
                <div role="group" :aria-label="substrateAriaLabel" class="icons-gallery__substrate-switch">
                    <button type="button" :data-active="substrate === 'light' ? 'true' : 'false'" :aria-pressed="substrate === 'light' ? 'true' : 'false'" @click="() => (substrate = 'light')" class="icons-gallery__substrate">
                        {{ substrateLightLabel }}
                    </button>
                    <button type="button" :data-active="substrate === 'night' ? 'true' : 'false'" :aria-pressed="substrate === 'night' ? 'true' : 'false'" @click="() => (substrate = 'night')" class="icons-gallery__substrate">
                        {{ substrateNightLabel }}
                    </button>
                </div>
            </section>
            <section :aria-labelledby="'icons-currentcolor'" class="icons-gallery__usage">
                <h2 :id="'icons-currentcolor'">
                    {{ currentColorTitle }}
                </h2>
                <p class="icons-gallery__usage-lead">
                    {{ currentColorLead }}
                </p>
                <div class="icons-gallery__usage-row">
                    <span class="icons-gallery__usage-sample">
                        <Icon name="action.search" size="md" />
                        {{ currentColorSampleText }}
                    </span>
                    <span class="icons-gallery__usage-sample icons-gallery__usage-sample--brand">
                        <Icon name="action.search" size="md" />
                        {{ currentColorSampleText }}
                    </span>
                    <span class="icons-gallery__usage-sample icons-gallery__usage-sample--success">
                        <Icon name="status.success" size="md" />
                        {{ currentColorSampleText }}
                    </span>
                    <span class="icons-gallery__usage-sample icons-gallery__usage-sample--danger">
                        <Icon name="status.error" size="md" />
                        {{ currentColorSampleText }}
                    </span>
                </div>
                <pre class="icons-gallery__code"><code>{{ currentColorSnippet }}</code></pre>
            </section>
            <section v-for="group in filteredGroups" :key="group.prefix" :aria-labelledby="'icons-group-' + group.prefix" class="icons-group">
                <h2 :id="'icons-group-' + group.prefix">
                    {{ group.label }}
                    <code class="icons-group__prefix">
                        {{ group.prefix }}
                        .*
                    </code>
                    <span class="icons-group__count">
                        {{ group.items.length }}
                    </span>
                </h2>
                <div :data-substrate="substrate" class="icons-group__grid">
                    <button v-for="entry in group.items" :key="entry.name" type="button" :data-active="selectedName === entry.name ? 'true' : 'false'" @click="() => (selectedName = entry.name)" class="icon-card">
                        <span class="icon-card__glyphs">
                            <span v-for="col in sizeColumns" :key="col.px" :data-glyph-size="col.px" class="icon-card__glyph">
                                <Icon :name="entry.name" size="md" />
                                <span class="icon-card__glyph-size">
                                    {{ col.px }}
                                </span>
                            </span>
                        </span>
                        <span class="icon-card__name">
                            {{ entry.name }}
                        </span>
                    </button>
                </div>
            </section>
            <p v-if="filteredGroups.length === 0" class="icons-gallery__empty">
                {{ emptyLabel }}
            </p>
            <section v-if="selectedEntry" aria-live="polite" class="icons-gallery__detail">
                <h2>
                    {{ detailTitleLabel }}
                </h2>
                <div :data-substrate="substrate" class="icons-gallery__detail-body">
                    <div class="icons-gallery__detail-preview">
                        <span v-for="col in sizeColumns" :key="col.px" :data-glyph-size="col.px" class="icon-card__glyph">
                            <Icon :name="selectedEntry.name" size="md" />
                            <span class="icon-card__glyph-size">
                                {{ col.px }}
                            </span>
                        </span>
                    </div>
                    <dl class="icons-gallery__detail-meta">
                        <dt>
                            {{ detailNameLabel }}
                        </dt>
                        <dd>
                            <code>
                                {{ selectedEntry.name }}
                            </code>
                        </dd>
                        <dt>
                            {{ detailKindLabel }}
                        </dt>
                        <dd>
                            <code>
                                {{ selectedEntry.def.kind }}
                            </code>
                        </dd>
                    </dl>
                    <div class="icons-gallery__detail-snippets">
                        <pre class="icons-gallery__code"><code>{{ usageSnippet }}</code></pre>
                        <pre class="icons-gallery__code"><code>{{ registrySnippet }}</code></pre>
                    </div>
                </div>
            </section>
        </main>
    </SiteShell>
</template>
<style>
/* 本页底色纯白：整页底板是页面级口径，灰白大底不允许出现在 gallery 页。 */
