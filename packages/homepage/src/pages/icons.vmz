}
.icon-card[data-active="true"] {
    border-color: var(--vmz-action-primary-background);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--vmz-action-primary-background) 18%, transparent);
}
.icon-card__glyphs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 0.25rem;
}
.icon-card__glyph {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-width: 0;
}
.icon-card__glyph-size {
    font: 400 0.75rem / 1 var(--vmz-font-mono);
    color: var(--vmz-text-steel);
}
/* Exact preview sizes: the package glyph box is `1em`, so the page only sets
   font-size on the component host. Stroke width comes from the registry def
   and stays untouched. */
.icons-gallery [data-glyph-size="16"] .vmz-ui-icon {
    font-size: 16px;
}
.icons-gallery [data-glyph-size="20"] .vmz-ui-icon {
    font-size: 20px;
}
.icons-gallery [data-glyph-size="24"] .vmz-ui-icon {
    font-size: 24px;
}
.icons-gallery [data-glyph-size="32"] .vmz-ui-icon {
    font-size: 32px;
}
.icon-card__name {
    font: 400 0.75rem / 1.35 var(--vmz-font-mono);
    color: var(--vmz-text-steel);
    word-break: break-all;
}
/* Preview substrate toggle — strokes are checked against light and night
   surfaces without touching the site theme. */
.icons-group__grid[data-substrate="night"] .icon-card,
.icons-gallery__detail-body[data-substrate="night"] .icons-gallery__detail-preview {
    background: #0b1220;
    border-color: #1f2937;
    color: #e5e7eb;
}
.icons-group__grid[data-substrate="night"] .icon-card__name,
.icons-group__grid[data-substrate="night"] .icon-card__glyph-size {
    color: #9ca3af;
}
.icons-gallery__detail {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-lg);
    background: var(--vmz-surface-paper);
}
.icons-gallery__detail h2 {
    margin: 0 0 1rem;
    color: var(--vmz-text-ink);
    font: 600 1.15rem / 1.6 var(--vmz-font-display);
}
.icons-gallery__detail-body {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
}
@media (max-width: 60rem) {
    .icons-gallery__detail-body {
        grid-template-columns: 1fr;
    }
}
.icons-gallery__detail-preview {
    display: flex;
    align-items: end;
    gap: 1rem;
    padding: 1rem;
    border: 1px dashed var(--vmz-line-default);
    border-radius: var(--vmz-radius-md);
}
.icons-gallery__detail-meta {
    margin: 0;
    display: grid;
    gap: 0.5rem;
}
.icons-gallery__detail-meta dt {
    font: 500 0.75rem / 1 var(--vmz-font-sans);
    color: var(--vmz-text-steel);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.icons-gallery__detail-meta dd {
    margin: 0;
    font: 400 0.875rem / 1.4 var(--vmz-font-mono);
    color: var(--vmz-text-ink);
}
.icons-gallery__detail-snippets {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
}
.icons-gallery__code {
    margin: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--vmz-radius-md);
    background: var(--vmz-surface-fill);
    overflow-x: auto;
    font: 400 0.78rem / 1.55 var(--vmz-font-mono);
    color: var(--vmz-text-ink);
    white-space: pre;
}
.icons-gallery__empty {
    margin-top: 2rem;
    color: var(--vmz-text-steel);
    font: 400 1rem / 1.6 var(--vmz-font-sans);
    text-align: center;
}
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
</style>
<script client>
import { REGISTRY, type IconDef } from "@vmz/ui-icons/registry";
import { pageMeta } from "../page-meta.ts";

/**
 * 图标浏览页 — 分组、搜索、筛选与尺寸预览全部由 `@vmz/ui-icons` 的
 * `REGISTRY` 驱动；页面不持有任何图标数据、路径或映射表副本（由
 * `tests/icon-duplication.gate.mjs` 强制）。渲染经公开 `Icon` 组件完成。
 */

interface IconEntry {
    name: string;
    def: IconDef;
}

interface IconGroup {
    prefix: string;
    label: string;
    items: IconEntry[];
}

interface CategoryFilter {
    prefix: string;
    label: string;
    count: number;
}

/** 分类中文名是页面文案，不是图标数据；前缀集合始终从 registry 键派生。 */
const CATEGORY_LABELS: Record<string, string> = {
    action: "操作",
    brand: "品牌",
    commerce: "商业",
    data: "数据",
    develop: "开发",
    device: "设备",
    editor: "编辑器",
    feature: "特性",
    file: "文件",
    git: "Git",
    media: "媒体",
    nav: "导航",
    social: "社交",
    status: "状态",
    tool: "工具",
};

function prefixOf(name: string): string {
    const dot = name.indexOf(".");
    return dot > 0 ? name.slice(0, dot) : "other";
}

function labelOf(prefix: string): string {
    return CATEGORY_LABELS[prefix] ?? prefix;
}

/** Registry 键的首次出现顺序即分类顺序（与包内模块顺序一致）。 */
function collectGroups(): IconGroup[] {
    const byPrefix = new Map<string, IconEntry[]>();
    for (const name of Object.keys(REGISTRY)) {
        const prefix = prefixOf(name);
        if (!byPrefix.has(prefix)) byPrefix.set(prefix, []);
        byPrefix.get(prefix)!.push({ name, def: REGISTRY[name] });
    }
    const groups: IconGroup[] = [];
    for (const [prefix, items] of byPrefix) {
        items.sort((a, b) => a.name.localeCompare(b.name));
        groups.push({ prefix, label: labelOf(prefix), items });
    }
    return groups;
}

const ALL_GROUPS = collectGroups();

export default class IconGalleryPage {
    static meta = pageMeta(
        "图标库 · VMZ",
        "Icon library · VMZ",
        "浏览 @vmz/ui-icons registry 的全部语义图标：15 个分类、四种尺寸、深浅底核对与 currentColor 用法。",
        "Browse the full @vmz/ui-icons registry: 15 categories, four sizes, light/night substrates and currentColor usage.",
    );

    kickerLabel = "VMZ · UI Icons";
    titleLabel = "图标库";
    toolbarAriaLabel = "图标浏览控制";
    searchPlaceholderLabel = "搜索语义名，如 action.search";
    categoryAriaLabel = "按分类筛选";
    allCategoriesLabel = "全部";
    substrateAriaLabel = "预览底色";
    substrateLightLabel = "浅色底";
    substrateNightLabel = "深色底";
    currentColorTitle = "currentColor 用法";
    currentColorLead = "图标描边与填充都继承 CSS color，放进任何文字颜色环境即自动跟随，无需额外变量。";
    currentColorSampleText = "文字内嵌";
    detailTitleLabel = "图标详情";
    detailNameLabel = "语义名";
    detailKindLabel = "类型";
    emptyLabel = "没有匹配的图标，换个关键词或分类试试。";

    searchQuery = "";
    activeCategory = "";
    substrate: "light" | "night" = "light";
    selectedName = "";

    sizeColumns = [{ px: 16 }, { px: 20 }, { px: 24 }, { px: 32 }];

    currentColorSnippet = `<span style="color: #1677ff">\n    <Icon name="action.search" size="md" />\n    搜索\n</span>`;

    get totalCount(): number {
        return Object.keys(REGISTRY).length;
    }

    get leadLabel(): string {
        return `全部 ${this.totalCount} 个语义图标直接来自 @vmz/ui-icons registry，按 ${ALL_GROUPS.length} 个分类分组。每个图标以 16 / 20 / 24 / 32 px 实渲染，描边重量由 registry 定义决定；切换深浅底可核对描边表现。`;
    }

    get categoryFilters(): CategoryFilter[] {
        return ALL_GROUPS.map((group) => ({
            prefix: group.prefix,
            label: group.label,
            count: group.items.length,
        }));
    }

    get filteredGroups(): IconGroup[] {
        const q = this.searchQuery.trim().toLowerCase();
        return ALL_GROUPS.filter((group) => this.activeCategory === "" || group.prefix === this.activeCategory)
            .map((group) => ({
                ...group,
                items: group.items.filter((entry) => !q || entry.name.toLowerCase().includes(q)),
            }))
            .filter((group) => group.items.length > 0);
    }

    get selectedEntry(): IconEntry | null {
        if (!this.selectedName) return null;
        const def = REGISTRY[this.selectedName];
        return def ? { name: this.selectedName, def } : null;
    }

    get usageSnippet(): string {
        if (!this.selectedEntry) return "";
        return `<Icon name="${this.selectedEntry.name}" size="md" />`;
    }

    get registrySnippet(): string {
        if (!this.selectedEntry) return "";
        return `import { REGISTRY } from "@vmz/ui-icons/registry";\n\nREGISTRY["${this.selectedEntry.name}"].kind // "${this.selectedEntry.def.kind}"`;
    }
}
</script>
