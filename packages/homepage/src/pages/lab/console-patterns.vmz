<template>
    <div data-vmz-fixture="ui5" data-density="compact">
        <ConsoleShell brand="VMZ" home-href="/" :title="pageTitle" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Breadcrumb :label="breadcrumbLabel" :items="crumbs" />
                <QueryForm :label="queryLabel" @submit="applyQuery">
                    <Field :label="fieldNameLabel" control-id="home-ui5-name" description-id="home-ui5-name-desc" error-id="home-ui5-name-err" described-by="home-ui5-name-desc" :value="nameQuery" @input="((e) => nameQuery = e.target.value)" />
                    <Field :label="fieldStatusLabel" control-id="home-ui5-status" description-id="home-ui5-status-desc" error-id="home-ui5-status-err" described-by="home-ui5-status-desc" :value="statusQuery" @input="((e) => statusQuery = e.target.value)" />
                    <Button type="button" data-vmz-action="ui5-search" @click="applyQuery">
                        {{ searchLabel }}
                    </Button>
                    <Button type="button" data-vmz-action="ui5-export" :disabled="writeDisabled">
                        {{ exportLabel }}
                    </Button>
                </QueryForm>
                <p data-vmz-fixture="ui5-query" class="vmz-sr-only">
                    name:
                    {{ nameQuery }}
                    ;status:
                    {{ statusQuery }}
                </p>
                <p data-vmz-fixture="ui5-sort" class="vmz-sr-only">
                    sort:
                    {{ sortKey }}
                    :
                    {{ sortDir }}
                </p>
                <p data-vmz-fixture="ui5-perm" class="vmz-sr-only">
                    write:
                    {{ writeDisabled ? 'denied' : 'allowed' }}
                </p>
                <Button type="button" data-vmz-action="ui5-toggle-loading" @click="toggleLoading">
                    {{ toggleLoadingLabel }}
                </Button>
                <Button type="button" data-vmz-action="ui5-toggle-write" @click="toggleWrite">
                    {{ toggleWriteLabel }}
                </Button>
                <Skeleton :loading="loading" :loading-attr="loadingAttr">
                    <Table :columns="columns" :rows="rows" :has-row-action="rowAction" :row-action-disabled="writeDisabled" :action-title="actionTitle" :action-label="actionLabel" :sort-key="sortKey" :sort-dir="sortDir" :on-sort="sortBy" :on-row-action="openDetail" />
                </Skeleton>
                <Timeline :label="timelineLabel" :items="auditItems" />
                <Drawer :open="drawerOpen" :title="drawerTitle" title-id="home-ui5-drawer-title" :on-close="(() => drawerOpen = false)">
                    <p data-vmz-fixture="ui5-drawer-body">
                        detail:
                        {{ detailId }}
                    </p>
                </Drawer>
            </div>
        </ConsoleShell>
    </div>
</template>
<script client>
import { navLab } from "#locales/common";
import {
    labConsolePageTitle,
    labConsoleNavLabel,
    labConsoleBreadcrumbLabel,
    labConsoleQueryLabel,
    labConsoleFieldName,
    labConsoleFieldStatus,
    labConsoleSearch,
    labConsoleExport,
    labConsoleToggleLoading,
    labConsoleToggleWrite,
    labConsoleColumnName,
    labConsoleColumnStatus,
    labConsoleActionTitle,
    labConsoleActionLabel,
    labConsoleTimelineLabel,
    labConsoleDrawerTitle,
    labConsoleCrumbHome,
    labConsoleCrumbConsole,
    labConsoleCrumbPatterns,
    labConsoleAuditFilterTitle,
    labConsoleAuditFilterDetail,
    labConsoleAuditPermTitle,
    labConsoleAuditPermDetail,
} from "#locales/lab-console";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

export default class ConsolePatternsPage {
    nameQuery = "";
    statusQuery = "";
    loading = true;
    loadingAttr = "true";
    writeDisabled = true;
    rowAction = true;
    drawerOpen = false;
    detailId = "";
    sortKey = "name";
    sortDir = "asc";
    navItems = [];
    pageTitle = "";
    navLabel = "";
    breadcrumbLabel = "";
    queryLabel = "";
    fieldNameLabel = "";
    fieldStatusLabel = "";
    searchLabel = "";
    exportLabel = "";
    toggleLoadingLabel = "";
    toggleWriteLabel = "";
    actionTitle = "";
    actionLabel = "";
    timelineLabel = "";
    drawerTitle = "";
    crumbHome = "";
    crumbConsole = "";
    crumbPatterns = "";
    auditFilterTitle = "";
    auditFilterDetail = "";
    auditPermTitle = "";
    auditPermDetail = "";
    _unwatchLocale = null;
    columns = [];
    allRows = [
        { id: "r1", cells: ["Alpha", "Active"] },
        { id: "r2", cells: ["Beta", "Paused"] },
        { id: "r3", cells: ["Gamma", "Active"] },
    ];
    rows = [
        { id: "r1", cells: ["Alpha", "Active"] },
        { id: "r2", cells: ["Beta", "Paused"] },
        { id: "r3", cells: ["Gamma", "Active"] },
    ];
    crumbs = [];
    auditItems = [];

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.pageTitle = labConsolePageTitle();
        this.navLabel = labConsoleNavLabel();
        this.breadcrumbLabel = labConsoleBreadcrumbLabel();
        this.queryLabel = labConsoleQueryLabel();
        this.fieldNameLabel = labConsoleFieldName();
        this.fieldStatusLabel = labConsoleFieldStatus();
        this.searchLabel = labConsoleSearch();
        this.exportLabel = labConsoleExport();
        this.toggleLoadingLabel = labConsoleToggleLoading();
        this.toggleWriteLabel = labConsoleToggleWrite();
        this.actionTitle = labConsoleActionTitle();
        this.actionLabel = labConsoleActionLabel();
        this.timelineLabel = labConsoleTimelineLabel();
        this.drawerTitle = labConsoleDrawerTitle();
        this.crumbHome = labConsoleCrumbHome();
        this.crumbConsole = labConsoleCrumbConsole();
        this.crumbPatterns = labConsoleCrumbPatterns();
        this.auditFilterTitle = labConsoleAuditFilterTitle();
        this.auditFilterDetail = labConsoleAuditFilterDetail();
        this.auditPermTitle = labConsoleAuditPermTitle();
        this.auditPermDetail = labConsoleAuditPermDetail();
        this.columns = [
            { id: "name", title: labConsoleColumnName() },
            { id: "status", title: labConsoleColumnStatus() },
        ];
        this.crumbs = [
            { id: "home", title: this.crumbHome, href: "/" },
            { id: "console", title: this.crumbConsole, href: "/console" },
            { id: "patterns", title: this.crumbPatterns },
        ];
        this.auditItems = [
            { id: "a1", time: "10:01", title: this.auditFilterTitle, detail: this.auditFilterDetail },
            { id: "a2", time: "10:02", title: this.auditPermTitle, detail: this.auditPermDetail },
        ];
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    applyQuery() {
        const name = (this.nameQuery || "").trim().toLowerCase();
        const status = (this.statusQuery || "").trim().toLowerCase();
        let list = this.allRows.slice();
        if (name) {
            list = list.filter((row) => String(row.cells[0]).toLowerCase().includes(name));
        }
        if (status) {
            list = list.filter((row) => String(row.cells[1]).toLowerCase().includes(status));
        }
        this.rows = this.sortRows(list);
        this.loading = false;
        this.loadingAttr = "false";
    }

    sortRows(list) {
        const key = this.sortKey === "status" ? 1 : 0;
        const dir = this.sortDir === "desc" ? -1 : 1;
        return list.slice().sort((a, b) => {
            const av = String(a.cells[key] || "");
            const bv = String(b.cells[key] || "");
            if (av < bv) return -1 * dir;
            if (av > bv) return 1 * dir;
            return 0;
        });
    }

    sortBy(id) {
        if (this.sortKey === id) {
            this.sortDir = this.sortDir === "asc" ? "desc" : "asc";
        } else {
            this.sortKey = id;
            this.sortDir = "asc";
        }
        this.rows = this.sortRows(this.rows);
    }

    toggleLoading() {
        this.loading = !this.loading;
        this.loadingAttr = this.loading ? "true" : "false";
    }

    toggleWrite() {
        this.writeDisabled = !this.writeDisabled;
    }

    openDetail(id) {
        if (this.writeDisabled) return;
        this.detailId = id;
        this.drawerOpen = true;
    }
}
</script>
