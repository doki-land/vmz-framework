<template>
    <div data-vmz-fixture="motion">
        <AppShell brand="VMZ" home-href="/" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <h1>
                    {{ pageTitle }}
                </h1>
                <p>
                    {{ pageLead }}
                </p>
                <section data-vmz-fixture="motion-feedback">
                    <Button type="button" data-vmz-action="pulse" @click="(() => clicks += 1)">
                        {{ pulseLabel }}
                    </Button>
                    <p data-vmz-fixture="motion-clicks" class="vmz-sr-only">
                        clicks:
                        {{ clicks }}
                    </p>
                </section>
                <section data-vmz-fixture="motion-overlay">
                    <Button type="button" data-vmz-action="open-dialog" @click="(() => dialogOpen = true)">
                        {{ openDialogLabel }}
                    </Button>
                    <Dialog :open="dialogOpen" :title="dialogTitle" title-id="home-motion-dialog-title" :on-close="(() => dialogOpen = false)">
                        <p data-vmz-fixture="motion-dialog-body">
                            {{ dialogBody }}
                        </p>
                    </Dialog>
                    <Button type="button" data-vmz-action="open-drawer" @click="(() => drawerOpen = true)">
                        {{ openDrawerLabel }}
                    </Button>
                    <Drawer :open="drawerOpen" :title="drawerTitle" title-id="home-motion-drawer-title" :on-close="(() => drawerOpen = false)">
                        <p data-vmz-fixture="motion-drawer-body">
                            {{ drawerBody }}
                        </p>
                    </Drawer>
                </section>
                <section data-vmz-fixture="motion-interrupt">
                    <p data-vmz-fixture="motion-interrupt-state" class="vmz-sr-only">
                        interrupt-dialog:
                        {{ interruptDialogOpen ? 'open' : 'closed' }}
                    </p>
                    <Button type="button" data-vmz-action="open-interrupt" @click="openInterruptDialog">
                        {{ openInterruptLabel }}
                    </Button>
                    <Dialog :open="interruptDialogOpen" :title="interruptTitle" title-id="home-motion-interrupt-dialog-title" :on-close="onInterruptDialogClose">
                        <p data-vmz-fixture="motion-interrupt-body">
                            {{ interruptBody }}
                        </p>
                    </Dialog>
                </section>
                <section data-vmz-fixture="motion-resume">
                    <p data-vmz-fixture="motion-resume-state" class="vmz-sr-only">
                        ssr-dialog:
                        {{ ssrDialogOpen ? 'open' : 'closed' }}
                    </p>
                    <Button type="button" data-vmz-action="reopen-ssr" @click="(() => ssrDialogOpen = true)">
                        {{ reopenSsrLabel }}
                    </Button>
                    <Dialog :open="ssrDialogOpen" :title="ssrTitle" title-id="home-motion-ssr-dialog-title" :on-close="(() => ssrDialogOpen = false)">
                        <p data-vmz-fixture="motion-resume-body">
                            {{ ssrBody }}
                        </p>
                    </Dialog>
                </section>
                <section data-vmz-fixture="motion-list">
                    <Button type="button" data-vmz-action="filter-alpha" @click="filterAlpha">
                        {{ filterAlphaLabel }}
                    </Button>
                    <Button type="button" data-vmz-action="reset-rows" @click="resetRows">
                        {{ resetRowsLabel }}
                    </Button>
                    <Table :columns="columns" :rows="rows" :has-row-action="rowAction" />
                    <p data-vmz-fixture="motion-row-count" class="vmz-sr-only">
                        rows:
                        {{ rowCount }}
                    </p>
                </section>
            </div>
        </AppShell>
    </div>
</template>
<script client>
import { navLab } from "#locales/common";
import {
    labMotionNavLabel,
    labMotionPageTitle,
    labMotionPageLead,
    labMotionPulse,
    labMotionOpenDialog,
    labMotionDialogTitle,
    labMotionDialogBody,
    labMotionOpenDrawer,
    labMotionDrawerTitle,
    labMotionDrawerBody,
    labMotionOpenInterrupt,
    labMotionInterruptTitle,
    labMotionInterruptBody,
    labMotionReopenSsr,
    labMotionSsrTitle,
    labMotionSsrBody,
    labMotionFilterAlpha,
    labMotionResetRows,
    labMotionColName,
    labMotionColStatus,
    labMotionRowAlpha,
    labMotionRowBeta,
    labMotionRowGamma,
    labMotionStatusActive,
    labMotionStatusPaused,
} from "#locales/lab-motion";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

export default class MotionPage {
    navItems = [];
    navLabel = "";
    pageTitle = "";
    pageLead = "";
    pulseLabel = "";
    openDialogLabel = "";
    dialogTitle = "";
    dialogBody = "";
    openDrawerLabel = "";
    drawerTitle = "";
    drawerBody = "";
    openInterruptLabel = "";
    interruptTitle = "";
    interruptBody = "";
    reopenSsrLabel = "";
    ssrTitle = "";
    ssrBody = "";
    filterAlphaLabel = "";
    resetRowsLabel = "";
    clicks = 0;
    dialogOpen = false;
    drawerOpen = false;
    interruptDialogOpen = false;
    /** Open on first paint so SSR HTML includes the overlay for resume-adopt proof. */
    ssrDialogOpen = true;
    rowCount = 3;
    rowAction = false;
    columns = [
        { id: "name", title: "Name" },
        { id: "status", title: "Status" },
    ];
    allRows = [
        { id: "r1", cells: ["Alpha", "Active"] },
        { id: "r2", cells: ["Beta", "Paused"] },
        { id: "r3", cells: ["Gamma", "Active"] },
    ];
    rows = [
        { id: "r1", cells: ["Alpha", "Active"] },
        { id: "r2", cells: ["Beta", "Paused"] },
        { id: "r3", cells: ["Gamma", "Active"] },
    ];
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.navLabel = labMotionNavLabel();
        this.pageTitle = labMotionPageTitle();
        this.pageLead = labMotionPageLead();
        this.pulseLabel = labMotionPulse();
        this.openDialogLabel = labMotionOpenDialog();
        this.dialogTitle = labMotionDialogTitle();
        this.dialogBody = labMotionDialogBody();
        this.openDrawerLabel = labMotionOpenDrawer();
        this.drawerTitle = labMotionDrawerTitle();
        this.drawerBody = labMotionDrawerBody();
        this.openInterruptLabel = labMotionOpenInterrupt();
        this.interruptTitle = labMotionInterruptTitle();
        this.interruptBody = labMotionInterruptBody();
        this.reopenSsrLabel = labMotionReopenSsr();
        this.ssrTitle = labMotionSsrTitle();
        this.ssrBody = labMotionSsrBody();
        this.filterAlphaLabel = labMotionFilterAlpha();
        this.resetRowsLabel = labMotionResetRows();
        this.columns = [
            { id: "name", title: labMotionColName() },
            { id: "status", title: labMotionColStatus() },
        ];
        this.allRows = [
            { id: "r1", cells: [labMotionRowAlpha(), labMotionStatusActive()] },
            { id: "r2", cells: [labMotionRowBeta(), labMotionStatusPaused()] },
            { id: "r3", cells: [labMotionRowGamma(), labMotionStatusActive()] },
        ];
        this.rows = this.allRows.slice();
        this.rowCount = this.rows.length;
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    openInterruptDialog() {
        this.interruptDialogOpen = true;
    }

    onInterruptDialogClose() {
        this.interruptDialogOpen = false;
    }

    filterAlpha() {
        this.rows = this.allRows.filter((row) => row.id === "r1");
        this.rowCount = this.rows.length;
    }

    resetRows() {
        this.rows = this.allRows.slice();
        this.rowCount = this.rows.length;
    }
}
</script>
