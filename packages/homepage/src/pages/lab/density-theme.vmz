<template>
    <div data-vmz-fixture="ui6" :data-density="density" :dir="dir">
        <AppShell brand="VMZ" home-href="/" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Alert tone="info" role-name="status" :title="alertTitle" :description="alertDesc" />
                <p data-vmz-fixture="ui6-state" class="vmz-sr-only">
                    density:
                    {{ density }}
                    ;dir:
                    {{ dir }}
                    ;theme:
                    {{ theme }}
                </p>
                <div class="vmz-ui6-actions">
                    <Button type="button" data-vmz-action="cycle-density" @click="cycleDensity">
                        {{ cycleLabel }}
                    </Button>
                    <Button type="button" variant="secondary" data-vmz-action="toggle-rtl" @click="toggleDir">
                        {{ toggleDirLabel }}
                    </Button>
                    <Button type="button" variant="ghost" data-vmz-action="toggle-high-contrast" @click="toggleTheme">
                        {{ toggleThemeLabel }}
                    </Button>
                </div>
                <Card :title="cardTitle" :description="cardDesc">
                    <Field :label="fieldLabel" :description="fieldDesc" control-id="home-ui6-sample" description-id="home-ui6-sample-desc" :value="sample" @input="onSample" />
                    <Button type="button" data-vmz-action="probe-control">
                        {{ probeLabel }}
                    </Button>
                </Card>
            </div>
        </AppShell>
    </div>
</template>
<style>
.vmz-ui6-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
}
</style>
<script client>
import { navLab } from "#locales/common";
import {
    labDensityNavLabel,
    labDensityAlertTitle,
    labDensityAlertDesc,
    labDensityCycle,
    labDensityToggleDir,
    labDensityToggleTheme,
    labDensityCardTitle,
    labDensityCardDesc,
    labDensityFieldLabel,
    labDensityFieldDesc,
    labDensityProbe,
} from "#locales/lab-density";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

export default class DensityThemePage {
    density = "comfortable";
    dir = "ltr";
    theme = "default";
    sample = "";
    navItems = [];
    navLabel = "";
    alertTitle = "";
    alertDesc = "";
    cycleLabel = "";
    toggleDirLabel = "";
    toggleThemeLabel = "";
    cardTitle = "";
    cardDesc = "";
    fieldLabel = "";
    fieldDesc = "";
    probeLabel = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.navLabel = labDensityNavLabel();
        this.alertTitle = labDensityAlertTitle();
        this.alertDesc = labDensityAlertDesc();
        this.cycleLabel = labDensityCycle();
        this.toggleDirLabel = labDensityToggleDir();
        this.toggleThemeLabel = labDensityToggleTheme();
        this.cardTitle = labDensityCardTitle();
        this.cardDesc = labDensityCardDesc();
        this.fieldLabel = labDensityFieldLabel();
        this.fieldDesc = labDensityFieldDesc();
        this.probeLabel = labDensityProbe();
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    cycleDensity() {
        if (this.density === "comfortable") this.density = "compact";
        else if (this.density === "compact") this.density = "dense";
        else this.density = "comfortable";
    }

    toggleDir() {
        this.dir = this.dir === "rtl" ? "ltr" : "rtl";
    }

    toggleTheme() {
        const next = this.theme === "high-contrast" ? "default" : "high-contrast";
        this.theme = next;
        if (typeof document !== "undefined") {
            document.documentElement.setAttribute("data-theme", next);
        }
    }

    onSample(e) {
        const t = e?.target;
        this.sample = t && "value" in t ? String(t.value) : "";
    }
}
</script>
