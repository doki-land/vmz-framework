<template>
    <div data-vmz-fixture="datatable" data-density="compact">
        <ConsoleShell brand="VMZ" home-href="/" :title="pageTitle" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Alert tone="info" role-name="status" :title="alertTitle" :description="alertDesc" />
                <p data-vmz-fixture="datatable-state" class="vmz-sr-only">
                    selected:
                    {{ selectedAttr || 'none' }}
                    ;count:
                    {{ selectedCount }}
                    ;sort:
                    {{ sortKey }}
                    :
                    {{ sortDir }}
                    ;detail:
                    {{ detailId || 'none' }}
                </p>
                <BulkActions :label="bulkActionsLabel" :selected-count="selectedCount" :count-label="bulkLabel">
                    <Button type="button" variant="secondary" @click="clearSelection">
                        {{ clearLabel }}
                    </Button>
                </BulkActions>
                <DataTable :columns="columns" :rows="rows" :has-row-action="rowAction" :action-title="actionTitle" :action-label="actionLabel" :sort-key="sortKey" :sort-dir="sortDir" :selected-count="selectedCountLabel" :all-selected="allSelected" :select-all-label="selectAllLabel" :on-sort="sortBy" :on-toggle-row="toggleRow" :on-toggle-all="toggleAll" :on-row-action="openDetail" />
                <Drawer :open="drawerOpen" :title="drawerTitle" title-id="home-datatable-drawer-title" :on-close="(() => drawerOpen = false)">
                    <p data-vmz-fixture="datatable-drawer-body">
                        detail:
                        {{ detailId }}
                    </p>
                </Drawer>
            </div>
        </ConsoleShell>
    </div>
</template>
<script client>
import { navLab } from "#locales/common";
import {
    labDatatablePageTitle,
    labDatatableNavLabel,
    labDatatableAlertTitle,
    labDatatableAlertDesc,
    labDatatableBulkLabel,
    labDatatableClear,
    labDatatableActionTitle,
    labDatatableActionLabel,
    labDatatableSelectAll,
    labDatatableDrawerTitle,
    labDatatableColumnName,
    labDatatableColumnStatus,
    labDatatableColumnOwner,
    labDatatableSelectRow,
    labDatatableSelectedCount,
} from "#locales/lab-datatable";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

export default class DatatablePage {
    selectedAttr = "";
    selectedCount = 0;
    selectedCountLabel = "0";
    bulkLabel = "";
    allSelected = false;
    sortKey = "name";
    sortDir = "asc";
    rowAction = true;
    drawerOpen = false;
    detailId = "";
    navItems = [];
    pageTitle = "";
    navLabel = "";
    alertTitle = "";
    alertDesc = "";
    bulkActionsLabel = "";
    clearLabel = "";
    actionTitle = "";
    actionLabel = "";
    selectAllLabel = "";
    drawerTitle = "";
    columnName = "";
    columnStatus = "";
    columnOwner = "";
    _unwatchLocale = null;
    columns = [];
    baseRows = [
        { id: "r1", cells: ["Alpha", "Active", "Ops"] },
        { id: "r2", cells: ["Beta", "Paused", "Docs"] },
        { id: "r3", cells: ["Gamma", "Active", "Runtime"] },
        { id: "r4", cells: ["Delta", "Draft", "Design"] },
        { id: "r5", cells: ["Epsilon", "Active", "QA"] },
    ];
    rows = [];

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.pageTitle = labDatatablePageTitle();
        this.navLabel = labDatatableNavLabel();
        this.alertTitle = labDatatableAlertTitle();
        this.alertDesc = labDatatableAlertDesc();
        this.bulkActionsLabel = labDatatableBulkLabel();
        this.clearLabel = labDatatableClear();
        this.actionTitle = labDatatableActionTitle();
        this.actionLabel = labDatatableActionLabel();
        this.selectAllLabel = labDatatableSelectAll();
        this.drawerTitle = labDatatableDrawerTitle();
        this.columnName = labDatatableColumnName();
        this.columnStatus = labDatatableColumnStatus();
        this.columnOwner = labDatatableColumnOwner();
        this.columns = [
            { id: "name", title: this.columnName },
            { id: "status", title: this.columnStatus },
            { id: "owner", title: this.columnOwner },
        ];
        this.refreshRows();
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    selectedSet() {
        return new Set(
            String(this.selectedAttr || "")
                .split(",")
                .map((s) => s.trim())
                .filter(Boolean),
        );
    }

    refreshRows() {
        const selected = this.selectedSet();
        const sorted = this.baseRows.slice().sort((a, b) => {
            const idx = this.columns.findIndex((c) => c.id === this.sortKey);
            const ai = idx >= 0 ? String(a.cells[idx] || "") : a.id;
            const bi = idx >= 0 ? String(b.cells[idx] || "") : b.id;
            const cmp = ai.localeCompare(bi);
            return this.sortDir === "desc" ? -cmp : cmp;
        });
        this.rows = sorted.map((row) => {
            const isOn = selected.has(row.id);
            return {
                id: row.id,
                cells: row.cells.slice(),
                selected: isOn,
                selectedAttr: isOn ? "true" : "false",
                selectLabel: labDatatableSelectRow({ name: row.cells[0] }),
            };
        });
        this.selectedCount = selected.size;
        this.selectedCountLabel = String(selected.size);
        this.allSelected = this.rows.length > 0 && this.rows.every((r) => r.selected);
        this.bulkLabel = selected.size
            ? labDatatableSelectedCount({ count: selected.size })
            : "";
    }

    toggleRow(id) {
        const set = this.selectedSet();
        if (set.has(id)) set.delete(id);
        else set.add(id);
        this.selectedAttr = [...set].sort().join(",");
        this.refreshRows();
    }

    toggleAll() {
        if (this.allSelected) {
            this.selectedAttr = "";
        } else {
            this.selectedAttr = this.rows
                .map((r) => r.id)
                .sort()
                .join(",");
        }
        this.refreshRows();
    }

    clearSelection() {
        this.selectedAttr = "";
        this.refreshRows();
    }

    sortBy(id) {
        if (this.sortKey === id) {
            this.sortDir = this.sortDir === "asc" ? "desc" : "asc";
        } else {
            this.sortKey = id;
            this.sortDir = "asc";
        }
        this.refreshRows();
    }

    openDetail(id) {
        this.detailId = id;
        this.drawerOpen = true;
    }
}
</script>
