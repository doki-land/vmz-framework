<template>
    <div data-vmz-fixture="structure">
        <AppShell brand="VMZ" home-href="/" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Alert tone="info" role-name="status" :title="alertTitle" :description="alertDesc" />
                <p data-vmz-fixture="structure-state" class="vmz-sr-only">
                    faq:
                    {{ faqOpen || 'none' }}
                    ;step:
                    {{ stepCurrent }}
                    ;list:
                    {{ listSelected || 'none' }}
                    ;tree:
                    {{ treeSelected || 'none' }}
                    ;expanded:
                    {{ treeExpandedAttr }}
                </p>
                <Card :title="accordionTitle" :description="accordionDesc">
                    <Accordion :label="accordionLabel" :open-id="faqOpen" :items="faqItems" :on-toggle="onFaqToggle" />
                </Card>
                <Card :title="stepsTitle" :description="stepsDesc">
                    <Steps :label="stepsLabel" :current="stepCurrent" :items="stepItems" />
                    <div class="vmz-structure-actions">
                        <span data-vmz-fixture="structure-step-back">
                            <Button type="button" variant="secondary" @click="stepBack">
                                {{ backLabel }}
                            </Button>
                        </span>
                        <span data-vmz-fixture="structure-step-next">
                            <Button type="button" @click="stepNext">
                                {{ nextLabel }}
                            </Button>
                        </span>
                    </div>
                </Card>
                <Card :title="listTitle" :description="listDesc">
                    <List :label="listLabel" label-id="home-structure-list-label" :selected="listSelected" :items="listItems" :on-select="onListSelect" />
                </Card>
                <Card :title="treeTitle" :description="treeDesc">
                    <Tree :label="treeLabel" label-id="home-structure-tree-label" :selected="treeSelected" :items="treeItems" :on-select="onTreeSelect" :on-toggle="onTreeToggle" />
                </Card>
            </div>
        </AppShell>
    </div>
</template>
<style>
.vmz-structure-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
    margin-top: 0.75rem;
}
</style>
<script client>
import { navLab } from "#locales/common";
import {
    labStructureNavLabel,
    labStructureAlertTitle,
    labStructureAlertDesc,
    labStructureAccordionTitle,
    labStructureAccordionDesc,
    labStructureStepsTitle,
    labStructureStepsDesc,
    labStructureListTitle,
    labStructureListDesc,
    labStructureTreeTitle,
    labStructureTreeDesc,
    labStructureAccordionLabel,
    labStructureStepsLabel,
    labStructureListLabel,
    labStructureTreeLabel,
    labStructureBack,
    labStructureNext,
    labStructureFaqBillingTitle,
    labStructureFaqBillingBody,
    labStructureFaqAccessTitle,
    labStructureFaqAccessBody,
    labStructureFaqSupportTitle,
    labStructureFaqSupportBody,
    labStructureStepAccountTitle,
    labStructureStepAccountDesc,
    labStructureStepWorkspaceTitle,
    labStructureStepWorkspaceDesc,
    labStructureStepInviteTitle,
    labStructureStepInviteDesc,
    labStructureTreePlatform,
    labStructureTreeRuntime,
    labStructureTreeUi,
    labStructureTreeDocuments,
    labStructureTreeGuide,
    labStructureTreeBrowser,
    labStructureTwistCollapse,
    labStructureTwistExpand,
} from "#locales/lab-structure";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

export default class StructurePage {
    faqOpen = "billing";
    stepCurrent = "account";
    listSelected = "alpha";
    treeSelected = "platform";
    treeExpandedAttr = "platform";

    navItems = [];
    navLabel = "";
    alertTitle = "";
    alertDesc = "";
    accordionTitle = "";
    accordionDesc = "";
    accordionLabel = "";
    stepsTitle = "";
    stepsDesc = "";
    stepsLabel = "";
    backLabel = "";
    nextLabel = "";
    listTitle = "";
    listDesc = "";
    listLabel = "";
    treeTitle = "";
    treeDesc = "";
    treeLabel = "";
    faqBillingTitle = "";
    faqBillingBody = "";
    faqAccessTitle = "";
    faqAccessBody = "";
    faqSupportTitle = "";
    faqSupportBody = "";
    stepAccountTitle = "";
    stepAccountDesc = "";
    stepWorkspaceTitle = "";
    stepWorkspaceDesc = "";
    stepInviteTitle = "";
    stepInviteDesc = "";
    treePlatformTitle = "";
    treeRuntimeTitle = "";
    treeUiTitle = "";
    treeDocumentsTitle = "";
    treeGuideTitle = "";
    treeBrowserTitle = "";
    _unwatchLocale = null;

    faqItems = [];

    listItems = [
        { id: "alpha", title: "Alpha Platform" },
        { id: "beta", title: "Beta Ops" },
        { id: "gamma", title: "Gamma Docs" },
    ];

    stepItems = [];

    treeItems = [];

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.navLabel = labStructureNavLabel();
        this.alertTitle = labStructureAlertTitle();
        this.alertDesc = labStructureAlertDesc();
        this.accordionTitle = labStructureAccordionTitle();
        this.accordionDesc = labStructureAccordionDesc();
        this.accordionLabel = labStructureAccordionLabel();
        this.stepsTitle = labStructureStepsTitle();
        this.stepsDesc = labStructureStepsDesc();
        this.stepsLabel = labStructureStepsLabel();
        this.backLabel = labStructureBack();
        this.nextLabel = labStructureNext();
        this.listTitle = labStructureListTitle();
        this.listDesc = labStructureListDesc();
        this.listLabel = labStructureListLabel();
        this.treeTitle = labStructureTreeTitle();
        this.treeDesc = labStructureTreeDesc();
        this.treeLabel = labStructureTreeLabel();
        this.faqBillingTitle = labStructureFaqBillingTitle();
        this.faqBillingBody = labStructureFaqBillingBody();
        this.faqAccessTitle = labStructureFaqAccessTitle();
        this.faqAccessBody = labStructureFaqAccessBody();
        this.faqSupportTitle = labStructureFaqSupportTitle();
        this.faqSupportBody = labStructureFaqSupportBody();
        this.stepAccountTitle = labStructureStepAccountTitle();
        this.stepAccountDesc = labStructureStepAccountDesc();
        this.stepWorkspaceTitle = labStructureStepWorkspaceTitle();
        this.stepWorkspaceDesc = labStructureStepWorkspaceDesc();
        this.stepInviteTitle = labStructureStepInviteTitle();
        this.stepInviteDesc = labStructureStepInviteDesc();
        this.treePlatformTitle = labStructureTreePlatform();
        this.treeRuntimeTitle = labStructureTreeRuntime();
        this.treeUiTitle = labStructureTreeUi();
        this.treeDocumentsTitle = labStructureTreeDocuments();
        this.treeGuideTitle = labStructureTreeGuide();
        this.treeBrowserTitle = labStructureTreeBrowser();
        this.faqItems = [
            {
                id: "billing",
                title: this.faqBillingTitle,
                body: this.faqBillingBody,
                triggerId: "home-faq-billing-trigger",
                panelId: "home-faq-billing-panel",
            },
            {
                id: "access",
                title: this.faqAccessTitle,
                body: this.faqAccessBody,
                triggerId: "home-faq-access-trigger",
                panelId: "home-faq-access-panel",
            },
            {
                id: "support",
                title: this.faqSupportTitle,
                body: this.faqSupportBody,
                triggerId: "home-faq-support-trigger",
                panelId: "home-faq-support-panel",
            },
        ];
        this.refreshSteps();
        this.refreshTree();
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    onFaqToggle(id) {
        this.faqOpen = this.faqOpen === id ? "" : id;
    }

    refreshSteps() {
        const ids = ["account", "workspace", "invite"];
        const cur = ids.indexOf(this.stepCurrent);
        this.stepItems = [
            {
                id: "account",
                index: "1",
                title: this.stepAccountTitle,
                description: this.stepAccountDesc,
                status: cur > 0 ? "done" : cur === 0 ? "current" : "upcoming",
            },
            {
                id: "workspace",
                index: "2",
                title: this.stepWorkspaceTitle,
                description: this.stepWorkspaceDesc,
                status: cur > 1 ? "done" : cur === 1 ? "current" : "upcoming",
            },
            {
                id: "invite",
                index: "3",
                title: this.stepInviteTitle,
                description: this.stepInviteDesc,
                status: cur > 2 ? "done" : cur === 2 ? "current" : "upcoming",
            },
        ];
    }

    stepBack() {
        const ids = ["account", "workspace", "invite"];
        const idx = Math.max(0, ids.indexOf(this.stepCurrent) - 1);
        this.stepCurrent = ids[idx];
        this.refreshSteps();
    }

    stepNext() {
        const ids = ["account", "workspace", "invite"];
        const idx = Math.min(ids.length - 1, ids.indexOf(this.stepCurrent) + 1);
        this.stepCurrent = ids[idx];
        this.refreshSteps();
    }

    onListSelect(id) {
        this.listSelected = id;
    }

    onTreeSelect(id) {
        this.treeSelected = id;
    }

    expandedSet() {
        return new Set(
            String(this.treeExpandedAttr || "")
                .split(",")
                .map((s) => s.trim())
                .filter(Boolean),
        );
    }

    refreshTree() {
        const expanded = this.expandedSet();
        const rows = [];
        const push = (id, title, depth, children) => {
            const expandable = !!(children && children.length);
            const isOpen = expanded.has(id);
            rows.push({
                id,
                title,
                depth: String(depth),
                expandable,
                expanded: isOpen,
                expandedAttr: expandable ? (isOpen ? "true" : "false") : "",
                twistLabel: isOpen
                    ? labStructureTwistCollapse({ name: title })
                    : labStructureTwistExpand({ name: title }),
                padStyle: `padding-inline-start: ${0.35 + depth * 0.9}rem`,
            });
            if (expandable && isOpen) {
                for (const child of children)
                    push(child.id, child.title, depth + 1, child.children || []);
            }
        };
        push("platform", this.treePlatformTitle, 0, [
            {
                id: "runtime",
                title: this.treeRuntimeTitle,
                children: [{ id: "browser", title: this.treeBrowserTitle }],
            },
            { id: "ui", title: this.treeUiTitle },
        ]);
        push("docs", this.treeDocumentsTitle, 0, [{ id: "guide", title: this.treeGuideTitle }]);
        this.treeItems = rows;
    }

    onTreeToggle(id) {
        const set = this.expandedSet();
        if (set.has(id)) set.delete(id);
        else set.add(id);
        this.treeExpandedAttr = [...set].sort().join(",");
        this.refreshTree();
    }
}
</script>
