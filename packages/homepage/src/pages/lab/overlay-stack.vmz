<template>
    <div data-vmz-fixture="stacking">
        <AppShell brand="VMZ" home-href="/" :nav-label="navLabel" :nav="navItems">
            <div class="vmz-slot-content">
                <Alert tone="info" role-name="status" :title="alertTitle" :description="alertDesc" />
                <p data-vmz-fixture="stacking-state" class="vmz-sr-only">
                    drawer:
                    {{ drawerOpen ? 'open' : 'closed' }}
                    ;dialog:
                    {{ dialogOpen ? 'open' : 'closed' }}
                    ;popover:
                    {{ popoverOpen ? 'open' : 'closed' }}
                </p>
                <div class="vmz-stacking-actions">
                    <span data-vmz-fixture="stacking-open-drawer">
                        <Button type="button" @click="openDrawer">
                            {{ openDrawerLabel }}
                        </Button>
                    </span>
                    <span data-vmz-fixture="stacking-open-dialog">
                        <Button type="button" variant="secondary" @click="openDialog">
                            {{ openDialogLabel }}
                        </Button>
                    </span>
                    <span data-vmz-fixture="stacking-open-popover">
                        <Button type="button" variant="ghost" @click="openPopover">
                            {{ openPopoverLabel }}
                        </Button>
                    </span>
                </div>
                <Drawer :open="drawerOpen" :title="drawerTitle" title-id="home-stack-drawer-title" stack-level="0" :on-close="closeDrawer">
                    <p data-vmz-fixture="stacking-drawer-body">
                        {{ drawerBody }}
                    </p>
                </Drawer>
                <Dialog :open="dialogOpen" :title="dialogTitle" title-id="home-stack-dialog-title" stack-level="1" :on-close="closeDialog">
                    <p data-vmz-fixture="stacking-dialog-body">
                        {{ dialogBody }}
                    </p>
                </Dialog>
                <Popover :open="popoverOpen" :title="popoverTitle" title-id="home-stack-popover-title" stack-level="2" :on-close="closePopover">
                    <p data-vmz-fixture="stacking-popover-body">
                        {{ popoverBody }}
                    </p>
                </Popover>
            </div>
        </AppShell>
    </div>
</template>
<style>
.vmz-stacking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
}
</style>
<script client>
import { navLab } from "#locales/common";
import {
    labOverlayNavLabel,
    labOverlayAlertTitle,
    labOverlayAlertDesc,
    labOverlayOpenDrawer,
    labOverlayOpenDialog,
    labOverlayOpenPopover,
    labOverlayDrawerTitle,
    labOverlayDrawerBody,
    labOverlayDialogTitle,
    labOverlayDialogBody,
    labOverlayPopoverTitle,
    labOverlayPopoverBody,
} from "#locales/lab-overlay";
import { labNav } from "../../lab-nav.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../../locale/copy.ts";

import { pageMeta } from "../../page-meta.ts";

export default class StackingPage {
    static meta = pageMeta("浮层堆叠 · VMZ", "Stacked overlays · VMZ");

    drawerOpen = false;
    dialogOpen = false;
    popoverOpen = false;

    navItems = [];
    navLabel = "";
    alertTitle = "";
    alertDesc = "";
    openDrawerLabel = "";
    openDialogLabel = "";
    openPopoverLabel = "";
    drawerTitle = "";
    drawerBody = "";
    dialogTitle = "";
    dialogBody = "";
    popoverTitle = "";
    popoverBody = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.navLabel = labOverlayNavLabel();
        this.alertTitle = labOverlayAlertTitle();
        this.alertDesc = labOverlayAlertDesc();
        this.openDrawerLabel = labOverlayOpenDrawer();
        this.openDialogLabel = labOverlayOpenDialog();
        this.openPopoverLabel = labOverlayOpenPopover();
        this.drawerTitle = labOverlayDrawerTitle();
        this.drawerBody = labOverlayDrawerBody();
        this.dialogTitle = labOverlayDialogTitle();
        this.dialogBody = labOverlayDialogBody();
        this.popoverTitle = labOverlayPopoverTitle();
        this.popoverBody = labOverlayPopoverBody();
        this.navItems = labNav(navLab());
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    openDrawer() {
        this.drawerOpen = true;
    }

    closeDrawer() {
        this.popoverOpen = false;
        this.dialogOpen = false;
        this.drawerOpen = false;
    }

    openDialog() {
        this.dialogOpen = true;
    }

    closeDialog() {
        this.popoverOpen = false;
        this.dialogOpen = false;
    }

    openPopover() {
        this.popoverOpen = true;
    }

    closePopover() {
        this.popoverOpen = false;
    }
}
</script>
