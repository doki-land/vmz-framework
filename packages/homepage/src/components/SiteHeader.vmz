<template>
  <header class="site-header" data-vmz-fixture="site-header">
    <a class="site-brand" href="/" :aria-label="homeLabel">
      <span class="site-brand__mark">{{ brandLabel }}</span>
      <span class="site-brand__pulse" aria-hidden="true"></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a :href="docsRootHref">{{ docsLabel }}</a>
      <a :href="guideHref">{{ guideLabel }}</a>
      <a :href="deployDocHref">{{ deployLabel }}</a>
      <a href="/deploy-planner">{{ deployPlannerLabel }}</a>
      <a href="/#showcase">{{ showcaseLabel }}</a>
      <a href="https://github.com/doki-land/vmz-framework">GitHub</a>
      <details class="site-language">
        <summary :aria-label="selectLanguageLabel">{{ langSummary }}</summary>
        <div class="site-language__menu">
          <button
            type="button"
            data-vmz-fixture="locale-zh-hans"
            :aria-current="localeId === 'zh-hans' ? 'true' : null"
            @click="() => switchLocale('zh-hans')"
          >
            {{ langZhFullLabel }}
          </button>
          <button
            type="button"
            data-vmz-fixture="locale-en-us"
            :aria-current="localeId === 'en-us' ? 'true' : null"
            @click="() => switchLocale('en-us')"
          >
            {{ langEnLabel }}
          </button>
        </div>
      </details>
      <a class="site-nav__cta" :href="guideHref">{{ startLabel }}</a>
    </nav>
  </header>
</template>

<script client>
import {
  brand,
  home,
  docs,
  guide,
  deploy,
  deployPlanner,
  showcase,
  start,
  selectLanguage,
  langZh,
  langZhFull,
  langEn,
} from '#locales/common';
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class SiteHeader {
  localeId = 'zh-hans';
  brandLabel = '';
  homeLabel = '';
  docsLabel = '';
  guideLabel = '';
  deployLabel = '';
  deployPlannerLabel = '';
  showcaseLabel = '';
  startLabel = '';
  selectLanguageLabel = '';
  langSummary = '';
  langZhFullLabel = '';
  langEnLabel = '';
  docsRootHref = '/d/zh-hans/';
  guideHref = '/d/zh-hans/guide/';
  deployDocHref = '/d/zh-hans/guide/deploy/';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.brandLabel = brand();
    this.homeLabel = home();
    this.docsLabel = docs();
    this.guideLabel = guide();
    this.deployLabel = deploy();
    this.deployPlannerLabel = deployPlanner();
    this.showcaseLabel = showcase();
    this.startLabel = start();
    this.selectLanguageLabel = selectLanguage();
    this.langSummary = this.localeId === 'en-us' ? langEn() : langZh();
    this.langZhFullLabel = langZhFull();
    this.langEnLabel = langEn();
    const paths = docsPaths(this.localeId);
    this.docsRootHref = paths.docsRootHref;
    this.guideHref = paths.guideHref;
    this.deployDocHref = paths.deployDocHref;
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  async switchLocale(to) {
    if (typeof window === 'undefined') return;
    const fn = window.__vmzTransitionLocale;
    if (typeof fn !== 'function') {
      if (typeof console !== 'undefined' && console.warn) {
        console.warn('[vmz] locale switch skipped: __vmzTransitionLocale missing (dev host not bootstrapped?)');
      }
      if (window) {
        window.__vmzLastLocaleTransition = {
          status: 'rejected',
          toLocale: to,
          reason: 'missing_host',
        };
      }
      return;
    }
    const r = await fn(to);
    if (r && r.status !== 'committed' && typeof console !== 'undefined' && console.warn) {
      console.warn('[vmz] locale transition not committed:', r.status, r.reason || '');
    }
    if (r && r.status === 'committed') {
      this.applyLocaleCopy(to);
      // Soft nav may settle a tick later; re-sync after paint.
      queueMicrotask(() => this.applyLocaleCopy(to));
    }
  }
}
</script>
