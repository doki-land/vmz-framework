<template>
    <header data-vmz-fixture="site-header" class="site-header">
        <a :href="homeHref" :aria-label="homeLabel" class="site-brand">
            <span class="site-brand__mark">
                {{ brandLabel }}
            </span>
            <span aria-hidden="true" class="site-brand__pulse" />
        </a>
        <nav aria-label="Primary" class="site-nav">
            <div class="site-nav__links">
                <a v-for="item in navItems" :key="item.id" :href="item.href" :data-active="item.id === activeId ? 'true' : 'false'" :aria-current="item.id === activeId ? 'page' : null">
                    {{ item.label }}
                </a>
            </div>
            <details class="site-nav-mobile">
                <summary :aria-label="navMenuLabel">
                    {{ navMenuLabel }}
                </summary>
                <div class="site-nav-mobile__menu">
                    <a v-for="item in navItems" :key="item.id" :href="item.href" :data-active="item.id === activeId ? 'true' : 'false'" :aria-current="item.id === activeId ? 'page' : null">
                        {{ item.label }}
                    </a>
                    <a :href="githubHref">
                        {{ githubLabel }}
                    </a>
                    <a :href="guideHref" class="site-nav-mobile__cta">
                        {{ startLabel }}
                    </a>
                </div>
            </details>
            <SitePreferences />
            <details class="site-language">
                <summary :aria-label="selectLanguageLabel">
                    {{ langSummary }}
                </summary>
                <div class="site-language__menu">
                    <button type="button" data-vmz-fixture="locale-zh-hans" :aria-current="localeId === 'zh-hans' ? 'true' : null" @click='(() => switchLocale("zh-hans"))'>
                        {{ langZhFullLabel }}
                    </button>
                    <button type="button" data-vmz-fixture="locale-en-us" :aria-current="localeId === 'en-us' ? 'true' : null" @click='(() => switchLocale("en-us"))'>
                        {{ langEnLabel }}
                    </button>
                </div>
            </details>
            <a :href="githubHref" :aria-label="githubLabel" rel="noopener" class="site-nav__github">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false" class="site-nav__github-icon">
                    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
            </a>
            <a :href="guideHref" class="site-nav__cta">
                {{ startLabel }}
            </a>
        </nav>
    </header>
</template>
<script client>
import {
    brand,
    home,
    github,
    navMenu,
    selectLanguage,
    langZh,
    langZhFull,
    langEn,
    start,
    navProduct,
    navDocs,
    navShowcase,
    navLab,
    navIcons,
    navCharts,
    navAbout,
} from "#locales/common";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";
import { activeNavId, siteHomeHref, siteNavItems } from "../nav.ts";

const GITHUB_HREF = "https://github.com/doki-land/vmz-framework";

export default class SiteHeader {
    localeId = "zh-hans";
    brandLabel = "";
    homeLabel = "";
    githubLabel = "";
    navMenuLabel = "";
    selectLanguageLabel = "";
    langSummary = "";
    langZhFullLabel = "";
    langEnLabel = "";
    startLabel = "";
    homeHref = "/";
    githubHref = GITHUB_HREF;
    guideHref = "/d/zh-hans/guide/";
    activeId = "";
    navItems = [];
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.brandLabel = brand();
        this.homeLabel = home();
        this.githubLabel = github();
        this.navMenuLabel = navMenu();
        this.selectLanguageLabel = selectLanguage();
        this.langSummary = this.localeId === "en-us" ? langEn() : langZh();
        this.langZhFullLabel = langZhFull();
        this.langEnLabel = langEn();
        this.startLabel = start();
        const paths = docsPaths(this.localeId);
        this.guideHref = paths.guideHref;
        this.homeHref = siteHomeHref(this.localeId);
        this.navItems = siteNavItems(
            this.localeId,
            {
                product: navProduct(),
                docs: navDocs(),
                showcase: navShowcase(),
                lab: navLab(),
                icons: navIcons(),
                charts: navCharts(),
                about: navAbout(),
            },
            paths.docsRootHref,
        );
        this.activeId = activeNavId(this.currentPath(), this.localeId);
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
    }

    currentPath() {
        if (typeof window === "undefined" || !window.location) return "/";
        return window.location.pathname || "/";
    }

    async switchLocale(to) {
        if (typeof window === "undefined") return;
        const fn = window.__vmzTransitionLocale;
        if (typeof fn !== "function") {
            if (typeof console !== "undefined" && console.warn) {
                console.warn(
                    "[vmz] locale switch skipped: __vmzTransitionLocale missing (dev host not bootstrapped?)",
                );
            }
            if (window) {
                window.__vmzLastLocaleTransition = {
                    status: "rejected",
                    toLocale: to,
                    reason: "missing_host",
                };
            }
            return;
        }
        const r = await fn(to);
        if (r && r.status !== "committed" && typeof console !== "undefined" && console.warn) {
            console.warn("[vmz] locale transition not committed:", r.status, r.reason || "");
        }
        if (r && r.status === "committed") {
            this.applyLocaleCopy(to);
            queueMicrotask(() => this.applyLocaleCopy(to));
        }
    }
}
</script>
