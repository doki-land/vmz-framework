<template>
    <footer data-vmz-fixture="site-footer" class="site-footer">
        <div class="site-footer__brand">
            <span class="site-footer__mark">
                {{ brandLabel }}
            </span>
            <p class="site-footer__tag">
                {{ footerTagLabel }}
            </p>
        </div>
        <nav :aria-label="pagesNavLabel" class="site-footer__group">
            <b>
                {{ pagesNavLabel }}
            </b>
            <a v-for="item in navItems" :key="item.id" :href="item.href">
                {{ item.label }}
            </a>
        </nav>
        <nav :aria-label="productNavLabel" class="site-footer__group">
            <b>
                {{ productNavLabel }}
            </b>
            <a data-vmz-fixture="footer-docs" :href="docsRootHref">
                {{ docsLabel }}
            </a>
            <a :href="guideHref">
                {{ gettingStartedGuideLabel }}
            </a>
            <a :href="deployDocHref">
                {{ deployGuideLabel }}
            </a>
            <a :href="pluginsHref">
                {{ pluginsLabel }}
            </a>
        </nav>
        <nav :aria-label="resourcesNavLabel" class="site-footer__group">
            <b>
                {{ resourcesNavLabel }}
            </b>
            <a :href="githubHref">
                {{ githubLabel }}
            </a>
            <a :href="issuesHref">
                {{ issuesLabel }}
            </a>
            <a :href="discussionsHref">
                {{ discussionsLabel }}
            </a>
        </nav>
        <p class="site-footer__note">
            {{ footerNoteLabel }}
        </p>
    </footer>
</template>
<script client>
import {
    brand,
    docs,
    gettingStartedGuide,
    deployGuide,
    plugins,
    footerTag,
    footerPages,
    productNav,
    resourcesNav,
    issues,
    discussions,
    github,
    footerNote,
    navProduct,
    navShowcase,
    navLab,
    navAbout,
} from "#locales/common";
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from "../locale/copy.ts";
import { siteNavItems } from "../nav.ts";

const REPO_HREF = "https://github.com/doki-land/vmz-framework";

export default class SiteFooter {
    localeId = "zh-hans";
    brandLabel = "";
    footerTagLabel = "";
    pagesNavLabel = "";
    docsLabel = "";
    gettingStartedGuideLabel = "";
    deployGuideLabel = "";
    pluginsLabel = "";
    productNavLabel = "";
    resourcesNavLabel = "";
    issuesLabel = "";
    discussionsLabel = "";
    githubLabel = "";
    footerNoteLabel = "";
    docsRootHref = "/d/zh-hans/";
    guideHref = "/d/zh-hans/guide/";
    deployDocHref = "/d/zh-hans/guide/deploy/";
    pluginsHref = "/d/zh-hans/plugins/";
    githubHref = REPO_HREF;
    issuesHref = `${REPO_HREF}/issues`;
    discussionsHref = `${REPO_HREF}/discussions`;
    navItems = [];
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.brandLabel = brand();
        this.footerTagLabel = footerTag();
        this.pagesNavLabel = footerPages();
        this.docsLabel = docs();
        this.gettingStartedGuideLabel = gettingStartedGuide();
        this.deployGuideLabel = deployGuide();
        this.pluginsLabel = plugins();
        this.productNavLabel = productNav();
        this.resourcesNavLabel = resourcesNav();
        this.issuesLabel = issues();
        this.discussionsLabel = discussions();
        this.githubLabel = github();
        this.footerNoteLabel = footerNote();
        const paths = docsPaths(this.localeId);
        this.docsRootHref = paths.docsRootHref;
        this.guideHref = paths.guideHref;
        this.deployDocHref = paths.deployDocHref;
        this.pluginsHref = paths.pluginsHref;
        this.navItems = siteNavItems(
            this.localeId,
            {
                product: navProduct(),
                docs: docs(),
                showcase: navShowcase(),
                lab: navLab(),
                about: navAbout(),
            },
            paths.docsRootHref,
        ).filter((item) => item.id !== "docs");
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
    }
}
</script>
