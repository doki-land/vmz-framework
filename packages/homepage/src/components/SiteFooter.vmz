<template>
  <footer class="site-footer" data-vmz-fixture="site-footer">
    <div class="site-footer__brand">
      <span class="site-footer__mark">{brandLabel}</span>
      <p class="site-footer__tag">{footerTagLabel}</p>
    </div>
    <nav class="site-footer__group" aria-label={productNavLabel}>
      <b>Product</b>
      <a data-vmz-fixture="footer-docs" href={docsRootHref}>{docsLabel}</a>
      <a href={guideHref}>{gettingStartedGuideLabel}</a>
      <a href={deployDocHref}>{deployGuideLabel}</a>
      <a href="/deploy-planner">{deployPlannerLabel}</a>
      <a href="/#showcase">{showcaseLabel}</a>
    </nav>
    <nav class="site-footer__group" aria-label={resourcesNavLabel}>
      <b>Resources</b>
      <a href="/welcome">Welcome</a>
      <a href={pluginsHref}>{pluginsLabel}</a>
      <a href="https://github.com/doki-land/vmz-framework">GitHub</a>
    </nav>
    <p class="site-footer__note">VMZ · Full-stack application compiler</p>
  </footer>
</template>

<script client>
import {
  brand,
  docs,
  deployPlanner,
  showcase,
  gettingStartedGuide,
  deployGuide,
  plugins,
  footerTag,
  productNav,
  resourcesNav,
} from '#locales/common';
import { docsPaths, readLocaleId, withLocaleHint, watchDocumentLocale } from '../locale/copy.ts';

export default class SiteFooter {
  localeId = 'zh-hans';
  brandLabel = '';
  footerTagLabel = '';
  docsLabel = '';
  gettingStartedGuideLabel = '';
  deployGuideLabel = '';
  deployPlannerLabel = '';
  showcaseLabel = '';
  pluginsLabel = '';
  productNavLabel = '';
  resourcesNavLabel = '';
  docsRootHref = '/d/zh-hans/';
  guideHref = '/d/zh-hans/guide/';
  deployDocHref = '/d/zh-hans/guide/deploy/';
  pluginsHref = '/d/zh-hans/plugins/';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.brandLabel = brand();
    this.footerTagLabel = footerTag();
    this.docsLabel = docs();
    this.gettingStartedGuideLabel = gettingStartedGuide();
    this.deployGuideLabel = deployGuide();
    this.deployPlannerLabel = deployPlanner();
    this.showcaseLabel = showcase();
    this.pluginsLabel = plugins();
    this.productNavLabel = productNav();
    this.resourcesNavLabel = resourcesNav();
    const paths = docsPaths(this.localeId);
    this.docsRootHref = paths.docsRootHref;
    this.guideHref = paths.guideHref;
    this.deployDocHref = paths.deployDocHref;
    this.pluginsHref = paths.pluginsHref;
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }
}
</script>
