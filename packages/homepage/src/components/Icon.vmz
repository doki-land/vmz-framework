<template>
    <span data-vmz-ui="icon" :data-name="name" :data-size="size" :role='decorative ? "presentation" : "img"' :aria-hidden='decorative ? "true" : "false"' :aria-label='decorative ? "" : label' class="vmz-ui-icon">
        <span v-if="isTextBadge()" class="vmz-ui-icon__badge">{{ badgeLabel() }}</span>
        <svg v-else viewBox="0 0 24 24" focusable="false" aria-hidden="true" class="vmz-ui-icon__svg">
            <g v-if="isStroke()" fill="none" stroke="currentColor" :stroke-width="strokeWidth()" stroke-linecap="round" stroke-linejoin="round">
                <path v-for="d in strokePaths()" :key="d" :d="d" />
                <circle v-for="c in strokeCircles()" :key="circleKey(c)" :cx="c.cx" :cy="c.cy" :r="c.r" />
                <circle v-for="dot in strokeDots()" :key="dotKey(dot)" :cx="dot.cx" :cy="dot.cy" :r="dot.r" fill="currentColor" stroke="none" />
            </g>
            <path v-else-if="isFill()" fill="currentColor" :fill-rule="fillRule()" :d="fillD()" />
        </svg>
    </span>
</template>
<style>
.vmz-ui-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    color: inherit;
    line-height: 1;
}
.vmz-ui-icon[data-size="sm"] {
    font-size: 0.875rem;
}
.vmz-ui-icon[data-size="md"] {
    font-size: 1rem;
}
.vmz-ui-icon[data-size="lg"] {
    font-size: 1.25rem;
}
.vmz-ui-icon__svg {
    width: 1em;
    height: 1em;
    display: block;
}
.vmz-ui-icon__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 1.65em;
    padding: 0.12em 0.22em;
    border: 1.5px solid currentColor;
    border-radius: 0.2em;
    font-family: var(--vmz-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-size: 0.52em;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
}
</style>
<script client>
import { DEFAULT_STROKE_WIDTH, resolveIconDef } from "@vmz/ui-icons/registry";

/**
 * Homepage Icon — semantic registry from `@vmz/ui-icons` for official dogfood surfaces.
 * Overrides dependency `Icon` tags within this app only.
 */
export default class Icon {
    static __vmzHostBox = "contents";
    public name: string = "status.info";
    public size: string = "md";
    public label: string = "";
    public decorative: boolean = true;

    iconDef() {
        return resolveIconDef(this.name);
    }

    isStroke() {
        const def = this.iconDef();
        return def?.kind === "stroke";
    }

    isFill() {
        const def = this.iconDef();
        return def?.kind === "fill";
    }

    isTextBadge() {
        const def = this.iconDef();
        return def?.kind === "text-badge";
    }

    badgeLabel() {
        const def = this.iconDef();
        if (def?.kind !== "text-badge") return "";
        return def.label;
    }

    strokeWidth() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return DEFAULT_STROKE_WIDTH;
        return def.strokeWidth ?? DEFAULT_STROKE_WIDTH;
    }

    strokePaths() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.paths ?? [];
    }

    strokeCircles() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.circles ?? [];
    }

    strokeDots() {
        const def = this.iconDef();
        if (def?.kind !== "stroke") return [];
        return def.dots ?? [];
    }

    circleKey(c) {
        return `c-${c.cx}-${c.cy}-${c.r}`;
    }

    dotKey(dot) {
        return `d-${dot.cx}-${dot.cy}-${dot.r}`;
    }

    fillD() {
        const def = this.iconDef();
        if (def?.kind !== "fill") return "";
        return def.d;
    }

    fillRule() {
        const def = this.iconDef();
        if (def?.kind !== "fill" || !def.fillRule) return "";
        return def.fillRule;
    }
}
</script>
