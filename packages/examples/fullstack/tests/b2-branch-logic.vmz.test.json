{
    "schema": "vmz.test.manifest.v0",
    "id": "b2.logic.branch",
    "title": "B2: BranchDemo toggle + inactive branch isolation",
    "modes": ["logic"],
    "program": {
        "chunkId": "components/BranchDemo",
        "unitName": "BranchDemo"
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "mount"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "text",
