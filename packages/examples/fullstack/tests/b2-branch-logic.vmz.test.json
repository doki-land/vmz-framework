        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "write",
            "field": "aText",
            "value": "A2"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "text",
            "expect": {
                "notContains": "A2"
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "write",
            "field": "showA",
            "value": true
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
