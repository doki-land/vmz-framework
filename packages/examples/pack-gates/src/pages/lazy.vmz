<template>
    <main>
        <h1>lazy</h1>
        <button type="button" @click="loadHeavy">load heavy</button>
        <p>{{ result }}</p>
    </main>
</template>
<script client>
export default class LazyPage {
    static meta() {
        return { title: "Lazy · Pack Gates", description: "lazy route" };
    }
    result = "";
    async loadHeavy() {
        const mod = await import("../lib/heavy.ts");
        this.result = String(mod.heavyCompute(3));
    }
}
</script>
