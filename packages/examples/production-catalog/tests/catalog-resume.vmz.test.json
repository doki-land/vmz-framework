{
    "schema": "vmz.test.manifest.v0",
    "id": "production.catalog.resume.chip",
    "title": "production catalog: Island SSR + resume adopt CatalogChip",
    "modes": ["resume"],
    "program": {
        "chunkId": "pages/index",
        "unitName": "IndexPage",
        "resumeComponent": "CatalogChip",
        "components": {
            "CatalogChip": "components/CatalogChip",
            "CatalogShell": "components/CatalogShell",
            "CatalogList": "components/CatalogList",
            "ProductRow": "components/ProductRow"
        }
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "ssr"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "html",
            "expect": {
                "contains": "data-vmz-island=\"CatalogChip\""
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "resume",
            "component": "CatalogChip"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "click",
            "selector": "button"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "html",
            "expect": {
                "contains": "vmz.resume.v0"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "resumed",
            "expect": {
                "value": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "createOnce",
            "expect": {}
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "text",
            "expect": {
                "contains": "chip:on"
            }
        }
    ]
}
