{
    "schema": "vmz.test.manifest.v0",
    "id": "production.catalog.browser.select",
    "title": "production catalog: real Chrome click select + nested ProductRow",
    "modes": ["browser"],
    "program": {
        "chunkId": "components/CatalogList",
        "unitName": "CatalogList",
        "components": {
            "ProductRow": "components/ProductRow"
        }
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "mount",
            "props": {}
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "click",
            "selector": "button"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "host",
            "expect": {
                "kind": "browser",
                "realDocument": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "text",
            "expect": {
                "contains": "selected: Alpha"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "state",
            "expect": {
                "selected": "Alpha"
            }
        }
    ]
}
