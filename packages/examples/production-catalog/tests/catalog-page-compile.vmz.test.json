{
    "schema": "vmz.test.manifest.v0",
    "id": "production.catalog.compile.page",
    "title": "production catalog: IndexPage + shell slot Direct plan",
    "modes": ["compile"],
    "program": {
        "chunkId": "pages/index",
        "unitName": "IndexPage",
        "components": {
            "CatalogShell": "components/CatalogShell",
            "CatalogList": "components/CatalogList",
            "ProductRow": "components/ProductRow"
        }
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "plan",
            "expect": {
                "schema": "vmz.plan.v0",
                "status": "partial",
                "nonEmpty": true,
                "anyStructuralKind": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "graph",
            "expect": {
                "direct": true,
                "create": true,
                "plan": true,
                "serialize": true,
                "noRender": true
            }
        }
    ]
}
