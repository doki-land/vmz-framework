<template>
    <main id="rows">
        <template v-for="item in items" :key="item.id">
            <h2>
                {{ item.title }}
            </h2>
            <p>
                {{ item.body }}
            </p>
        </template>
    </main>
</template>
<script client>
// Multi-root `template v-for` rows: each item owns an `h2` plus a `p`.
export default class IndexPage {
    public items = [
        {
            id: "a",
            title: "Alpha",
            body: "first",
        },
        {
            id: "b",
            title: "Bravo",
            body: "second",
        },
        {
            id: "c",
            title: "Charlie",
            body: "third",
        },
    ];
}
</script>
