{
    "schema": "vmz.test.manifest.v0",
    "id": "counter.browser.increment",
    "title": " Browser Host: real Chrome document + Direct click patch + node identity",
    "modes": ["browser"],
    "program": {
        "chunkId": "components/CounterButton",
        "unitName": "CounterButton"
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "mount",
            "props": {
                "initial": 0
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "click",
            "selector": "button"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "host",
            "expect": {
                "kind": "browser",
                "realDocument": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "text",
            "expect": {
                "contains": "count: 1"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "state",
            "expect": {
                "count": 1
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "nodeIdentity",
            "expect": {
                "selector": "button"
            }
        }
    ]
}
