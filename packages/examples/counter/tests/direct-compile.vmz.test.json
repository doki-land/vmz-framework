{
    "schema": "vmz.test.manifest.v0",
    "id": "l3.compile.counter",
    "title": "compile half: shared plan + Direct emit (no SSR/hydrate)",
    "modes": ["compile"],
    "program": {
        "chunkId": "components/CounterButton",
        "unitName": "CounterButton"
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "plan",
            "expect": {
                "schema": "vmz.plan.v0",
                "status": "partial",
                "nonEmpty": true,
                "anyStructuralKind": true,
                "nodeIdsInClient": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "graph",
            "expect": {
                "direct": true,
                "create": true,
                "plan": true,
                "serialize": true,
                "noRender": true,
                "includes": "vmz.plan.v0"
            }
        }
    ]
}
