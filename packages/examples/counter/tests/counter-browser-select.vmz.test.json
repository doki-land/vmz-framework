{
    "schema": "vmz.test.manifest.v0",
    "id": "counter.browser.select",
    "title": "Browser Host: select action (native) + timing evidence",
    "modes": ["browser"],
    "program": {
        "chunkId": "components/CounterButton",
        "unitName": "CounterButton"
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "mount",
            "props": {
                "initial": 0
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "select",
            "locator": { "kind": "testId", "testId": "counter-plan" },
            "value": "ops"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "value",
            "locator": { "kind": "testId", "testId": "counter-plan" },
            "expect": { "equals": "ops" }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "state",
            "expect": {
                "plan": "ops"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "timing",
            "expect": {
                "minSteps": 2
            }
        }
    ]
}
