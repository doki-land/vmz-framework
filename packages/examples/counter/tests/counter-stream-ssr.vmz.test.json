{
    "schema": "vmz.test.manifest.v0",
    "id": "counter.ssr.stream",
    "title": "T2 stream SSR: Direct serialize chunks join === renderToString",
    "modes": ["ssr"],
    "program": {
        "chunkId": "components/CounterButton",
        "unitName": "CounterButton"
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "renderToStream",
            "props": {
                "initial": 3
            }
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "html",
            "expect": {
                "contains": "count: 3"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "stream",
            "expect": {
                "chunkCountMin": 2,
                "equalsRenderToString": true,
                "firstChunkContains": "<button"
            }
        }
    ]
}
