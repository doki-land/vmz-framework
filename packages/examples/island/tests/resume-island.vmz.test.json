{
    "schema": "vmz.test.manifest.v0",
    "id": "resume.resume.island",
    "title": "Resume/: Island SSR slice + resume adopt + click",
    "modes": ["resume"],
    "program": {
        "chunkId": "pages/index",
        "unitName": "IndexPage",
        "resumeComponent": "LikeButton",
        "components": {
            "LikeButton": "components/LikeButton"
        }
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "ssr"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "html",
            "expect": {
                "contains": "data-vmz-island=\"LikeButton\""
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "resume",
            "component": "LikeButton"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "click",
            "selector": "button"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "html",
            "expect": {
                "contains": "vmz.resume.v0"
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "onMount",
            "expect": {
                "hits": 0
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "createOnce",
            "expect": {}
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "resumed",
            "expect": {
                "value": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "nodeIdentity",
            "expect": {}
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "text",
            "expect": {
                "containsAny": ["♥", "♡"]
            }
        }
    ]
}
