{
    "schema": "vmz.test.manifest.v0",
    "id": "resume.event.entry",
    "title": "Resume EventEntry: client:event waits for host click before resume",
    "modes": ["resume"],
    "program": {
        "chunkId": "pages/index",
        "unitName": "IndexPage",
        "resumeComponent": "EventButton",
        "components": {
            "LikeButton": "components/LikeButton",
            "EventButton": "components/EventButton"
        }
    },
    "plan": {
        "schema": "vmz.plan.v0",
        "ref": "unit.plan"
    },
    "actions": [
        {
            "schema": "vmz.test.action.v0",
            "kind": "ssr"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "html",
            "expect": {
                "contains": "data-vmz-entry=\"event\""
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "attachEventEntries",
            "component": "EventButton"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "assert",
            "assertion": "resumed",
            "expect": {
                "value": false
            }
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "clickHost",
            "component": "EventButton"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "click",
            "selector": "button"
        },
        {
            "schema": "vmz.test.action.v0",
            "kind": "flush"
        }
    ],
    "assertions": [
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "html",
            "expect": {
                "contains": "data-vmz-client=\"event\""
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "resumed",
            "expect": {
                "value": true
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "onMount",
            "expect": {
                "hits": 0
            }
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "nodeIdentity",
            "expect": {}
        },
        {
            "schema": "vmz.test.assertion.v0",
            "kind": "text",
            "expect": {
                "contains": "ON"
            }
        }
    ]
}
