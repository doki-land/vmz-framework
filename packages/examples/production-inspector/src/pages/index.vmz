<template>
  <div data-vmz-fixture="inspector" :data-density="density" :dir="dir">
    <AppShell brand="Inspector" homeHref="/" navLabel="Panel" :nav="navItems">
      <p data-vmz-fixture="inspector-explain">explain:route=InspectorPage</p>
      <p data-vmz-fixture="inspector-trace">trace:facet=route</p>
      <p data-vmz-fixture="inspector-state">density:{{ density }};dir:{{ dir }}</p>

      <div class="inspector-actions">
        <Button type="button" @click="cycleDensity">Cycle density</Button>
        <Button type="button" variant="secondary" @click="toggleDir">Toggle RTL</Button>
      </div>

      <Field
        label="Query"
        description="StableId or diagnostic code"
        :error="queryError"
        controlId="inspector-query"
        descriptionId="inspector-query-desc"
        errorId="inspector-query-err"
        :describedBy="queryDescribedBy"
        :value="query"
        @input="onQueryInput"
      />

      <Button type="button" @click="openDialog">Replay error</Button>
      <Dialog :open="open" title="Error replay" titleId="inspector-dialog-title" :onClose="closeDialog">
        <p data-vmz-fixture="inspector-replay">replay:generation=1</p>
      </Dialog>
    </AppShell>
  </div>
</template>

<style>
.inspector-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem 0.75rem;
}
</style>

<script client>
export default class InspectorPage {
  density = 'comfortable';
  dir = 'ltr';
  query = '';
  queryError = '';
  queryDescribedBy = 'inspector-query-desc';
  open = false;
  navItems = [
    { id: 'inspect', title: 'Inspect', href: '/' },
    { id: 'replay', title: 'Replay', href: '/#replay' },
  ];

  cycleDensity() {
    if (this.density === 'comfortable') this.density = 'compact';
    else if (this.density === 'compact') this.density = 'dense';
    else this.density = 'comfortable';
  }

  toggleDir() {
    this.dir = this.dir === 'rtl' ? 'ltr' : 'rtl';
  }

  openDialog() {
    this.open = true;
  }

  closeDialog() {
    this.open = false;
  }

  onQueryInput(e) {
    this.query = e?.target?.value ?? '';
    this.queryError = this.query.includes(' ') ? 'No spaces in StableId' : '';
    this.queryDescribedBy = this.queryError
      ? 'inspector-query-desc inspector-query-err'
      : 'inspector-query-desc';
  }
}
</script>
