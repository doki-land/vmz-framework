{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "baseUrl": ".",
        "types": ["node"]
    },
    "include": ["packages/runtimes/**/*.ts", "packages/plugins/**/*.ts", "packages/examples/**/*.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist", "packages/compilers", "**/dist"]
}
