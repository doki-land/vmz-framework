{
    "name": "vmz-framework",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.27.0",
    "scripts": {
        "build": "pnpm build:runtimes && pnpm vmz:build && pnpm build:examples",
        "vmz": "node packages/runtimes/vmz/bin/vmz.js",
        "vmz:cargo": "cargo run --manifest-path Cargo.toml -p vmz-tools --",
        "vmz:build": "cargo build --manifest-path Cargo.toml -p vmz-tools --release",
        "vmz:check": "cargo check --manifest-path Cargo.toml --workspace",
        "napi:build": "node scripts/build-napi.mjs",
        "build:vmz-test": "pnpm --filter @vmz/test run build",
        "gate:n1": "node scripts/_gate_n1_program_ir.mjs",
        "gate:n2": "node scripts/_gate_n2_node_cli.mjs",
        "gate:n3": "pnpm build:runtimes && node scripts/_gate_n3_plugin.mjs",
        "gate:n4": "node scripts/_gate_n4_affected.mjs",
        "gate:n": "pnpm gate:n1 && pnpm gate:n2 && pnpm gate:n3 && pnpm gate:n4",
        "gate:x0": "node scripts/_gate_x0_dx_protocol.mjs",
        "gate:x1": "node scripts/_gate_x1_dx_rename.mjs",
        "gate:x2": "node scripts/_gate_x2_dx_symbols.mjs",
        "gate:x3": "node scripts/_gate_x3_dx_incremental.mjs",
        "gate:x4": "node scripts/_gate_x4_dx_proof.mjs",
        "gate:x5": "node scripts/_gate_x5_dx_trace.mjs",
        "gate:mp0": "node scripts/_gate_mp0_target_contract.mjs",
        "gate:p0": "node scripts/_gate_p0_profile_protocol.mjs",
        "gate:p1": "node scripts/_gate_p1_profile_solver.mjs",
        "gate:p2": "node scripts/_gate_p2_unified_executor.mjs",
        "gate:p3": "node scripts/_gate_p3_lifecycle_recovery.mjs",
        "gate:p4": "node scripts/_gate_p4_delivery_proof.mjs",
        "gate:p5": "node scripts/_gate_p5_cross_host_conformance.mjs",
        "gate:nw0": "node scripts/_gate_nw0_native_host.mjs",
        "gate:nw1": "node scripts/_gate_nw1_native_shell.mjs",
        "gate:nw2": "node scripts/_gate_nw2_native_bridge.mjs",
        "gate:nw3": "node scripts/_gate_nw3_native_lifecycle.mjs",
        "gate:nw4": "node scripts/_gate_nw4_native_fullstack.mjs",
        "gate:nw5": "node scripts/_gate_nw5_native_surface.mjs",
        "gate:nw6": "node scripts/_gate_nw6_multi_platform.mjs",
        "gate:l3": "pnpm build:vmz-test && node scripts/_gate_l3_shared_plan.mjs",
        "gate:l4": "pnpm build:vmz-test && node scripts/_gate_l4_lifetime.mjs",
        "gate:l4-wb": "node scripts/_gate_l4_wb.mjs",
        "gate:l4-async-graph": "pnpm build:vmz-test && node scripts/_gate_l4_async_graph.mjs",
        "gate:l5": "pnpm build:vmz-test && node scripts/_gate_l5_resume.mjs",
        "gate:l5-zerojs": "pnpm build:vmz-test && node scripts/_gate_l5_zerojs.mjs",
        "gate:l5-mixed-pack": "pnpm build:vmz-test && node scripts/_gate_l5_mixed_pack.mjs",
        "gate:event-flow": "pnpm build:vmz-test && node scripts/_gate_event_flow.mjs && node scripts/_gate_l5_zerojs.mjs && node scripts/_gate_l5_mixed_pack.mjs",
        "gate:t0": "pnpm build:vmz-test && node scripts/_gate_t0_test_protocol.mjs",
        "gate:t1": "pnpm build:vmz-test && node scripts/_gate_t1_compile.mjs",
        "gate:t1-logic": "pnpm build:vmz-test && node scripts/_gate_t1_logic.mjs",
        "gate:t2": "pnpm build:vmz-test && node scripts/_gate_t2_ssr_resume.mjs",
        "gate:t2-browser": "pnpm build:vmz-test && node scripts/_gate_t2_browser.mjs",
        "gate:t2-stream": "pnpm build:vmz-test && node scripts/_gate_t2_stream.mjs",
        "gate:t2-stream-cancel": "pnpm build:vmz-test && node scripts/_gate_t2_stream_cancel.mjs",
        "gate:t4": "node scripts/_gate_t4_unload_vitest.mjs",
        "gate:d0-document": "node scripts/_gate_d0_document.mjs",
        "gate:d1": "node scripts/_gate_d1_document.mjs",
        "gate:d2": "node scripts/_gate_d2_document.mjs",
        "gate:d3": "node scripts/_gate_d3_document.mjs",
        "gate:i0": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i0_locale.mjs",
        "gate:i1": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i1_locale.mjs",
        "gate:i2": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i2_locale.mjs",
        "gate:i3": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i3_locale.mjs",
        "gate:m0": "node scripts/_gate_m0_application.mjs",
        "gate:m1": "node scripts/_gate_m1_application.mjs",
        "gate:m2": "node scripts/_gate_m2_application.mjs",
        "gate:m3": "node scripts/_gate_m3_application.mjs",
        "gate:m4": "node scripts/_gate_m4_application.mjs",
        "gate:m5": "node scripts/_gate_m5_application.mjs",
        "gate:style-theme": "node scripts/_gate_style_theme.mjs",
        "gate:ui0": "node scripts/_gate_ui0.mjs",
        "gate": "pnpm gate:n && pnpm gate:x0 && pnpm gate:x1 && pnpm gate:x2 && pnpm gate:x3 && pnpm gate:x4 && pnpm gate:x5 && pnpm gate:mp0 && pnpm gate:p0 && pnpm gate:p1 && pnpm gate:p2 && pnpm gate:p3 && pnpm gate:p4 && pnpm gate:p5 && pnpm gate:nw0 && pnpm gate:nw1 && pnpm gate:nw2 && pnpm gate:nw3 && pnpm gate:nw4 && pnpm gate:nw5 && pnpm gate:nw6 && pnpm gate:l3 && pnpm gate:l4 && pnpm gate:l4-wb && pnpm gate:l4-async-graph && pnpm gate:l5 && pnpm gate:event-flow && pnpm gate:t0 && pnpm gate:t1 && pnpm gate:t1-logic && pnpm gate:t2 && pnpm gate:t4 && pnpm gate:d0-document && pnpm gate:d1 && pnpm gate:d2 && pnpm gate:d3 && pnpm gate:i0 && pnpm gate:i1 && pnpm gate:i2 && pnpm gate:i3 && pnpm gate:i4 && pnpm gate:i5 && pnpm gate:m0 && pnpm gate:m1 && pnpm gate:m2 && pnpm gate:m3 && pnpm gate:m4 && pnpm gate:m5 && pnpm gate:style-theme && pnpm gate:ui0",
        "check:examples": "pnpm -r --filter \"./packages/examples/*\" --filter \"!@vmz-examples/test-utils\" run check",
        "build:examples": "pnpm -r --filter \"./packages/examples/*\" --filter \"!@vmz-examples/test-utils\" --filter \"!@vmz-examples/documents-fixture\" run build",
        "test": "pnpm test:unit && pnpm test:examples",
        "test:unit": "pnpm build:runtimes && pnpm --filter vmz --filter vmz-textmate run test",
        "test:examples": "pnpm --workspace-concurrency=1 --filter @vmz-examples/counter --filter @vmz-examples/island --filter @vmz-examples/fullstack run test",
        "sync:vscode-textmate": "node scripts/sync-vscode-textmate.mjs",
        "placeholder": "node scripts/publish-placeholder.mjs",
        "placeholder:publish": "node scripts/publish-placeholder.mjs publish",
        "placeholder:trust": "node scripts/publish-placeholder.mjs trust",
        "lint": "biome check .",
        "fmt": "biome format --write . && cargo fmt --all --manifest-path Cargo.toml",
        "fmt:check": "biome format . && cargo fmt --all --check --manifest-path Cargo.toml",
        "clean": "rimraf .turbo packages/examples/*/dist target",
        "build:runtimes": "pnpm --filter @vmz/protocol --filter vmz-fixtures --filter @vmz/core --filter vmz --filter @vmz/test run build",
        "gate:i4": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i4_locale.mjs",
        "gate:i5": "pnpm --filter @vmz/protocol --filter vmz run build && node scripts/_gate_i5_locale.mjs"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^22.15.30",
        "@vmz/core": "workspace:*",
        "@vmz/protocol": "workspace:*",
        "@vmz/test": "workspace:*",
        "linkedom": "^0.18.13",
        "rimraf": "^6.0.1",
        "shiki": "^3.12.2",
        "typescript": "^5.8.3",
        "vmz": "workspace:*",
        "vmz-textmate": "workspace:*",
        "vmz-fixtures": "workspace:*",
        "vmz-plugin-conformance": "workspace:*"
    }
}
