# Align with biome.json formatter keys consumed by `nifty format` (JetBrains / VS Code / Cursor).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,vue}]
indent_size = 2

# Consumed by `vmz format` / `vmz-formatter` (not Biome).
[*.vmz]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
