# Copy to `config.toml` (gitignored) for local Oaks sibling checkout.
# CI / publish: no `config.toml` — root `Cargo.toml` git `dev` only.
# Verify: `cargo tree -p oak-core` → filesystem path = patch active.

[patch."https://github.com/yggdrasil-language/oaks.git"]
oak-core = { path = "../../path/to/oaks/projects/oak-core" }
oak-vue = { path = "../../path/to/oaks/examples/oak-vue" }
oak-typescript = { path = "../../path/to/oaks/examples/oak-typescript" }

[alias]
